{
  "course": "causal-inference",
  "title": "Causal Inference and Applied Econometrics",
  "description": "Original constructed exercises in defining causal targets, stating identification assumptions, estimating contrasts and assessing their limits. Prerequisites: introductory econometrics, regression, conditional expectation, probability, sampling uncertainty and basic algebra. Advanced extensions are explicitly identified below; numerical scenarios are hypothetical, not empirical findings.",
  "reviewStatus": "draft",
  "sourceUrls": [
    "https://ocw.mit.edu/courses/14-387-applied-econometrics-mostly-harmless-big-data-fall-2014/",
