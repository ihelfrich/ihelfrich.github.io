    "https://coursebrowser.dce.harvard.edu/course/econometrics-and-causal-inference-with-r/"
  ],
  "prerequisites": [
    "Introductory econometrics and regression",
    "Conditional expectation and basic probability",
    "Sampling uncertainty and algebra"
  ],
