{
  "course": "game-theory",
  "title": "Game Theory",
  "description": "Original constructed exercises bridging advanced undergraduate game theory and graduate core reasoning. The numerical entry path uses algebra and probability; existence and refinement extensions require mathematical maturity.",
  "reviewStatus": "draft",
  "sourceUrls": [
    "https://ocw.mit.edu/courses/14-122-microeconomic-theory-ii-fall-2002/pages/calendar/",
    "https://ocw.mit.edu/courses/14-12-economic-applications-of-game-theory-fall-2025/pages/syllabus/",
    "https://oyc.yale.edu/economics/econ-159"
  ],
  "prerequisites": {
    "undergraduateEntry": [
      "Intermediate microeconomics",
      "Algebra and basic probability",
      "Single-variable optimization for quantity and auction examples"
    ],
    "graduateBridge": [
      "Expected utility and conditional probability",
      "Convexity, compactness, and fixed-point reasoning for existence",
      "Extensive-form strategies and limits for equilibrium refinements"
    ],
    "distinction": "The undergraduate path emphasizes explicit games and incentive calculations. Graduate bridge items ask about assumptions, counterexamples, and solution-concept distinctions; they are not a substitute for full theorem proofs."
  },
