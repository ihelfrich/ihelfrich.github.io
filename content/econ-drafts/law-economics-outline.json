{
  "course": "law-economics",
  "title": "Law and Economics",
  "description": "Original constructed economic models of property, liability, contracts, legal process, sanctions and institutions. Rules are stipulated for analysis and do not describe current law in a particular jurisdiction. Prerequisites: introductory microeconomics, probability, expected value and basic algebra; empirical extensions require introductory econometrics. All examples are hypothetical.",
  "reviewStatus": "draft",
  "sourceUrls": [
    "https://jsp-ls.berkeley.edu/sites/default/files/ls_145_fa_21.pdf",
    "https://catalog.yale.edu/ycps/courses/econ/"
  ],
  "prerequisites": [
    "Introductory microeconomics and welfare accounting",
    "Probability, expected value and algebra",
    "Empirical extensions: introductory econometrics and potential outcomes"
  ],
  "advancedExtensions": [
    "Bilateral precaution, incomplete collection and activity margins (2.4–2.6)",
