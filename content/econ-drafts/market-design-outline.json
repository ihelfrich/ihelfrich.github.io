{
  "course": "market-design",
  "title": "Market Design",
  "description": "Original constructed exercises on stable matching, school allocation, trading cycles, auction payments, contracts, exchange graphs and implementation evidence. Prerequisites: intermediate microeconomics, basic game theory, probability, graphs and careful execution of finite algorithms. Graduate extensions require mechanism-design and incentive-compatibility foundations. Compatibility graphs and market data are hypothetical, not clinical recommendations or empirical findings.",
  "reviewStatus": "draft",
  "sourceUrls": [
    "https://student.mit.edu/catalog/m14a.html",
    "https://ocw.mit.edu/courses/14-16-strategy-and-information-spring-2016/53dbe8d681978367f9c04182aa3c9b97_MIT14_16S16_Matching.pdf",
    "https://publicpolicy.stanford.edu/courses/market-design/1",
    "https://web.stanford.edu/~niederle/marketdesign2012.htm"
  ],
  "prerequisites": [
    "Intermediate microeconomics and game theory",
    "Probability and expected utility",
    "Finite graphs and algorithm tracing",
    "Graduate extensions: mechanism design and incentive compatibility"
  ],
  "advancedExtensions": [
    "VCG package externalities and budget tradeoffs (3.1–3.4, 3.9)",
    "Substitutability and institutional choice conditions (4.4–4.5, 4.7)",
    "Rural-hospitals domain and capacity incentives (4.8–4.9)",
    "Cycle packing, reliability and participation incentives (5.4–5.5, 5.8, 5.10)"
  ],
