  "course": "mathematical-economics",
  "title": "Mathematical Economics",
  "description": "Original constructed exercises in the mathematical tools of economic modeling. Prerequisites: single-variable calculus, algebra and basic economic optimization. Multivariate differentiation and linear algebra are developed through exercises; fixed-point and dynamic-programming extensions require comfort with limits, sets and probability. Domains, sign conventions and boundary cases are stated within questions. All numerical models are hypothetical.",
  "reviewStatus": "draft",
  "sourceUrls": [
    "https://web.mit.edu/14.102/www/syllabus.html",
    "https://eml.berkeley.edu/~hie/econ204/Syllabus.pdf",
    "https://ocw.mit.edu/courses/14-451-dynamic-optimization-methods-with-applications-fall-2009/pages/syllabus/"
  ],
  "prerequisites": [
    "Single-variable calculus and algebra",
    "Basic economic optimization and expected value",
    "For advanced units: sets, limits and elementary probability"
  ],
