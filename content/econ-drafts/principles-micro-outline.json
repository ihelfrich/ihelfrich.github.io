{
  "course": "principles-micro",
  "title": "Principles of Microeconomics",
  "description": "A standalone non-calculus introduction to microeconomics through original constructed decisions, schedules and short models. Covers opportunity cost and trade, markets, household choice, firms, strategic and information limits, and welfare. Prerequisites: arithmetic, percentages, basic algebra and reading tables. The course uses general undergraduate framing rather than exam-specific labels; hypothetical data are not empirical findings.",
  "reviewStatus": "draft",
  "sourceUrls": [
    "https://ocw.mit.edu/courses/14-01-principles-of-microeconomics-fall-2023/pages/calendar/",
    "https://eml.berkeley.edu/~olney/fall19/econ1/syllabus.pdf"
  ],
  "prerequisites": [
    "Arithmetic, percentages and basic algebra",
    "Reading tables and comparing alternatives",
    "No calculus or prior economics required"
  ],
  "advancedExtensions": [
    "Optional bridge to intermediate microeconomics: continuous constrained choice and production",
    "Optional bridge to game theory: formal equilibrium and private-information models",
    "Optional bridge to econometrics: causal evaluation beyond descriptive comparisons"
  ],
