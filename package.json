{
  "name": "ihelfrich-hub",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:copy && astro build && npm run fetch-spokes && npm run pagefind && npm run clean-spokes && npm run check:discovery",
    "build:fast": "astro build",
    "check:copy": "node scripts/check-site-copy.mjs",
    "check:fieldbook": "node scripts/check-fieldbook-content.mjs",
    "check:components": "node --test tests/unit/instruments.test.mjs",
    "check:econometrics": "node --test tests/unit/econometrics.test.mjs tests/unit/measurement.test.mjs tests/unit/measurement-ui.test.mjs && node scripts/check-econometrics.mjs",
    "check:discovery": "node scripts/check-public-discovery.mjs",
    "check:public-cv": "node scripts/check-public-cv-safety.mjs",
    "check": "npm run check:copy && npm run check:fieldbook && npm run check:components && npm run build:fast && npm run check:styles && npm run check:public-cv",
    "check:styles": "node scripts/check-rendered-styles.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "fetch-spokes": "node scripts/fetch-spokes.mjs",
    "pagefind": "pagefind --site dist --output-path dist/pagefind",
    "clean-spokes": "node scripts/clean-spokes.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "astro": "7.2.0",
    "katex": "0.18.5",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/rss": "4.0.19",
    "happy-dom": "^20.11.2",
    "js-yaml": "^4.3.1",
    "pagefind": "^1.5.2",
    "pdfjs-dist": "^6.2.108"
  },
  "overrides": {
    "sharp": "0.35.3",
    "svgo": "4.0.2"
  }
}
