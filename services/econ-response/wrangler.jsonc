{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "helfrich-economics-responses",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://ihelfrich.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helfrich-economics-responses",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
