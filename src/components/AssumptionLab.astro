---
import EvidenceAperture from "./EvidenceAperture.astro";
import { readVerdicts, renderFigure, runExperiment } from "../lib/ols-assumptions.mjs";

export interface Props {
  id: string;
  assumption: string;
  number: number;
  kicker: string;
  question: string;
  caption: string;
  strengthLabel: string;
  defaultStrength?: number;
  defaultN?: number;
  domain: [number, number];
  limit: string;
  method: string[];
}

const {
  id,
  assumption,
  number,
  kicker,
  question,
  caption,
  strengthLabel,
  defaultStrength = 0,
  defaultN = 60,
  domain,
  limit,
  method,
} = Astro.props;

const REPS = 500;
const initial = runExperiment({ assumption, strength: defaultStrength, n: defaultN, reps: REPS });
const verdict = readVerdicts(initial, { robust: false });
// Drawn at a typical desktop width; the script redraws it at the width it actually occupies.
const figure = renderFigure(initial, { domain, width: 720 });
---

<EvidenceAperture
  id={id}
  name={kicker}
  liveRegionId={`${id}-live`}
  class="assumption-lab"
  question={question}
  caption={caption}
  status={`Live Monte Carlo · ${REPS} samples per setting`}
  method={method}
  role="Designed and developed by Ian Helfrich"
  limit={limit}
  links={[
    { label: "All seven assumptions", href: "/teaching/ols-assumptions" },
    { label: "Engine source", href: "https://github.com/ihelfrich/ihelfrich.github.io/blob/main/src/lib/ols-assumptions.mjs", external: true },
  ]}
>
  <figure slot="figure" class="lab" data-lab data-assumption={assumption} data-domain={domain.join(",")} data-reps={REPS} data-truth={initial.trueB1}>
    <p class="lab-kicker"><span>{String(number).padStart(2, "0")}</span> {kicker}</p>

    <svg viewBox={`0 0 ${figure.width} ${figure.height}`} role="img" aria-labelledby={`${id}-t ${id}-d`} class="lab-svg" data-lab-svg>
      <title id={`${id}-t`}>{`Where five hundred estimates land, and whether one hundred confidence intervals cover the true slope`}</title>
      <desc id={`${id}-d`}>
        The upper panel is the distribution of the estimated slope across repeated samples, against the true slope.
        The lower panel draws one hundred confidence intervals as vertical lines; those that fail to cross the true
        slope are marked as misses. Every quantity is repeated in the text below the figure.
      </desc>
      <g data-lab-plot set:html={figure.markup} />
    </svg>

    <figcaption>
      Each vertical line is one study's 95% interval. A line that fails to cross the horizontal rule is a study that
      would have reported a confidently wrong answer. Five in a hundred is the promise. These hundred are themselves
      a sample, so they wobble around the rate in the verdict, which uses all five hundred.
    </figcaption>
  </figure>

  <div slot="controls" class="lab-controls">
    <label class="lab-control">
      <span class="lab-control__name">{strengthLabel}</span>
      <input type="range" min="0" max="100" value={defaultStrength * 100} step="1" data-lab-strength />
      <output class="lab-control__value" data-lab-strength-out>{defaultStrength === 0 ? "assumption holds" : `${Math.round(defaultStrength * 100)}%`}</output>
    </label>
    <label class="lab-control">
      <span class="lab-control__name">Sample size</span>
      <input type="range" min="10" max="400" value={defaultN} step="5" data-lab-n />
      <output class="lab-control__value" data-lab-n-out>{`n = ${defaultN}`}</output>
    </label>
    <label class="lab-control lab-control--toggle">
      <input type="checkbox" data-lab-robust />
      <span>Robust (HC1) standard errors</span>
    </label>
  </div>

  <div class="lab-receipt" data-lab-receipt>
    <p class="lab-start">The panel opens with the assumption satisfied. Moving the first slider introduces the violation, and the three readings below show which property of the estimate it affects.</p>
    <ol class="lab-chips">
      <li class="lab-chip" data-state={verdict.centre.state} data-lab-chip="centre">
        <p class="lab-chip__axis">Centre</p>
        <p class="lab-chip__verdict" data-lab-chip-label>{verdict.centre.label}</p>
        <p class="lab-chip__detail" data-lab-chip-detail>{verdict.centre.detail}</p>
      </li>
      <li class="lab-chip" data-state={verdict.honesty.state} data-lab-chip="honesty">
        <p class="lab-chip__axis">Honesty</p>
        <p class="lab-chip__verdict" data-lab-chip-label>{verdict.honesty.label}</p>
        <p class="lab-chip__detail" data-lab-chip-detail>{verdict.honesty.detail}</p>
      </li>
      <li class="lab-chip" data-state={verdict.size.state} data-lab-chip="size">
        <p class="lab-chip__axis">The test</p>
        <p class="lab-chip__verdict" data-lab-chip-label>{verdict.size.label}</p>
        <p class="lab-chip__detail" data-lab-chip-detail>{verdict.size.detail}</p>
      </li>
    </ol>
    <p class="lab-reading" data-lab-reading>{verdict.reading}</p>
  </div>

  <noscript>
    <p class="lab-noscript">
      The figure is rendered at {defaultStrength === 0 ? "0% violation, with the assumption satisfied," : `${Math.round(defaultStrength * 100)}% violation`} and n = {defaultN}.
      The summary table and the thumbnails above report the full violation. The sliders need JavaScript; the figure,
      the verdicts, and the reading of them do not.
    </p>
  </noscript>
</EvidenceAperture>

<style>
  /*
   * The aperture shell is rendered by EvidenceAperture, and the figure's SVG
   * content is generated as markup (on the server and again in the browser),
   * so neither carries this component's scoping attribute. Every rule that
   * reaches them is therefore anchored on the global .assumption-lab class.
   */
  :global(.assumption-lab) .lab {
    background: var(--ef-figure);
    border: 1px solid color-mix(in srgb, var(--ef-ink) 16%, var(--ef-paper));
    margin: 0;
    padding: 0.9rem 1rem 0.7rem;
  }
  .lab-kicker {
    align-items: baseline;
    color: color-mix(in srgb, var(--ef-ink) 72%, transparent);
    display: flex;
    font: 600 0.75rem/1.4 var(--font-data);
    gap: 0.6rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.5rem;
    text-transform: uppercase;
  }
  .lab-kicker span { color: var(--ef-signal); font-weight: 700; }
  .lab-svg { display: block; height: auto; width: 100%; }

  :global(.assumption-lab .lab-head) {
    fill: color-mix(in srgb, var(--ef-ink) 78%, transparent);
    font: 600 12px/1.4 var(--font-data);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  :global(.assumption-lab .lab-head--count) { fill: var(--ef-oxide); font-weight: 700; }
  :global(.assumption-lab .lab-axis-tick) {
    fill: color-mix(in srgb, var(--ef-ink) 72%, transparent);
    font: 500 11px/1.3 var(--font-data);
    font-variant-numeric: tabular-nums;
  }
  :global(.assumption-lab .lab-flag) {
    font: 600 12px/1.3 var(--font-data);
    font-variant-numeric: tabular-nums;
    paint-order: stroke;
    stroke: var(--ef-figure);
    stroke-linejoin: round;
    stroke-width: 4px;
  }
  :global(.assumption-lab .lab-flag--truth) { fill: var(--ef-ink); }
  :global(.assumption-lab .lab-flag--mean) { fill: var(--ef-signal); }
  :global(.assumption-lab .lab-bar) { fill: color-mix(in srgb, var(--ef-signal) 30%, var(--ef-paper)); }
  :global(.assumption-lab .lab-axis) { stroke: color-mix(in srgb, var(--ef-ink) 40%, transparent); }
  :global(.assumption-lab .lab-truth) { stroke: var(--ef-ink); stroke-dasharray: 7 5; stroke-width: 2; }
  :global(.assumption-lab .lab-truth-rule) { stroke: var(--ef-ink); stroke-width: 2; }
  :global(.assumption-lab .lab-mean) { stroke: var(--ef-signal); stroke-width: 2.5; }
  :global(.assumption-lab .lab-span) { stroke-linecap: butt; stroke-width: 8; }
  :global(.assumption-lab .lab-span--actual) { stroke: var(--ef-teal); }
  :global(.assumption-lab .lab-span--reported) { stroke: var(--ef-oxide); }
  :global(.assumption-lab .lab-span-label) { font: 500 12px/1.3 var(--font-data); font-variant-numeric: tabular-nums; }
  :global(.assumption-lab .lab-span-label--actual) { fill: var(--ef-teal); }
  :global(.assumption-lab .lab-span-label--reported) { fill: var(--ef-oxide); }
  :global(.assumption-lab .lab-ci) { stroke: color-mix(in srgb, var(--ef-ink) 34%, var(--ef-paper)); stroke-width: var(--lab-ci-width, 4px); }
  :global(.assumption-lab .lab-ci--miss) { stroke: var(--ef-oxide); stroke-width: var(--lab-ci-miss-width, 5px); }

  :global(.assumption-lab) figcaption {
    color: color-mix(in srgb, var(--ef-ink) 72%, transparent);
    font: 500 0.78rem/1.55 var(--font-data);
    margin-top: 0.5rem;
    max-width: 70ch;
  }

  .lab-controls { display: flex; flex-wrap: wrap; gap: 1rem 1.8rem; align-items: end; }
  .lab-control { display: grid; gap: 0.2rem; font: 500 0.78rem/1.4 var(--font-data); min-width: min(14rem, 100%); }
  .lab-control__name {
    color: color-mix(in srgb, var(--ef-ink) 72%, transparent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .lab-control input[type="range"] { accent-color: var(--ef-signal); min-height: 44px; width: 100%; }
  .lab-control__value { color: var(--ef-signal); font-variant-numeric: tabular-nums; font-weight: 650; }
  .lab-control--toggle { align-items: center; display: flex; gap: 0.55rem; min-height: 44px; }
  .lab-control--toggle input { accent-color: var(--ef-signal); height: 20px; width: 20px; }

  .lab-receipt { display: grid; gap: 0.85rem; }
  .lab-start {
    color: color-mix(in srgb, var(--ef-ink) 78%, transparent);
    font: 400 0.92rem/1.55 var(--font-text);
    margin: 0;
    max-width: 66ch;
  }
  .lab-chips { display: grid; gap: 0.6rem; list-style: none; margin: 0; padding: 0; }
  .lab-chip {
    border-left: 4px solid color-mix(in srgb, var(--ef-ink) 30%, var(--ef-paper));
    display: grid;
    gap: 0.1rem;
    padding: 0.35rem 0 0.35rem 0.7rem;
  }
  .lab-chip p { margin: 0; }
  .lab-chip__axis {
    color: color-mix(in srgb, var(--ef-ink) 74%, transparent);
    font: 600 0.75rem/1.4 var(--font-data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .lab-chip__verdict { font: 650 1rem/1.3 var(--font-display); }
  .lab-chip__detail {
    color: color-mix(in srgb, var(--ef-ink) 74%, transparent);
    font: 500 0.78rem/1.45 var(--font-data);
    font-variant-numeric: tabular-nums;
  }
  .lab-chip[data-state="clean"] { border-left-color: var(--ef-teal); }
  .lab-chip[data-state="clean"] .lab-chip__verdict { color: var(--ef-teal); }
  .lab-chip[data-state="warn"] { border-left-color: var(--ef-signal); }
  .lab-chip[data-state="warn"] .lab-chip__verdict { color: var(--ef-signal); }
  .lab-chip[data-state="broken"] { border-left-color: var(--ef-oxide); }
  .lab-chip[data-state="broken"] .lab-chip__verdict { color: var(--ef-oxide); }
  .lab-reading {
    border-top: 1px solid color-mix(in srgb, var(--ef-ink) 16%, var(--ef-paper));
    font: 400 1rem/1.6 var(--font-text);
    max-width: 66ch;
    padding-top: 0.7rem;
  }
  .lab-noscript { color: color-mix(in srgb, var(--ef-ink) 74%, transparent); font: 500 0.78rem/1.55 var(--font-data); }

  @media (min-width: 34rem) {
    .lab-chips { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  /* On a phone the nested insets of the shell and the figure frame cost a third of the width. */
  @media (max-width: 36rem) {
    :global(.assumption-lab .evidence-aperture__figure) { padding: var(--ef-space-3) var(--ef-space-2); }
    :global(.assumption-lab .evidence-aperture__header) { padding: var(--ef-space-4) var(--ef-space-3) 0; }
    :global(.assumption-lab .evidence-aperture__controls) { padding: 0 var(--ef-space-3); }
    :global(.assumption-lab .evidence-aperture__result) { padding: 0 var(--ef-space-3) var(--ef-space-4); }
    :global(.assumption-lab .evidence-aperture__margin) { padding: var(--ef-space-4) var(--ef-space-3); }
    :global(.assumption-lab) .lab { padding: 0.6rem 0.5rem 0.5rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.assumption-lab .lab-span) { transition: all 140ms ease-out; }
  }
</style>

<script>
  import { readVerdicts, renderFigure, runExperiment } from "../lib/ols-assumptions.mjs";

  document.querySelectorAll("[data-lab]").forEach((panel) => {
    const assumption = panel.getAttribute("data-assumption");
    const reps = Number(panel.getAttribute("data-reps")) || 500;
    const domain = (panel.getAttribute("data-domain") || "0,2").split(",").map(Number);
    const aperture = panel.closest(".evidence-aperture");
    if (!assumption || !aperture) return;

    const q = (selector) => aperture.querySelector(selector);
    const strength = q("[data-lab-strength]");
    const nInput = q("[data-lab-n]");
    const robust = q("[data-lab-robust]");
    const svg = q("[data-lab-svg]");
    const plot = q("[data-lab-plot]");
    const reading = q("[data-lab-reading]");
    const live = q(`#${aperture.id}-live`);
    if (!(strength instanceof HTMLInputElement) || !(nInput instanceof HTMLInputElement) || !svg || !plot) return;

    let latest = null;
    let drawnWidth = 0;
    let frame = 0;

    /** Lay the figure out for the width it occupies now, so its text renders at full size. */
    const paint = () => {
      if (!latest) return;
      const width = svg.getBoundingClientRect().width;
      if (!(width > 0)) return;
      const figure = renderFigure(latest.result, { domain, width, robust: latest.robust });
      svg.setAttribute("viewBox", `0 0 ${figure.width} ${figure.height}`);
      plot.innerHTML = figure.markup;
      drawnWidth = width;
    };

    const draw = (announce = true) => {
      const s = Number(strength.value) / 100;
      const n = Number(nInput.value);
      const useRobust = robust instanceof HTMLInputElement && robust.checked;
      const result = runExperiment({ assumption, strength: s, n, reps });
      if (!result) return;
      const verdict = readVerdicts(result, { robust: useRobust });
      latest = { result, robust: useRobust };
      paint();

      const chips = { centre: verdict.centre, honesty: verdict.honesty, size: verdict.size };
      for (const [key, value] of Object.entries(chips)) {
        const chip = q(`[data-lab-chip="${key}"]`);
        if (!chip) continue;
        chip.setAttribute("data-state", value.state);
        const label = chip.querySelector("[data-lab-chip-label]");
        const detail = chip.querySelector("[data-lab-chip-detail]");
        if (label) label.textContent = value.label;
        if (detail) detail.textContent = value.detail;
      }
      if (reading) reading.textContent = verdict.reading;
      if (live && announce) {
        live.textContent =
          `${verdict.centre.label}. ${verdict.honesty.label}. ${verdict.size.label}. ` +
          `${verdict.misses} of one hundred intervals miss the true slope.`;
      }
    };

    let pending = false;
    const schedule = () => {
      pending = true;
      window.cancelAnimationFrame(frame);
      // Animation frames are suspended while the tab is hidden, so a change made
      // on the way out would otherwise leave a stale figure behind.
      frame = window.requestAnimationFrame(() => {
        pending = false;
        draw();
      });
    };
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden && pending) schedule();
    });
    strength.addEventListener("input", () => {
      const out = q("[data-lab-strength-out]");
      if (out) out.textContent = strength.value === "0" ? "assumption holds" : `${strength.value}%`;
      schedule();
    });
    nInput.addEventListener("input", () => {
      const out = q("[data-lab-n-out]");
      if (out) out.textContent = `n = ${nInput.value}`;
      schedule();
    });
    if (robust instanceof HTMLInputElement) robust.addEventListener("change", schedule);

    // The server drew the figure at a nominal width. Redraw it at the real one
    // shortly before the panel scrolls into view, so seven simulations do not
    // all run during page load, and again whenever the column changes width,
    // without rerunning the simulation.
    if ("IntersectionObserver" in window) {
      const reveal = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        reveal.disconnect();
        if (!latest) draw(false);
      }, { rootMargin: "600px 0px" });
      reveal.observe(svg);
    } else {
      draw(false);
    }
    if ("ResizeObserver" in window) {
      new ResizeObserver(() => {
        const width = svg.getBoundingClientRect().width;
        if (Math.abs(width - drawnWidth) >= 1) paint();
      }).observe(svg);
    }
  });
</script>
