<section
  class="counterfactual-atlas"
  data-counterfactual-atlas
  data-stage="observe"
  data-rail-label="COUNTERFACTUAL ATLAS"
  aria-labelledby="atlas-title"
>
  <header class="atlas-identity">
    <span>IAN T. S. HELFRICH / PHD ECONOMICS + MS GIS</span>
    <span>THE EVIDENCE STUDIO</span>
  </header>

  <div class="atlas-field" data-atlas-field>
    <canvas data-atlas-canvas aria-hidden="true"></canvas>
    <div class="atlas-field__fallback" aria-hidden="true">
      <span class="atlas-field__fallback-mark"></span>
      <span class="atlas-field__fallback-mark"></span>
      <span class="atlas-field__fallback-mark"></span>
      <span class="atlas-field__fallback-mark"></span>
