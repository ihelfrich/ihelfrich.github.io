  </p>

  <p class="atlas-live" data-atlas-live aria-live="polite" aria-atomic="true"></p>
</section>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll("[data-counterfactual-atlas]");

    roots.forEach((root) => {
      if (root.dataset.atlasMounted === "true") return;
      root.dataset.atlasMounted = "true";

      const field = root.querySelector("[data-atlas-field]");
      const canvas = root.querySelector("[data-atlas-canvas]");
      const context = canvas?.getContext("2d", { alpha: false });
      if (!field || !canvas || !context) return;

      const ui = {
        stageButtons: Array.from(root.querySelectorAll("[data-stage-button]")),
        stageIndex: root.querySelector("[data-stage-index]"),
        designName: root.querySelector("[data-design-name]"),
        estimate: root.querySelector("[data-estimate]"),
        diagnosticLabel: root.querySelector("[data-diagnostic-label]"),
        diagnosticValue: root.querySelector("[data-diagnostic-value]"),
        interval: root.querySelector("[data-interval]"),
        intervalText: root.querySelector("[data-interval-text]"),
        claim: root.querySelector("[data-claim]"),
        explanation: root.querySelector("[data-explanation]"),
        focalInput: root.querySelector("[data-focal-input]"),
        focalLabel: root.querySelector("[data-focal-label]"),
        radiusInput: root.querySelector("[data-radius-input]"),
        radiusLabel: root.querySelector("[data-radius-label]"),
        estimands: Array.from(root.querySelectorAll('input[name="atlas-estimand"]')),
        reset: root.querySelector("[data-reset-button]"),
        lock: root.querySelector("[data-lock-button]"),
        receipt: root.querySelector("[data-lens-receipt]"),
        lensMode: root.querySelector("[data-lens-mode]"),
        lensUnit: root.querySelector("[data-lens-unit]"),
        lensRegion: root.querySelector("[data-lens-region]"),
        instruction: root.querySelector("[data-atlas-instruction]"),
        readout: root.querySelector("[data-atlas-readout]"),
        live: root.querySelector("[data-atlas-live]"),
      };

      const STAGES = {
        observe: {
          index: "01",
          label: "OBSERVE",
          design: "RAW COMPARISON",
          diagnostic: "ASSIGNMENT GAP",
        },
        design: {
          index: "02",
          label: "DESIGN",
          design: "BALANCED COMPARISON",
          diagnostic: "MAX BALANCE",
        },
        estimate: {
          index: "03",
          label: "ESTIMATE",
          design: "REGION FIXED EFFECTS",
          diagnostic: "REGIONS CONTROLLED",
        },
        decide: {
          index: "04",
          label: "DECIDE",
          design: "SPATIAL MATCH",
          diagnostic: "TREATED RETAINED",
        },
      };

      const COLUMNS = 12;
      const ROWS = 10;
      const UNIT_COUNT = COLUMNS * ROWS;
      const DEFAULT_FOCAL = 36;
      const DEFAULT_RADIUS = 0.24;
      const intervalDomain = [-0.6, 1.2];
      const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const forcedColorsQuery = window.matchMedia("(forced-colors: active)");

      const state = {
        stage: "observe",
        estimand: "place",
        radius: DEFAULT_RADIUS,
        focalUnitId: DEFAULT_FOCAL,
        hoverUnitId: null,
        pointerDown: false,
        locked: false,
        interacted: false,
        visible: true,
        reducedMotion: reducedMotionQuery.matches,
        forcedColors: forcedColorsQuery.matches,
        width: 1,
        height: 1,
        dpr: 1,
        lensX: 0,
        lensY: 0,
        targetLensX: 0,
        targetLensY: 0,
        lensInitialized: false,
        result: null,
        frame: 0,
        dirty: true,
        lane: "estimate",
      };

      function mulberry32(seed) {
        let value = seed >>> 0;
        return function random() {
          value += 0x6d2b79f5;
          let next = value;
          next = Math.imul(next ^ (next >>> 15), next | 1);
          next ^= next + Math.imul(next ^ (next >>> 7), next | 61);
          return ((next ^ (next >>> 14)) >>> 0) / 4294967296;
        };
      }

      const random = mulberry32(1931);

      function normalRandom() {
        const first = Math.max(random(), Number.EPSILON);
        const second = random();
        return Math.sqrt(-2 * Math.log(first)) * Math.cos(2 * Math.PI * second);
      }

      function clamp(value, minimum, maximum) {
        return Math.min(maximum, Math.max(minimum, value));
      }

      function logistic(value) {
        return 1 / (1 + Math.exp(-value));
      }

      function distanceToSegment(x, y, ax, ay, bx, by) {
        const dx = bx - ax;
        const dy = by - ay;
        const lengthSquared = dx * dx + dy * dy;
        const amount = lengthSquared === 0 ? 0 : clamp(((x - ax) * dx + (y - ay) * dy) / lengthSquared, 0, 1);
        const px = ax + amount * dx;
        const py = ay + amount * dy;
        return Math.hypot(x - px, y - py);
      }

      function generateUnits() {
        const vertices = [];
        for (let row = 0; row <= ROWS; row += 1) {
          const vertexRow = [];
          for (let column = 0; column <= COLUMNS; column += 1) {
            const edgeX = column === 0 || column === COLUMNS;
            const edgeY = row === 0 || row === ROWS;
            vertexRow.push([
              column / COLUMNS + (edgeX ? 0 : (random() - 0.5) * 0.022),
              row / ROWS + (edgeY ? 0 : (random() - 0.5) * 0.026),
            ]);
          }
          vertices.push(vertexRow);
        }

        const regionAssignmentShift = [0.32, -0.24, 0.18, -0.12];
        const regionOutcomeShift = [-0.34, 0.24, 0.42, -0.18];
        const generated = [];

        for (let row = 0; row < ROWS; row += 1) {
          for (let column = 0; column < COLUMNS; column += 1) {
            const polygon = [
              vertices[row][column],
              vertices[row][column + 1],
              vertices[row + 1][column + 1],
              vertices[row + 1][column],
            ];
            const x = polygon.reduce((sum, point) => sum + point[0], 0) / polygon.length;
            const y = polygon.reduce((sum, point) => sum + point[1], 0) / polygon.length;
            const region = (row < ROWS / 2 ? 0 : 2) + (column < COLUMNS / 2 ? 0 : 1);
            const corridorDistance = Math.min(
              distanceToSegment(x, y, 0.03, 0.18, 0.96, 0.76),
              distanceToSegment(x, y, 0.19, 0.97, 0.72, 0.03),
            );
            const access = Math.exp(-6 * corridorDistance);
            const spatialWave = 0.30 * Math.sin(Math.PI * 2.2 * x) * Math.cos(Math.PI * 1.6 * y);
            const baseline = 0.75 * x - 0.45 * y + spatialWave + normalRandom() * 0.20;
            const propensity = clamp(logistic(-0.68 + 1.15 * baseline + 0.90 * access + regionAssignmentShift[region]), 0.06, 0.94);
            const treated = random() < propensity ? 1 : 0;
            const population = Math.round(420 + 2750 * logistic(0.45 + 0.75 * baseline + 0.55 * access + normalRandom() * 0.45));
            const outcome = 0.30 * treated + 0.95 * baseline + 0.60 * access + regionOutcomeShift[region] + normalRandom() * 0.28;

            generated.push({
              id: row * COLUMNS + column,
              row,
              column,
              x,
              y,
              region,
              population,
              baseline,
              access,
              propensity,
              treated,
              outcome,
              polygon,
            });
          }
        }

        return generated;
      }

      const units = generateUnits();
      const meanPopulation = units.reduce((sum, unit) => sum + unit.population, 0) / units.length;
      const outcomeMean = units.reduce((sum, unit) => sum + unit.outcome, 0) / units.length;
      const outcomeDeviation = Math.sqrt(units.reduce((sum, unit) => sum + (unit.outcome - outcomeMean) ** 2, 0) / units.length) || 1;

      function baseWeight(unit) {
        return state.estimand === "population" ? unit.population / meanPopulation : 1;
      }

      function robustBinaryRegression(weights) {
        let s00 = 0;
        let s01 = 0;
        let s11 = 0;
        let sy0 = 0;
        let sy1 = 0;

        units.forEach((unit, index) => {
          const weight = weights[index];
          s00 += weight;
          s01 += weight * unit.treated;
          s11 += weight * unit.treated;
          sy0 += weight * unit.outcome;
          sy1 += weight * unit.treated * unit.outcome;
        });

        const determinant = s00 * s11 - s01 * s01;
        if (Math.abs(determinant) < 1e-9) return { estimate: 0, standardError: 0 };

        const inverse00 = s11 / determinant;
        const inverse01 = -s01 / determinant;
        const inverse11 = s00 / determinant;
        const intercept = inverse00 * sy0 + inverse01 * sy1;
        const estimate = inverse01 * sy0 + inverse11 * sy1;
        let meat00 = 0;
        let meat01 = 0;
        let meat11 = 0;

        units.forEach((unit, index) => {
          const residual = unit.outcome - intercept - estimate * unit.treated;
          const scoreSquared = (weights[index] * residual) ** 2;
          meat00 += scoreSquared;
          meat01 += scoreSquared * unit.treated;
          meat11 += scoreSquared * unit.treated;
        });

        const variance = (
          inverse01 * inverse01 * meat00
          + 2 * inverse01 * inverse11 * meat01
          + inverse11 * inverse11 * meat11
        ) * (units.length / Math.max(1, units.length - 2));

        return { estimate, standardError: Math.sqrt(Math.max(0, variance)) };
      }

      function weightedMoments(property, treatment, weights) {
        let totalWeight = 0;
        let weightedSum = 0;
        units.forEach((unit, index) => {
          if (unit.treated !== treatment) return;
          totalWeight += weights[index];
          weightedSum += weights[index] * unit[property];
        });
        const mean = totalWeight ? weightedSum / totalWeight : 0;
        let varianceSum = 0;
        units.forEach((unit, index) => {
          if (unit.treated !== treatment) return;
          varianceSum += weights[index] * (unit[property] - mean) ** 2;
        });
        return { mean, variance: totalWeight ? varianceSum / totalWeight : 0 };
      }

      function maximumBalanceGap(weights) {
        return ["baseline", "access"].reduce((maximum, property) => {
          const treated = weightedMoments(property, 1, weights);
          const comparison = weightedMoments(property, 0, weights);
          const pooled = Math.sqrt(Math.max(1e-9, (treated.variance + comparison.variance) / 2));
          return Math.max(maximum, Math.abs(treated.mean - comparison.mean) / pooled);
        }, 0);
      }

      function rawResult() {
        const weights = units.map((unit) => baseWeight(unit));
        const model = robustBinaryRegression(weights);
        const balance = maximumBalanceGap(weights);
        return {
          ...model,
          diagnosticValue: `${balance.toFixed(2)} SMD`,
          retained: units.length,
          changedUnits: [],
          claim: `Across the synthetic field, the unadjusted ${state.estimand === "population" ? "population-weighted" : "place-weighted"} difference is ${formatSigned(model.estimate)} ${formatInterval(model.estimate, model.standardError)}. It is descriptive and does not isolate a treatment effect.`,
          explanation: `This stage compares weighted average outcomes across ${units.filter((unit) => unit.treated).length} treated and ${units.filter((unit) => !unit.treated).length} comparison places. Assignment still follows baseline conditions, corridor access, and region.`,
        };
      }

      function balancedResult() {
        const weights = units.map((unit) => {
          const inverseProbability = unit.treated ? 1 / unit.propensity : 1 / (1 - unit.propensity);
          return baseWeight(unit) * clamp(inverseProbability, 0.1, 10);
        });
        const model = robustBinaryRegression(weights);
        const balance = maximumBalanceGap(weights);
        const changedUnits = units.filter((unit) => {
          const inverseProbability = unit.treated ? 1 / unit.propensity : 1 / (1 - unit.propensity);
          return inverseProbability >= 10;
        }).map((unit) => unit.id);
        return {
          ...model,
          diagnosticValue: `${balance.toFixed(2)} SMD`,
          retained: units.length,
          changedUnits,
          claim: `After balancing observed assignment factors, the simulated ${state.estimand === "population" ? "population-weighted" : "place-weighted"} difference is ${formatSigned(model.estimate)} ${formatInterval(model.estimate, model.standardError)}. The comparison relies on overlap and measured covariates.`,
          explanation: `Inverse-propensity weights balance baseline conditions and corridor access. Weights are clipped at 10; ${changedUnits.length} synthetic place${changedUnits.length === 1 ? " is" : "s are"} affected by that limit.`,
        };
      }

      function regionFixedEffectResult() {
        const weights = units.map((unit) => baseWeight(unit));
        const regionMeans = new Map();

        for (let region = 0; region < 4; region += 1) {
          const members = units.filter((unit) => unit.region === region);
          const totalWeight = members.reduce((sum, unit) => sum + weights[unit.id], 0);
          regionMeans.set(region, {
            treatment: members.reduce((sum, unit) => sum + weights[unit.id] * unit.treated, 0) / totalWeight,
            outcome: members.reduce((sum, unit) => sum + weights[unit.id] * unit.outcome, 0) / totalWeight,
          });
        }

        let denominator = 0;
        let numerator = 0;
        const transformed = units.map((unit) => {
          const means = regionMeans.get(unit.region);
          const treatment = unit.treated - means.treatment;
          const outcome = unit.outcome - means.outcome;
          denominator += weights[unit.id] * treatment * treatment;
          numerator += weights[unit.id] * treatment * outcome;
          return { treatment, outcome };
        });
        const estimate = denominator ? numerator / denominator : 0;
        let meat = 0;
        transformed.forEach((unit, index) => {
          const residual = unit.outcome - estimate * unit.treatment;
          meat += (weights[index] * unit.treatment * residual) ** 2;
        });
        const variance = denominator ? meat / (denominator * denominator) * (units.length / Math.max(1, units.length - 1)) : 0;
        const standardError = Math.sqrt(Math.max(0, variance));
        return {
          estimate,
          standardError,
          diagnosticValue: "4 / 4",
          retained: units.length,
          changedUnits: [],
          claim: `Within four synthetic regions, the ${state.estimand === "population" ? "population-weighted" : "place-weighted"} estimate is ${formatSigned(estimate)} ${formatInterval(estimate, standardError)}. Stable differences across regions are absorbed by the design.`,
          explanation: "Treatment and outcome are centered inside each of four synthetic regions before estimation. The interval uses a compact heteroskedasticity-robust approximation.",
        };
      }

      function unitDistance(first, second) {
        return Math.hypot(first.x - second.x, first.y - second.y);
      }

      function matchNeighbors(focal, limit = 12) {
        return units
          .filter((candidate) => candidate.treated !== focal.treated && unitDistance(focal, candidate) <= state.radius)
          .map((candidate) => ({
            unit: candidate,
            distance: unitDistance(focal, candidate),
            weight: Math.exp(-unitDistance(focal, candidate) / state.radius) * Math.exp(-5 * Math.abs(focal.propensity - candidate.propensity)),
          }))
          .sort((first, second) => second.weight - first.weight)
          .slice(0, limit);
      }

      function spatialMatchResult() {
        const treatedUnits = units.filter((unit) => unit.treated);
        const differences = [];
        const changed = new Set();

        treatedUnits.forEach((treated) => {
          const neighbors = matchNeighbors(treated, 16).filter((neighbor) => !neighbor.unit.treated);
          if (!neighbors.length) return;
          const totalNeighborWeight = neighbors.reduce((sum, neighbor) => sum + neighbor.weight * baseWeight(neighbor.unit), 0);
          const comparisonOutcome = neighbors.reduce((sum, neighbor) => sum + neighbor.weight * baseWeight(neighbor.unit) * neighbor.unit.outcome, 0) / totalNeighborWeight;
          differences.push({ value: treated.outcome - comparisonOutcome, weight: baseWeight(treated) });
          neighbors.forEach((neighbor) => changed.add(neighbor.unit.id));
        });

        const totalWeight = differences.reduce((sum, item) => sum + item.weight, 0);
        const estimate = totalWeight ? differences.reduce((sum, item) => sum + item.weight * item.value, 0) / totalWeight : 0;
        const weightedVariance = totalWeight ? differences.reduce((sum, item) => sum + item.weight * (item.value - estimate) ** 2, 0) / totalWeight : 0;
        const squaredWeights = differences.reduce((sum, item) => sum + item.weight * item.weight, 0);
        const effectiveCount = squaredWeights ? totalWeight * totalWeight / squaredWeights : 1;
        const standardError = Math.sqrt(weightedVariance / Math.max(1, effectiveCount - 1));
        return {
          estimate,
          standardError,
          diagnosticValue: `${differences.length} / ${treatedUnits.length}`,
          retained: differences.length,
          changedUnits: Array.from(changed),
          claim: `Among comparable nearby synthetic places, the ${state.estimand === "population" ? "population-weighted" : "place-weighted"} matched difference is ${formatSigned(estimate)} ${formatInterval(estimate, standardError)}. ${differences.length} treated places retain a nearby comparison.`,
          explanation: `Comparison places lie within radius ${state.radius.toFixed(2)} and receive more weight when distance and assignment propensity are close. The interval uses a weighted paired-difference approximation.`,
        };
      }

      function computeResult() {
        if (state.stage === "design") return balancedResult();
        if (state.stage === "estimate") return regionFixedEffectResult();
        if (state.stage === "decide") return spatialMatchResult();
        return rawResult();
      }

      function formatSigned(value) {
        return `${value >= 0 ? "+" : "−"}${Math.abs(value).toFixed(2)}`;
      }

      function formatInterval(estimate, standardError) {
        const lower = estimate - 1.96 * standardError;
        const upper = estimate + 1.96 * standardError;
        return `[${formatSigned(lower)}, ${formatSigned(upper)}]`;
      }

      function updateInterval(result) {
        const lower = result.estimate - 1.96 * result.standardError;
        const upper = result.estimate + 1.96 * result.standardError;
        const toPercent = (value) => clamp((value - intervalDomain[0]) / (intervalDomain[1] - intervalDomain[0]) * 100, 0, 100);
        const lowerPercent = toPercent(lower);
        const upperPercent = toPercent(upper);
        const estimatePercent = toPercent(result.estimate);
        const zeroPercent = toPercent(0);
        ui.interval?.style.setProperty("--interval-start", `${lowerPercent}%`);
        ui.interval?.style.setProperty("--interval-width", `${Math.max(1, upperPercent - lowerPercent)}%`);
        ui.interval?.style.setProperty("--interval-point", `${estimatePercent}%`);
        ui.interval?.style.setProperty("--interval-zero", `${zeroPercent}%`);
        if (ui.intervalText) ui.intervalText.textContent = formatInterval(result.estimate, result.standardError);
      }

      function selectedUnit() {
        return units[state.hoverUnitId ?? state.focalUnitId] || units[DEFAULT_FOCAL];
      }

      function updateReceipt() {
        const unit = selectedUnit();
        if (ui.lensMode) ui.lensMode.textContent = state.locked ? "LOCKED" : "INSPECT";
        if (ui.lensUnit) ui.lensUnit.textContent = `PLACE ${String(unit.id + 1).padStart(3, "0")}`;
        if (ui.lensRegion) ui.lensRegion.textContent = `REGION ${unit.region + 1} · ${unit.treated ? "TREATED" : "COMPARISON"}`;
        if (ui.receipt) {
          ui.receipt.style.setProperty("--lens-x", `${state.lensX}px`);
          ui.receipt.style.setProperty("--lens-y", `${state.lensY}px`);
          ui.receipt.dataset.side = state.lensX > state.width * 0.70 ? "left" : "right";
        }
      }

      function updateFocalControl() {
        const unit = units[state.focalUnitId];
        if (ui.focalInput) ui.focalInput.value = String(unit.id);
        if (ui.focalLabel) ui.focalLabel.textContent = `Place ${String(unit.id + 1).padStart(3, "0")} · Region ${unit.region + 1}`;
      }

      function updateLockControl() {
        if (!ui.lock) return;
        ui.lock.setAttribute("aria-pressed", String(state.locked));
        ui.lock.textContent = state.locked ? "Release focal place" : "Lock focal place";
      }

      function updateReadout(announce = false) {
        const result = computeResult();
        const stage = STAGES[state.stage];
        state.result = result;
        if (ui.stageIndex) ui.stageIndex.textContent = `${stage.index} / ${stage.label}`;
        if (ui.designName) ui.designName.textContent = stage.design;
        if (ui.estimate) ui.estimate.textContent = formatSigned(result.estimate);
        if (ui.diagnosticLabel) ui.diagnosticLabel.textContent = stage.diagnostic;
        if (ui.diagnosticValue) ui.diagnosticValue.textContent = result.diagnosticValue;
        if (ui.claim) ui.claim.textContent = result.claim;
        if (ui.explanation) ui.explanation.textContent = result.explanation;
        updateInterval(result);
        updateFocalControl();
        updateLockControl();

        if (!state.reducedMotion && ui.readout && typeof ui.readout.animate === "function") {
          ui.readout.animate(
            [{ opacity: 0.72, transform: "translateY(5px)" }, { opacity: 1, transform: "translateY(0)" }],
            { duration: 220, easing: "cubic-bezier(.22,.72,.18,1)" },
          );
        }

        if (announce && ui.live) {
          ui.live.textContent = `${stage.label.toLowerCase()} stage selected. Estimate ${formatSigned(result.estimate)}. ${stage.diagnostic.toLowerCase()} ${result.diagnosticValue}.`;
        }
      }

      function setStage(stageName, announce = true) {
        if (!STAGES[stageName]) return;
        state.stage = stageName;
        root.dataset.stage = stageName;
        ui.stageButtons.forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.stageButton === stageName));
        });
        updateReadout(announce);
        scheduleDraw();
      }

      function setFocal(unitId, announce = false) {
        state.focalUnitId = clamp(Math.round(Number(unitId) || 0), 0, UNIT_COUNT - 1);
        const unit = units[state.focalUnitId];
        if (state.locked || state.reducedMotion) {
          state.targetLensX = unit.x * state.width;
          state.targetLensY = unit.y * state.height;
          if (state.reducedMotion) {
            state.lensX = state.targetLensX;
            state.lensY = state.targetLensY;
          }
        }
        updateFocalControl();
        updateReceipt();
        if (announce && ui.live) {
          ui.live.textContent = `Focal place ${String(unit.id + 1).padStart(3, "0")}, region ${unit.region + 1}, ${unit.treated ? "treated" : "comparison"}.`;
        }
        scheduleDraw();
      }

      function readPalette() {
        const styles = getComputedStyle(root);
        const read = (name, fallback) => styles.getPropertyValue(name).trim() || fallback;
        return {
          background: read("--field-bg", "#0f302a"),
          panel: read("--field-panel", "#184139"),
          ink: read("--field-ink", "#f7f2e9"),
          muted: read("--field-muted", "#a8b8b0"),
          treated: read("--field-treated", "#f15a37"),
          comparison: read("--field-comparison", "#78a7a0"),
          adjusted: read("--field-adjusted", "#e0bd68"),
          warning: read("--field-warning", "#a9361f"),
          grid: read("--field-grid", "#426158"),
          focus: read("--field-focus", "#fffdf7"),
        };
      }

      function parseHex(color) {
        const normalized = color.trim().replace("#", "");
        if (!/^[0-9a-f]{6}$/i.test(normalized)) return null;
        return [
          Number.parseInt(normalized.slice(0, 2), 16),
          Number.parseInt(normalized.slice(2, 4), 16),
          Number.parseInt(normalized.slice(4, 6), 16),
        ];
      }

      function mixColor(first, second, amount) {
        const start = parseHex(first);
        const end = parseHex(second);
        if (!start || !end) return amount > 0.5 ? second : first;
        const mixed = start.map((value, index) => Math.round(value + (end[index] - value) * clamp(amount, 0, 1)));
        return `rgb(${mixed[0]}, ${mixed[1]}, ${mixed[2]})`;
      }

      function valueColor(unit, adjusted, palette) {
        let value = unit.outcome;
        if (adjusted) {
          if (state.stage === "observe") value -= state.result.estimate * unit.treated;
          if (state.stage === "design") value -= 0.70 * unit.baseline + 0.42 * unit.access;
          if (state.stage === "estimate") {
            const regionMembers = units.filter((candidate) => candidate.region === unit.region);
            const regionMean = regionMembers.reduce((sum, candidate) => sum + candidate.outcome, 0) / regionMembers.length;
            value -= regionMean;
          }
          if (state.stage === "decide") value -= state.result.estimate * unit.treated + 0.45 * unit.baseline;
        }
        const standardized = clamp((value - (adjusted ? 0 : outcomeMean)) / (outcomeDeviation * 1.65), -1, 1);
        if (standardized >= 0) return mixColor(palette.panel, adjusted ? palette.adjusted : palette.treated, standardized * 0.82);
        return mixColor(palette.panel, palette.comparison, Math.abs(standardized) * 0.78);
      }

      function mapPoint(point) {
        return [point[0] * state.width, point[1] * state.height];
      }

      function tracePolygon(unit) {
        context.beginPath();
        unit.polygon.forEach((point, index) => {
          const [x, y] = mapPoint(point);
          if (index === 0) context.moveTo(x, y);
          else context.lineTo(x, y);
        });
        context.closePath();
      }

      function drawHatch(unit, palette) {
        context.save();
        tracePolygon(unit);
        context.clip();
        context.strokeStyle = palette.ink;
        context.lineWidth = 1;
        const boundsLeft = unit.column / COLUMNS * state.width;
        const boundsTop = unit.row / ROWS * state.height;
        const boundsWidth = state.width / COLUMNS;
        const boundsHeight = state.height / ROWS;
        for (let offset = -boundsHeight; offset < boundsWidth + boundsHeight; offset += 8) {
          context.beginPath();
          context.moveTo(boundsLeft + offset, boundsTop + boundsHeight);
          context.lineTo(boundsLeft + offset + boundsHeight, boundsTop);
          context.stroke();
        }
        context.restore();
      }

      function drawContours(palette, adjusted) {
        context.save();
        context.strokeStyle = adjusted ? palette.adjusted : palette.grid;
        context.globalAlpha = adjusted ? 0.34 : 0.46;
        context.lineWidth = adjusted ? 1.3 : 0.8;
        for (let line = 0; line < 7; line += 1) {
          context.beginPath();
          for (let step = 0; step <= 48; step += 1) {
            const x = step / 48 * state.width;
            const baseline = (0.10 + line * 0.135) * state.height;
            const y = baseline + Math.sin(step * 0.31 + line * 0.72) * state.height * 0.026 + Math.cos(step * 0.13) * state.height * 0.012;
            if (step === 0) context.moveTo(x, y);
            else context.lineTo(x, y);
          }
          context.stroke();
        }
        context.restore();
      }

      function drawCorridors(palette, adjusted) {
        context.save();
        context.strokeStyle = adjusted ? palette.adjusted : palette.comparison;
        context.globalAlpha = adjusted ? 0.62 : 0.46;
        context.lineWidth = adjusted ? 2.2 : 1.35;
        context.setLineDash(adjusted ? [] : [7, 7]);
        context.beginPath();
        context.moveTo(state.width * 0.03, state.height * 0.18);
        context.lineTo(state.width * 0.96, state.height * 0.76);
        context.moveTo(state.width * 0.19, state.height * 0.97);
        context.lineTo(state.width * 0.72, state.height * 0.03);
        context.stroke();
        context.restore();
      }

      function drawRegionBoundaries(palette, adjusted) {
        if (state.stage === "observe" && !adjusted) return;
        context.save();
        context.strokeStyle = adjusted ? palette.focus : palette.muted;
        context.globalAlpha = adjusted ? 0.86 : 0.66;
        context.lineWidth = adjusted ? 2 : 1.3;
        context.setLineDash([5, 5]);
        context.beginPath();
        for (let row = 0; row <= ROWS; row += 1) {
          const x = state.width * 0.5;
          const y = state.height * row / ROWS;
          if (row === 0) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        context.moveTo(0, state.height * 0.5);
        context.lineTo(state.width, state.height * 0.5);
        context.stroke();
        context.restore();
      }

      function drawNeighborLinks(palette, adjusted) {
        if (state.stage !== "decide" && !adjusted) return;
        const focal = selectedUnit();
        const neighbors = matchNeighbors(focal, 10);
        if (!neighbors.length) return;
        const maximumWeight = Math.max(...neighbors.map((neighbor) => neighbor.weight), 1e-6);
        context.save();
        neighbors.forEach((neighbor) => {
          context.beginPath();
          context.moveTo(focal.x * state.width, focal.y * state.height);
          context.lineTo(neighbor.unit.x * state.width, neighbor.unit.y * state.height);
          context.strokeStyle = adjusted ? palette.adjusted : palette.comparison;
          context.globalAlpha = 0.22 + 0.64 * neighbor.weight / maximumWeight;
          context.lineWidth = 0.8 + 1.8 * neighbor.weight / maximumWeight;
          context.stroke();
        });
        context.restore();
      }

      function drawCells(palette, adjusted) {
        const selected = selectedUnit();
        units.forEach((unit) => {
          tracePolygon(unit);
          context.fillStyle = state.forcedColors ? palette.background : valueColor(unit, adjusted, palette);
          context.fill();

          context.strokeStyle = unit.treated ? palette.treated : palette.grid;
          context.globalAlpha = unit.treated ? 0.88 : 0.58;
          context.lineWidth = unit.treated ? 1.45 : 0.75;
          context.stroke();
          context.globalAlpha = 1;

          if (state.forcedColors && unit.treated) drawHatch(unit, palette);

          if (state.stage === "design" && unit.propensity > 0.78) {
            context.beginPath();
            context.arc(unit.x * state.width, unit.y * state.height, 2.4, 0, Math.PI * 2);
            context.fillStyle = palette.warning;
            context.fill();
          }

          if (unit.id === state.focalUnitId || unit.id === selected.id) {
            tracePolygon(unit);
            context.strokeStyle = unit.id === selected.id ? palette.focus : palette.adjusted;
            context.lineWidth = unit.id === selected.id ? 3.4 : 2;
            context.globalAlpha = 1;
            context.stroke();
            if (unit.id === selected.id) {
              context.beginPath();
              context.arc(unit.x * state.width, unit.y * state.height, 5.5, 0, Math.PI * 2);
              context.fillStyle = palette.treated;
              context.fill();
              context.strokeStyle = palette.focus;
              context.lineWidth = 1.5;
              context.stroke();
            }
          }
        });
      }

      function drawEstimateGlyph(palette, adjusted) {
        if (state.stage !== "estimate" && state.stage !== "decide") return;
        const result = state.result;
        const chartLeft = state.width * 0.58;
        const chartRight = state.width * 0.92;
        const chartY = state.height * 0.16;
        const scale = (value) => chartLeft + clamp((value - intervalDomain[0]) / (intervalDomain[1] - intervalDomain[0]), 0, 1) * (chartRight - chartLeft);
        const lower = result.estimate - 1.96 * result.standardError;
        const upper = result.estimate + 1.96 * result.standardError;
        context.save();
        context.globalAlpha = adjusted ? 0.96 : 0.58;
        context.strokeStyle = palette.muted;
        context.lineWidth = 1;
        context.beginPath();
        context.moveTo(chartLeft, chartY);
        context.lineTo(chartRight, chartY);
        context.stroke();
        context.strokeStyle = palette.adjusted;
        context.lineWidth = 3;
        context.beginPath();
        context.moveTo(scale(lower), chartY);
        context.lineTo(scale(upper), chartY);
        context.stroke();
        context.fillStyle = palette.treated;
        context.beginPath();
        context.arc(scale(result.estimate), chartY, 5, 0, Math.PI * 2);
        context.fill();
        context.strokeStyle = palette.focus;
        context.lineWidth = 1;
        context.stroke();
        context.restore();
      }

      function drawScene(palette, adjusted) {
        context.fillStyle = adjusted ? palette.panel : palette.background;
        context.fillRect(0, 0, state.width, state.height);
        drawContours(palette, adjusted);
        drawCorridors(palette, adjusted);
        drawNeighborLinks(palette, adjusted);
        drawCells(palette, adjusted);
        drawRegionBoundaries(palette, adjusted);
        drawEstimateGlyph(palette, adjusted);
      }

      function draw() {
        state.dirty = false;
        if (!state.visible || state.width <= 1 || state.height <= 1) return;
        const palette = readPalette();
        context.setTransform(state.dpr, 0, 0, state.dpr, 0, 0);
        drawScene(palette, false);

        const lensRadius = Math.min(state.width, state.height) * (state.width < 640 ? 0.18 : 0.145);
        context.save();
        context.beginPath();
        context.arc(state.lensX, state.lensY, lensRadius, 0, Math.PI * 2);
        context.clip();
        drawScene(palette, true);
        context.restore();

        context.save();
        context.beginPath();
        context.arc(state.lensX, state.lensY, lensRadius, 0, Math.PI * 2);
        context.strokeStyle = state.locked ? palette.treated : palette.focus;
        context.lineWidth = state.locked ? 3 : 1.5;
        context.stroke();
        context.beginPath();
        context.moveTo(state.lensX - lensRadius - 8, state.lensY);
        context.lineTo(state.lensX - lensRadius + 8, state.lensY);
        context.moveTo(state.lensX + lensRadius - 8, state.lensY);
        context.lineTo(state.lensX + lensRadius + 8, state.lensY);
        context.moveTo(state.lensX, state.lensY - lensRadius - 8);
        context.lineTo(state.lensX, state.lensY - lensRadius + 8);
        context.stroke();
        context.restore();
        updateReceipt();
      }

      function frame() {
        state.frame = 0;
        if (!state.lensInitialized) {
          state.lensX = state.targetLensX;
          state.lensY = state.targetLensY;
          state.lensInitialized = true;
        }

        const deltaX = state.targetLensX - state.lensX;
        const deltaY = state.targetLensY - state.lensY;
        const stillMoving = !state.reducedMotion && (Math.abs(deltaX) > 0.25 || Math.abs(deltaY) > 0.25);
        if (stillMoving) {
          state.lensX += deltaX * 0.32;
          state.lensY += deltaY * 0.32;
          state.dirty = true;
        } else {
          state.lensX = state.targetLensX;
          state.lensY = state.targetLensY;
        }

        if (state.dirty || stillMoving) draw();
        if (stillMoving && state.visible) state.frame = requestAnimationFrame(frame);
      }

      function scheduleDraw() {
        state.dirty = true;
        if (!state.visible || state.frame) return;
        state.frame = requestAnimationFrame(frame);
      }

      function resizeCanvas() {
        const bounds = field.getBoundingClientRect();
        state.width = Math.max(1, Math.round(bounds.width));
        state.height = Math.max(1, Math.round(bounds.height));
        let dpr = Math.min(window.devicePixelRatio || 1, 2);
        const projectedPixels = state.width * state.height * dpr * dpr;
        if (projectedPixels > 2500000) dpr *= Math.sqrt(2500000 / projectedPixels);
        state.dpr = Math.max(1, dpr);
        canvas.width = Math.round(state.width * state.dpr);
        canvas.height = Math.round(state.height * state.dpr);
        canvas.style.width = `${state.width}px`;
        canvas.style.height = `${state.height}px`;

        const focal = units[state.focalUnitId];
        if (!state.lensInitialized || state.locked || state.reducedMotion) {
          state.targetLensX = focal.x * state.width;
          state.targetLensY = focal.y * state.height;
          if (!state.lensInitialized || state.reducedMotion) {
            state.lensX = state.targetLensX;
            state.lensY = state.targetLensY;
          }
        } else {
          state.targetLensX = clamp(state.targetLensX, 0, state.width);
          state.targetLensY = clamp(state.targetLensY, 0, state.height);
        }
        scheduleDraw();
      }

      function pointInPolygon(x, y, polygon) {
        let inside = false;
        for (let first = 0, second = polygon.length - 1; first < polygon.length; second = first, first += 1) {
          const xi = polygon[first][0];
          const yi = polygon[first][1];
          const xj = polygon[second][0];
          const yj = polygon[second][1];
          const intersects = yi > y !== yj > y && x < (xj - xi) * (y - yi) / ((yj - yi) || 1e-9) + xi;
          if (intersects) inside = !inside;
        }
        return inside;
      }

      function hitTest(clientX, clientY) {
        const bounds = field.getBoundingClientRect();
        const normalizedX = clamp((clientX - bounds.left) / Math.max(1, bounds.width), 0, 0.999999);
        const normalizedY = clamp((clientY - bounds.top) / Math.max(1, bounds.height), 0, 0.999999);
        const column = clamp(Math.floor(normalizedX * COLUMNS), 0, COLUMNS - 1);
        const row = clamp(Math.floor(normalizedY * ROWS), 0, ROWS - 1);
        const candidates = [];
        for (let rowOffset = -1; rowOffset <= 1; rowOffset += 1) {
          for (let columnOffset = -1; columnOffset <= 1; columnOffset += 1) {
            const candidateRow = row + rowOffset;
            const candidateColumn = column + columnOffset;
            if (candidateRow < 0 || candidateRow >= ROWS || candidateColumn < 0 || candidateColumn >= COLUMNS) continue;
            candidates.push(units[candidateRow * COLUMNS + candidateColumn]);
          }
        }
        const containing = candidates.find((unit) => pointInPolygon(normalizedX, normalizedY, unit.polygon));
        if (containing) return containing;
        return candidates.sort((first, second) => (
          Math.hypot(first.x - normalizedX, first.y - normalizedY)
          - Math.hypot(second.x - normalizedX, second.y - normalizedY)
        ))[0];
      }

      function setLensFromPointer(event) {
        const bounds = field.getBoundingClientRect();
        state.targetLensX = clamp(event.clientX - bounds.left, 0, bounds.width);
        state.targetLensY = clamp(event.clientY - bounds.top, 0, bounds.height);
        const unit = hitTest(event.clientX, event.clientY);
        if (unit && state.hoverUnitId !== unit.id) {
          state.hoverUnitId = unit.id;
          updateReceipt();
        }
        scheduleDraw();
        return unit;
      }

      function markInteraction() {
        if (state.interacted) return;
        state.interacted = true;
        root.dataset.interacted = "true";
        if (ui.instruction) ui.instruction.setAttribute("aria-hidden", "true");
      }

      field.addEventListener("pointerenter", (event) => {
        if (!state.locked) setLensFromPointer(event);
      });

      field.addEventListener("pointermove", (event) => {
        if (state.locked && !state.pointerDown) return;
        const unit = setLensFromPointer(event);
        if (state.pointerDown && unit) setFocal(unit.id, false);
      });

      field.addEventListener("pointerdown", (event) => {
        if (event.button !== undefined && event.button !== 0) return;
        state.pointerDown = true;
        field.setPointerCapture?.(event.pointerId);
        const unit = setLensFromPointer(event);
        if (unit) setFocal(unit.id, false);
        markInteraction();
      });

      field.addEventListener("pointerup", (event) => {
        if (!state.pointerDown) return;
        state.pointerDown = false;
        if (field.hasPointerCapture?.(event.pointerId)) field.releasePointerCapture(event.pointerId);
        const unit = setLensFromPointer(event);
        if (unit) setFocal(unit.id, false);
        state.locked = true;
        state.hoverUnitId = null;
        updateLockControl();
        updateReceipt();
        if (ui.live) {
          const focal = units[state.focalUnitId];
          ui.live.textContent = `Focal place ${String(focal.id + 1).padStart(3, "0")} locked. ${focal.treated ? "Treated" : "Comparison"}, region ${focal.region + 1}.`;
        }
        scheduleDraw();
      });

      field.addEventListener("pointercancel", () => {
        state.pointerDown = false;
      });

      ui.stageButtons.forEach((button) => {
        button.addEventListener("click", () => {
          markInteraction();
          setStage(button.dataset.stageButton, true);
        });
      });

      ui.focalInput?.addEventListener("input", () => {
        state.locked = true;
        state.hoverUnitId = null;
        markInteraction();
        setFocal(ui.focalInput.value, false);
        updateLockControl();
      });

      ui.focalInput?.addEventListener("change", () => setFocal(ui.focalInput.value, true));

      ui.radiusInput?.addEventListener("input", () => {
        state.radius = Number(ui.radiusInput.value);
        if (ui.radiusLabel) ui.radiusLabel.textContent = state.radius.toFixed(2);
        updateReadout(false);
        scheduleDraw();
      });

      ui.radiusInput?.addEventListener("change", () => {
        markInteraction();
        updateReadout(true);
      });

      ui.estimands.forEach((input) => {
        input.addEventListener("change", () => {
          if (!input.checked) return;
          state.estimand = input.value;
          markInteraction();
          updateReadout(true);
          scheduleDraw();
        });
      });

      ui.lock?.addEventListener("click", () => {
        state.locked = !state.locked;
        state.hoverUnitId = null;
        const focal = units[state.focalUnitId];
        state.targetLensX = focal.x * state.width;
        state.targetLensY = focal.y * state.height;
        markInteraction();
        updateLockControl();
        updateReceipt();
        if (ui.live) ui.live.textContent = state.locked ? `Focal place ${String(focal.id + 1).padStart(3, "0")} locked.` : "Focal place released. Move across the field to inspect another place.";
        scheduleDraw();
      });

      root.querySelector("form")?.addEventListener("reset", (event) => {
        event.preventDefault();
        state.stage = "observe";
        state.estimand = "place";
        state.radius = DEFAULT_RADIUS;
        state.focalUnitId = DEFAULT_FOCAL;
        state.hoverUnitId = null;
        state.locked = false;
        ui.estimands.forEach((input) => { input.checked = input.value === "place"; });
        if (ui.radiusInput) ui.radiusInput.value = String(DEFAULT_RADIUS);
        if (ui.radiusLabel) ui.radiusLabel.textContent = DEFAULT_RADIUS.toFixed(2);
        const focal = units[DEFAULT_FOCAL];
        state.targetLensX = focal.x * state.width;
        state.targetLensY = focal.y * state.height;
        markInteraction();
        setStage("observe", true);
        updateLockControl();
      });

      root.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !state.locked) return;
        state.locked = false;
        state.hoverUnitId = null;
        updateLockControl();
        updateReceipt();
        scheduleDraw();
      });

      root.addEventListener("studio:lanechange", (event) => {
        if (!event.detail?.lane) return;
        state.lane = event.detail.lane;
        root.dataset.lane = state.lane;
      });

      const resizeObserver = new ResizeObserver(resizeCanvas);
      resizeObserver.observe(field);

      const intersectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.target !== root) return;
          state.visible = entry.isIntersecting;
          if (state.visible) scheduleDraw();
          else if (state.frame) {
            cancelAnimationFrame(state.frame);
            state.frame = 0;
          }
        });
      }, { rootMargin: "120px 0px", threshold: 0 });
      intersectionObserver.observe(root);

      const handleReducedMotion = () => {
        state.reducedMotion = reducedMotionQuery.matches;
        scheduleDraw();
      };
      const handleForcedColors = () => {
        state.forcedColors = forcedColorsQuery.matches;
        scheduleDraw();
      };
      reducedMotionQuery.addEventListener?.("change", handleReducedMotion);
      forcedColorsQuery.addEventListener?.("change", handleForcedColors);

      updateReadout(false);
      resizeCanvas();
      root.dataset.atlasReady = "true";

      document.addEventListener("astro:before-swap", () => {
        resizeObserver.disconnect();
        intersectionObserver.disconnect();
        reducedMotionQuery.removeEventListener?.("change", handleReducedMotion);
        forcedColorsQuery.removeEventListener?.("change", handleForcedColors);
        if (state.frame) cancelAnimationFrame(state.frame);
      }, { once: true });
    });
  })();
</script>

