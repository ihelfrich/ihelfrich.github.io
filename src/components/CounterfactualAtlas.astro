  <form class="atlas-controls" data-atlas-controls>
    <div class="atlas-control atlas-control--focal">
      <label for="atlas-focal-place">
        <span>FOCAL PLACE</span>
        <output data-focal-label for="atlas-focal-place">Place 037 · Region 2</output>
      </label>
      <input id="atlas-focal-place" data-focal-input type="range" min="0" max="119" step="1" value="36" />
    </div>

    <div class="atlas-control atlas-control--radius">
      <label for="atlas-radius">
        <span>NEIGHBORHOOD RADIUS</span>
        <output data-radius-label for="atlas-radius">0.24</output>
      </label>
      <input id="atlas-radius" data-radius-input type="range" min="0.10" max="0.45" step="0.01" value="0.24" />
    </div>

    <fieldset class="atlas-control atlas-control--estimand">
      <legend>TARGET ESTIMAND</legend>
      <label><input type="radio" name="atlas-estimand" value="place" checked /> <span>Places</span></label>
      <label><input type="radio" name="atlas-estimand" value="population" /> <span>Population</span></label>
