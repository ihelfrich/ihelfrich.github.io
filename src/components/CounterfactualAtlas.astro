  .atlas-estimate-row output { color: var(--atlas-signal); font: 650 clamp(2.6rem, 4vw, 4.7rem)/.82 var(--ih-mono, monospace); font-variant-numeric: tabular-nums; letter-spacing: -.08em; }

  .atlas-diagnostic { display: grid; padding-left: .8rem; gap: .25rem; border-left: 1px solid rgba(247, 242, 233, .2); text-align: right; }
  .atlas-diagnostic strong { color: var(--atlas-interval); font: 600 .76rem var(--ih-mono, monospace); font-variant-numeric: tabular-nums; }

  .atlas-interval { --interval-start: 33%; --interval-width: 20%; --interval-point: 44%; --interval-zero: 33%; }
  .atlas-interval__labels { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: #b8c6bf; font: 500 .47rem var(--ih-mono, monospace); letter-spacing: .05em; }
  .atlas-interval__labels output { color: var(--atlas-on-dark); font-variant-numeric: tabular-nums; }
  .atlas-interval__plot { position: relative; height: 22px; margin-top: .15rem; }
  .atlas-interval__axis,
  .atlas-interval__range,
  .atlas-interval__zero,
  .atlas-interval__point { position: absolute; display: block; }
  .atlas-interval__axis { top: 10px; right: 0; left: 0; height: 1px; background: rgba(247, 242, 233, .28); }
  .atlas-interval__zero { top: 4px; bottom: 4px; left: var(--interval-zero); width: 1px; background: var(--atlas-on-dark); }
  .atlas-interval__range { top: 9px; left: var(--interval-start); width: var(--interval-width); height: 3px; background: var(--atlas-interval); }
  .atlas-interval__range::before,
  .atlas-interval__range::after { position: absolute; top: -4px; width: 2px; height: 11px; content: ""; background: var(--atlas-interval); }
  .atlas-interval__range::before { left: 0; }
  .atlas-interval__range::after { right: 0; }
  .atlas-interval__point { top: 5px; left: var(--interval-point); width: 10px; height: 10px; background: var(--atlas-signal); border: 1px solid var(--atlas-on-dark); border-radius: 50%; transform: translateX(-50%); }
  .atlas-interval__scale { display: flex; justify-content: space-between; color: #8fa39a; font: 500 .44rem var(--ih-mono, monospace); }

  .atlas-claim { margin: .7rem 0 0; color: var(--atlas-on-dark); font: 400 .83rem/1.43 var(--ih-serif, "Source Serif 4", Georgia, serif); }
  .atlas-explanation { margin-top: .6rem; padding-top: .55rem; border-top: 1px solid rgba(247, 242, 233, .18); }
  .atlas-explanation summary { display: flex; min-height: 44px; align-items: center; color: var(--atlas-water); cursor: pointer; font: 600 .53rem/1.4 var(--ih-mono, monospace); letter-spacing: .04em; text-transform: uppercase; }
  .atlas-explanation p { margin: .35rem 0 0; color: #c5d0ca; font: 400 .73rem/1.45 var(--ih-sans, "Geist", sans-serif); }

  .atlas-controls {
    position: absolute;
    z-index: 6;
    right: 0;
    bottom: 0;
    display: grid;
    width: 62%;
    min-height: 142px;
    padding: .8rem clamp(8.8rem, 12vw, 12.5rem) .8rem 1rem;
    grid-template-columns: 1fr 1fr .9fr auto;
    gap: .7rem;
    align-items: center;
    color: var(--atlas-on-dark);
    background: rgba(10, 33, 30, .97);
    border-top: 1px solid rgba(247, 242, 233, .42);
  }

  .atlas-control { min-width: 0; }
  .atlas-control > label:first-child { display: grid; gap: .28rem; }
  .atlas-control label > span,
  .atlas-control legend { color: #a8b8b0; font: 600 .49rem var(--ih-mono, monospace); letter-spacing: .06em; }
  .atlas-control output { overflow: hidden; color: var(--atlas-on-dark); font: 500 .58rem var(--ih-mono, monospace); text-overflow: ellipsis; white-space: nowrap; }
  .atlas-control input[type="range"] { width: 100%; min-height: 44px; margin: .1rem 0 0; accent-color: var(--atlas-signal); cursor: pointer; }

  .atlas-control--estimand { display: grid; min-height: 74px; margin: 0; padding: 0; align-content: center; grid-template-columns: 1fr 1fr; gap: .3rem .55rem; border: 0; }
  .atlas-control--estimand legend { grid-column: 1 / -1; margin-bottom: .2rem; }
  .atlas-control--estimand label { display: flex; min-height: 44px; align-items: center; gap: .35rem; cursor: pointer; }
  .atlas-control--estimand input { width: 18px; height: 18px; accent-color: var(--atlas-signal); }
  .atlas-control--estimand label > span { color: var(--atlas-on-dark); font-size: .57rem; }

  .atlas-reset {
    min-height: 44px;
    padding: .55rem .7rem;
    color: var(--atlas-on-dark);
    background: transparent;
    border: 1px solid rgba(247, 242, 233, .45);
    cursor: pointer;
    font: 600 .52rem/1.2 var(--ih-mono, monospace);
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .atlas-reset:hover,
  .atlas-lock:hover { color: var(--atlas-ink); background: var(--atlas-paper-high); border-color: var(--atlas-paper-high); }

  .atlas-lens-receipt {
    position: absolute;
    z-index: 4;
    top: var(--lens-y, 45%);
    left: var(--lens-x, 55%);
    display: grid;
    min-width: 150px;
    padding: .55rem .65rem;
    gap: .15rem;
    color: var(--atlas-on-dark);
    background: rgba(10, 33, 30, .94);
    border-left: 2px solid var(--atlas-signal);
    transform: translate(92px, -50%);
    pointer-events: none;
  }

  .atlas-lens-receipt[data-side="left"] { transform: translate(calc(-100% - 92px), -50%); border-right: 2px solid var(--atlas-signal); border-left: 0; }
  .atlas-lens-receipt span { color: var(--atlas-signal); font: 650 .46rem var(--ih-mono, monospace); letter-spacing: .08em; }
  .atlas-lens-receipt strong { font: 600 .63rem var(--ih-mono, monospace); letter-spacing: .04em; }
  .atlas-lens-receipt small { color: #b8c6bf; font: 500 .46rem var(--ih-mono, monospace); letter-spacing: .04em; }

  .atlas-instruction {
    position: absolute;
    z-index: 7;
    right: clamp(1rem, 2.2vw, 2.5rem);
    bottom: 150px;
    margin: 0;
    color: var(--atlas-on-dark);
    font: 600 .5rem var(--ih-mono, monospace);
    letter-spacing: .08em;
    transition: opacity 180ms ease;
    pointer-events: none;
  }

  [data-interacted="true"] .atlas-instruction { opacity: 0; }

  .atlas-proofline {
    position: absolute;
    z-index: 5;
    bottom: 1.2rem;
    left: clamp(1rem, 4.5vw, 5.5rem);
    width: min(32vw, 480px);
    margin: 0;
    color: #a8b8b0;
    font: 500 .52rem/1.5 var(--ih-mono, monospace);
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .atlas-live { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); border: 0; white-space: nowrap; }

  .counterfactual-atlas :focus-visible {
    outline: 2px solid var(--atlas-signal);
    outline-offset: 3px;
  }

  @media (max-width: 1180px) {
    .counterfactual-atlas { min-height: 980px; }
    .atlas-thesis { top: 43%; width: 62vw; }
    .atlas-thesis h1 { font-size: clamp(4rem, 8.5vw, 7.2rem); }
    .atlas-readout { right: 8rem; bottom: 178px; width: min(34vw, 400px); }
    .atlas-controls { min-height: 158px; padding-right: 8rem; grid-template-columns: 1fr 1fr; }
    .atlas-control--estimand { grid-row: 2; }
    .atlas-reset { grid-row: 2; }
    .atlas-instruction { bottom: 166px; }
  }

  @media (max-width: 900px) {
    .counterfactual-atlas {
      display: grid;
      min-height: 0;
      padding-top: 42px;
      grid-template-columns: 1fr;
      overflow: visible;
    }

    .atlas-identity { position: absolute; }
    .atlas-thesis {
      position: relative;
      order: 1;
      top: auto;
      left: auto;
      width: auto;
      min-height: min(74svh, 680px);
      padding: clamp(3.2rem, 10vw, 6rem) 1rem 3rem;
      transform: none;
    }
    .atlas-thesis h1 { max-width: 11ch; font-size: clamp(3.6rem, 13.5vw, 7rem); }
    .atlas-thesis__lead { max-width: 570px; }
    .atlas-field {
      position: relative;
      order: 2;
      inset: auto;
      width: 100%;
      min-height: 540px;
      aspect-ratio: 1.25 / 1;
      border-top: 1px solid rgba(247, 242, 233, .25);
      border-left: 0;
    }
    .atlas-synthetic-label { top: calc(min(74svh, 680px) + 58px); }
    .atlas-stage-rail {
      position: relative;
      z-index: 8;
      order: 3;
      top: auto;
      right: auto;
      width: 100%;
      grid-template-columns: repeat(4, 1fr);
      transform: none;
      border-top-color: rgba(247, 242, 233, .35);
    }
    .atlas-stage-rail button { min-height: 68px; border-right: 1px solid rgba(247, 242, 233, .22); }
    .atlas-stage-rail button:last-child { border-right: 0; }
    .atlas-readout {
      position: relative;
      order: 4;
      right: auto;
      bottom: auto;
      width: auto;
      padding: 1rem;
      background: var(--atlas-night-deep);
    }
    .atlas-controls {
      position: relative;
      order: 5;
      right: auto;
      bottom: auto;
      width: 100%;
      min-height: 0;
      padding: 1rem;
      grid-template-columns: 1fr 1fr;
      background: var(--atlas-night-deep);
    }
    .atlas-instruction { top: calc(min(74svh, 680px) + 74px); bottom: auto; }
    .atlas-proofline { position: relative; order: 6; bottom: auto; left: auto; width: auto; margin: 0; padding: 1.2rem 1rem; border-top: 1px solid rgba(247, 242, 233, .22); }
  }

  @media (max-width: 640px) {
    .atlas-identity span:last-child { display: none; }
    .atlas-thesis { min-height: min(78svh, 700px); padding-top: 3.5rem; }
    .atlas-thesis h1 { font-size: clamp(3.25rem, 15vw, 5.8rem); line-height: .87; }
    .atlas-thesis h1 br { display: none; }
    .atlas-thesis__lead { font-size: 1rem; }
    .atlas-thesis__actions { align-items: flex-start; flex-direction: column; }
    .atlas-field { min-height: 390px; aspect-ratio: 1 / 1; }
    .atlas-field::after { width: 80px; }
    .atlas-synthetic-label { top: calc(min(78svh, 700px) + 52px); right: .75rem; }
    .atlas-stage-rail { grid-template-columns: 1fr 1fr; }
    .atlas-stage-rail button { min-height: 62px; }
    .atlas-stage-rail button:nth-child(2) { border-right: 0; }
    .atlas-readout__head { align-items: stretch; flex-direction: column; }
    .atlas-lock { width: 100%; }
    .atlas-estimate-row { grid-template-columns: 1fr; }
    .atlas-diagnostic { padding: .65rem 0 0; border-top: 1px solid rgba(247, 242, 233, .2); border-left: 0; text-align: left; }
    .atlas-controls { grid-template-columns: 1fr; }
    .atlas-control--estimand,
    .atlas-reset { grid-row: auto; }
    .atlas-instruction { top: calc(min(78svh, 700px) + 62px); right: .75rem; max-width: 210px; text-align: right; }
    .atlas-lens-receipt { min-width: 126px; transform: translate(58px, -50%); }
    .atlas-lens-receipt[data-side="left"] { transform: translate(calc(-100% - 58px), -50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .counterfactual-atlas *,
    .counterfactual-atlas *::before,
    .counterfactual-atlas *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
  }

  @media (forced-colors: active) {
    .counterfactual-atlas {
      --atlas-night: Canvas;
      --atlas-night-deep: Canvas;
      --atlas-paper: Canvas;
      --atlas-paper-high: Canvas;
      --atlas-ink: CanvasText;
      --atlas-on-dark: CanvasText;
      --atlas-signal: Highlight;
      --atlas-signal-dark: Highlight;
      --atlas-water: CanvasText;
