    <button type="button" data-stage-button="design" aria-pressed="false">
      <span>02</span><strong>Design</strong><small>Balance</small>
    </button>
    <button type="button" data-stage-button="estimate" aria-pressed="false">
      <span>03</span><strong>Estimate</strong><small>Region FE</small>
    </button>
    <button type="button" data-stage-button="decide" aria-pressed="false">
      <span>04</span><strong>Decide</strong><small>Spatial match</small>
