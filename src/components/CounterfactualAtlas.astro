  .counterfactual-atlas {
    --atlas-night: #0f302a;
    --atlas-night-deep: #0a211e;
    --atlas-paper: #f5f0e6;
    --atlas-paper-high: #fffdf7;
    --atlas-ink: #161915;
    --atlas-graphite: #3a3f39;
    --atlas-muted: #6a6c64;
    --atlas-rule: #c9c0af;
    --atlas-signal: #f15a37;
    --atlas-signal-dark: #a9361f;
    --atlas-water: #78a7a0;
    --atlas-interval: #e0bd68;
    --atlas-on-dark: #f7f2e9;
    --field-bg: #0f302a;
    --field-panel: #184139;
    --field-ink: #f7f2e9;
    --field-muted: #a8b8b0;
    --field-treated: #f15a37;
    --field-comparison: #78a7a0;
    --field-adjusted: #e0bd68;
    --field-warning: #a9361f;
    --field-grid: #426158;
    --field-focus: #fffdf7;
    position: relative;
    min-height: max(780px, calc(100svh - 66px));
    overflow: hidden;
    color: var(--atlas-on-dark);
    background: var(--atlas-night);
    border-bottom: 1px solid var(--atlas-night-deep);
    isolation: isolate;
  }

  .atlas-identity {
    position: absolute;
    z-index: 5;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    min-height: 42px;
    padding: 0 clamp(1rem, 3vw, 3.5rem);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--atlas-on-dark);
    border-bottom: 1px solid rgba(247, 242, 233, .25);
    font: 600 .58rem/1.2 var(--ih-mono, "Geist Mono", monospace);
    letter-spacing: .09em;
  }

  .atlas-field {
    position: absolute;
    z-index: 0;
    inset: 42px 0 0 38%;
    min-width: 0;
    overflow: hidden;
    background: var(--field-bg);
    border-left: 1px solid rgba(247, 242, 233, .2);
    cursor: crosshair;
    touch-action: pan-y;
  }

  .atlas-field canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .atlas-field__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--atlas-on-dark);
    background-color: var(--atlas-night);
    background-image:
      linear-gradient(rgba(120, 167, 160, .17) 1px, transparent 1px),
      linear-gradient(90deg, rgba(120, 167, 160, .17) 1px, transparent 1px);
    background-size: 8.333% 10%;
    transition: opacity 180ms ease;
  }

  [data-atlas-ready="true"] .atlas-field__fallback { opacity: 0; pointer-events: none; }
  .atlas-field__fallback p { color: var(--atlas-on-dark); font: 600 .66rem var(--ih-mono, monospace); letter-spacing: .1em; text-transform: uppercase; }
  .atlas-field__fallback-mark { position: absolute; width: 14px; height: 14px; background: var(--atlas-signal); border: 2px solid var(--atlas-on-dark); }
  .atlas-field__fallback-mark:nth-child(1) { top: 22%; left: 28%; }
  .atlas-field__fallback-mark:nth-child(2) { top: 41%; left: 68%; background: var(--atlas-water); }
  .atlas-field__fallback-mark:nth-child(3) { top: 67%; left: 46%; background: var(--atlas-interval); }
  .atlas-field__fallback-mark:nth-child(4) { top: 76%; left: 81%; }

  .atlas-field::after {
    position: absolute;
    z-index: 1;
    inset: 0 auto 0 0;
    width: min(22vw, 280px);
    content: "";
    background: linear-gradient(90deg, var(--atlas-night), rgba(15, 48, 42, 0));
    pointer-events: none;
  }

  .atlas-thesis {
    position: absolute;
    z-index: 4;
    top: 50%;
    left: clamp(1rem, 4.5vw, 5.5rem);
    width: min(57vw, 1040px);
    transform: translateY(-53%);
    pointer-events: none;
  }

  .atlas-kicker {
    margin: 0 0 1.25rem;
    color: var(--atlas-water);
    font: 600 .65rem/1.3 var(--ih-mono, "Geist Mono", monospace);
    letter-spacing: .11em;
  }

  .atlas-thesis h1 {
    max-width: 9.8ch;
    margin: 0;
    color: var(--atlas-on-dark);
    font: 600 clamp(4.2rem, 7.55vw, 9.3rem)/.84 var(--ih-display, "Geist", sans-serif);
    letter-spacing: -.072em;
    text-wrap: balance;
  }

  .atlas-thesis h1 em {
    position: relative;
    display: inline-block;
    color: var(--atlas-on-dark);
    font-style: normal;
    font-weight: 600;
  }

  .atlas-thesis h1 em::after {
    position: absolute;
    right: .02em;
    bottom: -.06em;
    left: .02em;
    height: .055em;
    content: "";
    background: var(--atlas-signal);
    transform: scaleX(.36);
    transform-origin: left;
    transition: transform 420ms cubic-bezier(.22,.72,.18,1);
  }

  [data-stage="decide"] .atlas-thesis h1 em::after { transform: scaleX(1); }

  .atlas-thesis__lead {
    max-width: 650px;
    margin: 1.55rem 0 0;
    color: #d6ded9;
    font: 400 clamp(1rem, 1.45vw, 1.28rem)/1.52 var(--ih-serif, "Source Serif 4", Georgia, serif);
  }

  .atlas-thesis__actions {
    display: flex;
    margin-top: 1.55rem;
    align-items: center;
    gap: 1rem 1.35rem;
    flex-wrap: wrap;
    pointer-events: auto;
  }

  .atlas-primary-action {
    display: inline-flex;
    min-height: 52px;
    padding: 0 1.05rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.8rem;
    color: var(--atlas-ink);
    background: var(--atlas-signal);
    border: 1px solid var(--atlas-signal);
    font: 650 .67rem/1 var(--ih-mono, monospace);
    letter-spacing: .06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 160ms ease, background 160ms ease;
  }

  .atlas-primary-action:hover { color: var(--atlas-ink); background: var(--atlas-paper-high); border-color: var(--atlas-paper-high); }
  .atlas-secondary-action { display: inline-flex; min-height: 44px; align-items: center; color: var(--atlas-on-dark); font: 600 .68rem/1.2 var(--ih-mono, monospace); text-underline-offset: .35em; text-transform: uppercase; }

  .atlas-synthetic-label {
    position: absolute;
    z-index: 5;
    top: 58px;
    right: clamp(1rem, 2.2vw, 2.5rem);
    display: grid;
    padding: .65rem .75rem;
    gap: .2rem;
    color: var(--atlas-on-dark);
    background: rgba(10, 33, 30, .9);
    border-left: 3px solid var(--atlas-signal);
    pointer-events: none;
  }

  .atlas-synthetic-label strong { font: 650 .58rem var(--ih-mono, monospace); letter-spacing: .08em; }
  .atlas-synthetic-label span { color: #b8c6bf; font: 500 .49rem var(--ih-mono, monospace); letter-spacing: .06em; }

  .atlas-stage-rail {
    position: absolute;
    z-index: 6;
    top: 50%;
    right: clamp(.7rem, 1.7vw, 2rem);
    display: grid;
    width: clamp(98px, 8.5vw, 132px);
    transform: translateY(-50%);
    border-top: 1px solid rgba(247, 242, 233, .35);
  }

  .atlas-stage-rail button {
    display: grid;
    min-height: 64px;
    padding: .6rem .2rem .6rem .65rem;
    grid-template-columns: 24px 1fr;
    grid-template-rows: auto auto;
    align-content: center;
    color: #b8c6bf;
    background: rgba(10, 33, 30, .82);
    border: 0;
    border-bottom: 1px solid rgba(247, 242, 233, .35);
    cursor: pointer;
    text-align: left;
    transition: color 160ms ease, background 160ms ease, border-color 160ms ease;
  }

  .atlas-stage-rail button span { grid-row: 1 / 3; color: var(--atlas-water); font: 600 .5rem var(--ih-mono, monospace); }
  .atlas-stage-rail button strong { color: inherit; font: 600 .65rem var(--ih-sans, "Geist", sans-serif); letter-spacing: .02em; }
  .atlas-stage-rail button small { color: inherit; font: 500 .48rem var(--ih-mono, monospace); letter-spacing: .04em; text-transform: uppercase; }
  .atlas-stage-rail button:hover { color: var(--atlas-on-dark); background: var(--atlas-night-deep); }
  .atlas-stage-rail button[aria-pressed="true"] { color: var(--atlas-on-dark); background: var(--atlas-signal-dark); border-left: 3px solid var(--atlas-signal); }

  .atlas-readout {
    position: absolute;
    z-index: 5;
    right: clamp(8.8rem, 12vw, 12.5rem);
    bottom: 164px;
    width: min(29vw, 430px);
    padding: 1rem;
    color: var(--atlas-on-dark);
    background: rgba(10, 33, 30, .94);
    border-top: 1px solid rgba(247, 242, 233, .55);
    border-bottom: 1px solid rgba(247, 242, 233, .22);
  }

  .atlas-readout__head {
    display: flex;
    padding-bottom: .7rem;
    align-items: start;
    justify-content: space-between;
    gap: .75rem;
    border-bottom: 1px solid rgba(247, 242, 233, .2);
  }

  .atlas-readout__head > div { display: grid; gap: .18rem; }
  .atlas-readout__head span { color: var(--atlas-water); font: 600 .5rem var(--ih-mono, monospace); letter-spacing: .07em; }
  .atlas-readout__head strong { font: 600 .61rem var(--ih-mono, monospace); letter-spacing: .05em; }

  .atlas-lock {
    min-height: 44px;
    padding: 0 .65rem;
    color: var(--atlas-on-dark);
    background: transparent;
    border: 1px solid rgba(247, 242, 233, .45);
    cursor: pointer;
    font: 600 .52rem var(--ih-mono, monospace);
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .atlas-lock[aria-pressed="true"] { color: var(--atlas-ink); background: var(--atlas-interval); border-color: var(--atlas-interval); }

  .atlas-estimate-row {
    display: grid;
    padding: .75rem 0;
    grid-template-columns: 1fr auto;
    gap: .8rem;
    align-items: end;
  }

  .atlas-estimate-row > div:first-child { display: grid; gap: .22rem; }
