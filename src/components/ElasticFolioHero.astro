---
const projects = [
  {
    id: "folio-project-nmtc",
    number: "01",
    title: "NMTC rural leverage",
    category: "Econometrics · policy · public data product",
    outcome:
      "Most of the raw rural leverage gap sits between intermediaries, not within comparable ones.",
    proof: "−0.262 → −0.047",
  },
  {
    id: "folio-project-distance",
    number: "02",
    title: "Effective distance",
    category: "Trade · remote sensing · measurement",
    outcome:
      "Nightlights and population reposition bilateral endpoints where economic activity actually occurs.",
    proof: "VIIRS + population",
  },
  {
    id: "folio-project-teaching",
    number: "03",
    title: "Quantitative teaching systems",
    category: "Teaching · mathematics · interaction design",
    outcome:
      "Rigorous teaching from ACT/SAT through graduate econometrics becomes a system learners can inspect and reuse.",
    proof: "450+ students taught",
  },
];
---

<section class="elastic-folio" data-elastic-folio aria-labelledby="elastic-folio-title">
  <header class="elastic-folio__mast">
    <p>Ian Helfrich, PhD <span aria-hidden="true">·</span> Research economist / Quantitative designer / Educator</p>
    <a href="#selected-work">Selected work <span aria-hidden="true">↓</span></a>
  </header>

  <div class="elastic-folio__hero">
    <div class="elastic-folio__statement">
      <h1 id="elastic-folio-title">
        I make complex<br />
        evidence <span>usable.</span>
      </h1>
    </div>

    <div class="elastic-folio__introduction">
      <p>
        I combine economics, quantitative research, software, and teaching to turn difficult questions into models,
        products, and decisions people can inspect and use.
      </p>
      <nav aria-label="Homepage introduction">
        <a class="elastic-folio__primary" href="/start?source=home-hero">
          Start a project <span aria-hidden="true">↗</span>
        </a>
        <a class="elastic-folio__secondary" href="/start?problem=learning&source=home-hero">
          Private tutoring <span aria-hidden="true">↗</span>
        </a>
        <a class="elastic-folio__tertiary" href="#selected-work">
          Selected work <span aria-hidden="true">↓</span>
        </a>
      </nav>
      <p class="elastic-folio__utility">
        Independent practice <span aria-hidden="true">·</span> St. Louis / working worldwide
        <a href="/cv">View CV</a>
      </p>
    </div>
  </div>

  <div class="elastic-folio__work-heading">
    <p>Selected work</p>
    <p id="elastic-folio-instruction">Move, focus, or tap to give a project more space.</p>
  </div>

  <div
    class="elastic-folio__leaves"
    data-folio-leaves
    aria-label="Selected work"
    aria-describedby="elastic-folio-instruction"
  >
    {
      projects.map((project, index) => (
        <article
          class:list={["folio-leaf", { "is-active": index === 0 }]}
          data-folio-leaf
          data-project={project.id}
          style="--leaf-share: 1"
        >
          <a
            class="folio-leaf__hit"
            data-folio-link
            href={`#${project.id}`}
          >
            <span class="folio-leaf__seam" aria-hidden="true"></span>
            <span class="folio-leaf__surface" data-fold-host aria-hidden="true">
              <span class="folio-leaf__fallback folio-leaf__fallback--left"></span>
              <span class="folio-leaf__fallback folio-leaf__fallback--right"></span>
              <span class="folio-leaf__fallback-seam"></span>
            </span>

            <span class="folio-leaf__content">
              <span class="folio-leaf__meta">
                <span>{project.number}</span>
                <span>{project.category}</span>
              </span>
              <span class="folio-leaf__body">
                <h2 data-folio-title>{project.title}</h2>
                <span class="folio-leaf__outcome">{project.outcome}</span>
              </span>
              <span class="folio-leaf__footer">
                <span>{project.proof}</span>
                <span class="folio-leaf__open">Open case <span aria-hidden="true">↗</span></span>
              </span>
            </span>
          </a>
        </article>
      ))
    }
  </div>

  <canvas data-fold-canvas aria-hidden="true" hidden></canvas>
  <p class="elastic-folio__status" data-folio-status aria-live="polite" aria-atomic="true"></p>
</section>

<script>
  import { gsap } from "gsap";

  type FoldSurface = {
    activate: (index: number, impulse: number) => void;
    move: (localX: number, speed: number) => void;
    rest: () => void;
    resize: () => void;
    disable: () => void;
    destroy: () => void;
  };

  const clamp = (value: number, minimum: number, maximum: number) =>
    Math.min(maximum, Math.max(minimum, value));

  const mountElasticFolio = (root: HTMLElement) => {
    if (root.dataset.folioMounted === "true") return;
    root.dataset.folioMounted = "true";

    const rack = root.querySelector<HTMLElement>("[data-folio-leaves]");
    const leaves = Array.from(root.querySelectorAll<HTMLElement>("[data-folio-leaf]"));
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-folio-link]"));
    const hosts = Array.from(root.querySelectorAll<HTMLElement>("[data-fold-host]"));
    const canvas = root.querySelector<HTMLCanvasElement>("[data-fold-canvas]");
    const status = root.querySelector<HTMLElement>("[data-folio-status]");

    if (!rack || leaves.length !== 3 || links.length !== 3 || hosts.length !== 3 || !canvas) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const forcedColors = window.matchMedia("(forced-colors: active)");
    const coarsePointer = window.matchMedia("(pointer: coarse)");
    const narrowLayout = window.matchMedia("(max-width: 54rem)");
    const aborter = new AbortController();
    const { signal } = aborter;

    let activeIndex = 0;
    let armedTouchIndex = -1;
    let springFrame = 0;
    let lastSpringTime = 0;
    let lastPointerX = 0;
    let lastPointerTime = performance.now();
    let pointerInside = false;
    let gpu: FoldSurface | null = null;
    let revealTween: ReturnType<typeof gsap.fromTo> | null = null;

    const shares = [1, 1, 1];
    const velocities = [0, 0, 0];
    const targets = [1, 1, 1];

    const announce = (index: number) => {
      if (!status) return;
      const title = leaves[index]?.querySelector("[data-folio-title]")?.textContent?.trim();
      status.textContent = title ? `${title} selected. Activate again to open the case.` : "";
    };

    const applyShares = () => {
      leaves.forEach((leaf, index) => {
        gsap.set(leaf, { flexGrow: shares[index] });
      });
    };

    const settleSharesImmediately = () => {
      shares.fill(1);
      velocities.fill(0);
      targets.fill(1);
      applyShares();
    };

    const springTick = (time: number) => {
      springFrame = 0;
      if (reducedMotion.matches || narrowLayout.matches) {
        settleSharesImmediately();
        return;
      }

      const elapsed = lastSpringTime ? (time - lastSpringTime) / 1000 : 1 / 60;
      const delta = clamp(elapsed, 1 / 120, 1 / 24);
      lastSpringTime = time;
      let unsettled = false;

      shares.forEach((share, index) => {
        const acceleration = (targets[index] - share) * 58;
        velocities[index] = (velocities[index] + acceleration * delta) * Math.exp(-12 * delta);
        shares[index] += velocities[index] * delta;

        if (Math.abs(targets[index] - shares[index]) > 0.001 || Math.abs(velocities[index]) > 0.001) {
          unsettled = true;
        } else {
          shares[index] = targets[index];
          velocities[index] = 0;
        }
      });

      applyShares();
      gpu?.resize();

      if (unsettled) springFrame = requestAnimationFrame(springTick);
      else lastSpringTime = 0;
    };

    const startSpring = () => {
      if (reducedMotion.matches || narrowLayout.matches || springFrame) return;
      springFrame = requestAnimationFrame(springTick);
    };

    const setFocusedTargets = (index: number) => {
      if (reducedMotion.matches || narrowLayout.matches) {
        settleSharesImmediately();
        return;
      }

      targets.forEach((_, targetIndex) => {
        targets[targetIndex] = targetIndex === index ? 1.54 : 0.73;
      });
      startSpring();
    };

    const setPointerTargets = (clientX: number) => {
      if (reducedMotion.matches || narrowLayout.matches) return;
      const rackRect = rack.getBoundingClientRect();
      if (!rackRect.width) return;

      const x = clamp((clientX - rackRect.left) / rackRect.width, 0, 1);
      const raw = leaves.map((leaf) => {
        const rect = leaf.getBoundingClientRect();
        const center = (rect.left + rect.width / 2 - rackRect.left) / rackRect.width;
        const distance = x - center;
        return 0.66 + 1.08 * Math.exp(-(distance * distance) / 0.035);
      });
      const sum = raw.reduce((total, value) => total + value, 0);

      raw.forEach((value, index) => {
        targets[index] = clamp((value / sum) * 3, 0.66, 1.62);
      });

      const normalized = targets.reduce((total, value) => total + value, 0);
      targets.forEach((value, index) => {
        targets[index] = (value / normalized) * 3;
      });
      startSpring();
    };

    const setActive = (index: number, source: "pointer" | "focus" | "touch" | "initial") => {
      const next = (index + leaves.length) % leaves.length;
      if (next === activeIndex && source !== "initial") {
        if (source === "focus") setFocusedTargets(next);
        return;
      }

      activeIndex = next;
      root.dataset.activeProject = leaves[next].dataset.project ?? "";

      leaves.forEach((leaf, leafIndex) => leaf.classList.toggle("is-active", leafIndex === next));

      gpu?.activate(next, source === "pointer" ? 0.46 : 0.82);
      root.dispatchEvent(
        new CustomEvent("folio:select", {
          bubbles: true,
          detail: { index: next, project: leaves[next].dataset.project, source },
        }),
      );
    };

    const nearestLeaf = (clientX: number) => {
      let nearest = activeIndex;
      let distance = Number.POSITIVE_INFINITY;
      leaves.forEach((leaf, index) => {
        const rect = leaf.getBoundingClientRect();
        const nextDistance = Math.abs(clientX - (rect.left + rect.width / 2));
        if (nextDistance < distance) {
          distance = nextDistance;
          nearest = index;
        }
      });
      return nearest;
    };

    rack.addEventListener(
      "pointermove",
      (event) => {
        if (event.pointerType === "touch") return;
        pointerInside = true;
        const next = nearestLeaf(event.clientX);
        setActive(next, "pointer");
        setPointerTargets(event.clientX);

        const now = performance.now();
        const elapsed = Math.max(8, now - lastPointerTime);
        const speed = Math.abs(event.clientX - lastPointerX) / elapsed;
        const activeRect = leaves[activeIndex].getBoundingClientRect();
        const localX = clamp((event.clientX - activeRect.left) / Math.max(1, activeRect.width), 0, 1);
        gpu?.move(localX, clamp(speed / 1.25, 0, 1));
        lastPointerX = event.clientX;
        lastPointerTime = now;
      },
      { signal },
    );

    rack.addEventListener(
      "pointerleave",
      () => {
        pointerInside = false;
        targets.fill(1);
        startSpring();
        gpu?.rest();
      },
      { signal },
    );

    links.forEach((link, index) => {
      link.addEventListener(
        "focus",
        () => {
          setActive(index, "focus");
          setFocusedTargets(index);
        },
        { signal },
      );

      link.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            event.preventDefault();
            links[(index + 1) % links.length].focus();
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            event.preventDefault();
            links[(index - 1 + links.length) % links.length].focus();
          } else if (event.key === "Home") {
            event.preventDefault();
            links[0].focus();
          } else if (event.key === "End") {
            event.preventDefault();
            links[links.length - 1].focus();
          }
        },
        { signal },
      );

      link.addEventListener(
        "click",
        (event) => {
          const keyboardActivation = event.detail === 0;
          if (coarsePointer.matches && !keyboardActivation && armedTouchIndex !== index) {
            event.preventDefault();
            armedTouchIndex = index;
            setActive(index, "touch");
            announce(index);
            return;
          }

          armedTouchIndex = -1;
          root.dispatchEvent(
            new CustomEvent("folio:open", {
              bubbles: true,
              detail: { index, project: leaves[index].dataset.project },
            }),
          );
        },
        { signal },
      );
    });

    const resetMotionMode = () => {
      if (springFrame) cancelAnimationFrame(springFrame);
      springFrame = 0;
      lastSpringTime = 0;
      settleSharesImmediately();
      if (reducedMotion.matches || forcedColors.matches || narrowLayout.matches) gpu?.disable();
    };

    reducedMotion.addEventListener("change", resetMotionMode, { signal });
    forcedColors.addEventListener("change", resetMotionMode, { signal });
    narrowLayout.addEventListener("change", resetMotionMode, { signal });

    if (!reducedMotion.matches) {
      const revealTargets = [
        root.querySelector(".elastic-folio__mast"),
        root.querySelector(".elastic-folio__statement"),
        root.querySelector(".elastic-folio__introduction"),
        rack,
      ].filter(Boolean);

      revealTween = gsap.fromTo(
        revealTargets,
        { opacity: 0, y: 18 },
        { opacity: 1, y: 0, duration: 0.72, stagger: 0.07, ease: "power3.out", clearProps: "opacity,transform" },
      );
    }

    async function createFoldSurface(): Promise<FoldSurface | null> {
      const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
      if (reducedMotion.matches || forcedColors.matches || narrowLayout.matches || connection?.saveData) {
        root.dataset.foldSurface = "static";
        return null;
      }

      let THREE: typeof import("three");
      try {
        THREE = await import("three");
      } catch {
        root.dataset.foldSurface = "static";
        return null;
      }
      if (signal.aborted) return null;

      let renderer: import("three").WebGLRenderer;
      try {
        renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: false,
          antialias: false,
          powerPreference: "high-performance",
          depth: false,
          stencil: false,
        });
      } catch {
        root.dataset.foldSurface = "static";
        return null;
      }

      const scene = new THREE.Scene();
      const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);
      camera.position.z = 3;

      const geometry = new THREE.PlaneGeometry(2, 2, 96, 1);
      const uniforms = {
        uCrease: { value: 0.5 },
        uFold: { value: 0.105 },
        uEnergy: { value: 0.22 },
      };
      const material = new THREE.ShaderMaterial({
        uniforms,
        vertexShader: `
          uniform float uCrease;
          uniform float uFold;
          varying vec2 vUv;
          varying float vRidge;
          varying float vSlope;

          void main() {
            vUv = uv;
            vec3 transformed = position;
            float crease = (uCrease * 2.0) - 1.0;
            float distanceFromCrease = transformed.x - crease;
            float ridge = exp(-distanceFromCrease * distanceFromCrease * 28.0);
            float slope = -56.0 * distanceFromCrease * ridge * uFold;
            transformed.z += ridge * uFold;
            transformed.y += distanceFromCrease * ridge * uFold * 0.12;
            vRidge = ridge;
            vSlope = slope;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(transformed, 1.0);
          }
        `,
        fragmentShader: `
          uniform float uCrease;
          uniform float uEnergy;
          varying vec2 vUv;
          varying float vRidge;
          varying float vSlope;

          void main() {
            vec3 charcoal = vec3(0.055, 0.055, 0.064);
            vec3 graphite = vec3(0.185, 0.185, 0.205);
            vec3 cobalt = vec3(0.294, 0.310, 0.914);
            float directionalLight = clamp(0.52 + vSlope * 0.34, 0.16, 0.86);
            float edgeQuiet = 1.0 - 0.12 * smoothstep(0.62, 1.0, abs(vUv.y * 2.0 - 1.0));
            vec3 matte = mix(charcoal, graphite, directionalLight) * edgeQuiet;
            float creaseDistance = abs(vUv.x - uCrease);
            float seam = 1.0 - smoothstep(0.004, 0.014, creaseDistance);
            float reflection = vRidge * uEnergy * 0.13;
            vec3 color = matte + reflection;
            color = mix(color, cobalt, seam * (0.30 + uEnergy * 0.70));
            gl_FragColor = vec4(color, 1.0);
          }
        `,
      });
      const plane = new THREE.Mesh(geometry, material);
      scene.add(plane);

      const lowCapability =
        (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4) ||
        ((navigator as Navigator & { deviceMemory?: number }).deviceMemory ?? 8) <= 4;
      const maximumDpr = lowCapability ? 1 : 1.5;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, maximumDpr));
      renderer.outputColorSpace = THREE.SRGBColorSpace;

      let currentHost = hosts[0];
      let visible = true;
      let pageVisible = !document.hidden;
      let disabled = false;
      let destroyed = false;
      let frame = 0;
      let lastTime = 0;
      let crease = 0.5;
      let creaseTarget = 0.5;
      let creaseVelocity = 0;
      let fold = 0.105;
      let foldTarget = 0.105;
      let foldVelocity = 0;
      let energy = 0.22;
      let energyTarget = 0;
      let energyVelocity = 0;

      const resize = () => {
        if (disabled || !currentHost.isConnected) return;
        const rect = currentHost.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        const aspect = width / height;
        camera.left = -aspect;
        camera.right = aspect;
        camera.top = 1;
        camera.bottom = -1;
        camera.updateProjectionMatrix();
        plane.scale.x = aspect;
        renderer.setSize(width, height, false);
        renderOnce();
      };

      const renderOnce = () => {
        if (!disabled && visible && pageVisible) renderer.render(scene, camera);
      };

      const tick = (time: number) => {
        frame = 0;
        if (disabled || !visible || !pageVisible) return;

        const elapsed = lastTime ? (time - lastTime) / 1000 : 1 / 60;
        const delta = clamp(elapsed, 1 / 120, 1 / 24);
        lastTime = time;

        const spring = (current: number, target: number, velocity: number, stiffness: number, damping: number) => {
          const nextVelocity = (velocity + (target - current) * stiffness * delta) * Math.exp(-damping * delta);
          return [current + nextVelocity * delta, nextVelocity] as const;
        };

        [crease, creaseVelocity] = spring(crease, creaseTarget, creaseVelocity, 66, 13);
        [fold, foldVelocity] = spring(fold, foldTarget, foldVelocity, 54, 12);
        [energy, energyVelocity] = spring(energy, energyTarget, energyVelocity, 70, 14);
        energyTarget *= Math.exp(-5.8 * delta);

        uniforms.uCrease.value = crease;
        uniforms.uFold.value = fold;
        uniforms.uEnergy.value = clamp(energy, 0, 1);
        renderer.render(scene, camera);

        const unsettled =
          Math.abs(creaseTarget - crease) > 0.0005 ||
          Math.abs(creaseVelocity) > 0.0005 ||
          Math.abs(foldTarget - fold) > 0.0005 ||
          Math.abs(foldVelocity) > 0.0005 ||
          Math.abs(energyTarget - energy) > 0.0005 ||
          Math.abs(energyVelocity) > 0.0005 ||
          energyTarget > 0.0005;

        if (unsettled) frame = requestAnimationFrame(tick);
        else lastTime = 0;
      };

      const schedule = () => {
        if (disabled || !visible || !pageVisible || frame) return;
        frame = requestAnimationFrame(tick);
      };

      const activate = (index: number, impulse: number) => {
        currentHost = hosts[index];
        currentHost.appendChild(canvas);
        canvas.hidden = false;
        creaseTarget = 0.5;
        foldTarget = 0.105 + impulse * 0.025;
        energyTarget = Math.max(energyTarget, impulse);
        resize();
        schedule();
      };

      const move = (localX: number, speed: number) => {
        creaseTarget = clamp(localX, 0.14, 0.86);
        foldTarget = 0.105 + speed * 0.045;
        energyTarget = Math.max(energyTarget, speed);
        schedule();
      };

      const rest = () => {
        creaseTarget = 0.5;
        foldTarget = 0.105;
        energyTarget = 0;
        schedule();
      };

      const disable = () => {
        disabled = true;
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        canvas.hidden = true;
        root.dataset.foldSurface = "static";
      };

      const observer = new IntersectionObserver(
        ([entry]) => {
          visible = Boolean(entry?.isIntersecting);
          if (!visible && frame) {
            cancelAnimationFrame(frame);
            frame = 0;
            lastTime = 0;
          } else if (visible) {
            schedule();
          }
        },
        { rootMargin: "12% 0px", threshold: 0.01 },
      );
      observer.observe(root);

      const resizeObserver = new ResizeObserver(() => resize());
      resizeObserver.observe(rack);

      const destroy = () => {
        if (destroyed) return;
        destroyed = true;
        disabled = true;
        observer.disconnect();
        resizeObserver.disconnect();
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        canvas.hidden = true;
        geometry.dispose();
        material.dispose();
        renderer.dispose();
      };

      document.addEventListener(
        "visibilitychange",
        () => {
          pageVisible = !document.hidden;
          if (!pageVisible && frame) {
            cancelAnimationFrame(frame);
            frame = 0;
            lastTime = 0;
          } else if (pageVisible) {
            resize();
            schedule();
          }
        },
        { signal },
      );

      canvas.addEventListener(
        "webglcontextlost",
        (event) => {
          event.preventDefault();
          disable();
        },
        { signal },
      );

      root.dataset.foldSurface = "webgl";

      return { activate, move, rest, resize, disable, destroy };
    }

    setActive(0, "initial");

    const initializeFoldSurface = async () => {
      const surface = await createFoldSurface();
      if (!surface || signal.aborted) return;
      gpu = surface;
      gpu.activate(activeIndex, 0.22);
    };

    if ("requestIdleCallback" in window) {
      const idleId = window.requestIdleCallback(() => void initializeFoldSurface(), { timeout: 900 });
      signal.addEventListener("abort", () => window.cancelIdleCallback(idleId), { once: true });
    } else {
      const timerId = window.setTimeout(() => void initializeFoldSurface(), 120);
      signal.addEventListener("abort", () => window.clearTimeout(timerId), { once: true });
    }

    const destroy = () => {
      gpu?.destroy();
      gpu = null;
      revealTween?.kill();
      revealTween = null;
      aborter.abort();
      if (springFrame) cancelAnimationFrame(springFrame);
      springFrame = 0;
      delete root.dataset.folioMounted;
    };

    const handlePageShow = (event: PageTransitionEvent) => {
      if (!event.persisted) return;
      window.removeEventListener("pageshow", handlePageShow);
      if (root.isConnected) mountElasticFolio(root);
    };

    window.addEventListener("pageshow", handlePageShow);
    window.addEventListener("pagehide", () => destroy(), { once: true });

    if (!pointerInside) settleSharesImmediately();
  };

  document.querySelectorAll<HTMLElement>("[data-elastic-folio]").forEach(mountElasticFolio);
</script>

<style>
  .elastic-folio {
    --folio-black: #09090b;
    --folio-white: #f7f7f5;
    --folio-pure: #fff;
    --folio-graphite: #343439;
    --folio-muted: #686870;
    --folio-line: rgba(9, 9, 11, 0.14);
    --folio-line-dark: rgba(255, 255, 255, 0.16);
    --folio-accent: #4b4fe9;
    --folio-accent-hover: #3337c8;
    --folio-sans: var(--ih-display, "Geist Variable", Geist, Inter, system-ui, sans-serif);
    --folio-mono: var(--ih-mono, "Geist Mono", "SFMono-Regular", Consolas, monospace);

    position: relative;
    display: grid;
    min-height: 100vh;
    min-height: 100svh;
    padding: 0 clamp(1rem, 2.7vw, 3rem) clamp(1rem, 2vw, 2rem);
    overflow: clip;
    color: var(--folio-black);
    background: var(--folio-white);
    font-family: var(--folio-sans);
    isolation: isolate;
  }

  .elastic-folio *,
  .elastic-folio *::before,
  .elastic-folio *::after {
    box-sizing: border-box;
  }

  .elastic-folio__mast {
    display: flex;
    min-height: 3.3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--folio-line);
