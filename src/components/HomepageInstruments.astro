---
import {getCollection} from 'astro:content';
import {filterDiscoverableResearch} from '../data/research-discovery.mjs';
import ResearchGraph from './ResearchGraph.astro';
import OptimalTransportAperture from './OptimalTransportAperture.astro';
import LeastSquaresLab from './LeastSquaresLab.astro';
import SpatialAllocationStudio from './SpatialAllocationStudio.astro';
const papers=filterDiscoverableResearch(await getCollection('research'));
---
<section class="st-instruments st-section" id="instruments">
 <div class="st-section-top"><span>Interactive models</span><a href="/econometrics/lab/">Explore the full lab ↗</a></div>
 <h2>Models and calculations</h2>


 <details class="st-tool" id="tool-transport"><summary><span>Optimal transport<small>Move mass between spatial distributions</small></span><span class="st-tool-symbol" aria-hidden="true">+</span></summary><div class="st-tool-body"><OptimalTransportAperture/></div></details>
 <details class="st-tool" id="tool-regression"><summary><span>Regression sensitivity<small>Outliers, leverage, and regression estimates</small></span><span class="st-tool-symbol" aria-hidden="true">+</span></summary><div class="st-tool-body"><LeastSquaresLab/></div></details>
 <details class="st-tool" id="tool-spatial"><summary><span>Spatial allocation<small>Change the metric, boundaries, and map</small></span><span class="st-tool-symbol" aria-hidden="true">+</span></summary><div class="st-tool-body"><SpatialAllocationStudio headingLevel="h3"/></div></details>
 <nav class="st-tool-links" aria-label="More analytical tools"><a href="/econometrics/lab/">Econometrics investigations ↗</a><a href="/learn/policy-statistics/">Policy Statistics Lab ↗</a><a href="/library">Search the public archive ↗</a></nav>
</section>
<section class="st-connections st-section" id="connections"><div class="st-section-top"><span>Research topics</span><a href="/research">All research ↗</a></div><h2>Related projects</h2><p class="st-instruments-intro">Lines connect projects with shared subjects or methods.</p><details class="content-disclosure" id="connection-map"><summary><span>Topic map</span><span class="disclosure-symbol" aria-hidden="true">+</span></summary><div class="disclosure-body"><ResearchGraph papers={papers}/></div></details></section>
