---
import EvidenceAperture from "./EvidenceAperture.astro";
import { fitLeastSquares, MINIMUM_SVG_TARGET_CSS_PX } from "../lib/fieldbook-math.mjs";

const SEED = [
  { x: 120, y: 380 }, { x: 210, y: 330 }, { x: 300, y: 355 },
  { x: 390, y: 280 }, { x: 480, y: 250 }, { x: 570, y: 270 },
  { x: 660, y: 195 }, { x: 770, y: 165 }, { x: 880, y: 120 },
];
const initialFit = fitLeastSquares(SEED);
const initialSummary = initialFit
  ? `n=${initialFit.n} · fitted slope ${(-initialFit.b1 * 10).toFixed(2)} per 10 horizontal units · robust slope SE (HC1) ${(initialFit.seHC1 * 10).toFixed(2)} · R² ${initialFit.r2.toFixed(2)} · shaded area: conventional 95% confidence band for the fitted mean`
  : "Add at least three points.";
const bandPath = initialFit ? (() => {
  const yAt = (x: number) => initialFit.b0 + initialFit.b1 * x;
  let upper = "";
  let lower = "";
  for (let x = 24; x <= 976; x += 24) {
    const se = Math.sqrt(initialFit.s2 * (1 / initialFit.n + ((x - initialFit.mx) ** 2) / initialFit.Sxx)) * initialFit.tcrit;
    upper += `${upper ? "L" : "M"} ${x} ${yAt(x) - se} `;
    lower = `L ${x} ${yAt(x) + se} ${lower}`;
  }
  return `${upper}${lower}Z`;
})() : "";
---

<EvidenceAperture
  id="least-squares-lab"
  liveRegionId="least-squares-live"
  class="least-squares-aperture"
  question="How much can one observation change a fitted line and its uncertainty?"
  caption="Add, move, or remove observations. The fitted line, confidence band, slope, robust standard error, and R² update together."
  status="Live teaching demonstration"
  method={["ordinary least squares", "HC1 robust standard error", "95% conditional-mean band"]}
  role="Designed and developed by Ian Helfrich"
  limit="The points are an editable teaching fixture. The display demonstrates estimator sensitivity; it is not evidence about a population or causal effect."
  links={[
    { label: "Applied Statistics project", href: "/projects/applied-statistics" },
    { label: "Source repository", href: "https://github.com/ihelfrich/applied-statistics", external: true },
  ]}
>
  <figure slot="figure" class="least-squares-lab inst-panel" data-least-squares-lab>
    <svg
      viewBox="0 0 1000 480"
      role="img"
      aria-labelledby="least-squares-title least-squares-desc"
      data-est-plot
      data-min-hit-target-css-px={MINIMUM_SVG_TARGET_CSS_PX}
      style={`--svg-hit-target:${MINIMUM_SVG_TARGET_CSS_PX}px`}
    >
      <title id="least-squares-title">Editable least-squares scatterplot</title>
      <desc id="least-squares-desc">Nine initial points on axes labeled Illustrative x and Illustrative outcome, with a fitted line and confidence band. Pointer users can add or drag points; equivalent add, remove, and reset buttons follow the figure.</desc>
      {[120, 240, 360].map((gridY) => <line x1="24" x2="976" y1={gridY} y2={gridY} class="est-grid"></line>)}
      <line x1="24" x2="24" y1="20" y2="456" class="est-axis"></line>
      <line x1="24" x2="976" y1="456" y2="456" class="est-axis"></line>
      <text x="500" y="476" text-anchor="middle" class="est-axis-label">Illustrative x</text>
      <text transform="translate(13 238) rotate(-90)" text-anchor="middle" class="est-axis-label">Illustrative outcome</text>
      <path d={bandPath} class="est-band" data-est-band></path>
      {initialFit && <line x1="24" y1={initialFit.b0 + initialFit.b1 * 24} x2="976" y2={initialFit.b0 + initialFit.b1 * 976} class="est-line" data-est-line></line>}
      <g data-est-points>
        {SEED.map((point, index) => (
          <g>
            <circle class="est-hit" cx={point.x} cy={point.y} r="1" data-i={index}></circle>
            <circle class="est-dot" cx={point.x} cy={point.y} r="6" data-i={index}></circle>
          </g>
        ))}
      </g>
    </svg>
    <figcaption>The axes are illustrative. Pointer: select empty space to add a point, drag a point to move it, or select a point without dragging to remove it. Keyboard: use the controls below to add a tail point, remove the last point, or restore the fixture.</figcaption>
  </figure>

  <div slot="controls" class="est-controls">
    <button type="button" data-est-add>Add a tail point</button>
    <button type="button" data-est-remove>Remove last point</button>
    <button type="button" data-est-reset>Restore fixture</button>
  </div>

  <p><output data-est-readout>{initialSummary}</output></p>
</EvidenceAperture>

<script>
  import { fitLeastSquares, resolveLeastSquaresGesture, svgHitRadiusForCssTarget } from "../lib/fieldbook-math.mjs";

  const SEED = [
    { x: 120, y: 380 }, { x: 210, y: 330 }, { x: 300, y: 355 },
    { x: 390, y: 280 }, { x: 480, y: 250 }, { x: 570, y: 270 },
    { x: 660, y: 195 }, { x: 770, y: 165 }, { x: 880, y: 120 },
  ];

  document.querySelectorAll(".least-squares-aperture").forEach((aperture) => {
    const svg = aperture.querySelector("[data-est-plot]");
    const pointsGroup = aperture.querySelector("[data-est-points]");
    const band = aperture.querySelector("[data-est-band]");
    const line = aperture.querySelector("[data-est-line]");
    const readout = aperture.querySelector("[data-est-readout]");
    const live = aperture.querySelector("#least-squares-live");
    if (!(svg instanceof SVGSVGElement) || !pointsGroup || !band || !line) return;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const NS = "http://www.w3.org/2000/svg";
    const L = 24, R = 976, T = 20, B = 456;
    let points = SEED.map((point) => ({ ...point }));
    let dragging = -1;
    let dragMoved = 0;
    let addedDuringGesture = false;
    let dragStartPoint: { x: number; y: number } | null = null;
    let settleTimer = 0;

    const syncHitTargets = () => {
      const matrix = svg.getScreenCTM();
      if (!matrix) {
        svg.classList.remove("has-css-sized-hit-targets");
        return;
      }
      const radius = svgHitRadiusForCssTarget({
        scaleX: Math.hypot(matrix.a, matrix.b),
        scaleY: Math.hypot(matrix.c, matrix.d),
      });
      svg.querySelectorAll(".est-hit").forEach((hit) => hit.setAttribute("r", String(radius)));
      svg.classList.add("has-css-sized-hit-targets");
    };

    const summary = () => {
      const fit = fitLeastSquares(points);
      if (!fit) return "Add at least three points with varying horizontal positions.";
      return `n=${fit.n} · fitted slope ${(-fit.b1 * 10).toFixed(2)} per 10 horizontal units · robust slope SE (HC1) ${(fit.seHC1 * 10).toFixed(2)} · R² ${fit.r2.toFixed(2)} · shaded area: conventional 95% confidence band for the fitted mean`;
    };
    const render = (resolving = false) => {
      const fit = fitLeastSquares(points);
      pointsGroup.replaceChildren();
      points.forEach((point, index) => {
        const group = document.createElementNS(NS, "g");
        const hit = document.createElementNS(NS, "circle");
        const dot = document.createElementNS(NS, "circle");
        for (const circle of [hit, dot]) {
          circle.setAttribute("cx", String(point.x)); circle.setAttribute("cy", String(point.y)); circle.setAttribute("data-i", String(index));
        }
        hit.setAttribute("r", "1"); hit.setAttribute("class", "est-hit");
        dot.setAttribute("r", "6"); dot.setAttribute("class", `est-dot${index === dragging ? " is-dragging" : ""}`);
        group.append(hit, dot);
        pointsGroup.appendChild(group);
      });
      if (!fit) {
        line.setAttribute("visibility", "hidden");
        band.setAttribute("d", "");
      } else {
        const yAt = (x: number) => fit.b0 + fit.b1 * x;
        line.setAttribute("visibility", "visible");
        line.setAttribute("x1", String(L)); line.setAttribute("y1", String(yAt(L)));
        line.setAttribute("x2", String(R)); line.setAttribute("y2", String(yAt(R)));
        let upper = "", lower = "";
        for (let x = L; x <= R; x += 24) {
          const se = Math.sqrt(fit.s2 * (1 / fit.n + ((x - fit.mx) ** 2) / fit.Sxx)) * fit.tcrit;
          upper += `${upper ? "L" : "M"} ${x} ${yAt(x) - se} `;
          lower = `L ${x} ${yAt(x) + se} ${lower}`;
        }
        band.setAttribute("d", `${upper}${lower}Z`);
      }
      svg.classList.toggle("is-resolving", resolving);
      if (readout) readout.textContent = summary();
      syncHitTargets();
    };
    const finish = (message: string) => {
      window.clearTimeout(settleTimer);
      if (reduced) {
        render(false);
        if (live) live.textContent = `${message} ${summary()}`;
        return;
      }
      render(true);
      settleTimer = window.setTimeout(() => {
        render(false);
        if (live) live.textContent = `${message} ${summary()}`;
      }, 380);
    };
    const toSvg = (event: PointerEvent) => {
      const matrix = svg.getScreenCTM();
      if (!matrix) return { x: L, y: B };
      const inverse = matrix.inverse();
      return {
        x: Math.min(R, Math.max(L, event.clientX * inverse.a + event.clientY * inverse.c + inverse.e)),
        y: Math.min(B - 6, Math.max(T, event.clientX * inverse.b + event.clientY * inverse.d + inverse.f)),
      };
    };

    svg.addEventListener("pointerdown", (event) => {
      const target = event.target as Element;
      const point = toSvg(event);
      if (target.tagName === "circle") {
        dragging = Number(target.getAttribute("data-i"));
        dragMoved = 0;
        addedDuringGesture = false;
        dragStartPoint = { ...points[dragging] };
        svg.setPointerCapture(event.pointerId);
      } else {
        points.push(point);
        dragging = points.length - 1;
        dragMoved = 6;
        addedDuringGesture = true;
        dragStartPoint = null;
        svg.setPointerCapture(event.pointerId);
      }
      render(true);
    });
    svg.addEventListener("pointermove", (event) => {
      if (dragging < 0) return;
      const point = toSvg(event);
      dragMoved += Math.abs(point.x - points[dragging].x) + Math.abs(point.y - points[dragging].y);
      points[dragging] = point;
      render(true);
    });
    svg.addEventListener("pointerup", (event) => {
      if (dragging < 0) return;
      points = resolveLeastSquaresGesture({
        points,
        index: dragging,
        originalPoint: dragStartPoint,
        addedDuringGesture,
        canceled: false,
        movement: dragMoved,
      });
      dragging = -1;
      addedDuringGesture = false;
      dragStartPoint = null;
      if (svg.hasPointerCapture(event.pointerId)) svg.releasePointerCapture(event.pointerId);
      finish("Fit updated.");
    });
    const cancelDrag = () => {
      if (dragging < 0) return;
      points = resolveLeastSquaresGesture({
        points,
        index: dragging,
        originalPoint: dragStartPoint,
        addedDuringGesture,
        canceled: true,
        movement: dragMoved,
      });
      dragging = -1;
      dragMoved = 0;
      addedDuringGesture = false;
      dragStartPoint = null;
      render(false);
      if (live) live.textContent = "Point edit canceled; the prior fit was restored.";
    };
    svg.addEventListener("pointercancel", cancelDrag);
    svg.addEventListener("lostpointercapture", cancelDrag);
    aperture.querySelector("[data-est-add]")?.addEventListener("click", () => {
      points.push({ x: 940, y: 60 });
      finish("Tail point added.");
    });
    aperture.querySelector("[data-est-remove]")?.addEventListener("click", () => {
      if (points.length > 0) points.pop();
      finish("Last point removed.");
    });
    aperture.querySelector("[data-est-reset]")?.addEventListener("click", () => {
      points = SEED.map((point) => ({ ...point }));
      finish("Fixture restored.");
    });
    render(false);
    if (typeof ResizeObserver !== "undefined") new ResizeObserver(syncHitTargets).observe(svg);
    else window.addEventListener("resize", syncHitTargets, { passive: true });
  });
</script>

<style>
  .least-squares-lab { margin: 0; }
  .least-squares-lab svg { display: block; width: 100%; touch-action: pan-y; }
  .est-grid { stroke: color-mix(in srgb, var(--ef-ink) 7%, transparent); }
  .est-axis { stroke: color-mix(in srgb, var(--ef-ink) 18%, var(--ef-paper)); }
  .est-axis-label { fill: color-mix(in srgb, var(--ef-ink) 68%, transparent); font: 520 11px var(--font-data); }
  .est-band { fill: color-mix(in srgb, var(--ef-ink) 6%, transparent); stroke: none; }
  .est-line { stroke: var(--ef-ink); stroke-width: 1.7; }
  [data-est-points] :global(.est-hit) {
    cursor: grab;
    fill: transparent;
    forced-color-adjust: none;
    pointer-events: all;
    stroke: transparent;
    stroke-width: var(--svg-hit-target);
    vector-effect: non-scaling-stroke;
  }
  svg.has-css-sized-hit-targets [data-est-points] :global(.est-hit) { stroke-width: 0; }
  [data-est-points] :global(.est-dot) { fill: var(--ef-ink); pointer-events: none; }
  [data-est-points] :global(.est-dot.is-dragging), svg.is-resolving .est-line { fill: var(--ef-signal); stroke: var(--ef-signal); }
  svg.is-resolving .est-band { fill: color-mix(in srgb, var(--ef-signal) 8%, transparent); }
  .least-squares-lab figcaption { color: color-mix(in srgb, var(--ef-ink) 68%, transparent); font-size: 0.82rem; line-height: 1.5; }
  .est-controls { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .est-controls button { min-height: 44px; }
  @media (prefers-reduced-motion: reduce) { .least-squares-lab * { transition: none !important; } }
</style>
