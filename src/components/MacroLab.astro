---
import {models} from '../data/macroeconomics.mjs';
---
<section class="macro-lab" data-macro aria-label="Interactive macroeconomics models">
  <aside class="macro-directory">
    <label class="macro-mobile-model">Model<select data-model-select>{models.map(m=><option value={m.id}>{m.title}</option>)}</select></label>
    <p class="macro-eyebrow">Choose a model</p>
    <nav data-model-nav aria-label="Macroeconomic model">
      {models.map(m=><button type="button" data-model={m.id} aria-pressed={m.id==='solow'}><span>{m.number}</span>{m.title}</button>)}
    </nav>

  </aside>
  <article class="macro-workspace">
    <header class="macro-model-header"><p class="macro-eyebrow" data-level>Undergraduate → graduate</p><h2 data-model-title>Solow growth</h2><p data-model-question>When does new investment become better equipment per worker?</p></header>
    <div class="macro-experiment">
      <aside class="macro-parameters" data-parameter-panel><div class="macro-control-heading"><h3>Parameters</h3><button class="macro-parameter-toggle" type="button" data-toggle-parameters aria-expanded="false" aria-controls="macro-parameter-controls">Adjust parameters</button><button type="button" data-reset>Reset</button></div><div id="macro-parameter-controls" data-controls></div></aside>
      <div class="macro-results">
        <p class="macro-error" data-error role="alert" hidden></p>
        <div class="macro-metrics" data-metrics><div><span>Initial capital / worker</span><strong>16</strong></div><div><span>After one period</span><strong>16</strong></div><div><span>Steady capital / effective worker</span><strong>16</strong></div></div>
        <div class="macro-selection" data-selection></div>
        <section class="macro-insight" data-insight aria-label="Model-specific comparison"></section>
        <div class="macro-live-math" data-live-math></div>
        <div class="macro-flow" data-flow></div>
        <div class="macro-plots" data-plots></div>
        <p class="macro-live" data-live aria-live="polite">Investment and upkeep balance at these starting values.</p>
      </div>
    </div>
    <div class="macro-reading-nav" data-reading-nav aria-label="Explanation depth"><button type="button" data-mode="explore" aria-pressed="true">Explanation</button><button type="button" data-mode="equations" aria-pressed="false">Equations</button><button type="button" data-mode="computation" aria-pressed="false">Computation</button></div>
    <div class="macro-reading" data-reading></div>
    <noscript><p>Enable JavaScript to calculate the models and change their parameters. The suite covers growth, optimization, monetary and fiscal policy, open economies, labor markets, heterogeneous households and sequence-space methods.</p></noscript>
  </article>
</section>
<script>
  import {initializeMacro} from '../scripts/macroeconomics-lab.mjs';
  initializeMacro(document);
</script>
