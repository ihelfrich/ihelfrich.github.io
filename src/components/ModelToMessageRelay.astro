---
const {
  id = "model-to-message-relay",
  headingLevel = "h2",
} = Astro.props;

const Heading = headingLevel;
const effectId = `${id}-effect`;
const uncertaintyId = `${id}-uncertainty`;
const baselineId = `${id}-baseline`;
const thresholdId = `${id}-threshold`;
const claimName = `${id}-claim`;
---

<section id={id} class="mr-relay" data-model-relay aria-labelledby={`${id}-title`}>
  <header class="mr-header">
    <div>
      <span class="mr-kicker">LAB 03 / MODEL TO MESSAGE</span>
      <Heading id={`${id}-title`}>One estimate.<br />Every sentence accountable.</Heading>
    </div>
    <div>
      <p>
        Change a synthetic program estimate, its uncertainty, the baseline, and the minimum useful effect. The interval, table, technical interpretation, and decision brief update from the same state.
      </p>
      <p class="mr-data-note"><i aria-hidden="true"></i>SYNTHETIC PROGRAM EVALUATION / OUTCOMES PER 1,000 ELIGIBLE FIRMS</p>
    </div>
  </header>

  <div class="mr-workbench">
    <aside class="mr-controls" aria-label="Model and decision controls">
      <div class="mr-control-head">
        <span>CONTROL SURFACE</span>
        <button type="button" data-mr-reset>Reset</button>
      </div>

      <label class="mr-range" for={effectId}>
        <span><b>INPUT 01</b>Estimated effect <output for={effectId} data-mr-effect-output>+12.0</output></span>
        <input id={effectId} type="range" min="-20" max="40" step="1" value="12" data-mr-effect aria-describedby={`${effectId}-note`} />
        <small id={`${effectId}-note`}>Additional completed applications per 1,000 firms</small>
        <i aria-hidden="true"><span>−20</span><span>+40</span></i>
      </label>

      <label class="mr-range" for={uncertaintyId}>
        <span><b>INPUT 02</b>Standard error <output for={uncertaintyId} data-mr-uncertainty-output>4.0</output></span>
        <input id={uncertaintyId} type="range" min="1" max="15" step="0.5" value="4" data-mr-uncertainty aria-describedby={`${uncertaintyId}-note`} />
        <small id={`${uncertaintyId}-note`}>The 95% interval uses estimate ± 1.96 standard errors</small>
        <i aria-hidden="true"><span>1</span><span>15</span></i>
      </label>

      <label class="mr-range" for={baselineId}>
        <span><b>INPUT 03</b>Baseline outcome <output for={baselineId} data-mr-baseline-output>120</output></span>
        <input id={baselineId} type="range" min="20" max="300" step="5" value="120" data-mr-baseline aria-describedby={`${baselineId}-note`} />
        <small id={`${baselineId}-note`}>Completed applications per 1,000 firms before the program</small>
        <i aria-hidden="true"><span>20</span><span>300</span></i>
      </label>

      <label class="mr-range" for={thresholdId}>
        <span><b>INPUT 04</b>Decision threshold <output for={thresholdId} data-mr-threshold-output>+8.0</output></span>
        <input id={thresholdId} type="range" min="0" max="25" step="1" value="8" data-mr-threshold aria-describedby={`${thresholdId}-note`} />
        <small id={`${thresholdId}-note`}>Minimum additional outcomes required by the decision rule</small>
        <i aria-hidden="true"><span>0</span><span>+25</span></i>
      </label>

      <fieldset class="mr-claim-control">
        <legend><span>INPUT 05</span>Claim posture</legend>
        <label>
          <input type="radio" name={claimName} value="disciplined" checked data-mr-claim />
          <span><strong>Disciplined</strong><small>Sentence follows the full interval</small></span>
        </label>
        <label>
          <input type="radio" name={claimName} value="forceful" data-mr-claim />
          <span><strong>Forceful</strong><small>Sentence leads with the point estimate</small></span>
        </label>
      </fieldset>
    </aside>

    <div class="mr-output">
      <div class="mr-output-head">
        <div><span>INSTRUMENT 03</span><strong>SYNTHETIC PROGRAM EFFECT / DECISION TRANSLATION</strong></div>
        <span data-mr-evidence-code>THRESHOLD / UNCERTAIN</span>
      </div>

      <div class="mr-estimate-banner">
        <div>
          <span>ESTIMATED EFFECT</span>
          <strong data-mr-estimate>+12.0</strong>
          <small>additional outcomes / 1,000 firms</small>
        </div>
        <div>
          <span>95% INTERVAL</span>
          <strong data-mr-interval>+4.2 to +19.8</strong>
          <small data-mr-relative>+10.0% relative to baseline</small>
        </div>
        <div class="mr-evidence-status" data-mr-evidence-state="uncertain">
          <span>DECISION TEST</span>
          <strong data-mr-evidence-status>UNCERTAINTY CROSSES THRESHOLD</strong>
          <small data-mr-evidence-detail>Point estimate clears +8.0. Lower bound does not.</small>
        </div>
      </div>

      <div class="mr-plot-panel">
        <div class="mr-plot-head"><span>EFFECT SCALE / OUTCOMES PER 1,000</span><span>INTERVAL + DECISION RULE</span></div>
        <div
          class="mr-effect-plot"
          role="img"
          aria-label="Estimated effect positive 12.0 with a 95 percent interval from positive 4.2 to positive 19.8 and a decision threshold of positive 8.0"
          data-mr-plot
          style="--mr-lower:45.1%;--mr-estimate:51.7%;--mr-upper:58.2%;--mr-threshold:48.3%"
        >
          <div class="mr-plot-scale" aria-hidden="true">
            <span style="left:0%">−50</span>
            <span style="left:25%">−20</span>
            <span style="left:41.6667%">0</span>
            <span style="left:58.3333%">+20</span>
            <span style="left:75%">+40</span>
            <span style="left:100%">+70</span>
          </div>
          <div class="mr-plot-track" aria-hidden="true">
            <i class="mr-zero"></i>
            <i class="mr-threshold-line"><b>THRESHOLD</b></i>
            <span class="mr-interval-line"><i></i><i></i></span>
            <span class="mr-estimate-point"><i></i><b data-mr-plot-estimate>+12.0</b></span>
          </div>
          <div class="mr-plot-labels" aria-hidden="true"><span>DECREASE</span><span>NO CHANGE</span><span>INCREASE</span></div>
        </div>

        <div class="mr-baseline-plot" role="img" aria-label="Baseline 120 outcomes and modeled outcome 132 outcomes per 1,000 firms" data-mr-baseline-plot>
          <div><span>BASELINE</span><i><b data-mr-baseline-bar style="width:40%"></b></i><strong data-mr-baseline-value>120</strong></div>
          <div><span>MODELED</span><i><b data-mr-modeled-bar style="width:44%"></b></i><strong data-mr-modeled-value>132</strong></div>
        </div>
      </div>

      <div class="mr-synchronized-grid">
        <article class="mr-table-card">
          <span>01 / TABLE</span>
          <table>
            <caption>Current synthetic estimate and decision quantities</caption>
            <tbody>
              <tr><th scope="row">Baseline</th><td data-mr-table-baseline>120.0</td></tr>
              <tr><th scope="row">Effect</th><td data-mr-table-effect>+12.0</td></tr>
              <tr><th scope="row">95% lower</th><td data-mr-table-lower>+4.2</td></tr>
              <tr><th scope="row">95% upper</th><td data-mr-table-upper>+19.8</td></tr>
              <tr><th scope="row">Relative effect</th><td data-mr-table-relative>+10.0%</td></tr>
              <tr><th scope="row">Decision threshold</th><td data-mr-table-threshold>+8.0</td></tr>
            </tbody>
          </table>
        </article>

        <article class="mr-message-card">
          <span>02 / TECHNICAL SENTENCE</span>
          <p data-mr-technical>
            The synthetic estimate is +12.0 additional completed applications per 1,000 eligible firms, with a 95% interval from +4.2 to +19.8.
          </p>
        </article>

        <article class="mr-message-card mr-message-card--decision">
          <span>03 / DECISION SENTENCE</span>
          <p data-mr-decision>
            The point estimate clears the +8.0 decision threshold. Plausible effects extend below that threshold, so this scenario still requires a risk decision.
          </p>
        </article>

        <article class="mr-claim-card" data-mr-claim-state="within">
          <div>
            <span>04 / CLAIM BOUNDARY</span>
            <strong data-mr-claim-status>WITHIN BOUNDARY</strong>
          </div>
          <p data-mr-claim-sentence>
            The estimate is positive, while the interval includes effects below the +8.0 decision threshold.
          </p>
          <small data-mr-claim-note>The sentence reports the interval and the decision rule.</small>
        </article>
      </div>

      <div class="mr-actions">
        <button type="button" data-mr-copy>Copy current brief</button>
        <span role="status" data-mr-copy-status></span>
        <a href="/start?problem=team&source=model-relay">Bring this discipline to a team →</a>
      </div>
    </div>
  </div>

  <footer class="mr-footer">
    <span><i aria-hidden="true"></i>ALL REPRESENTATIONS SHARE ONE STATE</span>
    <span>SYNTHETIC DATA / NO CLIENT OR ADMINISTRATIVE RECORDS</span>
    <span>EFFECT DOMAIN / −50 TO +70</span>
  </footer>

  <p class="mr-sr-only" data-mr-announcer aria-live="polite"></p>
</section>

<script is:inline>
  (() => {
    const DOMAIN_MIN = -50;
    const DOMAIN_MAX = 70;
    const BAR_MAX = 320;

    document.querySelectorAll("[data-model-relay]").forEach((relay) => {
      const effectInput = relay.querySelector("[data-mr-effect]");
      const uncertaintyInput = relay.querySelector("[data-mr-uncertainty]");
      const baselineInput = relay.querySelector("[data-mr-baseline]");
      const thresholdInput = relay.querySelector("[data-mr-threshold]");
      const claimInputs = Array.from(relay.querySelectorAll("[data-mr-claim]"));
      const plot = relay.querySelector("[data-mr-plot]");
      const baselinePlot = relay.querySelector("[data-mr-baseline-plot]");
      const announcer = relay.querySelector("[data-mr-announcer]");
      const copyStatus = relay.querySelector("[data-mr-copy-status]");
      let currentBrief = "";

      if (!effectInput || !uncertaintyInput || !baselineInput || !thresholdInput) return;

      const signed = (value, digits = 1) => {
        const rounded = Number(value).toFixed(digits);
        if (Number(value) > 0) return `+${rounded}`;
        if (Number(value) < 0) return `−${Math.abs(Number(value)).toFixed(digits)}`;
        return Number(0).toFixed(digits);
      };

      const percentPosition = (value) => {
        const bounded = Math.max(DOMAIN_MIN, Math.min(DOMAIN_MAX, value));
        return (bounded - DOMAIN_MIN) / (DOMAIN_MAX - DOMAIN_MIN) * 100;
      };

      const setText = (selector, value) => {
        const target = relay.querySelector(selector);
        if (target) target.textContent = value;
      };

      const getState = () => {
        const effect = Number(effectInput.value);
        const uncertainty = Number(uncertaintyInput.value);
        const baseline = Number(baselineInput.value);
        const threshold = Number(thresholdInput.value);
        const lower = effect - 1.96 * uncertainty;
        const upper = effect + 1.96 * uncertainty;
        const modeled = baseline + effect;
        const relative = baseline !== 0 ? effect / baseline * 100 : 0;
        const posture = relay.querySelector("[data-mr-claim]:checked")?.value || "disciplined";
        return { effect, uncertainty, baseline, threshold, lower, upper, modeled, relative, posture };
      };

      const evidenceMessage = (state) => {
        if (state.lower >= state.threshold && state.lower > 0) {
          return {
            state: "clear",
            code: "THRESHOLD / CLEAR",
            status: "INTERVAL CLEARS THRESHOLD",
            detail: `Lower bound ${signed(state.lower)} exceeds ${signed(state.threshold)}.`,
            decision: `The full 95% interval clears the ${signed(state.threshold)} decision threshold. This scenario supports action under the stated rule.`,
          };
        }
        if (state.effect >= state.threshold && state.lower < state.threshold) {
          return {
            state: "uncertain",
            code: "THRESHOLD / UNCERTAIN",
            status: "UNCERTAINTY CROSSES THRESHOLD",
            detail: `Point estimate clears ${signed(state.threshold)}. Lower bound does not.`,
            decision: `The point estimate clears the ${signed(state.threshold)} decision threshold. Plausible effects extend below that threshold, so this scenario still requires a risk decision.`,
          };
        }
        if (state.lower <= 0 && state.upper >= 0) {
          return {
            state: "unresolved",
            code: "DIRECTION / UNRESOLVED",
            status: "INTERVAL CROSSES ZERO",
            detail: "The interval includes increases, no change, and decreases.",
            decision: `The interval crosses zero and the ${signed(state.threshold)} decision threshold. Current evidence cannot settle the direction or minimum useful effect.`,
          };
        }
        if (state.effect < state.threshold && state.upper >= state.threshold) {
          return {
            state: "uncertain",
            code: "THRESHOLD / UNCERTAIN",
            status: "UPPER RANGE CLEARS THRESHOLD",
            detail: `Point estimate falls below ${signed(state.threshold)}. Upper bound exceeds it.`,
            decision: `The point estimate falls below the ${signed(state.threshold)} decision threshold. Plausible effects include values that clear it, so the decision depends on tolerance for uncertainty.`,
          };
        }
        if (state.upper < 0) {
          return {
            state: "adverse",
            code: "DIRECTION / ADVERSE",
            status: "INTERVAL BELOW ZERO",
            detail: "The full interval indicates fewer completed applications.",
            decision: "The full 95% interval is below zero. This scenario supports an adverse effect under the stated model.",
          };
        }
        return {
          state: "below",
          code: "THRESHOLD / BELOW",
          status: "INTERVAL BELOW THRESHOLD",
          detail: `Upper bound ${signed(state.upper)} remains below ${signed(state.threshold)}.`,
          decision: `The full 95% interval remains below the ${signed(state.threshold)} decision threshold. This scenario does not satisfy the stated action rule.`,
        };
      };

      const claimMessage = (state) => {
        if (state.posture === "disciplined") {
          if (state.lower >= state.threshold && state.lower > 0) {
            return {
              state: "within",
              status: "WITHIN BOUNDARY",
              sentence: `The estimate supports an increase that clears the ${signed(state.threshold)} decision threshold across the 95% interval.`,
              note: "The sentence reports the direction, interval, and decision rule.",
            };
          }
          if (state.lower > 0 && state.effect >= state.threshold) {
            return {
              state: "within",
              status: "WITHIN BOUNDARY",
              sentence: `The estimate is positive, while the interval includes effects below the ${signed(state.threshold)} decision threshold.`,
              note: "The sentence separates statistical direction from decision sufficiency.",
            };
          }
          if (state.lower <= 0 && state.upper >= 0) {
            return {
              state: "within",
              status: "WITHIN BOUNDARY",
              sentence: "The interval includes zero, so the direction of the effect remains unresolved in this scenario.",
              note: "The sentence keeps the claim inside the interval.",
            };
          }
          if (state.upper < 0) {
            return {
              state: "within",
              status: "WITHIN BOUNDARY",
              sentence: "The estimate and its 95% interval indicate fewer completed applications in this scenario.",
              note: "The sentence reports the adverse direction without adding a causal guarantee.",
            };
          }
          return {
            state: "within",
            status: "WITHIN BOUNDARY",
            sentence: `The estimate falls below the ${signed(state.threshold)} decision threshold under the stated rule.`,
            note: "The sentence follows the current decision criterion.",
          };
        }

        let sentence = "The program had no effect.";
        let supported = false;
        if (state.effect >= state.threshold) {
          sentence = "The program delivered a decision-ready improvement.";
          supported = state.lower >= state.threshold && state.lower > 0;
        } else if (state.effect > 0) {
          sentence = "The program improved completed applications.";
          supported = state.lower > 0;
        } else if (state.effect < 0) {
          sentence = "The program reduced completed applications.";
          supported = state.upper < 0;
        }
        return supported
          ? { state: "within", status: "WITHIN BOUNDARY", sentence, note: "The full interval supports this forceful draft." }
          : { state: "outside", status: "OUTSIDE BOUNDARY", sentence, note: "The point estimate alone cannot carry this draft." };
      };

      const update = (announce = false) => {
        const state = getState();
        const evidence = evidenceMessage(state);
        const claim = claimMessage(state);
        const effectText = signed(state.effect);
        const lowerText = signed(state.lower);
        const upperText = signed(state.upper);
        const thresholdText = signed(state.threshold);
        const relativeText = `${signed(state.relative)}%`;

        setText("[data-mr-effect-output]", effectText);
        setText("[data-mr-uncertainty-output]", state.uncertainty.toFixed(1));
        setText("[data-mr-baseline-output]", state.baseline.toFixed(0));
        setText("[data-mr-threshold-output]", thresholdText);
        setText("[data-mr-estimate]", effectText);
        setText("[data-mr-interval]", `${lowerText} to ${upperText}`);
        setText("[data-mr-relative]", `${relativeText} relative to baseline`);
        setText("[data-mr-evidence-code]", evidence.code);
        setText("[data-mr-evidence-status]", evidence.status);
        setText("[data-mr-evidence-detail]", evidence.detail);
        setText("[data-mr-plot-estimate]", effectText);
        setText("[data-mr-baseline-value]", state.baseline.toFixed(0));
        setText("[data-mr-modeled-value]", state.modeled.toFixed(0));
        setText("[data-mr-table-baseline]", state.baseline.toFixed(1));
        setText("[data-mr-table-effect]", effectText);
        setText("[data-mr-table-lower]", lowerText);
        setText("[data-mr-table-upper]", upperText);
        setText("[data-mr-table-relative]", relativeText);
        setText("[data-mr-table-threshold]", thresholdText);
        setText("[data-mr-technical]", `The synthetic estimate is ${effectText} additional completed applications per 1,000 eligible firms, with a 95% interval from ${lowerText} to ${upperText}.`);
        setText("[data-mr-decision]", evidence.decision);
        setText("[data-mr-claim-status]", claim.status);
        setText("[data-mr-claim-sentence]", claim.sentence);
        setText("[data-mr-claim-note]", claim.note);

        const evidenceCard = relay.querySelector(".mr-evidence-status");
        const claimCard = relay.querySelector(".mr-claim-card");
        if (evidenceCard) evidenceCard.dataset.mrEvidenceState = evidence.state;
        if (claimCard) claimCard.dataset.mrClaimState = claim.state;

        if (plot) {
          plot.style.setProperty("--mr-lower", `${percentPosition(state.lower)}%`);
          plot.style.setProperty("--mr-estimate", `${percentPosition(state.effect)}%`);
          plot.style.setProperty("--mr-upper", `${percentPosition(state.upper)}%`);
          plot.style.setProperty("--mr-threshold", `${percentPosition(state.threshold)}%`);
          plot.setAttribute("aria-label", `Estimated effect ${effectText} with a 95 percent interval from ${lowerText} to ${upperText} and a decision threshold of ${thresholdText}`);
        }

        const baselineWidth = Math.max(0, Math.min(100, state.baseline / BAR_MAX * 100));
        const modeledWidth = Math.max(0, Math.min(100, state.modeled / BAR_MAX * 100));
        const baselineBar = relay.querySelector("[data-mr-baseline-bar]");
        const modeledBar = relay.querySelector("[data-mr-modeled-bar]");
        if (baselineBar) baselineBar.style.width = `${baselineWidth}%`;
        if (modeledBar) modeledBar.style.width = `${modeledWidth}%`;
        if (baselinePlot) baselinePlot.setAttribute("aria-label", `Baseline ${state.baseline.toFixed(0)} outcomes and modeled outcome ${state.modeled.toFixed(0)} outcomes per 1,000 firms`);

        currentBrief = [
          "SYNTHETIC MODEL TO MESSAGE BRIEF",
          "",
          `Baseline: ${state.baseline.toFixed(1)} outcomes per 1,000 firms`,
          `Estimated effect: ${effectText}`,
          `95% interval: ${lowerText} to ${upperText}`,
          `Relative effect: ${relativeText}`,
          `Decision threshold: ${thresholdText}`,
          `Decision test: ${evidence.status}`,
          "",
          "TECHNICAL",
          `The synthetic estimate is ${effectText} additional completed applications per 1,000 eligible firms, with a 95% interval from ${lowerText} to ${upperText}.`,
          "",
          "DECISION",
          evidence.decision,
          "",
          "CLAIM DRAFT",
          claim.sentence,
          `Claim boundary: ${claim.status}`,
        ].join("\n");

        if (announce && announcer) announcer.textContent = `${evidence.status}. Claim ${claim.status.toLowerCase()}. Effect ${effectText}; interval ${lowerText} to ${upperText}.`;
      };

      [effectInput, uncertaintyInput, baselineInput, thresholdInput].forEach((input) => {
        input.addEventListener("input", () => update(false));
        input.addEventListener("change", () => update(true));
      });
      claimInputs.forEach((input) => input.addEventListener("change", () => update(true)));

      relay.querySelector("[data-mr-reset]")?.addEventListener("click", () => {
        effectInput.value = "12";
        uncertaintyInput.value = "4";
        baselineInput.value = "120";
        thresholdInput.value = "8";
        const disciplined = relay.querySelector('[data-mr-claim][value="disciplined"]');
        if (disciplined) disciplined.checked = true;
        update(true);
        effectInput.focus();
      });

      relay.querySelector("[data-mr-copy]")?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(currentBrief);
          if (copyStatus) copyStatus.textContent = "Brief copied.";
        } catch {
          if (copyStatus) copyStatus.textContent = "Copy was blocked. Select the visible sentences manually.";
        }
      });

      update();
    });
  })();
</script>

<style>
  .mr-relay {
    --mr-ink: var(--ih-ink, #121426);
    --mr-bone: var(--ih-bone, #f2eade);
    --mr-paper: var(--ih-paper, #faf5ed);
    --mr-blue: var(--ih-blue, #2852e8);
    --mr-blue-dark: var(--ih-blue-dark, #193fbe);
    --mr-graphite: var(--ih-graphite, #30313d);
    --mr-muted: var(--ih-muted, #66636a);
    --mr-rule: var(--ih-rule, #c7bdb0);
    --mr-oxide: var(--ih-oxide, #ad4e35);
    --mr-serif: var(--ih-serif, "Newsreader", Georgia, serif);
    --mr-sans: var(--ih-sans, "Geist", system-ui, sans-serif);
    --mr-mono: var(--ih-mono, "Geist Mono", ui-monospace, monospace);
    color: var(--mr-bone);
    background: var(--mr-ink);
    border-block: 1px solid var(--mr-ink);
    font-family: var(--mr-sans);
  }

  .mr-relay *, .mr-relay *::before, .mr-relay *::after { box-sizing: border-box; }

  .mr-header {
    display: grid;
    max-width: 1460px;
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 4vw, 4rem);
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, .65fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
  }

  .mr-kicker,
  .mr-data-note,
  .mr-control-head,
  .mr-range > span b,
  .mr-claim-control legend span,
  .mr-output-head,
  .mr-estimate-banner span,
  .mr-plot-head,
  .mr-synchronized-grid article > span,
  .mr-claim-card div span,
  .mr-footer {
    font: 600 .6rem/1.4 var(--mr-mono);
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .mr-kicker { color: #a9bcff; }
  .mr-header h2, .mr-header h1 { max-width: 12ch; margin: 1.1rem 0 0; color: white; font: 500 clamp(3rem, 6vw, 6.4rem)/.9 var(--mr-serif); letter-spacing: -.055em; }
  .mr-header > div:last-child > p:first-child { margin: 0; color: #d0cbc3; font: 400 clamp(1rem, 1.4vw, 1.2rem)/1.55 var(--mr-serif); }
  .mr-data-note { margin: 2rem 0 0; padding-top: .9rem; color: #aaa6a0; border-top: 1px solid rgba(242,234,222,.35); }
  .mr-data-note i { display: inline-block; width: 6px; height: 6px; margin-right: .55rem; background: var(--mr-blue); }

  .mr-workbench { display: grid; max-width: 1460px; margin: 0 auto; grid-template-columns: 300px minmax(0, 1fr); border: 1px solid rgba(242,234,222,.55); }
  .mr-controls { color: var(--mr-ink); background: var(--mr-bone); border-right: 1px solid rgba(242,234,222,.55); }
  .mr-control-head { display: flex; min-height: 54px; padding: 1rem; align-items: center; justify-content: space-between; color: var(--mr-muted); border-bottom: 1px solid var(--mr-ink); }
