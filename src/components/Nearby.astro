---
import "../styles/nearby.css";
const { pathname = Astro.url.pathname } = Astro.props;
---
<nav class="nearby" data-surface="map" data-nearby data-path={pathname} aria-labelledby="nearby-title" hidden>
  <div class="nearby-inner">
    <div class="nearby-head">
      <h2 id="nearby-title">Connected pages</h2>
      <a data-nearby-map href={`/field/#p=${encodeURIComponent(pathname)}`}>Show this page on the site map</a>
    </div>
    <div class="nearby-body">
      <svg class="nearby-ego" data-nearby-ego role="img" aria-label="This page at the centre, with the pages it links to around it."></svg>
      <div class="nearby-groups" data-nearby-groups></div>
    </div>
  </div>
</nav>
<script>
  import { mountNearby } from "../scripts/nearby.mjs";
  const root = document.querySelector("[data-nearby]");
  if (root) mountNearby(root);
</script>
