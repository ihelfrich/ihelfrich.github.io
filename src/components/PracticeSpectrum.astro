---
const fields = [
  {
    key: "economics",
    title: "Economics",
    line: "Econometrics · network economics · micro · macro · trade · labor · strategy",
    detail: "Research starts with the structure of the economic problem: who interacts, what adjusts, which comparison identifies the claim, and where the model can fail.",
    proof: "PhD Economics · network and spatial research",
    link: ["Explore the research", "/research"],
  },
  {
    key: "systems",
    title: "Quantitative systems",
    line: "Mathematics · causal inference · software · data products",
    detail: "The analysis becomes code, a reproducible workflow, or an interface that keeps the logic visible after the original model leaves the screen.",
    proof: "Python · R · Stata · Julia · SQL · interactive products",
    link: ["See the capabilities", "/capabilities"],
  },
  {
    key: "place",
    title: "Place & measurement",
    line: "Remote sensing · geospatial socioeconomics · spatial representation",
    detail: "GIS is one part of a wider measurement practice: using satellite signals, networks, boundaries, and population structure to represent economic activity more honestly.",
    proof: "MS GIS · remote sensing · effective distance",
    link: ["Open the spatial work", "/gis"],
  },
  {
    key: "learning",
    title: "Learning & curiosity",
    line: "ACT / SAT · AP · IB HL · university methods · acoustics · signals · sound",
    detail: "Teaching ranges from standardized tests through graduate econometrics. Acoustics, signal behavior, and sound remain an active amateur inquiry into how complex systems become perceptible.",
    proof: "1,200+ recent-year teaching hours · Georgia Tech award",
    link: ["Explore teaching and tutoring", "/teaching"],
  },
];
---

<section class="practice-spectrum" data-practice-spectrum aria-labelledby="practice-spectrum-title">
  <header class="practice-spectrum__head">
    <p>The practice</p>
    <div>
      <h2 id="practice-spectrum-title">See the structure.<br />Build it. Teach it.</h2>
      <p>The throughline is the ability to find structure across domains, model it precisely, and turn it into something another person can use.</p>
    </div>
  </header>

  <div class="practice-spectrum__rows">
    {fields.map((field, index) => (
      <article class="practice-row" data-practice-row data-field-key={field.key}>
        <button
          class="practice-row__trigger"
          type="button"
          data-practice-trigger
          aria-expanded="true"
          aria-controls={`practice-panel-${field.key}`}
        >
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{field.title}</strong>
          <i aria-hidden="true">+</i>
        </button>
        <div class="practice-row__body" id={`practice-panel-${field.key}`} data-practice-panel>
          <p class="practice-row__line">{field.line}</p>
          <div>
            <p>{field.detail}</p>
            <aside><span>{field.proof}</span><a href={field.link[1]}>{field.link[0]} <b aria-hidden="true">↗</b></a></aside>
          </div>
        </div>
      </article>
    ))}
  </div>

  <p class="practice-spectrum__closing">
    From a standardized test to a frontier method, from an economic network to a sound signal, the instinct is the same: find what governs the system, then make it legible.
  </p>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-practice-spectrum]").forEach((root) => {
    if (root.dataset.spectrumReady === "true") return;
    root.dataset.spectrumReady = "true";
    root.classList.add("has-spectrum-js");

    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-practice-row]"));
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-practice-trigger]"));
    const aborter = new AbortController();
    const { signal } = aborter;
    let active: number | null = 0;

    const synchronize = () => {
      rows.forEach((row, rowIndex) => {
        const selected = rowIndex === active;
        row.classList.toggle("is-active", selected);
        const trigger = triggers[rowIndex];
        const panel = row.querySelector<HTMLElement>("[data-practice-panel]");
        trigger?.setAttribute("aria-expanded", String(selected));
        if (panel) {
          panel.inert = !selected;
          panel.setAttribute("aria-hidden", String(!selected));
        }
      });
    };

    const toggle = (index: number) => {
      active = active === index ? null : index;
      synchronize();
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener("click", () => toggle(index), { signal });
      trigger.addEventListener("keydown", (event: KeyboardEvent) => {
        let destination: number | null = null;
        if (event.key === "ArrowDown" || event.key === "ArrowRight") {
          event.preventDefault();
          destination = (index + 1) % triggers.length;
        }
        if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
          event.preventDefault();
          destination = (index - 1 + triggers.length) % triggers.length;
        }
        if (event.key === "Home") {
          event.preventDefault();
          destination = 0;
        }
        if (event.key === "End") {
          event.preventDefault();
          destination = triggers.length - 1;
        }
        if (destination !== null) triggers[destination]?.focus();
      }, { signal });
    });

    synchronize();

    document.addEventListener("astro:before-swap", () => {
      aborter.abort();
      delete root.dataset.spectrumReady;
    }, { once: true, signal });
  });
</script>

<style>
  .practice-spectrum {
    --folio-black: #09090b;
    --folio-white: #f7f7f5;
    --folio-graphite: #343439;
    --folio-muted: #686870;
    --folio-line: rgba(9, 9, 11, .14);
    --folio-accent: #4b4fe9;
    padding: clamp(6rem, 11vw, 11rem) clamp(1.25rem, 3vw, 3.5rem);
    color: var(--folio-black);
    background: var(--folio-white);
  }

  .practice-spectrum__head {
    display: grid;
    max-width: 1680px;
    margin: 0 auto clamp(4rem, 8vw, 8rem);
    grid-template-columns: minmax(120px, .26fr) 1fr;
    gap: 2rem;
  }

  .practice-spectrum__head > p { margin: .5rem 0 0; color: var(--folio-muted); font: 500 .75rem var(--ih-mono); }
  .practice-spectrum__head > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .42fr); gap: 2rem 5vw; align-items: end; }
  .practice-spectrum__head h2 { max-width: 11ch; margin: 0; font: 520 clamp(3.6rem, 7.2vw, 8.2rem)/.86 var(--ih-display); letter-spacing: -.072em; }
  .practice-spectrum__head div > p { max-width: 540px; margin: 0 0 .6rem; color: var(--folio-graphite); font: 430 clamp(1rem, 1.35vw, 1.24rem)/1.52 var(--ih-sans); letter-spacing: -.018em; }

  .practice-spectrum__rows { display: grid; max-width: 1680px; margin: 0 auto; border-top: 1px solid var(--folio-line); border-bottom: 1px solid var(--folio-line); }
  .practice-row { display: grid; min-height: 74px; overflow: hidden; grid-template-rows: auto auto; border-bottom: 1px solid var(--folio-line); }
  .practice-row:last-child { border-bottom: 0; }

  .has-spectrum-js .practice-row { grid-template-rows: auto 0fr; transition: grid-template-rows 620ms cubic-bezier(.16, 1, .3, 1); }
  .has-spectrum-js .practice-row.is-active { grid-template-rows: auto 1fr; }

  .practice-row__trigger { display: grid; min-height: 74px; padding: .8rem 0; grid-template-columns: 70px 1fr auto; gap: 1rem; align-items: center; color: var(--folio-black); text-align: left; background: transparent; border: 0; cursor: pointer; }
  .practice-row__trigger > span { color: var(--folio-muted); font: 500 .68rem var(--ih-mono); }
  .practice-row__trigger > strong { font: 520 clamp(1.5rem, 3vw, 3.4rem)/1 var(--ih-display); letter-spacing: -.05em; }
  .practice-row__trigger > i { display: grid; width: 44px; height: 44px; place-items: center; color: var(--folio-accent); font: normal 400 1.25rem var(--ih-sans); transition: transform 240ms ease; }
  .practice-row.is-active .practice-row__trigger > i { transform: rotate(45deg); }

  .practice-row__body { display: grid; min-height: 0; overflow: hidden; padding: 0 0 clamp(1.4rem, 3vw, 3rem) 86px; grid-template-columns: minmax(0, .7fr) minmax(320px, 1fr); gap: 2rem 6vw; align-content: end; }
  .practice-row__line { max-width: 650px; margin: 0; color: var(--folio-accent); font: 520 clamp(1.45rem, 2.6vw, 3.2rem)/1.02 var(--ih-display); letter-spacing: -.045em; }
  .practice-row__body > div { display: grid; max-width: 720px; gap: 1.4rem; }
  .practice-row__body > div > p { max-width: 650px; margin: 0; color: var(--folio-graphite); font: 430 clamp(.98rem, 1.16vw, 1.1rem)/1.55 var(--ih-sans); }
  .practice-row__body aside { display: flex; padding-top: 1rem; align-items: baseline; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--folio-line); }
  .practice-row__body aside span { color: var(--folio-muted); font: 500 .7rem/1.4 var(--ih-mono); }
  .practice-row__body aside a { color: var(--folio-black); font: 600 .76rem var(--ih-sans); text-underline-offset: .3em; white-space: nowrap; }

  .has-spectrum-js .practice-row .practice-row__body { padding-bottom: 0; visibility: hidden; opacity: 0; pointer-events: none; transition: opacity 220ms ease, padding-bottom 620ms cubic-bezier(.16, 1, .3, 1), visibility 0s linear 620ms; }
  .has-spectrum-js .practice-row.is-active .practice-row__body { padding-bottom: clamp(1.4rem, 3vw, 3rem); visibility: visible; opacity: 1; pointer-events: auto; transition: opacity 300ms ease 100ms, padding-bottom 620ms cubic-bezier(.16, 1, .3, 1), visibility 0s linear 0s; }

  .practice-spectrum__closing { max-width: 1230px; margin: clamp(4rem, 8vw, 8rem) auto 0; text-align: center; font: 500 clamp(2rem, 4.1vw, 5rem)/.98 var(--ih-display); letter-spacing: -.055em; text-wrap: balance; }

  .practice-spectrum button:focus-visible,
  .practice-spectrum a:focus-visible { outline: 2px solid var(--folio-accent); outline-offset: 3px; }

  @media (max-width: 900px) {
    .practice-spectrum__head { grid-template-columns: 1fr; }
    .practice-spectrum__head > div { grid-template-columns: 1fr; }
    .practice-spectrum__head h2 { font-size: clamp(3.4rem, 13vw, 6.8rem); }
    .practice-row__trigger { grid-template-columns: 44px 1fr auto; }
    .practice-row__body { padding-left: 44px; grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .practice-spectrum { padding-inline: 1rem; }
    .practice-row__trigger { grid-template-columns: 34px 1fr 44px; }
    .practice-row__trigger > strong { font-size: clamp(1.35rem, 7vw, 2rem); }
    .practice-row__body { padding-left: 34px; }
    .practice-row__body aside { align-items: flex-start; flex-direction: column; }
    .practice-spectrum__closing { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .practice-spectrum *,
    .practice-spectrum *::before,
    .practice-spectrum *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
  }

  @media (forced-colors: active) {
    .practice-spectrum,
    .practice-row { color: CanvasText; background: Canvas; }
    .practice-row__line { color: LinkText; }
  }
</style>
