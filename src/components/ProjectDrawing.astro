---
interface Props { kind: 'audio' | 'ocean'; }
const {kind} = Astro.props;
// Original editorial drawings, never sampled from recordings or survey data.
const relief = (x:number, y:number) => 28 + 46*Math.exp(-((x+.22)**2/.2+(y-.1)**2/.9)) + 10*Math.sin(x*4+y*2);
const project = (x:number,y:number) => `${(300+x*177+y*85).toFixed(1)},${(155+y*75-x*29-relief(x,y)).toFixed(1)}`;
const contours = Array.from({length:23},(_,j)=>Array.from({length:65},(_,i)=>project(-1+i/32,-1+j/11)).join(' '));
const cross = Array.from({length:18},(_,j)=>Array.from({length:45},(_,i)=>project(-1+j/8.5,-1+i/22)).join(' '));
---
<div class:list={['project-drawing',`project-drawing--${kind}`]} aria-hidden="true">
 <svg viewBox="0 0 600 270" focusable="false">
  {kind==='audio'?<>
   {[70,135,200].map(y=><line x1="28" x2="572" y1={y} y2={y} class="drawing-grid"/>)}
   {Array.from({length:112},(_,i)=>{const h=9+Math.abs(Math.sin(i*.23)*Math.cos(i*.07))*104;return <line x1={30+i*4.85} x2={30+i*4.85} y1={135-h} y2={135+h} class="drawing-wave"/>;})}
   <rect x="217" y="24" width="113" height="222" class="drawing-selection"/>
   <line x1="277" x2="277" y1="24" y2="246" class="drawing-playhead"/>
  </>:<>
   <path d="M36 230 294 267 571 190" class="drawing-base"/>
   {cross.map(points=><polyline points={points} class="drawing-cross"/>)}
   {contours.map(points=><polyline points={points} class="drawing-terrain"/>)}
   {[0,1,2,3].map(i=><path d={`M${40+i*12} ${59+i*17} C180 ${-11+i*19} 250 ${89+i*15} 346 ${45+i*17} S484 ${47+i*15} 565 ${21+i*18}`} class="drawing-current" style={`--delay:${i*.15}s`}/>)}
  </>}
 </svg>
 <div class="drawing-caption"><span>{kind==='audio'?'Sound → signal → composition':'Terrain + fields + perspective'}</span><span>{kind==='audio'?'Illustrative waveform':'Illustrative terrain'}</span></div>
</div>
<style>
 .project-drawing{overflow:hidden;background:#171717;color:#ddd;border:1px solid #333;isolation:isolate}
 svg{display:block;width:100%;height:auto;max-height:25rem}
 .drawing-grid{stroke:#353535;stroke-width:.6}.drawing-wave{stroke:#d4d4d4;stroke-width:1.3}
 .drawing-selection{fill:#fff;fill-opacity:.07;stroke:#aaa;stroke-width:.65}.drawing-playhead{stroke:#fff;stroke-width:1.3}
 .drawing-base{stroke:#777;stroke-width:.7;fill:none}.drawing-cross{fill:none;stroke:#747474;stroke-width:.6}
 .drawing-terrain{fill:none;stroke:#c8c8c8;stroke-width:.8}.drawing-current{fill:none;stroke:#fff;stroke-width:1.2;stroke-dasharray:3 8;animation:current-pass 4s linear var(--delay) 1}
 .drawing-caption{display:flex;justify-content:space-between;gap:1rem;padding:.75rem 1rem;border-top:1px solid #3a3a3a;color:#bbb;font:500 .6rem/1.5 var(--font-data);letter-spacing:.04em}
 @keyframes current-pass{from{stroke-dashoffset:66}to{stroke-dashoffset:0}}
 @media(prefers-reduced-motion:reduce){.drawing-current{animation:none}}
 @media(max-width:30rem){.drawing-caption{font-size:.55rem}}
</style>
