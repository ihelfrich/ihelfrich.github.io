---

<section class="proof-circuit" data-proof-circuit data-active-route="estimate" aria-labelledby="proof-circuit-title" data-rail-label="PROOF CIRCUIT">
  <header class="proof-circuit__intro">
    <div>
      <span class="proof-circuit__kicker">04 / PROOF CIRCUIT</span>
      <h2 id="proof-circuit-title">Trace a problem until the method, artifact, and proof line up.</h2>
    </div>
    <p>
      Choose a live client signal. Every illuminated path carries a scoped analytical move into a tangible deliverable and an inspectable public record.
    </p>
  </header>

  <nav class="proof-circuit__routes" role="tablist" aria-label="Choose a client problem">
    {routes.map((route, index) => (
      <button
        id={`proof-route-${route.key}`}
        type="button"
        role="tab"
        aria-selected={index === 0 ? "true" : "false"}
        aria-controls="proof-circuit-panel"
        tabindex={index === 0 ? "0" : "-1"}
        class:list={["proof-circuit__route", index === 0 && "is-active"]}
        data-circuit-route={route.key}
      >
        <span>{route.index}</span>
        <strong>{route.label}</strong>
      </button>
    ))}
  </nav>

  <div id="proof-circuit-panel" class="proof-circuit__panel" role="tabpanel" aria-labelledby="proof-route-estimate">
    <div class="proof-circuit__stage" data-circuit-stage>
      <canvas class="proof-circuit__canvas" data-circuit-canvas aria-hidden="true"></canvas>

      <div class="proof-circuit__grid" data-circuit-grid>
        {columns.map((column, columnIndex) => (
          <section class="proof-circuit__column" data-circuit-column={column.key} aria-labelledby={`proof-column-${column.key}`}>
            <header>
              <span>{column.index}</span>
              <div>
                <h3 id={`proof-column-${column.key}`}>{column.label}</h3>
                <p>{column.note}</p>
              </div>
            </header>

            <div class="proof-circuit__node-list">
              {nodes.filter((node) => node.column === column.key).map((node, nodeIndex) => (
                node.href ? (
                  <a
                    class:list={["proof-circuit__node", node.routes.includes("estimate") && "is-route-member"]}
                    href={node.href}
                    data-circuit-node
                    data-node-id={node.id}
                    data-node-routes={node.routes.join(" ")}
                    data-column-index={columnIndex}
                    data-node-index={nodeIndex}
                  >
                    <span>{node.code}</span>
                    <strong>{node.label}</strong>
                    <small>{node.detail}</small>
                    <i aria-hidden="true">↗</i>
                  </a>
                ) : (
                  <button
                    type="button"
                    class:list={["proof-circuit__node", node.routes.includes("estimate") && "is-route-member"]}
                    data-circuit-node
                    data-node-id={node.id}
                    data-node-routes={node.routes.join(" ")}
                    data-column-index={columnIndex}
                    data-node-index={nodeIndex}
                    aria-pressed="false"
                  >
                    <span>{node.code}</span>
                    <strong>{node.label}</strong>
                    <small>{node.detail}</small>
                    <i aria-hidden="true">+</i>
                  </button>
                )
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>

    <aside class="proof-circuit__receipt" data-circuit-receipt aria-labelledby="proof-circuit-receipt-title">
      <div class="proof-circuit__receipt-head">
        <span data-receipt-index>ROUTE 01 / 04</span>
        <output data-receipt-count>{routes[0].methodCount}</output>
      </div>
      <div class="proof-circuit__receipt-state">
        <span data-receipt-signal>{routes[0].signal}</span>
        <h3 id="proof-circuit-receipt-title" data-receipt-headline>{routes[0].headline}</h3>
        <p data-receipt-summary>{routes[0].summary}</p>
      </div>
      <div class="proof-circuit__trace" aria-label="Selected evidence path">
        <span>ACTIVE TRACE</span>
        <strong data-receipt-path>{routes[0].path}</strong>
      </div>
      <div class="proof-circuit__hypothesis">
        <span>PROJECT HYPOTHESIS</span>
        <p id="proof-circuit-detail" data-receipt-hypothesis>{routes[0].hypothesis}</p>
      </div>
      <div class="proof-circuit__receipt-actions">
        <a class="proof-circuit__start" href={routes[0].startHref} data-receipt-start>Scope this route <span aria-hidden="true">→</span></a>
        <a class="proof-circuit__proof" href={routes[0].proofHref} data-receipt-proof>{routes[0].proofLabel} <span aria-hidden="true">↗</span></a>
      </div>
    </aside>
  </div>

  <footer class="proof-circuit__legend">
    <span><i class="legend-flow" aria-hidden="true"></i> Active relationship</span>
    <span><i class="legend-selection" aria-hidden="true"></i> Selected evidence</span>
    <span>Focus or select any node to expose its route</span>
    <button type="button" data-circuit-reset>RESET TRACE</button>
  </footer>

  <p class="sr-only" data-circuit-status aria-live="polite" aria-atomic="true"></p>
</section>

<script is:inline define:vars={{ routes, nodes, edges, columns }}>
  (() => {
    const routeKeys = routes.map((route) => route.key);
    const routeMap = new Map(routes.map((route) => [route.key, route]));
    const nodeMap = new Map(nodes.map((node) => [node.id, node]));
    const columnOrder = columns.map((column) => column.key);

    document.querySelectorAll("[data-proof-circuit]").forEach((root) => {
      const stage = root.querySelector("[data-circuit-stage]");
      const canvas = root.querySelector("[data-circuit-canvas]");
      const context = canvas?.getContext("2d");
      const routeButtons = Array.from(root.querySelectorAll("[data-circuit-route]"));
      const nodeElements = Array.from(root.querySelectorAll("[data-circuit-node]"));
      const resetButton = root.querySelector("[data-circuit-reset]");
      const panel = root.querySelector("[role='tabpanel']");
      const status = root.querySelector("[data-circuit-status]");
      const fields = {
        index: root.querySelector("[data-receipt-index]"),
        count: root.querySelector("[data-receipt-count]"),
        signal: root.querySelector("[data-receipt-signal]"),
        headline: root.querySelector("[data-receipt-headline]"),
        summary: root.querySelector("[data-receipt-summary]"),
        path: root.querySelector("[data-receipt-path]"),
        hypothesis: root.querySelector("[data-receipt-hypothesis]"),
        start: root.querySelector("[data-receipt-start]"),
        proof: root.querySelector("[data-receipt-proof]"),
      };

      const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const state = {
        route: "estimate",
        selectedNodeId: null,
        previewNodeId: null,
        pinned: false,
        reducedMotion: motionQuery.matches,
        visible: true,
      };

      let nodeRects = new Map();
      let animationFrame = 0;
      let resizeFrame = 0;
      let transitionStart = 0;

      const routesForElement = (element) => (element?.dataset.nodeRoutes || "").split(" ").filter(Boolean);

      const preferredRouteForNode = (element) => {
        const available = routesForElement(element);
        return available.includes(state.route) ? state.route : available[0];
      };

      const activeNodeId = () => state.pinned ? state.selectedNodeId : state.previewNodeId;

      const writeReceipt = (routeKey, nodeId = null) => {
        const route = routeMap.get(routeKey);
        const node = nodeId ? nodeMap.get(nodeId) : null;
        if (!route) return;

        if (fields.index) fields.index.textContent = `ROUTE ${route.index} / 04`;
        if (fields.count) fields.count.textContent = route.methodCount;
        if (fields.signal) fields.signal.textContent = route.signal;
        if (fields.headline) fields.headline.textContent = route.headline;
        if (fields.summary) fields.summary.textContent = route.summary;
        if (fields.path) fields.path.textContent = route.path;
        if (fields.hypothesis) fields.hypothesis.textContent = node?.detail || route.hypothesis;
        if (fields.start) fields.start.href = route.startHref;
        if (fields.proof) {
          fields.proof.href = route.proofHref;
          fields.proof.childNodes[0].nodeValue = `${route.proofLabel} `;
        }
      };

      const announce = () => {
        const route = routeMap.get(state.route);
        if (!status || !route) return;
        status.textContent = `${route.label}. ${route.methodCount}.`;
      };

      const updateDom = ({ announceChange = false } = {}) => {
        const emphasizedId = activeNodeId();
        root.dataset.activeRoute = state.route;

        routeButtons.forEach((button) => {
          const active = button.dataset.circuitRoute === state.route;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-selected", String(active));
          button.setAttribute("tabindex", active ? "0" : "-1");
          if (active && panel) panel.setAttribute("aria-labelledby", button.id);
        });

        nodeElements.forEach((element) => {
          const member = routesForElement(element).includes(state.route);
          const emphasized = element.dataset.nodeId === emphasizedId;
          element.classList.toggle("is-route-member", member);
          element.classList.toggle("is-emphasized", emphasized);
          if (element.matches("button")) {
            element.setAttribute("aria-pressed", String(state.pinned && emphasized));
          }
        });

        writeReceipt(state.route, emphasizedId);
        if (announceChange) announce();
      };

      const cssColor = (name, fallback) => {
        const value = getComputedStyle(root).getPropertyValue(name).trim();
        return value || fallback;
      };

      const measureNodes = () => {
        if (!stage || !canvas || !context || canvas.offsetParent === null) return false;
        const stageRect = stage.getBoundingClientRect();
        const cssWidth = Math.max(1, Math.round(stageRect.width));
        const cssHeight = Math.max(1, Math.round(stageRect.height));
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const pixelWidth = Math.round(cssWidth * dpr);
        const pixelHeight = Math.round(cssHeight * dpr);

        if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
          canvas.width = pixelWidth;
          canvas.height = pixelHeight;
          canvas.style.width = `${cssWidth}px`;
          canvas.style.height = `${cssHeight}px`;
        }
        context.setTransform(dpr, 0, 0, dpr, 0, 0);

        nodeRects = new Map(nodeElements.map((element) => {
          const rect = element.getBoundingClientRect();
          return [element.dataset.nodeId, {
            left: rect.left - stageRect.left,
            right: rect.right - stageRect.left,
            top: rect.top - stageRect.top,
            bottom: rect.bottom - stageRect.top,
            width: rect.width,
            height: rect.height,
          }];
        }));
        return true;
      };

      const drawCurve = (edge, color, alpha, width, progress = 1, emphasized = false) => {
        const from = nodeRects.get(edge.from);
        const to = nodeRects.get(edge.to);
        if (!from || !to || !context) return;

        const x1 = from.right;
        const y1 = from.top + from.height / 2;
        const x2 = to.left;
        const y2 = to.top + to.height / 2;
        const bend = Math.max(26, (x2 - x1) * 0.42);

        context.save();
        context.globalAlpha = alpha;
        context.strokeStyle = color;
        context.fillStyle = color;
        context.lineWidth = width;
        context.lineCap = "round";
        if (progress < 1) {
          context.setLineDash([8, 10]);
          context.lineDashOffset = (1 - progress) * 38;
        }
        context.beginPath();
        context.moveTo(x1, y1);
        context.bezierCurveTo(x1 + bend, y1, x2 - bend, y2, x2 - 7, y2);
        context.stroke();

        if (emphasized || progress > 0.72) {
          context.setLineDash([]);
          context.beginPath();
          context.moveTo(x2 - 8, y2 - 4);
          context.lineTo(x2 - 1, y2);
          context.lineTo(x2 - 8, y2 + 4);
          context.closePath();
          context.fill();
        }
        context.restore();
      };

      const draw = (progress = 1) => {
        if (!context || !canvas || !stage || canvas.offsetParent === null) return;
        const cssWidth = canvas.width / Math.min(window.devicePixelRatio || 1, 2);
        const cssHeight = canvas.height / Math.min(window.devicePixelRatio || 1, 2);
        context.clearRect(0, 0, cssWidth, cssHeight);

        const rule = cssColor("--atlas-rule", "#c9c0af");
        const flow = cssColor("--atlas-water", "#78a7a0");
        const selected = cssColor("--atlas-signal", "#f15a37");
        const emphasizedId = activeNodeId();

        edges.forEach((edge) => drawCurve(edge, rule, 0.11, 1, 1, false));
        edges.filter((edge) => edge.routes.includes(state.route)).forEach((edge) => {
          const emphasized = emphasizedId && (edge.from === emphasizedId || edge.to === emphasizedId);
          drawCurve(
            edge,
            emphasized ? selected : flow,
            emphasized ? 0.96 : 0.36 + (0.46 * progress),
            emphasized ? 2.25 : 1.35,
            progress,
            emphasized,
          );
        });
      };

      const animateDraw = () => {
        cancelAnimationFrame(animationFrame);
        if (!state.visible || state.reducedMotion) {
          if (measureNodes()) draw(1);
          return;
        }

        transitionStart = performance.now();
        const tick = (now) => {
          const linear = Math.min(1, (now - transitionStart) / 260);
          const eased = 1 - Math.pow(1 - linear, 3);
          if (measureNodes()) draw(eased);
          if (linear < 1) animationFrame = requestAnimationFrame(tick);
        };
        animationFrame = requestAnimationFrame(tick);
      };

      const scheduleMeasure = ({ animate = false } = {}) => {
        cancelAnimationFrame(resizeFrame);
        resizeFrame = requestAnimationFrame(() => {
          if (animate) animateDraw();
          else if (measureNodes()) draw(1);
        });
      };

      const persistRoute = (key) => {
        try {
          sessionStorage.setItem("ih-proof-route", key);
        } catch {
          /* Storage is an optional continuity aid. */
        }
      };

      const setRoute = (key, { focusTab = false, announceChange = false, persist = true } = {}) => {
        if (!routeMap.has(key)) return;
        state.route = key;
        state.selectedNodeId = null;
        state.previewNodeId = null;
        state.pinned = false;
        updateDom({ announceChange });
        if (persist) persistRoute(key);
        if (focusTab) routeButtons.find((button) => button.dataset.circuitRoute === key)?.focus();
        scheduleMeasure({ animate: true });
      };

      const previewNode = (element) => {
        if (state.pinned || !element) return;
        const nextRoute = preferredRouteForNode(element);
        if (nextRoute && nextRoute !== state.route) state.route = nextRoute;
        state.previewNodeId = element.dataset.nodeId;
        updateDom();
        scheduleMeasure({ animate: true });
      };

      const clearPreview = () => {
        if (state.pinned || !state.previewNodeId) return;
        state.previewNodeId = null;
        updateDom();
        scheduleMeasure();
      };

      const toggleNode = (element) => {
        if (!element) return;
        const id = element.dataset.nodeId;
        const nextRoute = preferredRouteForNode(element);
        if (nextRoute) state.route = nextRoute;

        if (state.pinned && state.selectedNodeId === id) {
          state.pinned = false;
          state.selectedNodeId = null;
          state.previewNodeId = id;
        } else {
          state.pinned = true;
          state.selectedNodeId = id;
          state.previewNodeId = null;
        }
        updateDom({ announceChange: true });
        persistRoute(state.route);
        scheduleMeasure({ animate: true });
      };

      const nodesInColumn = (columnIndex, routeOnly = true) => nodeElements.filter((element) => {
        const sameColumn = Number(element.dataset.columnIndex) === columnIndex;
        return sameColumn && (!routeOnly || routesForElement(element).includes(state.route));
      });

      const focusRelativeNode = (element, direction) => {
        const currentColumn = Number(element.dataset.columnIndex);
        const currentIndex = Number(element.dataset.nodeIndex);
        let target = null;

        if (direction === "up" || direction === "down") {
          const peers = nodesInColumn(currentColumn);
          const peerIndex = peers.indexOf(element);
          if (peers.length) {
            const delta = direction === "up" ? -1 : 1;
            target = peers[(peerIndex + delta + peers.length) % peers.length];
          }
        } else {
          const delta = direction === "left" ? -1 : 1;
          const targetColumn = currentColumn + delta;
          const candidates = nodesInColumn(targetColumn);
          if (candidates.length) {
            target = candidates.reduce((best, candidate) => {
              if (!best) return candidate;
              const candidateDistance = Math.abs(Number(candidate.dataset.nodeIndex) - currentIndex);
              const bestDistance = Math.abs(Number(best.dataset.nodeIndex) - currentIndex);
              return candidateDistance < bestDistance ? candidate : best;
            }, null);
          }
        }
        target?.focus();
      };

      routeButtons.forEach((button, index) => {
        button.addEventListener("click", () => setRoute(button.dataset.circuitRoute, { announceChange: true }));
        button.addEventListener("keydown", (event) => {
          let nextIndex = null;
          if (event.key === "ArrowRight" || event.key === "ArrowDown") nextIndex = index + 1;
          if (event.key === "ArrowLeft" || event.key === "ArrowUp") nextIndex = index - 1;
          if (event.key === "Home") nextIndex = 0;
          if (event.key === "End") nextIndex = routeButtons.length - 1;
          if (nextIndex === null) return;
          event.preventDefault();
          const normalized = (nextIndex + routeButtons.length) % routeButtons.length;
          setRoute(routeButtons[normalized].dataset.circuitRoute, {
            focusTab: true,
            announceChange: true,
          });
        });
      });

      nodeElements.forEach((element) => {
        element.addEventListener("focus", () => previewNode(element));
        element.addEventListener("pointerenter", (event) => {
          if (event.pointerType !== "touch") previewNode(element);
        });
        element.addEventListener("pointerleave", () => {
          if (!element.matches(":focus")) clearPreview();
        });
        if (element.matches("button")) element.addEventListener("click", () => toggleNode(element));
        element.addEventListener("keydown", (event) => {
          if (event.key === "ArrowUp") {
            event.preventDefault();
            focusRelativeNode(element, "up");
          } else if (event.key === "ArrowDown") {
            event.preventDefault();
            focusRelativeNode(element, "down");
          } else if (event.key === "ArrowLeft") {
            event.preventDefault();
            focusRelativeNode(element, "left");
          } else if (event.key === "ArrowRight") {
            event.preventDefault();
            focusRelativeNode(element, "right");
          } else if (event.key === "Home" || event.key === "End") {
            event.preventDefault();
            const peers = nodesInColumn(Number(element.dataset.columnIndex));
            (event.key === "Home" ? peers[0] : peers[peers.length - 1])?.focus();
          } else if (event.key === "Escape") {
            state.pinned = false;
            state.selectedNodeId = null;
            state.previewNodeId = null;
            updateDom({ announceChange: true });
            scheduleMeasure({ animate: true });
          }
        });
      });

      root.addEventListener("focusout", (event) => {
        requestAnimationFrame(() => {
          if (!state.pinned && !root.contains(document.activeElement)) clearPreview();
        });
      });

      resetButton?.addEventListener("click", () => setRoute("estimate", { announceChange: true }));

      document.addEventListener("studio:lanechange", (event) => {
        const key = event.detail?.lane;
        if (routeKeys.includes(key)) setRoute(key, { announceChange: true });
      });

      const onMotionChange = (event) => {
        state.reducedMotion = event.matches;
        scheduleMeasure();
      };
      motionQuery.addEventListener?.("change", onMotionChange);

      const resizeObserver = "ResizeObserver" in window ? new ResizeObserver(() => scheduleMeasure()) : null;
      if (resizeObserver && stage) resizeObserver.observe(stage);
      else window.addEventListener("resize", () => scheduleMeasure(), { passive: true });

      const intersectionObserver = "IntersectionObserver" in window ? new IntersectionObserver((entries) => {
        state.visible = entries[0]?.isIntersecting ?? true;
        if (state.visible) scheduleMeasure();
        else cancelAnimationFrame(animationFrame);
      }, { rootMargin: "180px" }) : null;
      intersectionObserver?.observe(root);

      if (!context) root.classList.add("has-no-canvas");

      let initialRoute = "estimate";
      try {
        const queryRoute = new URLSearchParams(window.location.search).get("problem");
        const storedRoute = sessionStorage.getItem("ih-proof-route");
        if (routeKeys.includes(queryRoute)) initialRoute = queryRoute;
        else if (routeKeys.includes(storedRoute)) initialRoute = storedRoute;
      } catch {
        /* The server-rendered route remains complete. */
      }
      setRoute(initialRoute, { persist: false });
    });
  })();
</script>

