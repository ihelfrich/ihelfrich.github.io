---
import EvidenceAperture from "./EvidenceAperture.astro";
import { relayGraphGeometry } from "../lib/fieldbook-math.mjs";
const initialGeometry = relayGraphGeometry(20);
---

<EvidenceAperture
  id="representation-relay"
  liveRegionId="representation-relay-live"
  class="relay-aperture"
  question="How does one demand relationship look in words, an equation, a table, a graph, and code?"
  caption="Change the price. All five representations update from the same demand curve, so their agreement is easy to check."
  status="Live teaching demonstration"
  method="Linked representations of Q = 90 − 2P"
  role="Designed and taught by Ian Helfrich"
  limit="This is a deterministic demand-curve illustration, not an estimated market demand system."
  links={[{ label: "Teaching subjects", href: "/teaching#capability-libraries" }]}
>
  <div slot="figure" class="relay" data-representation-relay style="--relay-x: 40%; --relay-y: 46%">
    <div class="relay-stage">
      <article class="relay-cell relay-sentence">
        <span>Words</span>
        <p>At <strong data-relay-price-word>$20</strong>, buyers demand <strong data-relay-quantity-word>50 units</strong>. One more dollar reduces quantity by two units along this curve.</p>
      </article>
      <article class="relay-cell relay-equation">
        <span>Equation</span>
        <div><i>Q</i> = 90 − 2(<b data-relay-price-equation>20</b>) = <strong data-relay-quantity-equation>50</strong></div>
      </article>
      <article class="relay-cell relay-table">
        <span>Table</span>
        <table>
          <thead><tr><th>Price</th><th>Quantity</th><th>Revenue</th></tr></thead>
          <tbody><tr><td data-relay-price-table>$20</td><td data-relay-quantity-table>50</td><td data-relay-revenue-table>$1,000</td></tr></tbody>
        </table>
      </article>
      <article class="relay-cell relay-graph">
        <span>Graph</span>
        <svg viewBox="0 0 560 310" role="img" aria-labelledby="relay-graph-title relay-graph-desc">
          <title id="relay-graph-title">Linear demand curve</title>
          <desc id="relay-graph-desc" data-relay-graph-desc>Quantity equals ninety minus two times price. The current point is price twenty and quantity fifty.</desc>
          <g class="relay-grid" aria-hidden="true"><path d="M60 30V260H530M60 76H530M60 122H530M60 168H530M60 214H530M154 30V260M248 30V260M342 30V260M436 30V260"></path></g>
          <path class="relay-demand" d={initialGeometry.path}></path>
          <line class="relay-guide relay-guide-x" x1="60" y1={initialGeometry.point.y} x2={initialGeometry.point.x} y2={initialGeometry.point.y} data-relay-guide-x></line>
          <line class="relay-guide relay-guide-y" x1={initialGeometry.point.x} y1={initialGeometry.point.y} x2={initialGeometry.point.x} y2="260" data-relay-guide-y></line>
          <circle class="relay-point" cx={initialGeometry.point.x} cy={initialGeometry.point.y} r="8" data-relay-point></circle>
          <g class="relay-labels" aria-hidden="true"><text x="60" y="285">0</text><text x="530" y="285" text-anchor="end">QUANTITY</text><text x="42" y="35" text-anchor="end">PRICE</text><text x="489" y="31">Q = 90 − 2P</text></g>
          <text class="relay-point-label" x={initialGeometry.point.x + 15} y={initialGeometry.point.y - 11} data-relay-point-label>P $20 / Q 50</text>
        </svg>
      </article>
      <article class="relay-cell relay-code">
        <span>Code</span>
        <pre><code><i>price</i> &lt;- <b data-relay-price-code>20</b>
quantity &lt;- 90 - 2 * <i>price</i>
revenue &lt;- <i>price</i> * quantity

# quantity: <b data-relay-quantity-code>50</b>
# revenue:  <b data-relay-revenue-code>1000</b></code></pre>
      </article>
    </div>
  </div>

  <div slot="controls" class="relay-control">
    <div class="relay-control-top"><span>Price</span><output for="relay-price" data-relay-price>$20</output></div>
    <label for="relay-price">Change the price</label>
    <input id="relay-price" type="range" min="10" max="35" step="1" value="20" data-relay-input />
    <div class="relay-scale" aria-hidden="true"><span>$10</span><span>$35</span></div>
    <dl>
      <div><dt>Demand rule</dt><dd>Q = 90 − 2P</dd></div>
      <div><dt>Slope</dt><dd>−2 units / $1</dd></div>
      <div><dt>Current elasticity</dt><dd data-relay-elasticity>−0.80</dd></div>
      <div><dt>Revenue</dt><dd data-relay-revenue>$1,000</dd></div>
    </dl>
    <button type="button" data-relay-reset>Return to $20</button>
  </div>

  <p data-relay-summary>At $20, quantity demanded is 50 units, revenue is $1,000, and point elasticity is −0.80.</p>
</EvidenceAperture>

<script>
  import { relayGraphGeometry, relayState } from "../lib/fieldbook-math.mjs";

  document.querySelectorAll(".relay-aperture").forEach((aperture) => {
    const relay = aperture.querySelector("[data-representation-relay]");
    const input = aperture.querySelector("[data-relay-input]");
    if (!(relay instanceof HTMLElement) || !(input instanceof HTMLInputElement)) return;
    const one = (selector: string) => aperture.querySelector(selector);
    const all = (selector: string) => aperture.querySelectorAll(selector);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const transitionDuration = Number.parseFloat(getComputedStyle(aperture).getPropertyValue("--ef-motion-fast")) || 140;
    const money = (value: number) => `$${Number(value).toLocaleString("en-US")}`;
    const update = (announce = false) => {
      const state = relayState(Number(input.value));
      all("[data-relay-price]").forEach((field) => field.textContent = money(state.price));
      all("[data-relay-price-word]").forEach((field) => field.textContent = money(state.price));
      all("[data-relay-price-equation], [data-relay-price-code]").forEach((field) => field.textContent = String(state.price));
      const priceTable = one("[data-relay-price-table]");
      const quantityWord = one("[data-relay-quantity-word]");
      if (priceTable) priceTable.textContent = money(state.price);
      if (quantityWord) quantityWord.textContent = `${state.quantity} units`;
      all("[data-relay-quantity-equation], [data-relay-quantity-table], [data-relay-quantity-code]").forEach((field) => field.textContent = String(state.quantity));
      all("[data-relay-elasticity]").forEach((field) => field.textContent = `−${Math.abs(state.elasticity).toFixed(2)}`);
      all("[data-relay-revenue], [data-relay-revenue-table]").forEach((field) => field.textContent = money(state.revenue));
      all("[data-relay-revenue-code]").forEach((field) => field.textContent = String(state.revenue));
      const geometry = relayGraphGeometry(state.price);
      const { x, y } = geometry.point;
      const point = one("[data-relay-point]");
      const guideX = one("[data-relay-guide-x]");
      const guideY = one("[data-relay-guide-y]");
      const label = one("[data-relay-point-label]");
      const graphDescription = one("[data-relay-graph-desc]");
      point?.setAttribute("cx", String(x)); point?.setAttribute("cy", String(y));
      guideX?.setAttribute("y1", String(y)); guideX?.setAttribute("y2", String(y)); guideX?.setAttribute("x2", String(x));
      guideY?.setAttribute("x1", String(x)); guideY?.setAttribute("x2", String(x)); guideY?.setAttribute("y1", String(y));
      label?.setAttribute("x", String(Math.min(445, x + 15))); label?.setAttribute("y", String(Math.max(24, y - 11)));
      if (label) label.textContent = `P $${state.price} / Q ${state.quantity}`;
      if (graphDescription) graphDescription.textContent = `Quantity equals ninety minus two times price. The current point is price ${state.price} and quantity ${state.quantity}.`;
      input.style.setProperty("--relay-progress", `${(state.price - 10) / 25 * 100}%`);
      const summary = `At ${money(state.price)}, quantity demanded is ${state.quantity} units, revenue is ${money(state.revenue)}, and point elasticity is −${Math.abs(state.elasticity).toFixed(2)}.`;
      const summaryEl = one("[data-relay-summary]");
      if (summaryEl) summaryEl.textContent = summary;
      if (announce) {
        const live = one("#representation-relay-live");
        if (live) live.textContent = `Representations updated. ${summary}`;
      }
    };
    input.addEventListener("input", () => {
      relay.classList.toggle("is-resolving", !reduced);
      update(false);
    });
    input.addEventListener("change", () => {
      if (reduced) { update(true); return; }
      window.setTimeout(() => { relay.classList.remove("is-resolving"); update(true); }, transitionDuration);
    });
    aperture.querySelector("[data-relay-reset]")?.addEventListener("click", () => {
      input.value = "20";
      relay.classList.toggle("is-resolving", !reduced);
      if (reduced) update(true);
      else window.setTimeout(() => { relay.classList.remove("is-resolving"); update(true); }, transitionDuration);
      input.focus();
    });
    update(false);
  });
</script>

<style>
  /* instrument.css styles the relay for a full-width dark band. Here the figure sits in the
     aperture's figure column (about 600 to 760 px wide on a desktop), and the controls sit on the
     light page below it, so both are restyled for that setting. */
  .relay { padding: clamp(1rem, 2.4vw, 2rem); }
  .relay-cell { padding: clamp(1rem, 1.8vw, 1.6rem); }
  .relay-sentence p { font-size: clamp(1.15rem, 1.6vw, 1.5rem); }
  .relay-equation > div { font-size: clamp(1.3rem, 2.2vw, 2rem); line-height: 1.15; }
  .relay-graph svg { min-height: 300px; }
  @media (min-width: 761px) {
    .relay-stage { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  }
  @media (max-width: 760px) {
    .relay-graph svg { height: auto; min-height: 0; }
  }
  .relay-control { width: min(100%, 28rem); min-height: 0; padding: 0; border: 0; color: var(--ef-ink); }
  .relay-control-top { min-height: 0; padding-bottom: 0.5rem; align-items: baseline; color: color-mix(in srgb, var(--ef-ink) 65%, transparent); border-bottom-color: color-mix(in srgb, var(--ef-ink) 18%, var(--ef-paper)); font-size: 0.68rem; }
  .relay-control-top output { color: var(--ef-ink); font-size: 2rem; }
  .relay-control label { margin: 1rem 0 0.25rem; color: var(--ef-ink); font-size: 0.9rem; }
  .relay-control input[type="range"] { min-height: 44px; width: 100%; background: linear-gradient(90deg, var(--ih-blue) 0 var(--relay-progress, 40%), color-mix(in srgb, var(--ef-ink) 25%, var(--ef-paper)) var(--relay-progress, 40%) 100%) center / 100% 3px no-repeat; }
  .relay-control .relay-scale { margin-top: 0; color: color-mix(in srgb, var(--ef-ink) 65%, transparent); font-size: 0.68rem; }
  .relay-control dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1rem; margin: 1rem 0; }
  .relay-control dl div { border-top-color: color-mix(in srgb, var(--ef-ink) 18%, var(--ef-paper)); }
  .relay-control dt { color: color-mix(in srgb, var(--ef-ink) 65%, transparent); font-size: 0.68rem; }
  .relay-control dd { color: var(--ef-ink); font-size: 0.85rem; }
  .relay-control button { min-height: 44px; color: var(--ef-ink); border-color: color-mix(in srgb, var(--ef-ink) 45%, var(--ef-paper)); font-size: 0.72rem; }
  .relay-control button:hover { color: var(--surface-raised); }
  .relay :is(strong, b, [data-relay-point], [data-relay-guide-x], [data-relay-guide-y]) { transition-duration: var(--ef-motion-fast); transition-property: color, fill, stroke, transform; transition-timing-function: var(--ef-ease-standard); }
  .relay.is-resolving :is(strong, b) { color: var(--ef-signal); }
  .relay.is-resolving [data-relay-point] { fill: var(--ef-signal); }
  .relay.is-resolving :is([data-relay-guide-x], [data-relay-guide-y]) { stroke: var(--ef-signal); }
  @media (prefers-reduced-motion: reduce) { .relay * { transition: none !important; } }
</style>
