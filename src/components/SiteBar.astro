---
import "../styles/site-bar.css";
import Breadcrumbs from "./Breadcrumbs.astro";
import { PRIMARY, CONTACT, BOOK, withSlash } from "../data/navigation.mjs";

const { title, pathname = Astro.url.pathname } = Astro.props;
const pageTitle = typeof title === "string" ? title.replace(/\s*·\s*Ian Helfrich.*$/, "") : "";
---
<nav class="site-bar" data-surface="map" aria-label="Site">
  <a class="site-bar-name" href="/">Ian Helfrich</a>
  <Breadcrumbs title={pageTitle} pathname={pathname} inline />
  <div class="site-bar-links">
    {PRIMARY.map(({ label, href }) => <a href={withSlash(href)}>{label}</a>)}
    <a href="/field/">Map</a>
  </div>
  <div class="site-bar-actions">
    <a class="site-bar-book" href={withSlash(BOOK.href)}>{BOOK.label}</a>
    <a class="site-bar-contact" href={withSlash(CONTACT.href)}>{CONTACT.label}</a>
  </div>
</nav>
