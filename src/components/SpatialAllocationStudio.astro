---
const {
  id = "spatial-allocation-studio",
  headingLevel = "h2",
} = Astro.props;

const Heading = headingLevel;
const metricName = `${id}-metric`;
const boundaryId = `${id}-boundary`;

const regions = [
  { id: "R01", name: "North Fork", area: 52, count: 8 },
  { id: "R02", name: "Copper Basin", area: 84, count: 13 },
  { id: "R03", name: "Juniper Ridge", area: 121, count: 5 },
  { id: "R04", name: "Mesa East", area: 63, count: 15 },
  { id: "R05", name: "Arroyo North", area: 97, count: 2 },
  { id: "R06", name: "Silver Plain", area: 140, count: 10 },
  { id: "R07", name: "Cedar Wash", area: 75, count: 7 },
  { id: "R08", name: "Red Butte", area: 110, count: 4 },
  { id: "R09", name: "Dry Creek", area: 48, count: 11 },
  { id: "R10", name: "Granite South", area: 155, count: 3 },
  { id: "R11", name: "Cottonwood", area: 89, count: 6 },
  { id: "R12", name: "Echo Valley", area: 132, count: 9 },
];

const initialTotal = regions.reduce((sum, region) => sum + region.count, 0);
const initialBreaks = [2, 3, 5, 8, 11, 15];
const initialClass = (value) => {
  for (let index = 1; index < initialBreaks.length; index += 1) {
    if (value <= initialBreaks[index]) return index - 1;
  }
  return initialBreaks.length - 2;
};
const initialRanked = [...regions].sort((a, b) => b.count - a.count || a.id.localeCompare(b.id));
---

<section id={id} class="sa-studio" data-spatial-studio aria-labelledby={`${id}-title`}>
  <header class="sa-header">
    <div>
      <span class="sa-kicker">LAB 02 / SPATIAL ALLOCATION</span>
      <Heading id={`${id}-title`}>A count becomes a map.<br />A map becomes a choice.</Heading>
    </div>
    <div class="sa-intro">
      <p>
        Place synthetic site locations inside synthetic planning districts, then change the metric, classification rule, and boundary decision. The map, legend, ranking, and export share one state.
      </p>
      <p class="sa-data-note"><i aria-hidden="true"></i>DEMONSTRATION DATA / SYNTHETIC / {regions.length} DISTRICTS / {initialTotal} SITES</p>
    </div>
  </header>

  <div class="sa-workbench">
    <aside class="sa-controls" aria-label="Spatial allocation controls">
      <div class="sa-control-head">
        <span>CONTROL SURFACE</span>
        <button type="button" data-sa-reset>Reset</button>
      </div>

      <fieldset class="sa-fieldset">
        <legend><span>INPUT 01</span>Metric</legend>
        <label>
          <input type="radio" name={metricName} value="count" checked />
          <span><strong>Raw count</strong><small>Sites assigned to a district</small></span>
        </label>
        <label>
          <input type="radio" name={metricName} value="density" />
          <span><strong>Density</strong><small>Sites per 100 km²</small></span>
        </label>
        <label>
          <input type="radio" name={metricName} value="share" />
          <span><strong>Share</strong><small>Percent of assigned sites</small></span>
        </label>
      </fieldset>

      <label class="sa-select-control">
        <span><b>INPUT 02</b>Classification rule</span>
        <select data-sa-classification>
          <option value="equal">Equal interval</option>
          <option value="quantile">Quantile</option>
          <option value="natural" selected>Natural breaks</option>
        </select>
        <small>Five classes recalculate from the active metric.</small>
      </label>

      <div class="sa-boundary-control">
        <span><b>INPUT 03</b>Boundary case</span>
        <label class="sa-switch" for={boundaryId}>
          <input id={boundaryId} type="checkbox" data-sa-boundary />
          <span aria-hidden="true"><i></i></span>
          <strong>Move site 043 onto the shared edge</strong>
        </label>
        <label class="sa-boundary-rule">
          <span>Assignment rule</span>
          <select data-sa-boundary-rule disabled>
            <option value="north">Assign to North Fork</option>
            <option value="copper">Assign to Copper Basin</option>
            <option value="exclude">Exclude from district totals</option>
          </select>
        </label>
      </div>

      <dl class="sa-totals">
        <div><dt>Unique sites</dt><dd>{initialTotal}</dd></div>
        <div><dt>Assigned sites</dt><dd data-sa-assigned>{initialTotal}</dd></div>
        <div><dt>District area</dt><dd>{regions.reduce((sum, region) => sum + region.area, 0).toLocaleString()} km²</dd></div>
      </dl>
    </aside>

    <div class="sa-display">
      <div class="sa-map-head">
        <div>
          <span>ALLOCATION SURFACE / SYNTHETIC DISTRICTS</span>
          <strong data-sa-map-title>RAW COUNT / NATURAL BREAKS</strong>
        </div>
        <div class="sa-map-instructions">FOCUS A DISTRICT / USE ARROW KEYS</div>
      </div>

      <div class="sa-map-frame">
        <div class="sa-map-grid" role="group" aria-label="Synthetic planning districts colored by site allocation">
          {regions.map((region, index) => (
            <button
              type="button"
              class:list={["sa-region", index === 0 && "is-selected"]}
              data-sa-region
              data-region-id={region.id}
              data-region-name={region.name}
              data-region-area={region.area}
              data-region-count={region.count}
              data-class={initialClass(region.count)}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <span>{region.id}</span>
              <strong>{region.name}</strong>
              <output data-sa-region-value>{region.count}</output>
            </button>
          ))}
          <span class="sa-boundary-site" aria-hidden="true"><i></i><small>SITE 043</small></span>
          <span class="sa-north" aria-hidden="true"><b>N</b><i></i></span>
          <span class="sa-scale" aria-hidden="true"><i></i><b>25 km</b></span>
        </div>
      </div>

      <div class="sa-legend" aria-label="Map class legend">
        <span class="sa-legend-title">CLASS BREAKS</span>
        {Array.from({ length: 5 }, (_, index) => (
          <span class="sa-legend-item" data-sa-legend={index}><i data-class={index}></i><b>{initialBreaks[index]} to {initialBreaks[index + 1]}</b></span>
        ))}
      </div>

      <article class="sa-inspector" aria-live="polite">
        <div>
          <span>SELECTED DISTRICT</span>
          <strong data-sa-selected-title>R01 / NORTH FORK</strong>
        </div>
        <dl>
          <div><dt>Sites</dt><dd data-sa-selected-count>8</dd></div>
          <div><dt>Area</dt><dd data-sa-selected-area>52 km²</dd></div>
          <div><dt data-sa-selected-metric-label>Raw count</dt><dd data-sa-selected-metric>8</dd></div>
          <div><dt>Map class</dt><dd data-sa-selected-class>{initialClass(regions[0].count) + 1} / 5</dd></div>
        </dl>
      </article>
    </div>
  </div>

  <section class="sa-ranking" aria-labelledby={`${id}-ranking-title`}>
    <header>
      <div>
        <span>RANKED OUTPUT / ACTIVE STATE</span>
        <h3 id={`${id}-ranking-title`}>The table remains inspectable.</h3>
      </div>
      <div class="sa-output-actions">
        <button type="button" data-sa-download>Download current CSV</button>
        <span data-sa-download-status role="status"></span>
      </div>
    </header>

    <div class="sa-table-wrap" tabindex="0" role="region" aria-label="Ranked district allocation table">
      <table>
        <caption>Districts ranked by the active spatial metric</caption>
        <thead>
          <tr><th scope="col">Rank</th><th scope="col">District</th><th scope="col">Sites</th><th scope="col">Area km²</th><th scope="col" data-sa-table-metric>Raw count</th><th scope="col">Class</th></tr>
        </thead>
        <tbody data-sa-table-body>
          {initialRanked.map((region, index) => (
            <tr data-sa-row data-region-id={region.id}>
              <td data-sa-rank>{index + 1}</td>
              <th scope="row"><button type="button" data-sa-row-select>{region.id} / {region.name}</button></th>
              <td data-sa-row-count>{region.count}</td>
              <td>{region.area}</td>
              <td data-sa-row-metric>{region.count}</td>
              <td data-sa-row-class>{initialClass(region.count) + 1}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <footer class="sa-footer">
    <span data-sa-summary>METRIC / RAW COUNT · CLASSIFIER / NATURAL BREAKS · {initialTotal} SITES ASSIGNED</span>
    <span>POINT IN POLYGON / CLIENT-SIDE DEMONSTRATION</span>
    <a href="/start?problem=spatial&source=allocation-lab">Scope a spatial intelligence sprint →</a>
  </footer>

  <p class="sa-sr-only" data-sa-announcer aria-live="polite"></p>
</section>

<script is:inline>
  (() => {
    const CLASS_COUNT = 5;

    document.querySelectorAll("[data-spatial-studio]").forEach((studio) => {
      const regionButtons = Array.from(studio.querySelectorAll("[data-sa-region]"));
      const tableBody = studio.querySelector("[data-sa-table-body]");
      const tableRows = Array.from(studio.querySelectorAll("[data-sa-row]"));
      const metricInputs = Array.from(studio.querySelectorAll('input[type="radio"]'));
      const classification = studio.querySelector("[data-sa-classification]");
      const boundary = studio.querySelector("[data-sa-boundary]");
      const boundaryRule = studio.querySelector("[data-sa-boundary-rule]");
      const announcer = studio.querySelector("[data-sa-announcer]");
      const downloadStatus = studio.querySelector("[data-sa-download-status]");
      let selectedId = regionButtons[0]?.dataset.regionId || "R01";
      let currentRows = [];

      const baseRows = regionButtons.map((button) => ({
        id: button.dataset.regionId,
        name: button.dataset.regionName,
        area: Number(button.dataset.regionArea),
        baseCount: Number(button.dataset.regionCount),
      }));

      const metricLabel = (metric) => ({
        count: "Raw count",
        density: "Sites per 100 km²",
        share: "Share of assigned sites",
      })[metric];

      const classifierLabel = (rule) => ({
        equal: "Equal interval",
        quantile: "Quantile",
        natural: "Natural breaks",
      })[rule];

      const formatValue = (value, metric) => {
        if (metric === "count") return String(Math.round(value));
        if (metric === "density") return `${value.toFixed(1)} / 100 km²`;
        return `${value.toFixed(1)}%`;
      };

      const getMetric = () => studio.querySelector('input[type="radio"]:checked')?.value || "count";

      const getCounts = () => {
        const rows = baseRows.map((row) => ({ ...row, count: row.baseCount }));
        if (!boundary?.checked) return rows;
        const north = rows.find((row) => row.id === "R01");
        const copper = rows.find((row) => row.id === "R02");
        if (copper) copper.count -= 1;
        if (boundaryRule?.value === "north" && north) north.count += 1;
        if (boundaryRule?.value === "copper" && copper) copper.count += 1;
        return rows;
      };

      const quantileBreaks = (values, classes) => {
        const sorted = [...values].sort((a, b) => a - b);
        const breaks = [sorted[0]];
        for (let index = 1; index < classes; index += 1) {
          breaks.push(sorted[Math.max(0, Math.ceil(index * sorted.length / classes) - 1)]);
        }
        breaks.push(sorted[sorted.length - 1]);
        return breaks;
      };

      const equalBreaks = (values, classes) => {
        const minimum = Math.min(...values);
        const maximum = Math.max(...values);
        return Array.from({ length: classes + 1 }, (_, index) => minimum + (maximum - minimum) * index / classes);
      };

      const naturalBreaks = (values, requestedClasses) => {
        const data = [...values].sort((a, b) => a - b);
        const classes = Math.max(1, Math.min(requestedClasses, data.length));
        const lower = Array.from({ length: data.length + 1 }, () => Array(classes + 1).fill(0));
        const variance = Array.from({ length: data.length + 1 }, () => Array(classes + 1).fill(Infinity));

        for (let classIndex = 1; classIndex <= classes; classIndex += 1) {
          lower[1][classIndex] = 1;
          variance[1][classIndex] = 0;
        }

        for (let length = 2; length <= data.length; length += 1) {
          let sum = 0;
          let sumSquares = 0;
          let weight = 0;
          let currentVariance = 0;
          for (let offset = 1; offset <= length; offset += 1) {
            const lowerIndex = length - offset + 1;
            const value = data[lowerIndex - 1];
            weight += 1;
            sum += value;
            sumSquares += value * value;
            currentVariance = sumSquares - sum * sum / weight;
            const previousIndex = lowerIndex - 1;
            if (previousIndex > 0) {
              for (let classIndex = 2; classIndex <= classes; classIndex += 1) {
                const candidate = currentVariance + variance[previousIndex][classIndex - 1];
                if (candidate <= variance[length][classIndex]) {
                  lower[length][classIndex] = lowerIndex;
                  variance[length][classIndex] = candidate;
                }
              }
            }
          }
          lower[length][1] = 1;
          variance[length][1] = currentVariance;
        }

        const breaks = Array(classes + 1).fill(data[0]);
        breaks[classes] = data[data.length - 1];
        let classIndex = classes;
        let position = data.length;
        while (classIndex > 1) {
          const breakIndex = Math.max(0, lower[position][classIndex] - 2);
          breaks[classIndex - 1] = data[breakIndex];
          position = Math.max(1, lower[position][classIndex] - 1);
          classIndex -= 1;
        }
        return breaks;
      };

      const getBreaks = (values, rule) => {
        if (rule === "equal") return equalBreaks(values, CLASS_COUNT);
        if (rule === "quantile") return quantileBreaks(values, CLASS_COUNT);
        return naturalBreaks(values, CLASS_COUNT);
      };

      const getClassIndex = (value, breaks) => {
        for (let index = 1; index < breaks.length; index += 1) {
          if (value <= breaks[index] || index === breaks.length - 1) return index - 1;
        }
        return breaks.length - 2;
      };

      const selectRegion = (id, moveFocus = false, announce = false) => {
        selectedId = id;
        regionButtons.forEach((button) => {
          const selected = button.dataset.regionId === id;
          button.classList.toggle("is-selected", selected);
          button.setAttribute("aria-pressed", String(selected));
          if (selected && moveFocus) button.focus();
        });
        tableRows.forEach((row) => row.classList.toggle("is-selected", row.dataset.regionId === id));
        const row = currentRows.find((candidate) => candidate.id === id);
        if (!row) return;
        const set = (selector, value) => {
          const target = studio.querySelector(selector);
          if (target) target.textContent = value;
        };
        set("[data-sa-selected-title]", `${row.id} / ${row.name.toUpperCase()}`);
        set("[data-sa-selected-count]", String(row.count));
        set("[data-sa-selected-area]", `${row.area} km²`);
        set("[data-sa-selected-metric-label]", metricLabel(row.metric));
        set("[data-sa-selected-metric]", formatValue(row.value, row.metric));
        set("[data-sa-selected-class]", `${row.classIndex + 1} / ${CLASS_COUNT}`);
        if (announce && announcer) announcer.textContent = `${row.name} selected. ${row.count} sites. ${formatValue(row.value, row.metric)}.`;
      };

      const update = (announce = false) => {
        const metric = getMetric();
        const rule = classification?.value || "natural";
        const rows = getCounts();
        const assignedTotal = rows.reduce((sum, row) => sum + row.count, 0);
        rows.forEach((row) => {
          row.metric = metric;
          row.value = metric === "count"
            ? row.count
            : metric === "density"
              ? row.count / row.area * 100
              : assignedTotal > 0 ? row.count / assignedTotal * 100 : 0;
        });
        const breaks = getBreaks(rows.map((row) => row.value), rule);
        rows.forEach((row) => { row.classIndex = getClassIndex(row.value, breaks); });
        currentRows = rows;

        const byId = Object.fromEntries(rows.map((row) => [row.id, row]));
        regionButtons.forEach((button) => {
          const row = byId[button.dataset.regionId];
          if (!row) return;
          button.dataset.class = String(row.classIndex);
          const output = button.querySelector("[data-sa-region-value]");
          if (output) output.textContent = formatValue(row.value, metric);
          button.setAttribute("aria-label", `${row.id}, ${row.name}, ${formatValue(row.value, metric)}, map class ${row.classIndex + 1} of ${CLASS_COUNT}`);
        });

        studio.querySelectorAll("[data-sa-legend]").forEach((item, index) => {
          const lower = breaks[index];
          const upper = breaks[index + 1];
          const label = metric === "count"
            ? `${Math.round(lower)} to ${Math.round(upper)}`
            : `${lower.toFixed(1)} to ${upper.toFixed(1)}${metric === "share" ? "%" : ""}`;
          const text = item.querySelector("b");
          if (text) text.textContent = label;
        });

        const ranked = [...rows].sort((a, b) => b.value - a.value || a.id.localeCompare(b.id));
        ranked.forEach((row, index) => {
          const tableRow = tableRows.find((candidate) => candidate.dataset.regionId === row.id);
          if (!tableRow || !tableBody) return;
          tableBody.append(tableRow);
          tableRow.querySelector("[data-sa-rank]").textContent = String(index + 1);
          tableRow.querySelector("[data-sa-row-count]").textContent = String(row.count);
          tableRow.querySelector("[data-sa-row-metric]").textContent = formatValue(row.value, metric);
          tableRow.querySelector("[data-sa-row-class]").textContent = String(row.classIndex + 1);
        });

        const boundaryState = boundary?.checked
          ? boundaryRule?.value === "exclude"
            ? "boundary site excluded"
            : `boundary site assigned to ${boundaryRule?.value === "north" ? "North Fork" : "Copper Basin"}`
          : "boundary site inside Copper Basin";
        studio.classList.toggle("is-boundary", Boolean(boundary?.checked));
        if (boundaryRule) boundaryRule.disabled = !boundary?.checked;
        const set = (selector, value) => {
          const target = studio.querySelector(selector);
          if (target) target.textContent = value;
        };
        set("[data-sa-assigned]", String(assignedTotal));
        set("[data-sa-map-title]", `${metricLabel(metric).toUpperCase()} / ${classifierLabel(rule).toUpperCase()}`);
        set("[data-sa-table-metric]", metricLabel(metric));
        set("[data-sa-summary]", `METRIC / ${metricLabel(metric).toUpperCase()} · CLASSIFIER / ${classifierLabel(rule).toUpperCase()} · ${assignedTotal} SITES ASSIGNED`);
        selectRegion(selectedId);
        if (announce && announcer) announcer.textContent = `${metricLabel(metric)} displayed with ${classifierLabel(rule)}. ${assignedTotal} sites assigned. ${boundaryState}.`;
      };

      regionButtons.forEach((button, index) => {
        button.addEventListener("click", () => selectRegion(button.dataset.regionId, false, true));
        button.addEventListener("keydown", (event) => {
          let next = index;
          if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % regionButtons.length;
          else if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index - 1 + regionButtons.length) % regionButtons.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = regionButtons.length - 1;
          else return;
          event.preventDefault();
          selectRegion(regionButtons[next].dataset.regionId, true, true);
        });
      });

      tableRows.forEach((row) => {
        row.querySelector("[data-sa-row-select]")?.addEventListener("click", () => selectRegion(row.dataset.regionId, true, true));
      });

      metricInputs.forEach((input) => input.addEventListener("change", () => update(true)));
      classification?.addEventListener("change", () => update(true));
      boundary?.addEventListener("change", () => update(true));
      boundaryRule?.addEventListener("change", () => update(true));

      studio.querySelector("[data-sa-reset]")?.addEventListener("click", () => {
        const countInput = studio.querySelector('input[value="count"]');
        if (countInput) countInput.checked = true;
        if (classification) classification.value = "natural";
        if (boundary) boundary.checked = false;
        if (boundaryRule) boundaryRule.value = "north";
        selectedId = "R01";
        update(true);
        selectRegion(selectedId, true);
      });

      studio.querySelector("[data-sa-download]")?.addEventListener("click", () => {
        const metric = getMetric();
        const rule = classification?.value || "natural";
        const header = ["rank", "district_id", "district_name", "sites", "area_km2", "metric", "metric_value", "class", "classification", "boundary_state"];
        const ranked = [...currentRows].sort((a, b) => b.value - a.value || a.id.localeCompare(b.id));
        const boundaryState = boundary?.checked ? boundaryRule?.value : "inside_copper_basin";
        const lines = [header.join(","), ...ranked.map((row, index) => [
          index + 1,
          row.id,
          `"${row.name.replaceAll('"', '""')}"`,
          row.count,
          row.area,
          metric,
          row.value.toFixed(metric === "count" ? 0 : 3),
          row.classIndex + 1,
          rule,
          boundaryState,
        ].join(","))];
        const blob = new Blob([lines.join("\n")], { type: "text/csv;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `synthetic-spatial-allocation-${metric}-${rule}.csv`;
        document.body.append(link);
        link.click();
        link.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 1000);
        if (downloadStatus) downloadStatus.textContent = "Current allocation downloaded.";
      });

      update();
    });
  })();
</script>

<style>
  .sa-studio {
    --sa-ink: var(--ih-ink, #121426);
    --sa-bone: var(--ih-bone, #f2eade);
    --sa-paper: var(--ih-paper, #faf5ed);
    --sa-blue: var(--ih-blue, #2852e8);
    --sa-blue-dark: var(--ih-blue-dark, #193fbe);
    --sa-graphite: var(--ih-graphite, #30313d);
    --sa-muted: var(--ih-muted, #66636a);
    --sa-rule: var(--ih-rule, #c7bdb0);
    --sa-oxide: var(--ih-oxide, #ad4e35);
    --sa-serif: var(--ih-serif, "Source Serif 4", Georgia, serif);
    --sa-sans: var(--ih-sans, "Geist", system-ui, sans-serif);
    --sa-mono: var(--ih-mono, "Geist Mono", ui-monospace, monospace);
    color: var(--sa-ink);
    background: var(--sa-bone);
    border-block: 1px solid var(--sa-ink);
    font-family: var(--sa-sans);
  }

  .sa-studio *, .sa-studio *::before, .sa-studio *::after { box-sizing: border-box; }

  .sa-header {
    display: grid;
    max-width: 1460px;
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 4vw, 4rem);
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, .65fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
  }

  .sa-kicker,
  .sa-data-note,
  .sa-control-head,
  .sa-fieldset legend span,
  .sa-select-control > span,
  .sa-boundary-control > span,
  .sa-map-head,
  .sa-legend,
  .sa-inspector span,
  .sa-ranking header span,
  .sa-footer {
    font: 600 .6rem/1.4 var(--sa-mono);
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .sa-kicker { color: var(--sa-blue); }

  .sa-header h2, .sa-header h1 {
    max-width: 13ch;
    margin: 1.1rem 0 0;
    color: var(--sa-ink);
    font: 500 clamp(3rem, 6vw, 6.4rem)/.9 var(--sa-serif);
    letter-spacing: -.055em;
  }

  .sa-intro > p:first-child { margin: 0; color: var(--sa-graphite); font: 400 clamp(1rem, 1.4vw, 1.2rem)/1.55 var(--sa-serif); }
  .sa-data-note { margin: 2rem 0 0; padding-top: .9rem; color: var(--sa-muted); border-top: 1px solid var(--sa-rule); }
