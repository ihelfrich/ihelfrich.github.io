---
const lanes = [
  {
    key: "estimate",
    index: "01",
    label: "I do not trust the estimate",
    verb: "AUDIT",
    question: "Which decision inside the model is carrying the conclusion?",
    method: "Estimand · identification · specification · code · inference",
    artifact: "A decision map, annotated diagnostics, and a claim that stays inside the design.",
    firstMove: "Evidence diagnostic",
    proof: "The coefficient that lost 82.2% of its magnitude",
    proofHref: "/research/helfrich-2026-nmtc-rural-gap",
    startHref: "/start?problem=estimate",
  },
  {
    key: "interface",
    index: "02",
    label: "The data needs an interface",
    verb: "BUILD",
    question: "What must a reader be able to change, compare, and verify?",
    method: "Data model · analytical state · interaction · provenance · handoff",
    artifact: "A working evidence instrument with a public or internal surface and a documented source trail.",
    firstMove: "Data product sprint",
    proof: "Public laboratories, viewers, atlases, and teaching systems",
    proofHref: "/projects",
    startHref: "/start?problem=interface",
  },
  {
    key: "spatial",
    index: "03",
    label: "Place or networks are part of it",
    verb: "MAP",
    question: "Which distance, boundary, route, or aggregation changes the answer?",
    method: "GIS · remote sensing · networks · spatial econometrics · cartography",
    artifact: "A reproducible spatial analysis, decision map, data package, or interactive explorer.",
    firstMove: "Spatial intelligence sprint",
    proof: "A planned satellite-calibrated effective-distance panel",
    proofHref: "/research/gonchar-helfrich-2026-effective-distance-panel",
    startHref: "/start?problem=spatial",
  },
  {
    key: "team",
    index: "04",
    label: "The team needs a shared method",
    verb: "TRANSFER",
    question: "What judgment must remain after the workshop ends?",
    method: "Needs analysis · live cases · working instruments · practice · handoff",
    artifact: "A methods studio built around the team’s real models, data, and recurring decisions.",
    firstMove: "Team methods studio",
    proof: "Quantitative instruction from foundations through PhD practice",
    proofHref: "/teaching",
    startHref: "/start?problem=team",
  },
];

const cases = [
  {
    code: "CASE / 01",
    type: "ECONOMETRIC DIAGNOSIS",
    title: "The coefficient that changed the interpretation.",
    question: "Why did rural projects appear to mobilize less private capital?",
    intervention: "A five-model specification path exposed the intermediary identity hidden in the pooled comparison.",
    result: "82.2%",
    resultLabel: "of the raw coefficient disappears after CDE fixed effects",
    href: "/research/helfrich-2026-nmtc-rural-gap",
  },
  {
    code: "CASE / 02",
    type: "SPATIAL + NETWORK SYSTEM",
    title: "Distance that changes when the world changes.",
    question: "How should bilateral trade distance respond when population, infrastructure, and corridors move?",
    intervention: "The in-preparation design would combine population surfaces, nightlights, transport networks, and least-cost paths in an inspectable panel construction.",
    result: "PLAN",
    resultLabel: "coverage and validation remain to be verified",
    href: "/research/gonchar-helfrich-2026-effective-distance-panel",
  },
  {
    code: "CASE / 03",
    type: "INTERACTIVE EVIDENCE",
    title: "A method another person can operate.",
    question: "Can the explanation survive after the expert leaves the room?",
    intervention: "Working labs synchronize the equation, estimate, graphic, table, and sentence so every representation can be tested.",
    result: "OPEN",
    resultLabel: "tools and research instruments available for inspection",
    href: "/projects",
  },
];
---

<section class="studio-hero" data-studio-frontdoor data-active-lane="estimate" aria-labelledby="studio-title" data-rail-label="STUDIO FRONT DOOR">
  <div class="studio-hero__topline">
    <span>IAN T. S. HELFRICH / PHD ECONOMICS + MS GIS</span>
    <span>RESEARCH · EVIDENCE SYSTEMS · TRAINING</span>
    <span class="studio-hero__status"><i aria-hidden="true"></i>ST. LOUIS / WORKING WORLDWIDE</span>
  </div>

  <div class="studio-hero__grid">
    <article class="studio-hero__thesis">
      <span class="studio-kicker">THE EVIDENCE STUDIO</span>
      <h1 id="studio-title">I turn uncertain data into decisions people can <em>inspect</em> and defend.</h1>
      <p class="studio-hero__lead">
        Research design, econometrics, geospatial intelligence, interactive data products, and quantitative training from the estimand to the interface.
      </p>
      <div class="studio-hero__actions">
        <a class="studio-button" href="/start">Start with the problem <span aria-hidden="true">→</span></a>
        <a class="studio-link" href="/work">Explore selected work <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="studio-hero__availability" aria-label="Available engagements">
        <li>Research audit</li>
        <li>Data product sprint</li>
        <li>Spatial intelligence</li>
        <li>Team methods studio</li>
      </ul>
    </article>

    <div class="studio-router" aria-label="Choose the problem closest to yours">
      <header class="studio-router__head">
        <div><span>CLIENT INSTRUMENT / 00</span><strong>PROBLEM ROUTER</strong></div>
        <output data-router-counter>01 / 04</output>
      </header>

      <div class="studio-router__field">
        <div class="studio-router__signal" aria-hidden="true">
          <span class="signal-node signal-node--question">Q</span>
          <span class="signal-line signal-line--one"></span>
          <span class="signal-node signal-node--design">D</span>
          <span class="signal-line signal-line--two"></span>
          <span class="signal-node signal-node--model">θ</span>
          <span class="signal-line signal-line--three"></span>
          <span class="signal-node signal-node--artifact">A</span>
          <span class="signal-scan"></span>
        </div>
        <span class="studio-router__verb" data-router-verb>AUDIT</span>
        <div class="studio-router__readout" aria-live="polite">
          <span data-router-index>PROBLEM 01</span>
          <h2 data-router-question>Which decision inside the model is carrying the conclusion?</h2>
          <p data-router-method>Estimand · identification · specification · code · inference</p>
        </div>
      </div>

      <div class="studio-router__tabs" role="tablist" aria-label="Problem routes">
        {lanes.map((lane, index) => (
          <button
            id={`studio-route-${lane.key}`}
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
            class:list={[index === 0 && "is-active"]}
            data-route-key={lane.key}
          >
            <span>{lane.index}</span><strong>{lane.label}</strong>
          </button>
        ))}
      </div>

      <div class="studio-router__result">
        <div><span>RECOMMENDED FIRST MOVE</span><strong data-router-move>Evidence diagnostic</strong></div>
        <p data-router-artifact>A decision map, annotated diagnostics, and a claim that stays inside the design.</p>
        <div class="studio-router__links">
          <a href={lanes[0].startHref} data-router-start>Scope this problem →</a>
          <a href={lanes[0].proofHref} data-router-proof>{lanes[0].proof} ↗</a>
        </div>
      </div>
    </div>
  </div>

  <div class="studio-proof-rail" aria-label="Selected credentials and proof">
    <div><strong>PHD</strong><span>Economics · Georgia Tech · 2024</span></div>
    <div><strong>MS</strong><span>Geographic Information Science + Technology</span></div>
    <div><strong>1,003</strong><span>public Wyzant hours · Aug 2026</span></div>
    <div><strong>2023</strong><span>Georgia Tech Graduate TA of the Year</span></div>
    <div><strong>OPEN</strong><span>public tools with inspectable methods and source trails</span></div>
  </div>
</section>

<section class="studio-cases" aria-labelledby="studio-cases-title" data-rail-label="SELECTED CASES">
  <header class="studio-section-head">
    <div><span>01 / SELECTED CASES</span><h2 id="studio-cases-title">The work has an argument,<br />an instrument, and a trail.</h2></div>
    <p>Each case begins with a decision that the ordinary workflow could not settle. Open the analysis, inspect the artifact, and see what changed.</p>
  </header>

  <div class="studio-case-grid">
    {cases.map((item, index) => (
      <article class="studio-case" style={`--case-index:${index}`}>
        <header><span>{item.code}</span><small>{item.type}</small></header>
        <h3>{item.title}</h3>
        <dl>
          <div><dt>QUESTION</dt><dd>{item.question}</dd></div>
          <div><dt>INTERVENTION</dt><dd>{item.intervention}</dd></div>
        </dl>
        <div class="studio-case__result"><strong>{item.result}</strong><span>{item.resultLabel}</span></div>
        <a href={item.href}>Inspect the case <span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </div>
</section>

<script is:inline define:vars={{ lanes }}>
  (() => {
    document.querySelectorAll("[data-studio-frontdoor]").forEach((root) => {
      const tabs = Array.from(root.querySelectorAll("[data-route-key]"));
      const fields = {
        counter: root.querySelector("[data-router-counter]"),
        verb: root.querySelector("[data-router-verb]"),
        index: root.querySelector("[data-router-index]"),
        question: root.querySelector("[data-router-question]"),
        method: root.querySelector("[data-router-method]"),
        move: root.querySelector("[data-router-move]"),
        artifact: root.querySelector("[data-router-artifact]"),
        start: root.querySelector("[data-router-start]"),
        proof: root.querySelector("[data-router-proof]"),
      };
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const select = (index, moveFocus = false) => {
        const normalized = (index + lanes.length) % lanes.length;
        const lane = lanes[normalized];
        root.dataset.activeLane = lane.key;
        tabs.forEach((tab, tabIndex) => {
          const active = tabIndex === normalized;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", String(active));
          tab.setAttribute("tabindex", active ? "0" : "-1");
        });
        if (fields.counter) fields.counter.textContent = `${lane.index} / ${String(lanes.length).padStart(2, "0")}`;
        if (fields.verb) fields.verb.textContent = lane.verb;
        if (fields.index) fields.index.textContent = `PROBLEM ${lane.index}`;
        if (fields.question) fields.question.textContent = lane.question;
        if (fields.method) fields.method.textContent = lane.method;
        if (fields.move) fields.move.textContent = lane.firstMove;
        if (fields.artifact) fields.artifact.textContent = lane.artifact;
        if (fields.start) fields.start.href = lane.startHref;
        if (fields.proof) {
          fields.proof.href = lane.proofHref;
          fields.proof.textContent = `${lane.proof} ↗`;
        }
        if (!reducedMotion) {
          fields.question?.animate(
            [{ opacity: .15, transform: "translateY(10px)" }, { opacity: 1, transform: "translateY(0)" }],
            { duration: 320, easing: "cubic-bezier(.2,.8,.2,1)" },
          );
          fields.artifact?.animate([{ opacity: .25 }, { opacity: 1 }], { duration: 380, easing: "ease-out" });
        }
        if (moveFocus) tabs[normalized]?.focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(index));
        tab.addEventListener("keydown", (event) => {
          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            event.preventDefault();
            select(index + 1, true);
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            event.preventDefault();
            select(index - 1, true);
          } else if (event.key === "Home") {
            event.preventDefault();
            select(0, true);
          } else if (event.key === "End") {
            event.preventDefault();
            select(lanes.length - 1, true);
          }
        });
      });
    });
  })();
</script>

<style>
  .studio-hero,
  .studio-cases {
    --studio-blue: #2852e8;
    --studio-blue-deep: #1737a5;
    --studio-bone: #f2eade;
    --studio-paper: #faf5ed;
    --studio-ink: #121426;
    --studio-graphite: #30313d;
    --studio-muted: #66636a;
    --studio-rule: #c7bdb0;
    color: var(--studio-ink);
    background: var(--studio-bone);
  }

  .studio-hero {
    min-height: calc(100svh - 66px);
    border-bottom: 1px solid var(--studio-ink);
  }

  .studio-hero__topline {
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    min-height: 38px;
    align-items: center;
    border-bottom: 1px solid var(--studio-ink);
    font: 500 .58rem/1.2 var(--ih-mono);
    letter-spacing: .08em;
  }

  .studio-hero__topline > span {
    height: 100%;
    padding: .8rem clamp(1rem, 3vw, 3.5rem);
    border-right: 1px solid var(--studio-rule);
  }

  .studio-hero__topline > span:nth-child(2) { text-align: center; }
  .studio-hero__topline > span:last-child { border-right: 0; text-align: right; }
  .studio-hero__status i { display: inline-block; width: 6px; height: 6px; margin-right: .45rem; background: #2b9c6f; border-radius: 50%; }

  .studio-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(560px, 1.1fr);
    min-height: 720px;
  }

  .studio-hero__thesis {
    display: flex;
    padding: clamp(3.5rem, 7vw, 7.5rem) clamp(1.25rem, 5vw, 6.5rem) 3rem;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--studio-ink);
  }

  .studio-kicker,
  .studio-section-head > div > span {
    color: var(--studio-blue);
    font: 600 .66rem/1.2 var(--ih-mono);
    letter-spacing: .08em;
  }

  .studio-hero__thesis h1 {
    max-width: 820px;
    margin: 1.2rem 0 1.45rem;
    font: 500 clamp(3.2rem, 6.6vw, 7.5rem)/.88 var(--ih-display);
    letter-spacing: -.065em;
  }

  .studio-hero__thesis h1 em { color: var(--studio-blue); font-weight: 500; }

  .studio-hero__lead {
    max-width: 680px;
    color: var(--studio-graphite);
    font: 400 clamp(1.1rem, 1.7vw, 1.45rem)/1.42 var(--ih-serif);
  }

  .studio-hero__actions { display: flex; margin-top: 1.4rem; align-items: center; gap: 1.2rem; flex-wrap: wrap; }

  .studio-button {
    display: inline-flex;
    min-height: 52px;
    padding: 0 1.15rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem;
    color: white;
    background: var(--studio-blue);
    border: 1px solid var(--studio-blue);
    font: 600 .68rem/1 var(--ih-mono);
    letter-spacing: .06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .studio-button:hover { color: var(--studio-bone); background: var(--studio-ink); border-color: var(--studio-ink); }
  .studio-link { color: var(--studio-ink); font: 600 .72rem/1 var(--ih-mono); text-underline-offset: .35em; }

  .studio-hero__availability {
    display: flex;
    margin: auto 0 0;
    padding: 2rem 0 0;
    border-top: 1px solid var(--studio-rule);
    list-style: none;
    gap: .55rem;
    flex-wrap: wrap;
  }

  .studio-hero__availability li {
    margin: 0;
    padding: .4rem .55rem;
    color: var(--studio-muted);
    border: 1px solid var(--studio-rule);
    font: 500 .58rem/1 var(--ih-mono);
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .studio-router { display: grid; min-width: 0; grid-template-rows: auto minmax(300px, 1fr) auto auto; background: var(--studio-ink); color: var(--studio-bone); }

  .studio-router__head {
    display: flex;
    min-height: 58px;
    padding: 0 1.15rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(242, 234, 222, .24);
    font-family: var(--ih-mono);
  }

  .studio-router__head div { display: grid; gap: .2rem; }
  .studio-router__head span { color: var(--ih-smoke-blue); font-size: .54rem; letter-spacing: .08em; }
  .studio-router__head strong { color: var(--studio-bone); font-size: .67rem; letter-spacing: .05em; }
  .studio-router__head output { color: var(--studio-bone); font: 500 .62rem var(--ih-mono); }

  .studio-router__field { position: relative; min-height: 350px; overflow: hidden; border-bottom: 1px solid rgba(242, 234, 222, .24); isolation: isolate; }

  .studio-router__field::before,
  .studio-router__field::after {
    position: absolute;
    z-index: -1;
    content: "";
    pointer-events: none;
  }

  .studio-router__field::before {
    inset: 0;
    opacity: .22;
    background-image: linear-gradient(rgba(185, 192, 216, .2) 1px, transparent 1px), linear-gradient(90deg, rgba(185, 192, 216, .2) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .studio-router__field::after {
    width: 260px;
    height: 260px;
    top: 50%;
    left: 18%;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(40, 82, 232, .6);
    border-radius: 50%;
    box-shadow: 0 0 90px rgba(40, 82, 232, .18), inset 0 0 70px rgba(40, 82, 232, .12);
  }

  .studio-router__signal { position: absolute; top: 50%; left: 18%; width: 210px; height: 210px; transform: translate(-50%, -50%); }
  .signal-node { position: absolute; z-index: 2; display: grid; width: 38px; height: 38px; place-items: center; color: var(--studio-bone); background: var(--studio-ink); border: 1px solid rgba(242, 234, 222, .55); font: 600 .72rem var(--ih-mono); }
  .signal-node--question { top: 6px; left: 84px; }
  .signal-node--design { top: 84px; right: 6px; }
  .signal-node--model { right: 84px; bottom: 6px; }
  .signal-node--artifact { top: 84px; left: 6px; }
  .signal-line { position: absolute; z-index: 1; width: 88px; height: 1px; top: 104px; left: 61px; background: rgba(242, 234, 222, .45); transform-origin: center; }
  .signal-line--one { transform: rotate(45deg) translateY(-58px); }
  .signal-line--two { transform: rotate(-45deg) translateX(58px); }
  .signal-line--three { transform: rotate(45deg) translateY(58px); }
  .signal-scan { position: absolute; inset: 50px; border: 1px solid var(--studio-blue); transform: rotate(45deg); transition: transform 320ms ease, border-color 200ms ease; }
  [data-active-lane="interface"] .signal-scan { transform: rotate(90deg) scale(.72); }
  [data-active-lane="spatial"] .signal-scan { transform: rotate(135deg) scale(1.15); }
  [data-active-lane="team"] .signal-scan { transform: rotate(180deg) scale(.9); }

  .studio-router__verb { position: absolute; right: 1.2rem; bottom: -.1em; color: rgba(242, 234, 222, .055); font: 700 clamp(4.5rem, 10vw, 10rem)/.8 var(--ih-sans); letter-spacing: -.08em; pointer-events: none; }

  .studio-router__readout { position: absolute; z-index: 3; top: 50%; right: clamp(1.2rem, 4vw, 3.5rem); width: min(55%, 580px); transform: translateY(-50%); }
  .studio-router__readout > span { color: var(--ih-smoke-blue); font: 500 .59rem var(--ih-mono); letter-spacing: .08em; }
  .studio-router__readout h2 { margin: .75rem 0 1rem; color: var(--studio-bone); font: 500 clamp(1.9rem, 3.4vw, 3.7rem)/.98 var(--ih-serif); letter-spacing: -.045em; }
  .studio-router__readout p { color: var(--ih-smoke-blue); font: 500 .61rem/1.7 var(--ih-mono); letter-spacing: .03em; text-transform: uppercase; }

  .studio-router__tabs { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid rgba(242, 234, 222, .24); }
  .studio-router__tabs button { display: grid; min-height: 100px; padding: .8rem; align-content: start; gap: .65rem; color: var(--ih-smoke-blue); background: transparent; border: 0; border-right: 1px solid rgba(242, 234, 222, .16); cursor: pointer; text-align: left; }
  .studio-router__tabs button:last-child { border-right: 0; }
  .studio-router__tabs button span { font: 500 .54rem var(--ih-mono); }
  .studio-router__tabs button strong { color: inherit; font: 500 .68rem/1.3 var(--ih-sans); }
  .studio-router__tabs button:hover,
  .studio-router__tabs button.is-active { color: white; background: var(--studio-blue); }

  .studio-router__result { display: grid; grid-template-columns: .8fr 1.2fr; padding: 1rem 1.15rem; gap: 1rem 1.5rem; }
  .studio-router__result > div:first-child { display: grid; gap: .25rem; }
  .studio-router__result span { color: var(--ih-smoke-blue); font: 500 .52rem var(--ih-mono); letter-spacing: .07em; }
  .studio-router__result strong { color: var(--studio-bone); font: 500 1.05rem var(--ih-serif); }
  .studio-router__result p { margin: 0; color: var(--ih-smoke-blue); font: 400 .82rem/1.45 var(--ih-sans); }
  .studio-router__links { grid-column: 1 / -1; display: flex; padding-top: .8rem; justify-content: space-between; gap: 1rem; border-top: 1px solid rgba(242, 234, 222, .16); }
  .studio-router__links a { color: var(--studio-bone); font: 600 .58rem var(--ih-mono); text-underline-offset: .3em; }

  .studio-proof-rail { display: grid; grid-template-columns: repeat(5, 1fr); border-top: 1px solid var(--studio-ink); }
  .studio-proof-rail > div { display: grid; min-height: 94px; padding: 1rem clamp(.8rem, 2vw, 1.5rem); align-content: center; gap: .25rem; border-right: 1px solid var(--studio-rule); }
  .studio-proof-rail > div:last-child { border-right: 0; }
  .studio-proof-rail strong { color: var(--studio-blue); font: 600 clamp(1.35rem, 2.2vw, 2.25rem)/1 var(--ih-serif); }
  .studio-proof-rail span { color: var(--studio-muted); font: 500 .57rem/1.4 var(--ih-mono); letter-spacing: .03em; text-transform: uppercase; }

  .studio-cases { padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 4vw, 4rem); border-bottom: 1px solid var(--studio-ink); }
  .studio-section-head { display: grid; max-width: 1500px; margin: 0 auto 3rem; grid-template-columns: 1.35fr .65fr; gap: 2rem; align-items: end; }
  .studio-section-head h2 { margin: .75rem 0 0; font: 500 clamp(2.8rem, 5.5vw, 6.2rem)/.9 var(--ih-display); letter-spacing: -.055em; }
  .studio-section-head > p { max-width: 520px; margin: 0; color: var(--studio-graphite); font: 400 1.06rem/1.5 var(--ih-serif); }

  .studio-case-grid { display: grid; max-width: 1500px; margin: 0 auto; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--studio-ink); border-left: 1px solid var(--studio-ink); }
  .studio-case { position: relative; display: flex; min-height: 590px; padding: 1.25rem; flex-direction: column; border-right: 1px solid var(--studio-ink); border-bottom: 1px solid var(--studio-ink); overflow: hidden; }
  .studio-case::before { position: absolute; right: -2rem; bottom: -4.5rem; content: counter(case-counter, decimal-leading-zero); color: rgba(40, 82, 232, .055); font: 700 15rem/.8 var(--ih-sans); letter-spacing: -.12em; pointer-events: none; }
  .studio-case-grid { counter-reset: case-counter; }
  .studio-case { counter-increment: case-counter; }
