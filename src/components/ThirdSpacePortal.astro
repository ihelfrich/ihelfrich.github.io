  </footer>
</section>

<script is:inline>
  (() => {
    const rooms = {
      lab: {
        index: "01 / LAB",
        title: "A place to do the work.",
        copy: "Mentored research projects organized around consequential questions, credible methods, and the expectation that participants act as researchers—not assistants waiting at the edge of the room.",
        function: "Research development",
        audience: "Emerging and independent researchers",
        principle: "Students as principal researchers"
      },
      papers: {
        index: "02 / PAPERS",
        title: "A place for the work to travel.",
        copy: "An open publication path for careful, citable research that deserves an audience. The aim is a legible record of inquiry, method, revision, and contribution.",
        function: "Open research publication",
        audience: "Authors with serious work to share",
        principle: "Work shared in the open"
      },
      methods: {
        index: "03 / METHODS",
        title: "A place to learn how rigor is made.",
        copy: "Methods instruction, protocols, working examples, and reusable research infrastructure that expose the decisions hidden beneath polished results.",
        function: "Methods training and infrastructure",
        audience: "Researchers building technical command",
        principle: "Rigor without gatekeeping"
      },
      fellows: {
        index: "04 / FELLOWS",
        title: "A place to become the researcher already forming.",
        copy: "A mentored path for ambitious undergraduates, graduate students, and serious high-school researchers who are ready to move from consuming knowledge to producing it.",
        function: "Research apprenticeship",
        audience: "High school through graduate level",
        principle: "Independence over affiliation"
      }
    };

    document.querySelectorAll("[data-third-space-portal]").forEach((portal) => {
      const tabs = Array.from(portal.querySelectorAll("[data-ts-room]"));
      const mapRooms = Array.from(portal.querySelectorAll("[data-map-room]"));
      const panel = portal.querySelector("[role='tabpanel']");
      const fields = {
        index: portal.querySelector("[data-ts-index]"),
        title: portal.querySelector("[data-ts-title]"),
        copy: portal.querySelector("[data-ts-copy]"),
        function: portal.querySelector("[data-ts-function]"),
        audience: portal.querySelector("[data-ts-audience]"),
        principle: portal.querySelector("[data-ts-principle]")
      };

      const selectRoom = (key, moveFocus = false) => {
        const room = rooms[key];
        if (!room) return;
        portal.dataset.activeRoom = key;
        tabs.forEach((tab) => {
          const active = tab.dataset.tsRoom === key;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", String(active));
          tab.setAttribute("tabindex", active ? "0" : "-1");
          if (active && panel) panel.setAttribute("aria-labelledby", tab.id);
        });
        mapRooms.forEach((mapRoom) => mapRoom.classList.toggle("is-active", mapRoom.dataset.mapRoom === key));
        Object.entries(fields).forEach(([name, element]) => { if (element) element.textContent = room[name]; });
        if (moveFocus) tabs.find((tab) => tab.dataset.tsRoom === key)?.focus();
      };

      tabs.forEach((tab, tabIndex) => {
        tab.addEventListener("click", () => selectRoom(tab.dataset.tsRoom));
        tab.addEventListener("keydown", (event) => {
          let nextIndex = tabIndex;
          if (event.key === "ArrowRight" || event.key === "ArrowDown") nextIndex = (tabIndex + 1) % tabs.length;
          else if (event.key === "ArrowLeft" || event.key === "ArrowUp") nextIndex = (tabIndex - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") nextIndex = 0;
          else if (event.key === "End") nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          selectRoom(tabs[nextIndex].dataset.tsRoom, true);
        });
      });
    });
  })();
</script>
