        <g class="ts-map-room ts-map-room--lab is-active" data-map-room="lab"><circle cx="132" cy="132" r="10"></circle><text x="132" y="164" text-anchor="middle">LAB</text></g>
        <g class="ts-map-room ts-map-room--papers" data-map-room="papers"><circle cx="508" cy="132" r="10"></circle><text x="508" y="164" text-anchor="middle">PAPERS</text></g>
        <g class="ts-map-room ts-map-room--methods" data-map-room="methods"><circle cx="132" cy="338" r="10"></circle><text x="132" y="370" text-anchor="middle">METHODS</text></g>
        <g class="ts-map-room ts-map-room--fellows" data-map-room="fellows"><circle cx="508" cy="338" r="10"></circle><text x="508" y="370" text-anchor="middle">FELLOWS</text></g>
        <text class="ts-map-center-label" x="320" y="232" text-anchor="middle">THIRD</text>
