---
import 'leaflet/dist/leaflet.css';
import '../styles/water-atlas.css';
---
  <div class="water-atlas" id="atlas" aria-label="Hidden Rivers water atlas" data-lenis-prevent>
    <header class="atlas-header">
      <a class="atlas-wordmark" href="/" aria-label="Ian Helfrich, home">Hidden <em>Rivers</em><span>OCEAN ATLAS</span></a>
      <button class="place-trigger" id="atlas-browse" type="button" aria-expanded="false" aria-controls="atlas-places"><span id="atlas-place-name">Meeting of the Waters</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button>
      <div class="atlas-header-actions"><button type="button" id="atlas-stories">Stories</button><button type="button" id="atlas-info" aria-label="Data and sources">Data <span>↗</span></button><button type="button" id="atlas-present" aria-label="Start presentation">Present <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m8 0h5v-5"/></svg></button></div>
    </header>
    <nav class="atlas-tabs" aria-label="Hidden Rivers collections"><button type="button" data-atlas-tab="ocean" aria-pressed="true">Ocean currents</button><button type="button" data-atlas-tab="satellite" aria-pressed="false">Satellite &amp; PCA</button><button type="button" data-atlas-tab="prints" aria-pressed="false">Prints &amp; lessons</button><div class="atlas-view-switch" role="group" aria-label="Map view"><span>View</span><button id="atlas-view-world" type="button" aria-pressed="true">Globe</button><button id="atlas-view-flat" type="button" aria-pressed="false">Map</button><i aria-hidden="true"></i><button id="atlas-tilt" type="button" aria-label="Toggle tilted globe view">Tilt</button><button id="atlas-orbit" type="button" aria-pressed="false">Orbit</button></div></nav>
    <div class="atlas-viewport">
      <iframe id="atlas-prints" title="Ocean prints and lessons" hidden></iframe>
      <div id="atlas-map" aria-label="Interactive satellite map. Drag to pan, scroll or pinch to zoom; click to inspect data." tabindex="0" data-lenis-prevent></div>
      <div id="atlas-world" aria-label="Interactive Cesium ocean globe. Drag to rotate, scroll to zoom, right-drag to tilt; click to inspect data." tabindex="0" hidden></div>
      <aside id="atlas-story" class="atlas-story" hidden aria-label="Water story"><div class="story-top"><span id="atlas-story-series"></span><button id="atlas-story-read" class="story-read" type="button" aria-expanded="false">Read</button><button id="atlas-story-close" type="button" aria-label="Close story">×</button></div><h2 id="atlas-story-title"></h2><p id="atlas-story-text"></p><p id="atlas-story-key" class="story-key"></p><div class="story-navigation"><button id="atlas-story-back" type="button" aria-label="Previous story chapter">←</button><div id="atlas-story-dots"></div><button id="atlas-story-next" type="button" aria-label="Next story chapter">→</button></div><a id="atlas-story-source" target="_blank" rel="noopener">Read the source ↗</a></aside>
      <aside id="atlas-story-library" class="atlas-story-library" hidden aria-label="Choose a water story"><div class="places-heading"><h2>Hidden rivers</h2><button id="atlas-stories-close" type="button" aria-label="Close stories">×</button></div><div id="atlas-story-list"></div></aside>
      <aside id="atlas-inspector" class="atlas-inspector" hidden aria-label="Ocean velocity or sampled spectra"><div class="places-heading"><h2 id="atlas-inspector-title">Light returned by the water</h2><button id="atlas-inspector-close" type="button" aria-label="Close comparison">×</button></div><div id="atlas-spectra-chart"></div><p id="atlas-spectra-note"></p></aside>
      <aside id="atlas-places" class="atlas-places" aria-label="Choose a water system" hidden>
        <div class="places-heading"><h2>Explore the water</h2><button id="atlas-close-places" type="button" aria-label="Close places">×</button></div>
        <label class="place-search"><span class="sr-only">Search places</span><input id="atlas-search" type="search" placeholder="Find a river, reef or current…" autocomplete="off"/></label>
        <div class="place-filters" role="group" aria-label="Place type"><button data-group="all" aria-pressed="true" type="button">All</button><button data-group="Amazon basin" aria-pressed="false" type="button">Amazon</button><button data-group="Ocean currents" aria-pressed="false" type="button">Currents</button><button data-group="coasts" aria-pressed="false" type="button">Coasts & reefs</button></div>
        <div id="atlas-place-list"></div>
      </aside>
      <div class="atlas-place-caption"><p id="atlas-place-group">AMAZON BASIN</p><h1 id="atlas-title">Meeting of the Waters</h1><p id="atlas-note">The dark Rio Negro meets the sediment-rich Solimões east of Manaus.</p></div>
      <div class="atlas-map-tools" role="group" aria-label="Map navigation"><button type="button" id="atlas-zoom-in" aria-label="Zoom in">+</button><button type="button" id="atlas-zoom-out" aria-label="Zoom out">−</button><button type="button" id="atlas-fit" aria-label="Return to selected place" title="Fit place"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m8 0h5v-5M8 8h8v8H8z"/></svg></button><button type="button" id="atlas-world-home" aria-label="Show the world" title="World view"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c6 5 6 13 0 18-6-5-6-13 0-18z"/></svg></button></div>
      <div id="atlas-legend" class="atlas-legend" aria-label="Map layer legend"></div>
      <div id="atlas-depth-rail" class="atlas-depth-rail" role="group" aria-label="Available model depth slices" hidden></div>
      <button id="atlas-controls-toggle" class="atlas-controls-toggle" type="button" aria-expanded="false" aria-controls="atlas-controls">Layers & time ↑</button>
      <div class="atlas-bottom" id="atlas-controls">
        <div class="atlas-layer-row"><div id="atlas-layers" role="group" aria-label="Satellite and ocean layers"></div><label id="atlas-flow-label"><input id="atlas-flow" type="checkbox" checked/><span>River direction</span></label><label id="atlas-diagnostic-mode-label" hidden>Color by<select id="atlas-diagnostic-mode" aria-label="Current diagnostic"><option value="speed">Speed</option><option value="vorticity">Vorticity</option></select></label><label id="atlas-speed-shading-label" hidden><input id="atlas-speed-shading" type="checkbox"/><span>Speed shading</span></label><label id="atlas-subsurface-label" hidden><input id="atlas-subsurface" type="checkbox"/><span>Subsurface view</span></label><label id="atlas-depth-label" hidden>Depth<select id="atlas-depth" aria-label="Current depth"></select></label><label id="atlas-grid-label" hidden>Sampling<select id="atlas-grid" aria-label="Source sampling"><option value="native">Full grid · daily</option><option value="sampled">Sampled grid · original cadence</option></select></label><button id="atlas-compare" type="button" aria-pressed="false" hidden>Compare</button><button id="atlas-share" type="button" aria-label="Copy a link to this view" title="Share view">↗</button></div>
        <div class="atlas-time-row"><button id="atlas-play" type="button" aria-label="Pause flow"><svg class="atlas-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg><svg class="atlas-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z"/></svg></button><button id="atlas-previous" type="button" aria-label="Previous acquisition">‹</button><div class="atlas-date-control"><div><output id="atlas-date">Loading satellite scenes</output><span id="atlas-cadence">Dated observations</span></div><input id="atlas-time" type="range" min="0" max="2" value="0" step="1" aria-label="Acquisition date"/><div id="atlas-date-ticks"></div></div><button id="atlas-next" type="button" aria-label="Next acquisition">›</button><button id="atlas-cycle" type="button" aria-pressed="false" title="Play the available dated scenes">Time-lapse</button></div>
        <div id="atlas-spectral-controls" class="atlas-spectral-controls" hidden><label>Combination <select id="atlas-blend"><option value="brightness">PC1 · brightness</option><option value="contrast">PC1 + PC2 · contrast</option></select></label><div class="atlas-palettes" role="group" aria-label="Spectral color palette"><button type="button" data-palette="gold" aria-label="Indigo and gold" aria-pressed="true"><span class="palette-gold"></span>Indigo / gold</button><button type="button" data-palette="coral" aria-label="Teal and coral" aria-pressed="false"><span class="palette-coral"></span>Teal / coral</button><button type="button" data-palette="ice" aria-label="Violet and ice" aria-pressed="false"><span class="palette-ice"></span>Violet / ice</button></div></div>
        <p id="atlas-evidence" class="atlas-evidence">Copernicus Sentinel-2 · HydroRIVERS</p>
      </div>
      <div id="atlas-compare-slider" hidden><label>Satellite <input type="range" id="atlas-swipe" min="0" max="100" value="50" aria-label="Satellite comparison boundary"/> <span id="atlas-compare-name">PCA</span></label></div>
      <p class="atlas-navigation-hint" id="atlas-navigation-hint">Drag to explore · scroll or pinch to zoom</p>
      <div id="atlas-status" class="atlas-status" role="status">Loading satellite observations…</div>
      <div class="atlas-presentation-controls" hidden><button id="atlas-present-previous" type="button" aria-label="Previous place">‹</button><button id="atlas-present-pause" type="button" aria-label="Pause animation">Ⅱ</button><button id="atlas-present-next" type="button" aria-label="Next place">›</button><button id="atlas-present-exit" type="button" aria-label="Exit presentation">×</button></div>
    </div>
  </div>
  <dialog id="atlas-data" aria-labelledby="atlas-data-title"><div class="atlas-data-top"><h2 id="atlas-data-title">Data behind the map</h2><button id="atlas-close-info" type="button" aria-label="Close data and sources">×</button></div><div id="atlas-data-content"></div><p><button id="atlas-export" type="button">Save this map as PNG</button></p><p><a href="/hidden-rivers/prints/">Ocean folio · depth, vortices & density ↗</a></p><p><a href="/hidden-rivers/research/">Ocean calculations, films & print maps ↗</a></p></dialog>
  <noscript><style>.water-atlas{display:none}.water-atlas-page{overflow:auto}</style><p>This atlas needs JavaScript for map navigation. <a href="/hidden-rivers/research/">Open the static map collection.</a></p></noscript>
  <script>import { startWaterAtlas } from '../scripts/hidden-rivers/water-atlas.js';startWaterAtlas();</script>
