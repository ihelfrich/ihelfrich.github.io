---
import "../styles/global.css";
const { title, description, wide = false } = Astro.props;
const siteTitle = "Ian Helfrich";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const desc = description ?? "Applied causal inference, blended-finance research, and teaching by Dr. Ian Helfrich (PhD Economics, Georgia Tech 2024).";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={desc} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
  <title>{fullTitle}</title>
</head>
<body>
  <nav class="h-nav">
    <div class="h-nav-inner">
      <a href="/" class="h-nav-brand">Ian Helfrich</a>
      <div class="h-nav-links">
        <a href="/research">Research</a>
        <a href="/writing">Writing</a>
        <a href="/projects">Projects</a>
        <a href="/teaching">Teaching</a>
        <a href="/search">Search</a>
      </div>
    </div>
  </nav>

  <main class={wide ? "wide" : ""}>
    <slot />
  </main>

  <footer>
    © 2026 Dr. Ian Helfrich · <a href="https://github.com/ihelfrich">GitHub</a> · <a href="https://orcid.org/">ORCID</a> · <a href="/rss.xml">RSS</a> · CC-BY-SA 4.0
  </footer>
</body>
</html>
