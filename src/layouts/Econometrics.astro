---
import '../styles/tokens.css';
import '../styles/econometrics.css';
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import SiteBar from '../components/SiteBar.astro';
import Analytics from '../components/Analytics.astro';
import { THEME_COLOR } from '../data/theme.mjs';
const { title = 'The Econometric Argument', description = 'A course in applied econometrics and quantitative reasoning: build a claim, inspect its assumptions, and work out what the evidence permits.', section = 'course', noindex = false, image = '/og.png', imageAlt = 'Ian Helfrich: applied economist, quantitative research designer, and educator; NMTC raw and within-CDE estimates' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Social previews need a raster image; LinkedIn, Facebook and X do not render SVG.
const socialImage = new URL(image, Astro.site);
const path = Astro.url.pathname.replace(/\/+$/, '');
const isChapter = (await getCollection('econometrics')).some((chapter) => path === `/econometrics/${chapter.id}`);
---
<!doctype html>
<html lang="en" data-pagefind-ignore={noindex ? 'all' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content={THEME_COLOR.course} />
    <meta name="author" content="Ian Helfrich" />
    <title>{title} · Ian Helfrich</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} · Ian Helfrich`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={isChapter ? 'article' : 'website'} />
    <meta property="og:site_name" content="Ian Helfrich, PhD" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Ian Helfrich`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <Analytics />
  </head>
  <body class="ea" data-surface="course">
    <a class="ea-skip" href="#main-content">Skip to content</a>
    <SiteBar title={title} />
    <header class="ea-header">
      <a class="ea-brand" href="/econometrics/" aria-label="The Econometric Argument home"><span class="ea-mark" aria-hidden="true">∴</span><span>The Econometric<br /><strong>Argument</strong></span></a>
      <nav aria-label="Course navigation">
        <a href="/econometrics/#contents" aria-current={section === 'course' ? 'page' : undefined}>The book</a>
        <a href="/econometrics/lab/" aria-current={section === 'lab' ? 'page' : undefined}>Experiments</a>
        <a href="/econometrics/measurement/" aria-current={section === 'measurement' ? 'page' : undefined}>Measurement</a>
        <a href="/econometrics/teach/" aria-current={section === 'teach' ? 'page' : undefined}>Teach &amp; apply</a>
        <a href="/econometrics/readings/" aria-current={section === 'readings' ? 'page' : undefined}>Reading room</a>
      </nav>
      <a class="ea-author" href="/">Ian Helfrich <span>PhD ↗</span></a>
    </header>
    <main id="main-content">
      <slot />
      {isChapter && <div class="ea-reading-grid ea-help-row" data-pagefind-ignore><aside class="ea-help" aria-label="Tutoring"><p>Ian Helfrich tutors econometrics one-to-one, for students taking a course and for researchers designing a study. To arrange sessions on this chapter, start with a <a href="/book/#tutoring-intro" data-goatcounter-click="course-tutoring-intro">20-minute intro call</a>; the <a href="/teaching/">teaching page</a> lists the subjects he covers and the kinds of support.</p></aside></div>}
    </main>
    <footer class="ea-footer">
      <div><strong>The Econometric Argument</strong><p>Applied work. Explicit assumptions. Consequences you can explain.</p></div>
      <div><a href="/econometrics/edition/">Edition &amp; methods</a><a href="https://github.com/ihelfrich/ihelfrich.github.io/tree/main/src/content/econometrics">Read the source ↗</a><a href="/contact">Contact →</a></div>
      <p class="ea-small">Development edition · September 2026. Synthetic lab data. No account required.</p>
    </footer>
    <script>
      import { initializeReading } from '../scripts/econometrics-reading';
      initializeReading();
    </script>
    <script>
      // Wide equations and tables scroll in labelled, focusable boxes; see src/scripts/course-scroll.ts.
      import { initializeScrollBoxes } from '../scripts/course-scroll';
      initializeScrollBoxes();
    </script>
  </body>
</html>
