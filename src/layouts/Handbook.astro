---
import '../styles/tokens.css';
import '../styles/econometrics.css';
import '../styles/handbook.css';
import 'katex/dist/katex.min.css';
import {getCollection} from 'astro:content';
import SiteBar from '../components/SiteBar.astro';
import Analytics from '../components/Analytics.astro';
import { THEME_COLOR } from '../data/theme.mjs';
const {title='Econometrics Across Disciplines', description='Measurement, models, and decisions. A developing handbook with intuitive examples, complete proofs, and independently tested Python, Julia, and R calculations.', noindex=false, image='/og.png', imageAlt='Ian Helfrich: applied economist, quantitative research designer, and educator; NMTC raw and within-CDE estimates'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
// Social previews need a raster image; LinkedIn, Facebook and X do not render SVG.
const socialImage=new URL(image,Astro.site);
const path=Astro.url.pathname.replace(/\/+$/,'');
const isChapter=(await getCollection('handbook')).some(chapter=>path===`/handbook/${chapter.id}`);
---
<!doctype html>
<html lang="en" data-pagefind-ignore={noindex ? 'all' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content="Ian Helfrich" />
    <meta name="theme-color" content={THEME_COLOR.course} />
    <title>{title} · Ian Helfrich</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} · Ian Helfrich`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={isChapter?'article':'website'} />
    <meta property="og:site_name" content="Ian Helfrich, PhD" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Ian Helfrich`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <Analytics />
  </head>
  <body class="ea hb" data-surface="course">
    <a class="ea-skip" href="#main-content">Skip to content</a>
    <SiteBar title={title} />
    <header class="ea-header">
      <a class="ea-brand" href="/handbook/"><span class="ea-mark" aria-hidden="true">∑</span><span>Econometrics<br /><strong>Across Disciplines</strong></span></a>
      <nav aria-label="Handbook navigation">
        <a href="/handbook/#contents">Contents</a>
        <a href="/handbook/#reading-levels">Reading levels</a>
        <a href="/time-series/">Time-series course</a>
        <a href="/handbook/print/">Print &amp; source</a>
      </nav>
      <a class="ea-author" href="/">Ian Helfrich <span>PhD ↗</span></a>
    </header>
    <main id="main-content">
      <slot />
      {isChapter && <div class="ea-reading-grid ea-help-row" data-pagefind-ignore><aside class="ea-help" aria-label="Tutoring"><p>Ian Helfrich tutors econometrics one-to-one, for students taking a course and for researchers designing a study. To arrange sessions on this chapter, start with a <a href="/book/#tutoring-intro" data-goatcounter-click="course-tutoring-intro">20-minute intro call</a>; the <a href="/teaching/">teaching page</a> lists the subjects he covers and the kinds of support.</p></aside></div>}
    </main>
    <footer class="ea-footer">
      <div><strong>Econometrics Across Disciplines</strong><p>Measurement, models, and decisions.</p></div>
      <div><a href="/handbook/print/">Working PDF &amp; editable source</a><a href="/time-series/research/">Time-series source register</a><a href="https://github.com/ihelfrich/ihelfrich.github.io/tree/main/src/content/handbook">Manuscript source ↗</a></div>
      <p class="ea-small">Working edition · October 2026. © Ian Helfrich. All rights reserved. Cited works and bundled fonts retain their own terms.</p>
    </footer>
    <script>
      import { initializeScrollBoxes } from '../scripts/course-scroll';
      // Worked solutions sit behind a disclosure on screen; a printed copy shows them. After printing,
      // the disclosures the reader had closed close again.
      let openedForPrint: HTMLDetailsElement[] = [];
      window.addEventListener('beforeprint', () => {
        openedForPrint = [...document.querySelectorAll<HTMLDetailsElement>('.ea-prose details:not([open])')];
        openedForPrint.forEach((details) => { details.open = true; });
      });
      window.addEventListener('afterprint', () => {
        openedForPrint.forEach((details) => { details.open = false; });
        openedForPrint = [];
      });
      // Wide equations and tables scroll in labelled, focusable boxes; see src/scripts/course-scroll.ts.
      initializeScrollBoxes();
    </script>
  </body>
</html>
