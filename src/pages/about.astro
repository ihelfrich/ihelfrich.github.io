---
import Base from "../layouts/Base.astro";
import { tutoringRecord } from "../data/public-record.mjs";

const education = [
  ["2024", "PhD, Economics", "Georgia Institute of Technology", "Doctoral minor in Quantitative Psychology"],
  ["2022", "MS, Geographic Information Science and Technology", "Georgia Institute of Technology", ""],
  ["2019", "MS, Economics", "Georgia Institute of Technology", ""],
  ["2018", "MA, Economics", "Indiana University Bloomington", ""],
  ["2015", "MSc, Specialized Economic Analysis (Public Policy)", "Barcelona School of Economics", ""],
  ["2014", "BA, Economics", "University of North Carolina at Chapel Hill", ""],
] as const;
---

<Base
  wide
  title="About Ian Helfrich"
  description="Ian Helfrich is an economist, quantitative research designer, and educator working across trade, policy, measurement, spatial analysis, and learning systems."
  pageClass="fieldbook-about"
>
  <section class="about-hero route-grid" data-rail-label="About Ian">
    <div class="about-hero__copy">
      <p class="record-label">Biography</p>
      <h1>About Ian</h1>
      <p class="lead">My research has asked how a country should be located in a trade model, how AI-exposure scores should be tested after the fact, and whether a rural financing pattern survives comparison within the same intermediary.</p>
      <p>In teaching, I use the same discipline: move among words, equations, tables, graphs, and code until the logic is clear and internally consistent.</p>
    </div>
    <figure class="about-portrait">
      <img src="/people/ian-editorial.webp" alt="Portrait of Ian Helfrich" width="720" height="900" loading="eager" decoding="async" />
      <figcaption>Ian Helfrich · St. Louis, Missouri</figcaption>
    </figure>
  </section>

  <section class="about-practice route-shell" data-rail-label="Practice">
    <div class="narrative-grid">
      <div>
        <p class="record-label">Current practice</p>
        <h2>Applied economics, quantitative research design, and education</h2>
      </div>
      <div class="reading-column">
        <p>I am an applied economist and quantitative research designer based in St. Louis. My work combines empirical research, economic theory, spatial analysis, software, and teaching.</p>
        <p>Current projects include a sole-authored study of rural financing in the New Markets Tax Credit, out-of-time validation of AI-exposure measures, trade research using night lights and population, and public tools for quantitative learning.</p>
      </div>
    </div>
  </section>

  <section class="about-education route-band" data-rail-label="Education">
    <div class="route-shell route-shell--compact">
      <header class="section-intro">
        <div>
          <p class="record-label">Education</p>
          <h2>Economics, measurement, geography, and computation</h2>
        </div>
        <p>My formal training centers on economics and extends to quantitative psychology and geographic information science. The research and teaching pages show how I use those fields in practice.</p>
      </header>
      <div class="education-register">
        {education.map(([year, degree, institution, note]) => (
          <article data-fieldbook-reveal>
            <time>{year}</time>
            <div><h3>{degree}</h3>{note && <p>{note}</p>}</div>
            <p>{institution}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-teaching route-shell" data-rail-label="Teaching">
    <div class="narrative-grid">
      <div>
        <p class="record-label">Teaching and public practice</p>
        <h2>Institutional teaching and independent work</h2>
      </div>
      <div class="reading-column">
        <p>I have taught as instructor of record at Georgia Tech, supported teaching at Duke and Indiana, taught online microeconomics and macroeconomics, and worked independently with learners and researchers.</p>
        <p>Current tutoring figures and the complete institutional chronology appear on <a href="/teaching">Teaching &amp; Coaching</a>; Wyzant and private-practice hours are reported separately.</p>
      </div>
    </div>
  </section>

  <section class="about-service route-band" id="service" data-rail-label="Leadership and service">
    <div class="route-shell route-shell--compact">
      <header class="section-intro">
        <div>
          <p class="record-label">Leadership and service</p>
          <h2>Leadership, contribution, awards, and academic service</h2>
        </div>
        <p>These entries state the role, date, and documented scope of each appointment or contribution.</p>
      </header>
      <dl class="service-ledger">
        <div>
          <dt>National Network for Critical Technology Assessment</dt>
          <dd>Additional contributor to the semiconductor demonstration in the 2023 report <cite>Securing America's Future</cite>; not an author of the full report.</dd>
        </div>
        <div>
          <dt>Georgia Tech Graduate Student Government</dt>
          <dd>Vice President for Campus Services, 2019–20; Graduate Senator, 2018–20; Senator of the Year, 2020.</dd>
        </div>
        <div>
          <dt>Teaching leadership</dt>
          <dd>Inaugural Graduate Teaching Fellow cohort, 2018–19; designed professional-development curriculum and co-led orientation.</dd>
        </div>
        <div>
          <dt>Teaching award</dt>
          <dd>Georgia Tech Economics Graduate Teaching Assistant of the Year, 2023.</dd>
        </div>
        <div>
          <dt>Academic service</dt>
          <dd>Ad hoc referee, Journal of Economic Theory.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="about-close route-grid" data-rail-label="Explore the record">
    <div>
      <p class="record-label">Continue</p>
      <h2>Explore the work, research, teaching, and full career record.</h2>
    </div>
    <nav aria-label="About page next steps">
      <a href="/work">Selected work →</a>
      <a href="/research">Research →</a>
      <a href="/teaching">Teaching &amp; coaching →</a>
      <a href="/cv">CV &amp; contact →</a>
    </nav>
  </section>
</Base>

<style>
  .route-shell { width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; padding-block: var(--ef-space-7); }
  .route-shell--compact { padding-block: 0; }
  .route-grid { display: grid; width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--ef-gutter); }
  .route-band { padding-block: var(--ef-space-7); background: var(--ef-figure); border-block: 1px solid var(--ef-ink); }
  .record-label { margin: 0 0 0.7rem; color: var(--muted); font: 620 0.7rem/1.45 var(--font-data); letter-spacing: 0.07em; text-transform: uppercase; }
  .about-hero { min-height: 43rem; padding-block: var(--ef-space-7); align-items: end; border-bottom: 1px solid var(--ef-ink); }
  .about-hero__copy { grid-column: 2 / span 6; }
  .about-hero__copy h1 { margin-bottom: 1.5rem; }
  .about-hero__copy .lead { max-width: 57ch; font-size: clamp(1.35rem, 2.4vw, 2rem); line-height: 1.35; }
  .about-hero__copy > p:last-child { max-width: 55ch; }
  .about-portrait { grid-column: 9 / span 3; margin: 0; }
  .about-portrait img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: saturate(0.82) contrast(1.02); }
  .about-portrait figcaption { padding-top: 0.5rem; font: 560 0.68rem/1.4 var(--font-data); }
  .narrative-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(20rem, 1.35fr); gap: var(--ef-space-7); }
  .narrative-grid h2 { margin: 0; }
  .reading-column { max-width: 62ch; font-size: 1.16rem; }
  .section-intro { display: grid; grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr); gap: var(--ef-space-6); align-items: end; }
  .section-intro h2 { margin: 0; }
  .section-intro > p { margin: 0; }
  .education-register { margin-top: var(--ef-space-6); border-top: 1px solid var(--ef-ink); }
  .education-register article { display: grid; padding-block: 1.1rem; grid-template-columns: 5rem minmax(0, 1.5fr) minmax(14rem, 1fr); gap: var(--ef-space-4); border-bottom: 1px solid var(--rule); }
  .education-register time { color: var(--ef-signal); font: 600 0.74rem/1.5 var(--font-data); }
  .education-register h3 { margin: 0; font-size: 1.18rem; }
  .education-register p { margin: 0.25rem 0 0; }
  .service-ledger { margin-top: var(--ef-space-6); border-top: 1px solid var(--ef-ink); }
  .service-ledger > div { display: grid; padding-block: 1.15rem; grid-template-columns: minmax(14rem, 1fr) minmax(0, 2fr); gap: var(--ef-space-5); border-bottom: 1px solid var(--rule); }
  .service-ledger dt { font: 650 0.72rem/1.45 var(--font-data); text-transform: uppercase; }
  .service-ledger dd { margin: 0; }
  .about-close { padding-block: var(--ef-space-7); }
  .about-close > div { grid-column: 2 / span 7; }
  .about-close h2 { margin: 0; }
  .about-close nav { display: grid; grid-column: 9 / span 3; align-content: end; gap: 0.7rem; font: 620 0.74rem/1.4 var(--font-data); text-transform: uppercase; }
  @media (max-width: 60rem) {
    .about-hero__copy { grid-column: 1 / span 5; }
    .about-portrait { grid-column: 6 / span 3; }
    .section-intro { grid-template-columns: 1fr; }
    .about-close > div { grid-column: 1 / span 5; }
    .about-close nav { grid-column: 6 / span 3; }
  }
  @media (max-width: 45rem) {
    .route-grid { display: block; }
    .about-hero { min-height: auto; }
    .about-portrait { max-width: 22rem; margin-top: var(--ef-space-5); }
    .route-shell { padding-block: var(--ef-space-6); }
    .narrative-grid { grid-template-columns: 1fr; gap: var(--ef-space-5); }
    .education-register article,
    .service-ledger > div { grid-template-columns: 1fr; gap: 0.45rem; }
    .about-close nav { margin-top: var(--ef-space-5); }
  }
</style>
