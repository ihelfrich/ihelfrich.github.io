---
import Base from "../layouts/Base.astro";
import { tutoringRecord } from "../data/public-record.mjs";
---

<Base
  wide
  noindex
  excludeFromSearch
  title="Capabilities have moved"
  description="Selected work now provides the canonical evidence-based account of Ian Helfrich's applied research, quantitative, and teaching practice."
>
  <section class="compatibility-page">
    <p class="record-label">Updated site route</p>
    <h1>Capabilities are easier to assess through completed records.</h1>
    <p>The current site organizes applied research, measurement, policy and spatial work, and quantitative learning systems as cases with a question, role, result or status, artifact, and limit.</p>
    <p class="source-note">Teaching evidence is maintained separately from the case index and is current as of {tutoringRecord.asOf}.</p>
    <a class="fieldbook-action" href="/work">Continue to selected work</a>
  </section>
</Base>

<style>
  .compatibility-page { width: min(calc(100% - 2 * var(--ef-edge)), 70rem); min-height: calc(100vh - 4.5rem); margin-inline: auto; padding-block: var(--ef-space-8); }
  .record-label { margin: 0 0 0.7rem; color: var(--muted); font: 620 0.7rem/1.45 var(--font-data); letter-spacing: 0.07em; text-transform: uppercase; }
  .compatibility-page h1 { max-width: 12ch; }
  .compatibility-page > p:not(.record-label) { max-width: 60ch; font-size: 1.2rem; }
  .compatibility-page .source-note { color: var(--muted); font: 560 0.75rem/1.5 var(--font-data); }
  .fieldbook-action { display: inline-flex; min-height: 48px; margin-top: 1rem; padding: 0.8rem 1rem; align-items: center; color: var(--ef-figure); background: var(--ef-signal); border: 1px solid var(--ef-signal); border-radius: var(--ef-control-radius); font: 650 0.72rem/1 var(--font-data); text-decoration: none; text-transform: uppercase; }
  .fieldbook-action:hover { color: var(--ef-figure); background: var(--ef-ink); border-color: var(--ef-ink); }
</style>
