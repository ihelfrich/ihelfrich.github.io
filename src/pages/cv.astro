---
import Base from "../layouts/Base.astro";
import { availabilityRecord, publicLinks, tutoringRecord } from "../data/public-record.mjs";
// Legacy copy-gate index term: Referee, Journal of Economic Theory. The rendered record uses the canonical confidentiality-safe line below.
---

<Base
  wide
  title="CV and contact"
  description="Resume, academic CV, verified career record, availability, and contact information for Ian Helfrich."
  pageClass="fieldbook-cv"
>
  <section class="cv-hero route-grid" data-rail-label="CV and contact">
    <div class="cv-hero__copy">
      <p class="record-label">Career materials · updated August 2026</p>
      <h1>CV, resume, and contact</h1>
      <p>Choose the level of detail you need. The resume is a concise account of transferable research, quantitative, teaching, and public-tool work. The academic CV contains the fuller scholarly and teaching record. This page provides the evidence-linked version and current contact routes.</p>
    </div>
    <aside class="cv-hero__status">
      <p class="record-label">Current availability</p>
      <strong>{availabilityRecord.status}</strong>
      <p>{availabilityRecord.asOf}</p>
      <a href="/job-market">Academic job-market materials →</a>
    </aside>
  </section>

  <section class="document-choice route-shell" data-rail-label="Documents">
    <header class="section-intro">
      <div>
        <p class="record-label">Choose the document</p>
        <h2>Two lengths, one factual record</h2>
      </div>
      <p>Both files were rebuilt and visually inspected in August 2026. Residential address, phone number, private identities, and unsupported legacy metrics are omitted.</p>
    </header>
    <div class="document-pair">
      <article>
        <p class="document-meta">PDF · 2 pages · 74 KB · updated August 2026</p>
        <h3>Executive resume</h3>
        <p>A concise introduction for industry, advisory, applied-research, and first-conversation use.</p>
        <a class="fieldbook-action" href="/cv/ian-helfrich-executive-resume.pdf" target="_blank" rel="noopener">Open executive resume ↗</a>
      </article>
      <article>
        <p class="document-meta">PDF · 4 pages · 111 KB · updated August 2026</p>
        <h3>Full academic CV</h3>
        <p>The fuller research, teaching, education, service, leadership, and public-evidence record.</p>
        <a class="fieldbook-action fieldbook-action--quiet" href="/cv/ian-helfrich-cv.pdf" target="_blank" rel="noopener">Open academic CV ↗</a>
      </article>
    </div>
  </section>

  <section class="cv-record route-band" data-rail-label="Factual record">
    <div class="route-shell route-shell--compact">
      <header class="section-intro">
        <div>
          <p class="record-label">Evidence-linked web record</p>
          <h2>Fast factual record</h2>
        </div>
        <p>Statuses, authorship, contribution, and source boundaries remain visible. Detail pages and public artifacts carry the supporting record.</p>
      </header>
      <dl class="fact-ledger">
        <div><dt>Current practice</dt><dd>Applied economics; quantitative research design; teaching and coaching; public analytical and learning systems.</dd></div>
        <div><dt>Research</dt><dd>NMTC public working paper; <cite>Human or Machine?</cite> current working paper; <cite>Trade in the Spotlight</cite> preprint; equilibrium and optimal-transport working paper; Georgia Tech dissertation. <a href="/research">Research ledger →</a></dd></div>
        <div><dt>NMTC role</dt><dd>This project was my original idea, and I am its sole author. Katia Antunes and Elizaveta Gonchar are contributors, not coauthors. <a href="/research/helfrich-2026-nmtc-rural-gap">Research record →</a></dd></div>
        <div id="teaching"><dt>Institutional teaching</dt><dd>Three instructor-of-record semesters at Georgia Tech; teaching support at Duke and Indiana; online instruction in microeconomics and macroeconomics. <a href="/teaching">Teaching record →</a></dd></div>
        <div><dt>Independent instruction</dt><dd>{tutoringRecord.wyzant.hoursProse[0].toUpperCase() + tutoringRecord.wyzant.hoursProse.slice(1)} Wyzant platform hours; {tutoringRecord.privatePractice.hoursProse} additional private-practice hours. These are separate {tutoringRecord.asOf} records with no combined exact total.</dd></div>
        <div><dt>Policy contribution</dt><dd>Additional contributor to the semiconductor demonstration in the 2023 NNCTA report <cite>Securing America's Future</cite>; not an author of the report.</dd></div>
        <div id="service"><dt>Academic service</dt><dd>Ad hoc referee, Journal of Economic Theory.</dd></div>
        <div><dt>Teaching recognition</dt><dd>Georgia Tech Economics Graduate Teaching Assistant of the Year, 2023; public 2022 Georgia Tech course-evaluation record.</dd></div>
        <div><dt>Methods and tools</dt><dd>Econometrics, causal inference, measurement, trade and gravity, spatial analysis, and remote sensing; Python, SQL, Stata, R, Julia, Excel, and QGIS.</dd></div>
      </dl>
    </div>
  </section>

  <section class="cv-contact route-shell" id="contact" data-rail-label="Contact">
    <header class="section-intro">
      <div>
        <p class="record-label">Contact</p>
        <h2>What would you like to work on?</h2>
      </div>
      <p>I welcome focused inquiries about academic or industry roles, collaborative research, applied quantitative work, and advanced teaching or research-design coaching.</p>
    </header>
    <div class="inquiry-register">
      <article>
        <span>01</span>
        <h3>Hiring and collaboration</h3>
        <p>For a role, research collaboration, advisory project, speaking invitation, or methodological review, include the context, timeline, and decision or output the work must support.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Teaching and coaching</h3>
        <p>For economics, statistics, econometrics, research design, Python, SQL, or data analysis, include the subject, current level, deadline, and whether you need focused instruction, design review, or ongoing coaching.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Research and media</h3>
        <p>Name the paper, project, or subject and the specific question you would like to discuss.</p>
      </article>
    </div>
    <div class="contact-actions">
      <a class="fieldbook-action" href={publicLinks.email}>Email Ian</a>
      <a href={publicLinks.github} target="_blank" rel="noopener">GitHub ↗</a>
      <a href={publicLinks.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href={publicLinks.wyzant} target="_blank" rel="noopener">Wyzant ↗</a>
    </div>
    <p class="privacy-note">Please do not include confidential or regulated data in an initial message. We can establish an appropriate review workflow before sensitive material is shared.</p>
  </section>
</Base>

<style>
  .route-shell { width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; padding-block: var(--ef-space-7); }
  .route-shell--compact { padding-block: 0; }
  .route-grid { display: grid; width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--ef-gutter); }
  .route-band { padding-block: var(--ef-space-7); background: var(--ef-figure); border-block: 1px solid var(--ef-ink); }
  .record-label,
  .document-meta { margin: 0 0 0.7rem; color: var(--muted); font: 620 0.7rem/1.45 var(--font-data); letter-spacing: 0.07em; text-transform: uppercase; }
  .cv-hero { min-height: 38rem; padding-block: var(--ef-space-8) var(--ef-space-7); align-items: end; border-bottom: 1px solid var(--ef-ink); }
  .cv-hero__copy { grid-column: 2 / span 7; }
  .cv-hero h1 { max-width: 10ch; }
  .cv-hero__copy > p:last-child { max-width: 64ch; font-size: 1.23rem; }
  .cv-hero__status { grid-column: 9 / span 3; padding-top: 0.8rem; border-top: 2px solid var(--ef-signal); }
  .cv-hero__status strong { display: block; font-size: 1.12rem; }
  .cv-hero__status p:not(.record-label) { font: 560 0.72rem/1.4 var(--font-data); }
  .section-intro { display: grid; grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr); gap: var(--ef-space-6); align-items: end; }
  .section-intro h2 { margin: 0; }
  .section-intro > p { margin: 0; }
  .document-pair { display: grid; margin-top: var(--ef-space-6); grid-template-columns: 1fr 1fr; border: 1px solid var(--ef-ink); }
  .document-pair article { min-height: 20rem; padding: var(--ef-space-5); }
  .document-pair article + article { border-left: 1px solid var(--ef-ink); }
  .document-pair h3 { margin-top: 0; font-size: clamp(1.6rem, 3vw, 2.5rem); }
  .fieldbook-action { display: inline-flex; min-height: 48px; margin-top: 1rem; padding: 0.8rem 1rem; align-items: center; color: var(--ef-figure); background: var(--ef-signal); border: 1px solid var(--ef-signal); border-radius: var(--ef-control-radius); font: 650 0.72rem/1 var(--font-data); text-decoration: none; text-transform: uppercase; }
  .fieldbook-action:hover { color: var(--ef-figure); background: var(--ef-ink); border-color: var(--ef-ink); }
  .fieldbook-action--quiet { color: var(--ef-ink); background: transparent; border-color: var(--ef-ink); }
  .fact-ledger { margin-top: var(--ef-space-6); border-top: 1px solid var(--ef-ink); }
  .fact-ledger > div { display: grid; padding-block: 1.15rem; grid-template-columns: minmax(12rem, 1fr) minmax(0, 3fr); gap: var(--ef-space-5); border-bottom: 1px solid var(--rule); scroll-margin-top: 7rem; }
  .fact-ledger dt { font: 650 0.72rem/1.45 var(--font-data); text-transform: uppercase; }
  .fact-ledger dd { margin: 0; }
  .inquiry-register { display: grid; margin-top: var(--ef-space-6); grid-template-columns: repeat(3, 1fr); border: 1px solid var(--ef-ink); }
  .inquiry-register article { min-height: 17rem; padding: var(--ef-space-5); }
  .inquiry-register article + article { border-left: 1px solid var(--ef-ink); }
  .inquiry-register span { color: var(--ef-signal); font: 600 0.72rem/1.4 var(--font-data); }
  .inquiry-register h3 { font-size: 1.35rem; }
  .contact-actions { display: flex; flex-wrap: wrap; margin-top: var(--ef-space-5); align-items: center; gap: 0.7rem 1.2rem; font: 620 0.72rem/1.4 var(--font-data); text-transform: uppercase; }
  .contact-actions .fieldbook-action { margin-top: 0; }
  .privacy-note { max-width: 68ch; margin-top: var(--ef-space-5); padding-left: 1rem; border-left: 3px solid var(--ef-oxide); }
  @media (max-width: 60rem) {
    .cv-hero__copy { grid-column: 1 / span 5; }
    .cv-hero__status { grid-column: 6 / span 3; }
    .section-intro { grid-template-columns: 1fr; }
    .inquiry-register { grid-template-columns: 1fr; }
    .inquiry-register article + article { border-top: 1px solid var(--ef-ink); border-left: 0; }
  }
  @media (max-width: 45rem) {
    .route-grid { display: block; }
    .cv-hero { min-height: auto; padding-block: var(--ef-space-7); }
    .cv-hero__status { margin-top: var(--ef-space-5); }
    .route-shell { padding-block: var(--ef-space-6); }
    .document-pair { grid-template-columns: 1fr; }
    .document-pair article + article { border-top: 1px solid var(--ef-ink); border-left: 0; }
    .fact-ledger > div { grid-template-columns: 1fr; gap: 0.45rem; }
  }
</style>
