---
import Base from "../../layouts/Base.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const datasets = await getCollection("datasets");
  return datasets.map(d => ({ params: { slug: d.id } }));
}

const { slug } = Astro.params;
const dataset = await getEntry("datasets", slug);
const { Content } = await render(dataset);
---
<Base wide pageClass="record-page record-data" title={dataset.data.title} description={dataset.data.blurb}>
  <article class="h-article">
    <header>
      <div class="record-topline"><a href="/library">PUBLIC INDEX</a><span>DATASET · {dataset.data.year}</span><span><i></i>{dataset.data.status}</span></div>
      <div class="h-article-meta">{dataset.data.license}{dataset.data.size ? ` · ${dataset.data.size}` : ""}</div>
      <h1>{dataset.data.title}</h1>
      <p class="record-authors">{dataset.data.authors.join(" · ")}</p>
      <p class="record-deck">{dataset.data.blurb}</p>
      <div class="record-actions">
        {dataset.data.doi && <a href={`https://doi.org/${dataset.data.doi}`} target="_blank" rel="noopener">DOI →</a>}
        {dataset.data.zenodo && <a href={dataset.data.zenodo} target="_blank" rel="noopener">Zenodo →</a>}
        {dataset.data.repo && <a href={dataset.data.repo} target="_blank" rel="noopener">Source code →</a>}
        {dataset.data.viewer && <a href={dataset.data.viewer} target="_blank" rel="noopener">Viewer →</a>}
      </div>
      {dataset.data.citation && (
        <div class="record-citation"><strong>CITE AS</strong><span>{dataset.data.citation}</span></div>
      )}
    </header>
    <div class="record-body"><Content /></div>
    <footer class="record-end"><span>END OF DATA RECORD</span><a href="/datasets">All datasets →</a><a href="/library">Complete public index →</a></footer>
  </article>
</Base>
