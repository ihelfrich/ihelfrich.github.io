---
import Base from '../layouts/Base.astro';
import ResearchContinuum from '../components/ResearchContinuum.astro';
import HomepageInstruments from '../components/HomepageInstruments.astro';
import VisitorPath from '../components/VisitorPath.astro';
import HomeGraph from '../components/HomeGraph.astro';
import TechnicalProjects from '../components/TechnicalProjects.astro';
import Portrait from '../components/Portrait.astro';
import NmtcCoefficientFigure from '../components/NmtcCoefficientFigure.astro';
import '../styles/homepage-studio.css';
import {identityRecord,publicLinks,tutoringRecord} from '../data/public-record.mjs';
import {workCases} from '../data/work-cases.mjs';
import {portrait} from '../data/homepage-studio.mjs';
const selectedRecordIds=['nmtc-rural-gap','trade-in-the-spotlight','applied-statistics'];
const selectedRecords=selectedRecordIds.map(id=>workCases.find(record=>record.id===id));
const tabs=['Place & policy','Trade & measurement','Learning & methods'];
const [nmtcRecord]=selectedRecords;
---
<Base wide title="Applied economist on the 2026–27 economics job market" description="Ian Helfrich is an applied economist on the 2026–27 economics job market. Working paper on rural financing in the New Markets Tax Credit, CV, research and teaching." image={portrait.share} imageAlt={portrait.alt} pageClass="studio studio-home">
 <section class="st-intro">
  <div class="st-name"><h1>Ian Helfrich</h1></div>
  <div class="st-hero">
   <div class="st-hero-copy"><h2>Applied economist on the 2026–27 economics job market</h2><p class="st-position">{identityRecord.positionLine}</p><p>My working paper, <cite>{nmtcRecord.title}</cite>, finds that the rural private-leverage gap in the New Markets Tax Credit falls from −0.262 in the pooled comparison to −0.047 within the same Community Development Entity, where it is not statistically distinguishable from zero.</p><div class="st-hero-actions"><a class="st-button" href="/research/ian-helfrich-nmtc-working-paper.pdf">Working paper (PDF)</a><a class="st-button st-button-quiet" href="/cv/ian-helfrich-cv.pdf">CV (PDF)</a><a class="st-underlink" href="/job-market">Candidate page</a></div></div>
   <div class="st-portrait-stage"><div class="st-field" data-line-field><canvas aria-hidden="true"></canvas><svg class="st-field-fallback" viewBox="0 0 500 500" aria-hidden="true">{Array.from({length:22},(_,i)=><path d={`M0 ${100+i*13} C180 ${40+i*9} 300 ${330+i*5} 500 ${120+i*14}`}/>)}</svg></div><button class="st-motion" type="button" hidden>Pause motion</button><figure class="st-portrait"><Portrait sizes="(max-width: 700px) min(304px, 84vw), 330px" alt={portrait.alt} loading="eager" fetchpriority="high"/><figcaption><span>{identityRecord.name}</span><span>{identityRecord.location}</span></figcaption></figure></div>
  </div>

 </section>
 <nav class="st-experience-nav" aria-label="Homepage sections"><a href="#selected-work">Selected work</a><a href="#graph">Site network</a><a href="#practice">Paths by purpose</a><a href="#instruments">Interactive lab</a><a href="#inquiry">Contact</a></nav>
 <section id="selected-work" class="st-work st-section" data-projects>
  <div class="st-section-top"><p>Selected work</p><a href="/research">The full research record <span aria-hidden="true">↗</span></a></div><h2>Selected research and teaching</h2>
  <div class="st-projects"><div class="st-project-tabs" role="tablist" aria-label="Explore selected projects" hidden>{selectedRecords.map((r,i)=><button id={`project-tab-${i}`} role="tab" aria-controls={`project-panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{tabs[i]}</button>)}</div>
  {selectedRecords.map((record,i)=><section class="st-project" id={`project-panel-${i}`} aria-labelledby={`project-title-${i}`}>
   {i===0?<NmtcCoefficientFigure/>:i===1?<div class="st-trade-art"><span>Trade in the Spotlight</span><div class="st-trade-question">Bilateral distance<br/>weighted by where<br/>activity is located</div><div class="st-trade-terms"><span>Population</span><span>Night lights</span><span>Distance</span></div></div>:<div class="st-method-art"><span>Applied Statistics</span><div class="st-method-chain"><span>Question</span><i aria-hidden="true">↓</i><span>Estimand</span><i aria-hidden="true">↓</i><span>Evidence</span><i aria-hidden="true">↓</i><span>Interpretation</span></div><small>Two-group inference in JavaScript, Python, R, and Julia</small></div>}
   <div class="st-project-copy"><p class="st-status">{record.status}</p><h3 id={`project-title-${i}`}>{record.title}</h3><p>{record.question}</p><p>{record.built}</p><p class="st-credit">{record.role}</p><div class="st-project-links">{record.links.slice(0,2).map(link=><a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}</div></div>
  </section>)}
  </div>
  <p class="st-supporting">Also in the record: additional contributor to the semiconductor demonstration in <a href="/work#case-nncta-semiconductor-demonstration"><cite>Securing America's Future</cite></a>; ad hoc referee, <a href="/cv#service">Journal of Economic Theory</a>. <a href="/work">See the wider body of work</a>.</p>
 </section>
 <HomeGraph/>
 <section id="practice" class="st-path-section st-section"><VisitorPath/><p class="st-supporting">{tutoringRecord.wyzant.hoursDisplay} platform-recorded Wyzant teaching hours as of {tutoringRecord.wyzant.asOf}. <a href="/teaching">Teaching experience and source record</a>.</p></section>
 <TechnicalProjects/>
 <details id="explore" class="st-lab-disclosure content-disclosure"><summary><span>Interactive models</span><span class="disclosure-symbol" aria-hidden="true">+</span></summary><div class="disclosure-body"><ResearchContinuum/><HomepageInstruments/></div></details>
 <section id="inquiry" class="st-home-close st-section"><div><h2>Contact</h2><p>For research, quantitative teaching, advisory work, or a professional opportunity.</p></div><div><a class="st-button" href="/contact">Get in touch <span aria-hidden="true">↗</span></a><a class="st-underlink" href={publicLinks.email}>Email Ian directly</a></div></section>
 <nav class="st-resource-shelf" aria-label="Open resources"><span>Resources</span><a href="/econometrics/">Open course</a><a href="/econometrics/lab/">Econometrics experiments</a><a href="/learn/policy-statistics/">Policy Statistics Lab</a><a href="/library">Public index</a><a href="/job-market">Candidate page &amp; CV</a></nav>
</Base>
<script>
 import {mountHomepage} from '../scripts/homepage-studio.mjs';
 import {mountFluidSurface} from '../scripts/homepage-fluid.mjs';
 let disposeFluid=mountFluidSurface(document);
 window.addEventListener('pagehide',()=>disposeFluid());
 window.addEventListener('pageshow',event=>{if(event.persisted)disposeFluid=mountFluidSurface(document);});
 let dispose=mountHomepage(document);
 window.addEventListener('pagehide',()=>dispose());
 window.addEventListener('pageshow',(event)=>{
  if(event.persisted) dispose=mountHomepage(document);
 });
</script>
