  wide
  pageClass="quiet-home"
  image="/og.png"
  imageAlt="Ian Helfrich, PhD, economist, quantitative researcher, and educator"
  description="Ian Helfrich is an economist on the 2026-27 academic job market, a quantitative researcher, and an educator offering private instruction and select consulting."
>
  <section class="quiet-hero" aria-labelledby="quiet-hero-title">
    <div class="quiet-hero__intro" id="field-stage">
      <canvas id="field-canvas" aria-hidden="true"></canvas>
      <p class="quiet-kicker">Ian Helfrich, PhD · Economist · On the 2026-27 job market</p>
      <div class="quiet-hero__grid">
        <h1 id="quiet-hero-title">I make complex evidence usable.</h1>
        <div class="quiet-hero__copy">
          <p>
            I solve difficult problems through economics, quantitative research, software, and teaching, then make the
            result clear enough to inspect, use, and trust.
          </p>
          <nav aria-label="Profile links">
            <a href="/job-market">Job market ↗</a>
            <a href="#selected-work">Selected work ↓</a>
            <a href="/cv">Curriculum vitae ↗</a>
          </nav>
        </div>
      </div>
      <p class="quiet-fieldnote">
        <span>φ : ℝ² → ℝ</span>
        <span class="quiet-fieldnote__hint">the marks follow ∇φ at your cursor</span>
        <a href="/research/helfrich-2024-ssrn-4772016">prices as gradients of convex potentials ↗</a>
      </p>
    </div>

    <div class="quiet-routes" aria-label="Ways to work with Ian">
      <a href="/job-market">
        <span class="quiet-routes__index">01</span>
        <div>
          <h2>Hiring committees</h2>
          <p>On the 2026-27 economics job market. Fields, job market paper, teaching record, availability, and the full packet on one page.</p>
        </div>
        <strong>Open the candidate page <i aria-hidden="true">↗</i></strong>
      </a>
      <a href="/start?problem=learning&source=home-hero">
        <span class="quiet-routes__index">02</span>
        <div>
          <h2>Private teaching</h2>
          <p>Econometrics, economics, strategy, mathematics, coding, ACT/SAT, AP, and IB Higher Level.</p>
        </div>
        <strong>Start a teaching brief <i aria-hidden="true">↗</i></strong>
      </a>
      <a href="/start?source=home-hero">
        <span class="quiet-routes__index">03</span>
        <div>
          <h2>Consulting + research</h2>
          <p>Policy, business, empirical strategy, network and spatial measurement, research systems, and team training.</p>
        </div>
        <strong>Scope an engagement <i aria-hidden="true">↗</i></strong>
      </a>
    </div>

    <ul class="quiet-proofline" aria-label="Selected qualifications">
      <li>PhD Economics</li>
      <li>MS Geographic Information Science</li>
      <li>450+ students taught</li>
      <li>Georgia Tech teaching award</li>
    </ul>
  </section>

  <section id="selected-work" class="quiet-work" aria-labelledby="quiet-work-title">
    <header>
      <p class="quiet-kicker">Selected evidence</p>
      <div>
        <h2 id="quiet-work-title">The work is the proof.</h2>
        <a href="/work">View all work ↗</a>
