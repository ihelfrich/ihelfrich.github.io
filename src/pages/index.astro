---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import fs from "node:fs";
import path from "node:path";

const projects = (await getCollection("projects")).sort((a, b) => +b.data.date - +a.data.date);
const pinnedProjects = projects.filter(p => p.data.pinned).slice(0, 6);

const writing = (await getCollection("writing"))
  .filter(p => !p.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 4);

const research = (await getCollection("research")).sort((a, b) => b.data.year - a.data.year).slice(0, 4);
const datasets = (await getCollection("datasets")).sort((a, b) => b.data.year - a.data.year).slice(0, 3);
const teaching = (await getCollection("teaching")).sort((a, b) => +b.data.date - +a.data.date);
const people = (await getCollection("people")).sort((a, b) => a.data.order - b.data.order);
const allTalks = await getCollection("talks");
const upcomingTalks = allTalks.filter(t => t.data.upcoming).sort((a, b) => +a.data.date - +b.data.date).slice(0, 3);

let readingItems = [];
try {
  readingItems = JSON.parse(fs.readFileSync(path.resolve("./public/data/feeds/reading.json"), "utf8")).slice(0, 5);
} catch (e) {}

const fmt = (d) => new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---
<Base>
  <section class="h-hero">
    <canvas id="hero-canvas" class="h-hero-canvas" aria-hidden="true"></canvas>
    <div class="h-hero-eyebrow">Smyrna, Georgia · open to new work</div>
    <h1>Ian Helfrich,<br/><span class="h-accent">trade economist.</span></h1>
    <p class="h-hero-lead">
      PhD in Economics from Georgia Institute of Technology, 2024. Primary field international trade. Secondary fields geospatial economics, microeconomic theory, and networks. Advisors Tibor Besedes and Usha Nair-Reichert.
    </p>
    <div class="h-hero-meta">
      <a href="mailto:ianthelfrich@gmail.com">ianthelfrich@gmail.com</a>
      <a href="https://github.com/ihelfrich" target="_blank" rel="noopener">github</a>
      <a href="/about">about</a>
      <a href="/book" class="h-cta">Book a session</a>
    </div>
  </section>

  <section style="max-width: var(--content-max); margin: 0 auto;">
    <p style="font-size: 1.1rem; line-height: 1.7;">
      My doctoral and post-doctoral research is in international trade, with secondary work in geospatial economics, microeconomic theory, and networks. The active line of work, joint with Dr. Elizaveta Gonchar, builds a satellite-calibrated bilateral trade-cost panel for 200 countries over 2000-2024; the 2025 SSRN preprint <a href="/research/gonchar-helfrich-2025-spotlight"><em>Trade in the Spotlight</em></a> introduced the construction. A separate working paper, <a href="/research/helfrich-2024-ssrn-4772016">SSRN 4772016</a>, unifies economic equilibrium and optimal transport in infinite-dimensional Hilbert spaces. The umbrella research program is documented at <a href="/program">/program</a>.
    </p>
    <p>
      A smaller, more applied line of work uses the same intermediary-network methods in domestic-policy settings. <a href="/research/helfrich-2026-nmtc-rural-gap">Helfrich (2026)</a> decomposes the apparent rural-urban leverage gap in the U.S. New Markets Tax Credit using Community Development Entity fixed effects. The companion European replication is in progress, with Katia Antunes.
    </p>
    <p style="color: var(--muted); font-size: 0.95rem;">
      Twin master's degrees from Georgia Tech in Economics (2019) and Geographic Information Science and Technology (2022). Prior degrees from Indiana University Bloomington, the Barcelona School of Economics, and UNC Chapel Hill. Working languages English, Spanish, Russian, Ukrainian.
    </p>
  </section>

  <div class="h-section-head">
    <h2>What I've built</h2>
    <a href="/projects" class="h-see-all">All projects →</a>
  </div>
  <div class="h-card-grid">
    {pinnedProjects.map(p => (
      <a class="h-card" href={p.data.url ?? `/projects/${p.id}`} target={p.data.url ? "_blank" : undefined} rel={p.data.url ? "noopener" : undefined}>
        <div class="h-card-tag">{p.data.tags[0] ?? "project"}</div>
        <div class="h-card-title">{p.data.title}</div>
        <div class="h-card-blurb">{p.data.blurb}</div>
        <span class="h-card-status" data-status={p.data.status}>{p.data.status}</span>
      </a>
    ))}
  </div>

  <div class="h-section-head">
    <h2>Papers</h2>
    <a href="/research" class="h-see-all">All papers →</a>
  </div>
  <ul class="h-row-list">
    {research.map(r => (
      <li class="h-row">
        <div class="h-row-meta">{r.data.year} · {r.data.status}{r.data.venue ? ` · ${r.data.venue}` : ""}</div>
        <h3 class="h-row-title"><a href={`/research/${r.id}`}>{r.data.title}</a></h3>
        <p class="h-row-summary">{r.data.authors.join(", ")}</p>
      </li>
    ))}
  </ul>

  <div class="h-section-head">
    <h2>Datasets</h2>
    <a href="/datasets" class="h-see-all">All datasets →</a>
  </div>
  <ul class="h-row-list">
    {datasets.map(d => (
      <li class="h-row">
        <div class="h-row-meta">{d.data.year} · {d.data.status}{d.data.size ? ` · ${d.data.size}` : ""}</div>
        <h3 class="h-row-title"><a href={`/datasets/${d.id}`}>{d.data.title}</a></h3>
        <p class="h-row-summary"><em>{d.data.authors.join(", ")}.</em> {d.data.blurb}</p>
      </li>
    ))}
  </ul>

  <div class="h-section-head">
    <h2>Writing</h2>
    <a href="/writing" class="h-see-all">All → · <a href="/rss.xml" style="font-family: var(--font-mono); font-size: 0.8em;">RSS</a></a>
  </div>
  <ul class="h-row-list">
    {writing.map(w => (
      <li class="h-row">
        <div class="h-row-meta">{fmt(w.data.date)}</div>
        <h3 class="h-row-title"><a href={`/writing/${w.id}`}>{w.data.title}</a></h3>
        <p class="h-row-summary">{w.data.summary}</p>
      </li>
    ))}
  </ul>

  <div class="h-section-head">
    <h2>Teaching</h2>
    <a href="/teaching" class="h-see-all">All →</a>
  </div>
  <div class="h-card-grid">
    {teaching.map(t => (
      <a class="h-card" href={t.data.url} target="_blank" rel="noopener">
        <div class="h-card-tag">{t.data.audience}</div>
        <div class="h-card-title">{t.data.title}</div>
        <div class="h-card-blurb">{t.data.blurb}</div>
      </a>
    ))}
  </div>

  {upcomingTalks.length > 0 && (
    <>
      <div class="h-section-head">
        <h2>Upcoming talks</h2>
        <a href="/talks" class="h-see-all">All talks →</a>
      </div>
      <ul class="h-row-list">
        {upcomingTalks.map(t => (
          <li class="h-row">
            <div class="h-row-meta">{fmt(t.data.date)} · {t.data.venue}{t.data.location ? ` · ${t.data.location}` : ''}</div>
            <h3 class="h-row-title">{t.data.title}</h3>
          </li>
        ))}
      </ul>
    </>
  )}

  <div class="h-section-head">
    <h2>People I work with</h2>
    <a href="/people" class="h-see-all">All →</a>
  </div>
  <div class="h-card-grid">
    {people.map(p => (
      <a class="h-card" href={`/people/${p.id}`}>
        <div class="h-card-tag">{p.data.role}</div>
        <div class="h-card-title">{p.data.name}</div>
        <div class="h-card-blurb">{p.data.bio.slice(0, 180)}{p.data.bio.length > 180 ? '…' : ''}</div>
      </a>
    ))}
  </div>

  {readingItems.length > 0 && (
    <>
      <div class="h-section-head">
        <h2>On my desk</h2>
        <a href="/reading" class="h-see-all">All →</a>
      </div>
      <ul class="h-row-list">
        {readingItems.map(item => (
          <li class="h-row">
            <div class="h-row-meta"><a href={item.link} target="_blank" rel="noopener" style="color: var(--rust); border: none;">{item.source}</a> · {fmt(item.date)}</div>
            <h3 class="h-row-title"><a href={item.link} target="_blank" rel="noopener">{item.title}</a></h3>
          </li>
        ))}
      </ul>
    </>
  )}

  <div style="margin: 4rem 0 2rem; padding: 2rem 2.2rem; background: linear-gradient(135deg, var(--paper-2), var(--paper)); border-left: 4px solid var(--sage); border-radius: 6px; box-shadow: 0 1px 12px rgba(13, 59, 102, 0.05);">
    <h3 style="margin: 0 0 0.4rem;">Want to work together?</h3>
    <p style="margin-bottom: 0; font-size: 1.05rem;">
      <a href="/book">Book a 30-minute consult</a> for tutoring (graduate or advanced-undergrad econ) or to chat about a project. For research or collaboration questions, write me directly at <a href="mailto:ianthelfrich@gmail.com">ianthelfrich@gmail.com</a>. I answer most emails within a day.
    </p>
  </div>

  <script src="/network.js" defer></script>
  <script src="/reveal.js" defer></script>
</Base>
