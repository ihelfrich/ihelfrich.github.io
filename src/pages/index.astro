---
import Base from "../layouts/Base.astro";
import ElasticFolioHero from "../components/ElasticFolioHero.astro";
import EngagementRoutes from "../components/EngagementRoutes.astro";
import SelectedWorkFolio from "../components/SelectedWorkFolio.astro";
import PracticeSpectrum from "../components/PracticeSpectrum.astro";
---

<Base
  wide
  pageClass="modern-home"
  image="/og.png"
  imageAlt="Ian Helfrich, PhD: Complex evidence, made usable"
  description="Ian Helfrich is an economist, quantitative designer, researcher, and educator working across policy, business, research, and learning to make complex evidence usable."
>
  <ElasticFolioHero />
  <EngagementRoutes />
  <SelectedWorkFolio />
  <PracticeSpectrum />

  <section class="modern-profile" aria-labelledby="modern-profile-title">
    <div class="modern-profile__label">
      <p>The person</p>
      <span>St. Louis / worldwide</span>
    </div>

    <div class="modern-profile__copy">
      <h2 id="modern-profile-title">A researcher who can teach. A teacher who can build.</h2>
      <p class="modern-profile__lead">
        I am a research economist, network economist, econometrician, quantitative designer, and educator. My formal
        work spans causal inference, trade, labor, strategy, remote sensing, and geospatial socioeconomics. My
        polymathic curiosity reaches further into mathematics, systems, acoustics, signals, sound, writing, and the craft of
        explaining difficult ideas clearly.
      </p>

      <dl class="modern-profile__credentials">
        <div><dt>Economics</dt><dd>PhD, Georgia Tech</dd></div>
        <div><dt>Spatial science</dt><dd>MS Geographic Information Science</dd></div>
        <div><dt>Human learning</dt><dd>Doctoral minor, quantitative psychology</dd></div>
        <div><dt>Teaching</dt><dd>Georgia Tech teaching award, 2023</dd></div>
      </dl>

      <nav class="modern-profile__links" aria-label="Profile links">
        <a href="/about">Full profile <span aria-hidden="true">↗</span></a>
        <a href="/cv">Curriculum vitae <span aria-hidden="true">↗</span></a>
        <a href="/library">Public index <span aria-hidden="true">↗</span></a>
      </nav>
    </div>

    <figure class="modern-profile__portrait">
      <img src="/people/ian-editorial.webp" alt="Ian Helfrich" width="400" height="400" loading="lazy" />
      <figcaption>
        <span>Research · design · education</span>
        <span>Current practice</span>
      </figcaption>
    </figure>
  </section>

  <section class="modern-close" aria-labelledby="modern-close-title">
    <header>
      <p>Available for select projects and private instruction</p>
      <span aria-hidden="true"></span>
    </header>
    <h2 id="modern-close-title">Bring the hard question.</h2>
    <div class="modern-close__body">
      <p>
        A research decision, an analytic system, a strategy problem, or a learner ready to move. Start with the real
        constraint and I will help define the smallest engagement that can produce a useful result.
      </p>
      <nav aria-label="Begin an engagement">
        <a class="modern-close__primary" href="/start?source=home-close">Start a project <span aria-hidden="true">↗</span></a>
        <a href="/start?problem=learning&source=home-close">Book private tutoring <span aria-hidden="true">↗</span></a>
        <a href="mailto:ianthelfrich@gmail.com">Email Ian</a>
      </nav>
    </div>
  </section>
</Base>

<style>
  .modern-profile {
    --profile-line: rgba(9, 9, 11, .14);
    display: grid;
    padding: clamp(6rem, 11vw, 11rem) clamp(1rem, 3vw, 3.5rem);
    grid-template-columns: minmax(110px, .22fr) minmax(0, 1.15fr) minmax(260px, .52fr);
    gap: 2rem clamp(2rem, 6vw, 7rem);
    color: #09090b;
    background: #fff;
    border-top: 1px solid var(--profile-line);
  }

  .modern-profile__label {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding-bottom: .5rem;
  }

  .modern-profile__label p,
  .modern-profile__label span {
    margin: 0;
    color: #73737b;
    font: 500 .7rem/1.4 var(--ih-mono);
  }

  .modern-profile__label span { writing-mode: vertical-rl; transform: rotate(180deg); }

  .modern-profile__copy h2 {
    max-width: 11ch;
    margin: 0 0 clamp(2rem, 4vw, 4rem);
    font: 520 clamp(3.4rem, 6.5vw, 7.6rem)/.87 var(--ih-display);
    letter-spacing: -.07em;
    text-wrap: balance;
  }

  .modern-profile__lead {
    max-width: 820px;
    margin: 0;
    color: #343439;
    font: 430 clamp(1.08rem, 1.55vw, 1.38rem)/1.55 var(--ih-sans);
    letter-spacing: -.018em;
  }

  .modern-profile__credentials {
    display: grid;
    margin: clamp(2.5rem, 5vw, 5rem) 0 0;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--profile-line);
  }

  .modern-profile__credentials > div { padding: 1rem 1rem 1rem 0; border-bottom: 1px solid var(--profile-line); }
  .modern-profile__credentials > div:nth-child(odd) { border-right: 1px solid var(--profile-line); }
  .modern-profile__credentials > div:nth-child(even) { padding-left: 1rem; }
  .modern-profile__credentials dt { margin-bottom: .34rem; color: #73737b; font: 500 .68rem var(--ih-mono); }
  .modern-profile__credentials dd { margin: 0; color: #09090b; font: 520 .92rem/1.4 var(--ih-sans); letter-spacing: -.015em; }

  .modern-profile__links { display: flex; margin-top: 2rem; gap: 1rem 1.8rem; flex-wrap: wrap; }
  .modern-profile__links a { color: #09090b; font: 600 .78rem var(--ih-sans); text-underline-offset: .32em; }
  .modern-profile__links a:hover { color: #4b4fe9; }

  .modern-profile__portrait { position: sticky; top: 108px; margin: 0; align-self: start; }
  .modern-profile__portrait::before { position: absolute; z-index: 1; inset: auto -10px -10px 22%; height: 28%; content: ""; background: #4b4fe9; mix-blend-mode: multiply; pointer-events: none; }
  .modern-profile__portrait img { display: block; width: 100%; aspect-ratio: .82; object-fit: cover; object-position: center top; filter: grayscale(1) contrast(1.08); }
  .modern-profile__portrait figcaption { display: flex; padding-top: .75rem; justify-content: space-between; gap: 1rem; color: #73737b; border-top: 1px solid #09090b; font: 500 .62rem/1.4 var(--ih-mono); }

  .modern-close {
    min-height: min(920px, 92svh);
    padding: clamp(2rem, 4vw, 4rem) clamp(1rem, 3vw, 3.5rem) clamp(4rem, 8vw, 8rem);
    color: #f7f7f5;
    background: #09090b;
  }

  .modern-close > header { display: grid; min-height: 58px; grid-template-columns: auto 1fr; gap: 2rem; align-items: center; }
  .modern-close > header p { margin: 0; color: #a8a8af; font: 500 .69rem var(--ih-mono); }
  .modern-close > header span { height: 1px; background: rgba(247, 247, 245, .18); }

  .modern-close h2 {
    max-width: 13ch;
    margin: clamp(4rem, 9vw, 9rem) 0 clamp(3rem, 7vw, 7rem);
    color: #f7f7f5;
    font: 520 clamp(4.2rem, 10.5vw, 12rem)/.78 var(--ih-display);
    letter-spacing: -.08em;
    text-wrap: balance;
  }

  .modern-close__body { display: grid; grid-template-columns: minmax(0, .82fr) minmax(320px, .5fr); gap: 2rem 8vw; align-items: end; }
  .modern-close__body > p { max-width: 700px; margin: 0; color: #b7b7bd; font: 430 clamp(1.05rem, 1.45vw, 1.3rem)/1.55 var(--ih-sans); letter-spacing: -.015em; }
  .modern-close__body nav { display: flex; flex-direction: column; align-items: stretch; }
  .modern-close__body nav a { display: flex; min-height: 54px; padding: 0; align-items: center; justify-content: space-between; color: #f7f7f5; border-bottom: 1px solid rgba(247, 247, 245, .2); font: 560 .86rem var(--ih-sans); text-decoration: none; }
  .modern-close__body nav a:hover { color: #9fa2ff; }
  .modern-close__body nav .modern-close__primary { padding: 0 1rem; color: #fff; background: #4b4fe9; border-color: #4b4fe9; }
  .modern-close__body nav .modern-close__primary:hover { color: #09090b; background: #f7f7f5; border-color: #f7f7f5; }

  @media (max-width: 980px) {
    .modern-profile { grid-template-columns: 1fr minmax(240px, .48fr); }
    .modern-profile__label { min-height: auto; grid-column: 1 / -1; flex-direction: row; }
    .modern-profile__label span { writing-mode: horizontal-tb; transform: none; }
    .modern-profile__copy h2 { font-size: clamp(3.5rem, 9vw, 6.5rem); }
  }

  @media (max-width: 720px) {
    .modern-profile { grid-template-columns: 1fr; }
    .modern-profile__portrait { position: relative; top: auto; width: min(82vw, 440px); }
    .modern-profile__credentials { grid-template-columns: 1fr; }
    .modern-profile__credentials > div:nth-child(odd) { border-right: 0; }
    .modern-profile__credentials > div:nth-child(even) { padding-left: 0; }
    .modern-close { min-height: 0; }
    .modern-close__body { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .modern-profile__label span { display: none; }
    .modern-profile__copy h2 { font-size: clamp(3rem, 15vw, 4.8rem); }
    .modern-profile__portrait { width: 100%; }
    .modern-close h2 { font-size: clamp(4rem, 20vw, 6.3rem); }
    .modern-close > header { grid-template-columns: 1fr; gap: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .modern-profile *,
    .modern-close * { scroll-behavior: auto !important; transition: none !important; }
  }

  @media (forced-colors: active) {
    .modern-profile,
    .modern-close { color: CanvasText; background: Canvas; }
    .modern-close h2,
    .modern-close__body nav a { color: CanvasText; }
    .modern-profile__portrait::before { display: none; }
  }
</style>
