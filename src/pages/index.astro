---
import Base from "../layouts/Base.astro";

const work = [
  {
    number: "01",
    field: "Policy · Econometrics",
    title: "Where the rural leverage gap actually sits",
    description:
      "A linked FY2001–FY2022 panel shifts the policy question from rural projects alone to the intermediaries that reach them.",
    proof: "−0.262 → −0.047",
    proofLabel: "with CDE fixed effects",
    href: "/research/helfrich-2026-nmtc-rural-gap",
  },
  {
    number: "02",
    field: "Trade · Remote sensing",
    title: "Measuring distance where economic activity occurs",
    description:
      "Nightlights and gridded population reposition bilateral endpoints, turning geography into a time-varying economic measure.",
    proof: "VIIRS + population",
    proofLabel: "economic endpoints",
    href: "/research/gonchar-helfrich-2025-spotlight",
  },
  {
    number: "03",
    field: "Quantitative education",
    title: "Teaching difficult material without making it smaller",
    description:
      "Private instruction and public learning tools connect intuition, mathematics, code, and the decisions each method supports.",
    proof: "1,003 hours",
    proofLabel: "171 ratings · Aug 2026",
    href: "/teaching",
  },
];
---

<Base
  wide
  pageClass="quiet-home"
  image="/og.png"
  imageAlt="Ian Helfrich, PhD, economist, quantitative researcher, and educator"
  description="Ian Helfrich is an economist on the 2026-27 academic job market, a quantitative researcher, and an educator offering private instruction and select consulting."
>
  <section class="quiet-hero" aria-labelledby="quiet-hero-title">
    <div class="quiet-hero__intro" id="field-stage">
      <canvas id="field-canvas" aria-hidden="true"></canvas>
      <p class="quiet-kicker">Ian Helfrich, PhD · Economist · On the 2026-27 job market</p>
      <div class="quiet-hero__grid">
        <h1 id="quiet-hero-title">I make complex evidence usable.</h1>
        <div class="quiet-hero__copy">
          <p>
            I use economics, quantitative research, software, and teaching to solve hard
            problems, and I make the results clear enough to inspect, use, and trust.
          </p>
          <nav aria-label="Profile links">
            <a href="/job-market">Job market ↗</a>
            <a href="#selected-work">Selected work ↓</a>
            <a href="/cv">Curriculum vitae ↗</a>
          </nav>
        </div>
      </div>
      <p class="quiet-fieldnote">
        <span class="quiet-fieldnote__hint">click the field: the mass re-optimizes · entropic optimal transport, solved here in your browser</span>
