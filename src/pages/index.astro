---
import Base from "../layouts/Base.astro";
import StudioFrontDoor from "../components/StudioFrontDoor.astro";
import SpecificationWorkbench from "../components/SpecificationWorkbench.astro";
import CapabilityMatrix from "../components/CapabilityMatrix.astro";
import PublicArchiveSwitchboard from "../components/PublicArchiveSwitchboard.astro";
---

<Base
  wide
  pageClass="studio-home"
  image="/og.png"
  description="Ian Helfrich is a research economist who builds defensible econometric analyses, geospatial intelligence, interactive evidence products, and quantitative capability for researchers, teams, and institutions."
>
  <StudioFrontDoor />

  <section class="studio-live-intro" aria-labelledby="studio-live-title" data-rail-label="LIVE EVIDENCE">
    <div>
      <span>02 / A LIVE CASE</span>
      <h2 id="studio-live-title">A polished result is where the investigation begins.</h2>
    </div>
    <p>
      The instrument below uses a real specification path from a place-based policy project. Change the model, inspect the interval, and watch the substantive story move when intermediary identity enters the comparison.
    </p>
    <aside>
      <span>WHAT THIS PROVES</span>
      <strong>Question → design → code → visual state → defensible sentence</strong>
    </aside>
  </section>

  <SpecificationWorkbench heading="h2" />

  <CapabilityMatrix />

  <PublicArchiveSwitchboard />

  <section class="studio-profile" aria-labelledby="studio-profile-title" data-rail-label="THE PERSON">
    <figure>
      <img src="/people/ian-editorial.webp" alt="Ian Helfrich" width="400" height="400" loading="lazy" />
      <figcaption>IAN T. S. HELFRICH · ST. LOUIS / WORLDWIDE</figcaption>
    </figure>
    <article>
      <span>05 / THE PERSON INSIDE THE SYSTEM</span>
      <h2 id="studio-profile-title">An economist who can build the model, the interface, and the room where it becomes usable.</h2>
      <p class="studio-profile__lead">
        I am a Georgia Tech-trained research economist, GIS specialist, software builder, editor, and award-winning educator. My work moves through trade, labor, networks, place-based policy, causal inference, remote sensing, and the design of quantitative tools people can actually operate.
      </p>
      <div class="studio-profile__ledger">
        <p><span>RESEARCH</span>Econometrics · trade · labor · networks · policy · measurement</p>
        <p><span>SPATIAL</span>GIS · remote sensing · effective distance · site and corridor analysis</p>
        <p><span>BUILD</span>Python · R · Stata · Julia · SQL · data products · research systems</p>
        <p><span>TRANSFER</span>Executive workshops · methods studios · research mentorship · editorial review</p>
      </div>
      <div class="studio-profile__links">
        <a href="/about">Read the full background →</a>
        <a href="/cv">Open the curriculum vitae ↗</a>
        <a href="/library">Search the public record ↗</a>
      </div>
    </article>
    <blockquote>“The deliverable is a decision whose construction remains visible.”</blockquote>
  </section>

  <section class="studio-close" aria-labelledby="studio-close-title" data-rail-label="START A PROJECT">
    <span>06 / BRING THE LAST RESULT YOU STILL TRUST</span>
    <h2 id="studio-close-title">Where does the evidence stop carrying the decision?</h2>
    <p>Describe the decision, current artifact, constraint, and real timeline. The project starter will recommend the smallest useful engagement and prepare a complete brief.</p>
    <div>
      <a class="studio-close__button" href="/start">Open the project starter →</a>
      <a href="mailto:ianthelfrich@gmail.com">ianthelfrich@gmail.com</a>
    </div>
  </section>
</Base>

<style>
  .studio-live-intro {
    display: grid;
    padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 5vw, 6rem);
    grid-template-columns: 1.25fr .75fr;
    gap: 2rem 5vw;
    color: var(--ih-ink);
    background: var(--ih-bone);
    border-bottom: 1px solid var(--ih-ink);
  }

  .studio-live-intro > div > span,
  .studio-profile article > span,
  .studio-close > span {
    color: var(--ih-blue);
    font: 600 .64rem/1.2 var(--ih-mono);
    letter-spacing: .08em;
  }

  .studio-live-intro h2 {
    max-width: 1000px;
    margin: .8rem 0 0;
    font: 500 clamp(3.2rem, 6vw, 7rem)/.9 var(--ih-display);
    letter-spacing: -.06em;
  }

  .studio-live-intro > p {
    max-width: 600px;
    margin: 1.7rem 0 0;
    color: var(--ih-graphite);
    font: 400 1.12rem/1.5 var(--ih-serif);
  }

  .studio-live-intro aside {
    display: grid;
    padding: 1rem 0 0;
    grid-column: 1 / -1;
    grid-template-columns: 190px 1fr;
    gap: 1rem;
    border-top: 1px solid var(--ih-rule);
  }

  .studio-live-intro aside span { color: var(--ih-muted); font: 500 .56rem var(--ih-mono); letter-spacing: .07em; }
  .studio-live-intro aside strong { color: var(--ih-ink); font: 500 .75rem var(--ih-mono); }

  .studio-profile {
    display: grid;
    padding: clamp(4rem, 9vw, 9rem) clamp(1rem, 5vw, 6rem);
    grid-template-columns: minmax(240px, .5fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 7rem);
    color: var(--ih-ink);
    background: var(--ih-paper);
    border-bottom: 1px solid var(--ih-ink);
  }

  .studio-profile figure { margin: 0; }
  .studio-profile img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; filter: saturate(.72) contrast(1.04); }
  .studio-profile figcaption { padding: .7rem 0; border-bottom: 1px solid var(--ih-ink); font: 500 .55rem var(--ih-mono); letter-spacing: .06em; }

  .studio-profile h2 {
    max-width: 1100px;
    margin: .8rem 0 1.4rem;
    font: 500 clamp(2.8rem, 5.1vw, 6rem)/.92 var(--ih-display);
    letter-spacing: -.055em;
  }

  .studio-profile__lead { max-width: 900px; color: var(--ih-graphite); font: 400 clamp(1.15rem, 1.7vw, 1.45rem)/1.5 var(--ih-serif); }

  .studio-profile__ledger { display: grid; margin-top: 2rem; border-top: 1px solid var(--ih-ink); }
  .studio-profile__ledger p { display: grid; margin: 0; padding: .85rem 0; grid-template-columns: 110px 1fr; gap: 1rem; border-bottom: 1px solid var(--ih-rule); color: var(--ih-graphite); font: 400 .83rem/1.4 var(--ih-sans); }
  .studio-profile__ledger span { color: var(--ih-blue); font: 600 .56rem var(--ih-mono); letter-spacing: .06em; }

  .studio-profile__links { display: flex; margin-top: 1.5rem; gap: 1rem 1.5rem; flex-wrap: wrap; }
  .studio-profile__links a { color: var(--ih-ink); font: 600 .62rem var(--ih-mono); text-underline-offset: .3em; text-transform: uppercase; }

  .studio-profile blockquote {
    margin: 0;
    padding: 1.3rem 0 0;
    grid-column: 1 / -1;
    color: var(--ih-blue);
    border: 0;
    border-top: 1px solid var(--ih-ink);
    font: italic 500 clamp(2rem, 3.8vw, 4.5rem)/1.02 var(--ih-display);
    letter-spacing: -.04em;
  }

  .studio-close {
    padding: clamp(4rem, 9vw, 9rem) clamp(1rem, 7vw, 9rem);
    color: var(--ih-bone);
    background: var(--ih-ink);
  }

  .studio-close h2 { max-width: 1250px; margin: .9rem 0 1.5rem; color: var(--ih-bone); font: 500 clamp(3.2rem, 7vw, 8rem)/.88 var(--ih-display); letter-spacing: -.065em; }
  .studio-close p { max-width: 680px; color: var(--ih-smoke-blue); font: 400 1.1rem/1.5 var(--ih-serif); }
  .studio-close > div { display: flex; margin-top: 2rem; align-items: center; gap: 1rem 1.5rem; flex-wrap: wrap; }
  .studio-close__button { display: inline-flex; min-height: 54px; padding: 0 1.2rem; align-items: center; color: white; background: var(--ih-blue); border: 1px solid var(--ih-blue); font: 600 .65rem var(--ih-mono); letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
  .studio-close__button:hover { color: var(--ih-ink); background: var(--ih-bone); border-color: var(--ih-bone); }
  .studio-close > div > a:last-child { color: var(--ih-bone); font: 500 .68rem var(--ih-mono); text-underline-offset: .35em; }

  @media (max-width: 820px) {
    .studio-live-intro,
    .studio-profile { grid-template-columns: 1fr; }
    .studio-live-intro aside { grid-template-columns: 1fr; }
    .studio-profile figure { max-width: 420px; }
    .studio-profile h2 { font-size: clamp(3rem, 13vw, 5rem); }
    .studio-profile__ledger p { grid-template-columns: 1fr; gap: .35rem; }
  }
</style>
