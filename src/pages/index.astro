---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import CourseFeature from "../components/econometrics/CourseFeature.astro";
import CaseRecord from "../components/CaseRecord.astro";
import ResearchGraph from "../components/ResearchGraph.astro";
import {
  availabilityRecord,
  identityRecord,
  publicLinks,
  teachingRecognition,
  tutoringRecord,
} from "../data/public-record.mjs";
import { workCases } from "../data/work-cases.mjs";
import { filterDiscoverableResearch } from "../data/research-discovery.mjs";

const selectedRecordIds = ["trade-in-the-spotlight", "applied-statistics", "nncta-semiconductor-demonstration"];
const selectedRecords = workCases.filter((record) => selectedRecordIds.includes(record.id));
const researchRecords = filterDiscoverableResearch(await getCollection("research"));
---

<Base
  wide
  title="Applied economist and quantitative research designer"
  description="Research, quantitative design, teaching, and public analytical tools by economist Ian Helfrich."
  pageClass="fieldbook-home"
>
  <section class="fieldbook-intro fieldbook-grid" data-rail-label="Introduction">
    <div class="fieldbook-intro__copy" data-fieldbook-reveal>
      <p class="route-kicker">{identityRecord.role}</p>
      <h1>I build the data, comparisons, and tools that difficult questions require.</h1>
      <p class="fieldbook-intro__lead">My work spans trade, place-based policy, labor and AI, measurement, and quantitative education. It includes empirical studies, public research tools, university teaching, and advanced quantitative coaching.</p>
      <div class="action-row">
        <a class="fieldbook-action" href="/work">See selected work</a>
        <a class="fieldbook-action fieldbook-action--quiet" href="/cv">CV &amp; contact</a>
      </div>
    </div>
    <aside class="fieldbook-intro__status" aria-label="Current record" data-fieldbook-reveal>
      <p class="record-label">Current record</p>
      <dl>
        <div><dt>Training</dt><dd>PhD in Economics, Georgia Tech, 2024</dd></div>
        <div><dt>Location</dt><dd>{identityRecord.location}</dd></div>
        <div><dt>Availability</dt><dd>{availabilityRecord.status}</dd></div>
        <div><dt>Updated</dt><dd>{availabilityRecord.asOf}</dd></div>
      </dl>
      <a href="/job-market">Academic job-market materials →</a>
    </aside>
  </section>

  <CourseFeature />

  <section class="home-signature route-band" data-rail-label="Research connections">
    <div class="route-band__heading fieldbook-grid">
      <div class="fieldbook-narrative">
        <p class="record-label">Research record</p>
        <h2>Trade, place, measurement, labor, and economic theory</h2>
        <p>The research spans several distinct questions. This map connects the public records only when their published metadata share a field, method, or substantive topic.</p>
      </div>
      <aside class="fieldbook-margin signature-note">
        <strong>How to read the map</strong>
        <p>Filter by topic or stage. A line records shared metadata, not a claim that every project belongs to one research program.</p>
      </aside>
    </div>
    <div class="signature-aperture" data-fieldbook-reveal>
      <ResearchGraph papers={researchRecords} />
    </div>
  </section>

  <section class="home-records route-shell" data-rail-label="Selected work">
    <header class="section-intro">
      <p class="record-label">Selected work</p>
      <h2>Research, measurement, and quantitative learning</h2>
      <p>These projects cover spatial measurement in trade, an inspectable statistical workflow, and a documented contribution to national critical-technology assessment.</p>
    </header>
    <div class="case-stack">
      {selectedRecords.map((record, index) => (
        <div class="numbered-case" data-fieldbook-reveal>
          <span class="case-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <CaseRecord record={record} />
        </div>
      ))}
    </div>
  </section>

  <section class="home-teaching route-shell" data-rail-label="Teaching">
    <header class="section-intro">
      <p class="record-label">Teaching &amp; coaching</p>
      <h2>Teaching across classrooms, online courses, and research practice</h2>
      <p>I have served as instructor of record for three semesters at Georgia Tech, supported teaching in Duke's Global Executive MBA program and at Indiana University, taught online microeconomics and macroeconomics, and built an independent practice from foundational tutoring through executive-level quantitative research-design coaching.</p>
    </header>
    <div class="teaching-ledger">
      <article>
        <p class="evidence-source">platform-recorded · {tutoringRecord.wyzant.asOf}</p>
        <strong>{tutoringRecord.wyzant.hoursDisplay}</strong>
        <h3>Wyzant instruction</h3>
        <p>{tutoringRecord.wyzant.hoursProse[0].toUpperCase() + tutoringRecord.wyzant.hoursProse.slice(1)} hours of instruction recorded through Wyzant.</p>
      </article>
      <article>
        <p class="evidence-source">practice-recorded · {tutoringRecord.privatePractice.asOf}</p>
        <strong>{tutoringRecord.privatePractice.hoursDisplay}</strong>
        <h3>Independent private practice</h3>
        <p>{tutoringRecord.privatePractice.hoursProse[0].toUpperCase() + tutoringRecord.privatePractice.hoursProse.slice(1)} additional hours in a separate independent practice.</p>
      </article>
      <article class="teaching-recognition">
        <p class="evidence-source">award</p>
        <h3>{teachingRecognition.award}, {teachingRecognition.year}</h3>
        <p><a href={teachingRecognition.evaluations.href}>View the {teachingRecognition.evaluations.year} Georgia Tech course-evaluation record →</a></p>
      </article>
    </div>
    <a class="text-route" href="/teaching">Teaching &amp; coaching →</a>
  </section>

  <section class="home-range route-shell" data-rail-label="Range">
    <header class="section-intro">
      <p class="record-label">Additional experience</p>
      <h2>Research, policy, software, leadership, and teaching</h2>
    </header>
    <dl class="range-ledger">
      <div>
        <dt>Industrial and trade diagnostics</dt>
        <dd>Independent Saudi Arabia-focused work on sector performance, economic complexity, import localization, firm productivity, and growth constraints. <a href="/work#additional-experience">Experience record →</a></dd>
      </div>
      <div>
        <dt>Location strategy</dt>
        <dd>North America-wide electric-vehicle manufacturing site analysis for Carnegie Mellon University and Toyota Research Institute. <a href="/work#additional-experience">Experience record →</a></dd>
      </div>
      <div>
        <dt>Critical-technology assessment</dt>
        <dd>Additional contributor to the semiconductor demonstration in the 2023 NNCTA report <cite>Securing America's Future</cite>. <a href="/work#case-nncta-semiconductor-demonstration">Contribution record →</a></dd>
      </div>
      <div>
        <dt>Spatial measurement</dt>
        <dd>MS in Geographic Information Science and Technology; remote-sensing and spatial measures in the dissertation and <cite>Trade in the Spotlight</cite>. <a href="/research/gonchar-helfrich-2025-spotlight">Research record →</a></dd>
      </div>
      <div>
        <dt>Research software</dt>
        <dd>Public viewers, reproducible pipelines, browser-based analytical tools, and multi-language learning systems. <a href="/projects">Public projects →</a></dd>
      </div>
      <div>
        <dt>Leadership</dt>
        <dd>Georgia Tech Graduate Student Government Vice President for Campus Services; Graduate Senator; Senator of the Year, 2020. <a href="/about#service">Service record →</a></dd>
      </div>
      <div>
        <dt>Academic service</dt>
        <dd>Ad hoc referee, Journal of Economic Theory. <a href="/cv#service">CV record →</a></dd>
      </div>
    </dl>
  </section>

  <section class="home-close route-band" data-rail-label="Contact">
    <div class="fieldbook-grid">
      <div class="fieldbook-narrative">
        <p class="record-label">Current roles and collaborations</p>
        <h2>Where this work may be useful</h2>
        <p>I am interested in roles and collaborations where the quality of a decision depends on how evidence is designed, compared, or explained. That includes applied research, economic and policy analysis, quantitative product work, research-methods advising, and advanced teaching or coaching.</p>
        <div class="action-row">
          <a class="fieldbook-action" href="/cv">View CV and availability</a>
          <a class="fieldbook-action fieldbook-action--quiet" href="/contact">Get in touch</a>
        </div>
      </div>
      <aside class="fieldbook-margin closing-links">
        <a href={publicLinks.github} target="_blank" rel="noopener">GitHub ↗</a>
        <a href={publicLinks.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="/job-market">Academic job-market materials →</a>
      </aside>
    </div>
  </section>
</Base>

<style>
  :global(.fieldbook-home main) { padding-top: 0; }
  .route-shell { width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; padding-block: var(--ef-space-7); }
  .route-band { padding-block: var(--ef-space-7); border-block: 1px solid var(--ef-ink); background: var(--ef-figure); }
  .record-label,
  .route-kicker,
  .evidence-source { margin: 0 0 0.75rem; color: color-mix(in srgb, var(--ef-ink) 64%, transparent); font: 620 0.72rem/1.4 var(--font-data); letter-spacing: 0.08em; text-transform: uppercase; }
  .fieldbook-intro { min-height: min(48rem, calc(100vh - 4.5rem)); padding-block: clamp(4rem, 10vw, 8.5rem); align-items: end; }
  .fieldbook-intro__copy { grid-column: 2 / span 7; }
  .fieldbook-intro h1 { max-width: 11ch; margin-bottom: 1.5rem; font-size: clamp(3.25rem, 7.6vw, 7.5rem); }
  .fieldbook-intro__lead { max-width: 62ch; font-size: clamp(1.2rem, 1.8vw, 1.55rem); line-height: 1.5; }
  .fieldbook-intro__status { grid-column: 9 / span 3; padding-top: 1rem; border-top: 2px solid var(--ef-signal); font-family: var(--font-data); font-size: 0.8rem; }
  .fieldbook-intro__status dl { margin: 0 0 1rem; }
  .fieldbook-intro__status dl > div { padding-block: 0.65rem; border-bottom: 1px solid var(--rule); }
  .fieldbook-intro__status dt { color: var(--muted); }
  .fieldbook-intro__status dd { margin: 0.15rem 0 0; }
  .action-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .fieldbook-action { display: inline-flex; min-height: 48px; padding: 0.8rem 1rem; align-items: center; justify-content: center; color: var(--ef-figure); background: var(--ef-signal); border: 1px solid var(--ef-signal); border-radius: var(--ef-control-radius); font: 650 0.76rem/1 var(--font-data); letter-spacing: 0.04em; text-decoration: none; text-transform: uppercase; }
  .fieldbook-action:hover { color: var(--ef-figure); background: var(--ef-ink); border-color: var(--ef-ink); }
  .fieldbook-action--quiet { color: var(--ef-ink); background: transparent; border-color: var(--ef-ink); }
  .fieldbook-action--quiet:hover { color: var(--ef-figure); }
  .route-band__heading { margin-bottom: var(--ef-space-5); }
  .section-intro { display: grid; max-width: 72rem; grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr); column-gap: var(--ef-space-6); }
  .section-intro .record-label { grid-column: 1 / -1; }
  .section-intro h2 { grid-column: 1; margin: 0; }
  .section-intro > p:last-child { grid-column: 2; margin: 0; align-self: end; }
  .signature-note { padding-top: 0.9rem; border-top: 2px solid var(--ef-oxide); }
  .signature-note strong { font: 650 0.76rem/1.4 var(--font-data); text-transform: uppercase; }
  .signature-note p { margin-top: 0.65rem; }
  .signature-aperture { width: min(calc(100% - 2 * var(--ef-edge)), 80rem); margin-inline: auto; }
  .case-stack { margin-top: var(--ef-space-6); border-bottom: 1px solid var(--ef-ink); }
  .numbered-case { display: grid; grid-template-columns: minmax(3rem, 0.4fr) minmax(0, 6fr); gap: var(--ef-space-4); border-top: 1px solid var(--ef-ink); }
  .numbered-case :global(.case-record) { border-top: 0; padding-block: var(--ef-space-5); }
  .case-number { padding-top: var(--ef-space-5); color: var(--ef-signal); font: 580 clamp(1.5rem, 3vw, 3rem)/1 var(--font-data); }
  .teaching-ledger { display: grid; margin-block: var(--ef-space-6) var(--ef-space-4); grid-template-columns: 1fr 1fr; border: 1px solid var(--ef-ink); }
  .teaching-ledger article { min-height: 18rem; padding: var(--ef-space-5); }
  .teaching-ledger article + article { border-left: 1px solid var(--ef-ink); }
  .teaching-ledger article > strong { display: block; margin-block: 1rem; font: 570 clamp(3rem, 7vw, 6.5rem)/0.9 var(--font-display); letter-spacing: -0.06em; }
  .teaching-ledger h3 { font-size: clamp(1.25rem, 2vw, 1.7rem); }
  .teaching-recognition { grid-column: 1 / -1; min-height: auto !important; border-top: 1px solid var(--ef-ink); border-left: 0 !important; }
  .text-route { font: 650 0.78rem/1 var(--font-data); text-transform: uppercase; }
  .range-ledger { margin-top: var(--ef-space-6); border-top: 1px solid var(--ef-ink); }
  .range-ledger > div { display: grid; padding-block: 1.2rem; grid-template-columns: minmax(12rem, 1fr) minmax(0, 3fr); gap: var(--ef-space-5); border-bottom: 1px solid var(--rule); }
  .range-ledger dt { font: 650 0.76rem/1.4 var(--font-data); text-transform: uppercase; }
  .range-ledger dd { margin: 0; }
  .closing-links { display: grid; align-content: end; gap: 0.7rem; font: 600 0.76rem/1.4 var(--font-data); }
  @media (max-width: 60rem) {
    .fieldbook-intro__copy { grid-column: 1 / span 8; }
    .fieldbook-intro__status { grid-column: 6 / span 3; }
    .section-intro { grid-template-columns: 1fr; }
    .section-intro h2,
    .section-intro > p:last-child { grid-column: 1; }
    .section-intro > p:last-child { margin-top: 1rem; }
  }
  @media (max-width: 45rem) {
    .fieldbook-intro { display: block; min-height: auto; }
    .fieldbook-intro h1 { overflow-wrap: normal; word-break: normal; }
    .fieldbook-intro__status { margin-top: 3rem; }
    .route-shell { padding-block: var(--ef-space-6); }
    .route-band { padding-block: var(--ef-space-6); }
    .teaching-ledger { grid-template-columns: 1fr; }
    .teaching-ledger article + article { border-top: 1px solid var(--ef-ink); border-left: 0; }
    .teaching-recognition { grid-column: 1; }
    .range-ledger > div { grid-template-columns: 1fr; gap: 0.5rem; }
  }
  @media (max-width: 22rem) {
    .fieldbook-intro h1 { font-size: 2.625rem; }
  }
</style>
