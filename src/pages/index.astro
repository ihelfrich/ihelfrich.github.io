---
import Base from "../layouts/Base.astro";
import FieldSignatures from "../components/FieldSignatures.astro";
import ReasoningInstrument from "../components/ReasoningInstrument.astro";
import { getCollection } from "astro:content";

const preferredLabs = ["stats-lab", "inference-lab", "econ101a", "macroprep", "ppd504-studio", "pictures-of-inference"];
const teaching = await getCollection("teaching");
const labs = preferredLabs
  .map((id) => teaching.find((entry) => entry.id === id))
  .filter(Boolean);

const researchCollection = await getCollection("research");
const preferredResearch = [
  "helfrich-vardanyan-2026-ai-entry-level-labor",
  "gonchar-helfrich-2025-spotlight",
  "helfrich-2026-nmtc-rural-gap",
];
const research = preferredResearch
  .map((id) => researchCollection.find((entry) => entry.id === id))
  .filter(Boolean);
---
<Base
  wide
  description="Private econometrics, statistics, and applied-research coaching with Dr. Ian Helfrich—PhD economist, award-winning educator, and creator of open quantitative teaching tools."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-inner">
      <div class="hero-copy">
        <div class="hero-folio" aria-hidden="true">
          <span>Selected private practice · No. 01</span>
          <span>Atlanta · working worldwide</span>
        </div>
        <span class="eyebrow">Private quantitative instruction · Research methods</span>
        <h1 id="home-title">Make the methods <em>yours.</em></h1>
        <p class="hero-lead">
          I help graduate students, researchers, professionals, and teams master econometrics, statistics, and applied economic research well enough to explain—and defend—every decision.
        </p>
        <div class="button-row">
          <a class="button" href="/work-with-me">Explore ways to work together</a>
          <a class="button secondary" href="/teaching">See the teaching</a>
        </div>
        <p class="hero-note">Instruction and coaching—not ghostwriting. Your analysis remains your own.</p>
      </div>

      <div class="hero-portrait" aria-hidden="true">
        <span class="portrait-coordinate portrait-coordinate-top">FIG. 001 · EDUCATOR / ECONOMIST</span>
        <span class="portrait-coordinate portrait-coordinate-side">C21 · C55 · L13 · R12</span>
        <svg class="portrait-orbit" viewBox="0 0 520 680">
          <ellipse cx="270" cy="350" rx="226" ry="282"></ellipse>
          <ellipse cx="270" cy="350" rx="168" ry="236"></ellipse>
          <path d="M44 350H496M270 68V632"></path>
          <circle cx="438" cy="193" r="6"></circle>
          <circle cx="93" cy="473" r="4"></circle>
        </svg>
        <img src="/people/ian.webp" alt="" width="1200" height="1800" fetchpriority="high" />
        <div class="hero-seal">
          <span class="seal-monogram">IH</span>
          <span class="seal-copy">PhD Economics · Georgia Tech · MMXXIV</span>
        </div>
      </div>
    </div>
  </section>

  <div class="proof-strip" aria-label="Teaching record">
    <div class="proof-item">
      <span class="proof-number">1,200+</span>
      <span class="proof-label">hours of instruction in the past year</span>
    </div>
    <div class="proof-item">
      <span class="proof-number">450+</span>
      <span class="proof-label">students taught across universities and private practice</span>
    </div>
    <div class="proof-item">
      <span class="proof-number">5.0</span>
      <span class="proof-label">average rating across 175+ public ratings</span>
    </div>
    <div class="proof-item">
      <span class="proof-number">2023</span>
      <span class="proof-label">Georgia Tech Graduate TA of the Year</span>
    </div>
  </div>

  <section class="positioning-statement">
    <div>
      <span class="section-label">What this practice is</span>
      <h2>Clarity for quantitative work that matters.</h2>
    </div>
    <div class="statement-copy">
      <p>
        A formula is not understanding. A result is not a research design. And software output is not an argument. My job is to help you connect the economics, the identification strategy, the code, and the interpretation—without taking ownership of the work away from you.
      </p>
      <p>
        This is rigorous, patient, high-context teaching for people who need more than an answer key.
      </p>
    </div>
  </section>

  <ReasoningInstrument />

  <section class="section" aria-labelledby="audience-title">
    <div class="section-heading">
      <div>
        <span class="section-label">Who I help</span>
        <h2 id="audience-title">Different stakes. The same standard.</h2>
      </div>
      <p>I work selectively so each engagement gets real preparation, continuity, and intellectual attention.</p>
    </div>

    <div class="audience-grid">
      <article class="audience-card">
        <h3>Graduate students</h3>
        <p>Master's and doctoral students navigating econometrics, statistics, microeconomics, macroeconomics, finance, qualifying exams, or an empirical paper.</p>
      </article>
      <article class="audience-card">
        <h3>Researchers & professionals</h3>
        <p>Analysts, economists, policy professionals, and research staff who need a sharper model, a defensible empirical strategy, or fluency in unfamiliar methods.</p>
      </article>
      <article class="audience-card">
        <h3>Departments & teams</h3>
        <p>Universities, research centers, and organizations that need an applied workshop, quantitative bootcamp, or custom instructional program.</p>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="offers-title">
    <div class="section-heading">
      <div>
        <span class="section-label">Ways to work together</span>
        <h2 id="offers-title">Built around the outcome—not the clock.</h2>
      </div>
      <p>One focused session when that is enough. A structured engagement when the problem deserves continuity.</p>
    </div>

    <div class="offer-grid">
      <article class="offer-card">
        <span class="card-tag">One-to-one</span>
        <h3>Private quantitative coaching</h3>
        <p>High-context instruction in econometrics, statistics, economics, finance, and quantitative software.</p>
        <ul>
          <li>Graduate and advanced undergraduate work</li>
          <li>R, Stata, Python, Excel, and Julia</li>
          <li>Recurring or focused sessions</li>
        </ul>
      </article>

      <article class="offer-card featured">
        <span class="card-tag">Structured</span>
        <h3>Research methods coaching</h3>
        <p>Methodological guidance for a paper, thesis, dissertation, replication, or applied research project.</p>
        <ul>
          <li>Research design and identification</li>
          <li>Code review and diagnostic reasoning</li>
          <li>Interpretation and defense preparation</li>
        </ul>
      </article>

      <article class="offer-card">
        <span class="card-tag">Institutional</span>
        <h3>Workshops & training</h3>
        <p>Custom instruction that turns a methods gap into working capability for a department, lab, or team.</p>
        <ul>
          <li>Econometrics and causal inference</li>
          <li>Applied R, Stata, and data workflows</li>
          <li>Half-day, full-day, and cohort formats</li>
        </ul>
      </article>
    </div>

    <div class="button-row">
      <a class="button" href="/work-with-me">See formats, rates, and fit</a>
    </div>
  </section>

  <section class="ethics-panel" aria-labelledby="ethics-title">
    <div>
      <span class="section-label">The non-negotiable</span>
      <h2 id="ethics-title">Your work stays yours.</h2>
    </div>
    <div>
      <p>
        I will teach, question, demonstrate, debug alongside you, review reasoning, and help you prepare to defend your choices. I will not take an exam, complete graded work, fabricate analysis, or ghostwrite research.
      </p>
      <p><strong>The goal is not dependence. It is command.</strong></p>
    </div>
  </section>

  <FieldSignatures />

  <section class="section" aria-labelledby="labs-title">
    <div class="section-heading">
      <div>
        <span class="section-label">Proof of teaching</span>
        <h2 id="labs-title">The classroom extends beyond the call.</h2>
      </div>
      <p>I build the resources I wish every quantitative course had: visual, worked, interactive, and grounded in real tools.</p>
    </div>

    <div class="lab-grid">
      {labs.map((lab) => lab && (
        <article class="lab-card">
          <span class="card-tag">{lab.data.audience}</span>
          <h3>{lab.data.title}</h3>
          <p>{lab.data.blurb}</p>
          <a class="lab-link" href={lab.data.url} target="_blank" rel="noopener">Explore the resource →</a>
        </article>
      ))}
    </div>

    <div class="button-row">
      <a class="button secondary" href="/teaching">Teaching record and full library</a>
    </div>
  </section>

  <aside class="proof-quote" aria-label="Teaching philosophy">
    <blockquote>
      The best session ends with you needing me less—not because the problem got easier, but because your mental model got stronger.
    </blockquote>
    <cite>Ian Helfrich · teaching philosophy</cite>
  </aside>

  <section class="section compact" aria-labelledby="research-title">
    <div class="section-heading">
      <div>
        <span class="section-label">Active scholarship</span>
        <h2 id="research-title">I teach the work because I do the work.</h2>
      </div>
      <p>Current research spans labor and AI, international trade, spatial econometrics, networks, and place-based policy.</p>
    </div>

    <ul class="h-row-list">
      {research.map((paper) => paper && (
        <li class="h-row">
          <div class="h-row-meta">{paper.data.year} · {paper.data.status}</div>
          <h3 class="h-row-title"><a href={`/research/${paper.id}`}>{paper.data.title}</a></h3>
          <p class="h-row-summary">{paper.data.authors.join(", ")}</p>
        </li>
      ))}
    </ul>
    <a class="card-arrow" href="/research">View the complete research program →</a>
  </section>

  <section class="cta-panel">
    <span class="section-label">Start with fit</span>
    <h2>Tell me what you are trying to understand—or build.</h2>
    <p>A short inquiry is enough. I will tell you plainly whether I am the right person, what format makes sense, and what it will cost.</p>
    <div class="button-row">
      <a class="button" href="/work-with-me#inquiry">Start an inquiry</a>
    </div>
  </section>
</Base>
