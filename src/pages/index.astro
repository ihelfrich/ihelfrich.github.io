</Base>

<script>
  // ── The transport hero ────────────────────────────────────────────────────
  // A cloud of mass particles at equilibrium. Each click declares a new
  // target density; the page solves the entropic optimal transport problem
  // between the cloud's current density and that target (convolutional
  // Sinkhorn: with squared-euclidean cost the Gibbs kernel is a gaussian, so
  // every iteration is two separable blurs), then moves the mass along the
  // barycentric transport map. Equipotential contours of the dual potential
  // are drawn and allowed to fade. The readout reports the real numbers:
  // W2, iterations, solve time. Motion has exactly the two licensed causes
  // in DESIGN_SYSTEM.md: a visitor changing state, and a calculation
  // resolving. The loop stops at equilibrium, so idle cost is zero.
  const stage = document.getElementById("field-stage");
  const canvas = document.getElementById("field-canvas") as HTMLCanvasElement | null;
  const readout = document.getElementById("ot-readout");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (stage && canvas) {
    const ctx = canvas.getContext("2d")!;
    const N = 3000;              // particles
    const GRID_MAX = 72;         // solver grid, long side
    const BLUR_SIGMA = 7;        // entropic width in grid cells: must be wide
                                 // enough that far-apart supports stay coupled
                                 // (a truncated narrow kernel degenerates)
    const ITERS = 28;            // sinkhorn iterations
    const FLOW_MS = 1300;        // displacement interpolation time
    const CONTOUR_MS = 2200;     // contour fade
    const INK = [17, 17, 19];
    const BLUE = [40, 82, 232];  // signal blue: live mass only
    const BONE = "rgba(242,234,222,0.34)"; // motion veil during transit

    let W = 0, H = 0, dpr = 1, gw = 0, gh = 0, cw = 0, chh = 0;
    const px = new Float32Array(N), py = new Float32Array(N);       // base position
    const sx = new Float32Array(N), sy = new Float32Array(N);       // flow start
    const tx = new Float32Array(N), ty = new Float32Array(N);       // flow target
    const ox = new Float32Array(N), oy = new Float32Array(N);       // cursor dimple offset
    const vx = new Float32Array(N), vy = new Float32Array(N);       // dimple velocity
    let curX = -1e9, curY = -1e9;
    let flowT0 = 0, flowing = false;
    let contours: number[][] = [], contourT0 = 0;
    let mode = 0, running = false, raf = 0;

    // ── solver ──────────────────────────────────────────────────────────
    let kernel: Float64Array, kr = 0;
    function makeKernel() {
      // full-width kernel: every cell pair must stay coupled, however faintly
      // (float64 holds e^-70 fine); truncation is what a graphics blur does,
      // and it silently decouples far supports
      kr = Math.max(gw, gh) - 1;
      kernel = new Float64Array(2 * kr + 1);
      for (let i = -kr; i <= kr; i++) kernel[i + kr] = Math.exp(-(i * i) / (2 * BLUR_SIGMA * BLUR_SIGMA));
    }
    function blur(src: Float64Array, tmp: Float64Array, out: Float64Array) {
      // separable gaussian with edge renormalization (mass preserving)
      for (let y = 0; y < gh; y++) for (let x = 0; x < gw; x++) {
        let s = 0, wsum = 0;
        const lo = Math.max(0, x - kr), hi = Math.min(gw - 1, x + kr);
        for (let u = lo; u <= hi; u++) { const w = kernel[u - x + kr]; s += src[y * gw + u] * w; wsum += w; }
        tmp[y * gw + x] = s / wsum;
      }
      for (let y = 0; y < gh; y++) for (let x = 0; x < gw; x++) {
        let s = 0, wsum = 0;
        const lo = Math.max(0, y - kr), hi = Math.min(gh - 1, y + kr);
        for (let u = lo; u <= hi; u++) { const w = kernel[u - y + kr]; s += tmp[u * gw + x] * w; wsum += w; }
        out[y * gw + x] = s / wsum;
      }
    }
    function normalize(d: Float64Array) {
      let s = 0;
      for (let i = 0; i < d.length; i++) { d[i] += 1e-10; s += d[i]; }
      for (let i = 0; i < d.length; i++) d[i] /= s;
    }
    function binParticles(): Float64Array {
      const mu = new Float64Array(gw * gh);
      for (let i = 0; i < N; i++) {
        const gx = Math.min(gw - 1, Math.max(0, Math.round(px[i] / cw)));
        const gy = Math.min(gh - 1, Math.max(0, Math.round(py[i] / chh)));
        mu[gy * gw + gx] += 1;
      }
      const t1 = new Float64Array(gw * gh), sm = new Float64Array(gw * gh);
      blur(mu, t1, sm); normalize(sm);
      return sm;
    }
    function targetDensity(cx: number, cy: number, m: number): Float64Array {
      const nu = new Float64Array(gw * gh);
      const minD = Math.min(W, H);
      for (let y = 0; y < gh; y++) for (let x = 0; x < gw; x++) {
        const X = (x + 0.5) * cw, Y = (y + 0.5) * chh;
        const dx = X - cx, dy = Y - cy;
        const d = Math.hypot(dx, dy);
        let v = 0;
        if (m === 0) {              // blob: demand concentrates at the click
          const s = 0.11 * minD; v = Math.exp(-(d * d) / (2 * s * s));
        } else if (m === 1) {       // ring: demand surrounds the click
          const r = 0.17 * minD, w0 = 0.032 * minD;
          v = Math.exp(-((d - r) * (d - r)) / (2 * w0 * w0));
        } else {                    // twin blobs: demand splits across the click
          const off = 0.16 * minD, s = 0.07 * minD;
          const d1x = dx - off, d2x = dx + off;
          v = Math.exp(-(d1x * d1x + dy * dy) / (2 * s * s)) + Math.exp(-(d2x * d2x + dy * dy) / (2 * s * s));
        }
        nu[y * gw + x] = v;
      }
      normalize(nu);
      return nu;
    }
    function solve(cx: number, cy: number) {
      const t0 = performance.now();
      const n = gw * gh;
      const mu = binParticles();
      const nu = targetDensity(cx, cy, mode);
      const a = new Float64Array(n).fill(1), b = new Float64Array(n).fill(1);
      const t1 = new Float64Array(n), Kb = new Float64Array(n), Ka = new Float64Array(n);
      for (let k = 0; k < ITERS; k++) {
        blur(b, t1, Kb);
        for (let i = 0; i < n; i++) a[i] = mu[i] / Math.max(Kb[i], 1e-300);
        blur(a, t1, Ka);
        for (let i = 0; i < n; i++) b[i] = nu[i] / Math.max(Ka[i], 1e-300);
      }
      for (let i = 0; i < n; i++) { // guard against inf/nan from extreme scalings
        if (!Number.isFinite(a[i])) a[i] = 0;
        if (!Number.isFinite(b[i])) b[i] = 0;
      }
      // barycentric map: T(x_i) = blur(b .* Y)_i / blur(b)_i, per coordinate
      const bx = new Float64Array(n), by = new Float64Array(n);
      for (let y = 0; y < gh; y++) for (let x = 0; x < gw; x++) {
        bx[y * gw + x] = b[y * gw + x] * (x + 0.5) * cw;
        by[y * gw + x] = b[y * gw + x] * (y + 0.5) * chh;
      }
      const Bx = new Float64Array(n), By = new Float64Array(n), B1 = new Float64Array(n);
      blur(bx, t1, Bx); blur(by, t1, By); blur(b, t1, B1);
      const Tx = new Float64Array(n), Ty = new Float64Array(n);
      for (let i = 0; i < n; i++) {
        if (B1[i] < 1e-290) { // numerically decoupled cell: mass stays put
          Tx[i] = ((i % gw) + 0.5) * cw; Ty[i] = (Math.floor(i / gw) + 0.5) * chh;
        } else { Tx[i] = Bx[i] / B1[i]; Ty[i] = By[i] / B1[i]; }
      }
      // per-particle targets, W2 estimate, dual potential contours
      let w2 = 0;
      for (let i = 0; i < N; i++) {
        const T = sampleMap(Tx, Ty, px[i], py[i]);
        sx[i] = px[i] + ox[i]; sy[i] = py[i] + oy[i];
        // sub-cell jitter: sample around the barycentric mean so the settled
        // cloud reads as mass, never as the solver's grid
        tx[i] = T[0] + (Math.random() + Math.random() - 1) * cw * 0.9;
        ty[i] = T[1] + (Math.random() + Math.random() - 1) * chh * 0.9;
        w2 += (tx[i] - px[i]) ** 2 + (ty[i] - py[i]) ** 2;
      }
      w2 = Math.sqrt(w2 / N) / Math.hypot(W, H);
      const phi = new Float64Array(n);
      for (let i = 0; i < n; i++) phi[i] = Math.log(Math.max(a[i], 1e-13));
      blur(phi, t1, Ka);
      contours = marchingSquares(Ka, 6);
      contourT0 = performance.now();
      const ms = performance.now() - t0;
      if (readout) {
        const msTxt = ms < 1 ? "<1" : ms.toFixed(0);
        readout.textContent = `W2 ≈ ${w2.toFixed(3)} · sinkhorn k=${ITERS} · ${msTxt}ms · n=${N}`;
        readout.classList.add("is-live");
      }
      mode = (mode + 1) % 3;
    }
    function sampleMap(Tx: Float64Array, Ty: Float64Array, x: number, y: number): [number, number] {
      const fx = Math.min(gw - 1.001, Math.max(0, x / cw - 0.5));
      const fy = Math.min(gh - 1.001, Math.max(0, y / chh - 0.5));
      const x0 = Math.floor(fx), y0 = Math.floor(fy), ax = fx - x0, ay = fy - y0;
      const i00 = y0 * gw + x0, i10 = i00 + 1, i01 = i00 + gw, i11 = i01 + 1;
      return [
        Tx[i00] * (1 - ax) * (1 - ay) + Tx[i10] * ax * (1 - ay) + Tx[i01] * (1 - ax) * ay + Tx[i11] * ax * ay,
        Ty[i00] * (1 - ax) * (1 - ay) + Ty[i10] * ax * (1 - ay) + Ty[i01] * (1 - ax) * ay + Ty[i11] * ax * ay,
      ];
    }
    function marchingSquares(f: Float64Array, nLevels: number): number[][] {
      const sorted = Array.from(f).sort((p, q) => p - q);
      const segs: number[][] = [];
      for (let L = 1; L <= nLevels; L++) {
        const lvl = sorted[Math.floor((L / (nLevels + 1)) * (sorted.length - 1))];
        for (let y = 0; y < gh - 1; y++) for (let x = 0; x < gw - 1; x++) {
          const v0 = f[y * gw + x] - lvl, v1 = f[y * gw + x + 1] - lvl;
          const v2 = f[(y + 1) * gw + x + 1] - lvl, v3 = f[(y + 1) * gw + x] - lvl;
          const pts: number[] = [];
          const edge = (a: number, b: number, xa: number, ya: number, xb: number, yb: number) => {
            if ((a < 0) !== (b < 0)) { const t = a / (a - b); pts.push((xa + (xb - xa) * t + 0.5) * cw, (ya + (yb - ya) * t + 0.5) * chh); }
          };
          edge(v0, v1, x, y, x + 1, y); edge(v1, v2, x + 1, y, x + 1, y + 1);
          edge(v2, v3, x + 1, y + 1, x, y + 1); edge(v3, v0, x, y + 1, x, y);
          if (pts.length === 4) segs.push(pts);
        }
      }
      return segs;
    }

    // ── render + physics ────────────────────────────────────────────────
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    function draw(veil: boolean, speeds: Float32Array | null) {
      if (veil) { ctx.fillStyle = BONE; ctx.fillRect(0, 0, W, H); }
      else ctx.clearRect(0, 0, W, H);
      const now = performance.now();
      const ca = Math.max(0, 1 - (now - contourT0) / CONTOUR_MS);
      if (contours.length && ca > 0) {
        ctx.strokeStyle = `rgba(17,17,19,${0.22 * ca})`;
        ctx.lineWidth = 0.7;
        ctx.beginPath();
        for (const s of contours) { ctx.moveTo(s[0], s[1]); ctx.lineTo(s[2], s[3]); }
        ctx.stroke();
      }
      for (let i = 0; i < N; i++) {
        let X: number, Y: number, sp = 0;
        if (flowing) {
          const t = ease(Math.min(1, (now - flowT0) / FLOW_MS));
          X = sx[i] + (tx[i] - sx[i]) * t; Y = sy[i] + (ty[i] - sy[i]) * t;
          sp = speeds ? speeds[i] : 0;
        } else { X = px[i] + ox[i]; Y = py[i] + oy[i]; sp = Math.hypot(vx[i], vy[i]) * 0.4; }
        const e = Math.min(1, sp);
        const r_ = Math.round(INK[0] + (BLUE[0] - INK[0]) * e);
        const g_ = Math.round(INK[1] + (BLUE[1] - INK[1]) * e);
        const b_ = Math.round(INK[2] + (BLUE[2] - INK[2]) * e);
        ctx.fillStyle = `rgba(${r_},${g_},${b_},${0.34 + 0.3 * e})`;
        ctx.fillRect(X - 0.8, Y - 0.8, 1.6, 1.6);
      }
    }
    const flowSpeed = new Float32Array(N);
    function step() {
      const now = performance.now();
      let energy = 0;
      if (flowing) {
        const t = Math.min(1, (now - flowT0) / FLOW_MS);
        for (let i = 0; i < N; i++)
          flowSpeed[i] = (Math.hypot(tx[i] - sx[i], ty[i] - sy[i]) / Math.max(1, FLOW_MS)) * 14 * (1 - Math.abs(2 * t - 1));
        if (t >= 1) {
          flowing = false;
          for (let i = 0; i < N; i++) { px[i] = tx[i]; py[i] = ty[i]; ox[i] = oy[i] = vx[i] = vy[i] = 0; }
          readout?.classList.remove("is-live");
        }
        energy = 1;
      } else {
        // cursor dimple: local repulsion with spring return
        const R = 110;
        for (let i = 0; i < N; i++) {
          const dx = px[i] + ox[i] - curX, dy = py[i] + oy[i] - curY;
          const d2 = dx * dx + dy * dy;
          let fx2 = 0, fy2 = 0;
          if (d2 < R * R) {
            const d = Math.sqrt(d2) || 1, g = (1 - d / R);
            fx2 = (dx / d) * g * 2.2; fy2 = (dy / d) * g * 2.2;
          }
          vx[i] = (vx[i] + fx2 - ox[i] * 0.12) * 0.82;
          vy[i] = (vy[i] + fy2 - oy[i] * 0.12) * 0.82;
          ox[i] += vx[i]; oy[i] += vy[i];
          energy += Math.abs(vx[i]) + Math.abs(vy[i]);
        }
      }
      draw(flowing, flowing ? flowSpeed : null);
      const contourAlive = contours.length && now - contourT0 < CONTOUR_MS;
      const pointerInside = curX > -1e8;
      if (!flowing && !contourAlive && !pointerInside && energy < 0.6) { running = false; return; }
      raf = requestAnimationFrame(step);
    }
    function wake() { if (!running) { running = true; raf = requestAnimationFrame(step); } }

    // ── setup ───────────────────────────────────────────────────────────
    function seed() {
      // rest distribution: a broad anisotropic gaussian, right of center
      const cx = W * 0.62, cy = H * 0.44, sxx = W * 0.19, syy = H * 0.17;
      for (let i = 0; i < N; i++) {
        let u = 0, v = 0;
        do { u = Math.random() * 2 - 1; v = Math.random() * 2 - 1; } while (u * u + v * v > 1 || u * u + v * v === 0);
        const m = Math.sqrt(-2 * Math.log(u * u + v * v) / (u * u + v * v));
        px[i] = Math.min(W - 2, Math.max(2, cx + u * m * sxx));
        py[i] = Math.min(H - 2, Math.max(2, cy + v * m * syy));
      }
    }
    function resize() {
      const r = stage!.getBoundingClientRect();
      W = Math.max(1, r.width); H = Math.max(1, r.height);
      dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas!.width = Math.round(W * dpr); canvas!.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (W >= H) { gw = GRID_MAX; gh = Math.max(24, Math.round(GRID_MAX * H / W)); }
      else { gh = GRID_MAX; gw = Math.max(24, Math.round(GRID_MAX * W / H)); }
      cw = W / gw; chh = H / gh;
      makeKernel();
      seed();
      contours = [];
      draw(false, null);
    }

    if (!reduced) {
      stage.addEventListener("pointermove", (e) => {
        const r = canvas.getBoundingClientRect();
        curX = e.clientX - r.left; curY = e.clientY - r.top;
        if (!flowing) wake();
      });
      stage.addEventListener("pointerleave", () => { curX = -1e9; curY = -1e9; wake(); });
      stage.addEventListener("pointerdown", (e) => {
        if (flowing) return;
        if ((e.target as Element).closest("a")) return;
        const r = canvas.getBoundingClientRect();
        solve(e.clientX - r.left, e.clientY - r.top);
        flowT0 = performance.now(); flowing = true;
        wake();
      });
    }

    const ro = new ResizeObserver(() => { cancelAnimationFrame(raf); running = false; flowing = false; resize(); });
    ro.observe(stage);
    resize();
  }
</script>

<style>
  :global(.quiet-home) {
    --quiet-ink: #111113;
    --quiet-paper: #f2eade;   /* archive bone, per DESIGN_SYSTEM.md */
    --quiet-white: #fff;
    --quiet-blue: #2852e8;    /* signal blue, per DESIGN_SYSTEM.md */
    --quiet-muted: #66666c;
    --quiet-rule: rgba(17, 17, 19, .19);
