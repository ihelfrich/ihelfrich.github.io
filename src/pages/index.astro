---
import Base from '../layouts/Base.astro';
import ResearchContinuum from '../components/ResearchContinuum.astro';
import HomepageInstruments from '../components/HomepageInstruments.astro';
import '../styles/homepage-studio.css';
import {identityRecord,publicLinks,teachingRecognition,tutoringRecord,availabilityRecord} from '../data/public-record.mjs';
import {workCases} from '../data/work-cases.mjs';
import {portrait,nmtc,coefficientX} from '../data/homepage-studio.mjs';
const selectedRecordIds=['nmtc-rural-gap','trade-in-the-spotlight','applied-statistics'];
const selectedRecords=selectedRecordIds.map(id=>workCases.find(record=>record.id===id));
const tabs=['Place & policy','Trade & measurement','Learning & methods'];
const titles=['The rural mobilization gap.','Where economic activity happens.','Follow the whole argument.'];
---
<Base wide title="Research is a practice. Pass it on." description="The research and teaching practice of economist Ian Helfrich. Explore the work, develop your methods, and bring a question of your own." image={portrait.src} imageAlt={portrait.alt} pageClass="studio studio-home">
 <section class="st-intro">
  <div class="st-name"><h1>Ian Helfrich</h1><span>PhD in Economics<br/>Georgia Tech, 2024</span></div>
  <div class="st-hero">
   <div class="st-hero-copy"><p class="st-kicker">Research is a practice. Pass it on.</p><h2>Make sense <br/>of the world.<br/>Help others <br/>do the same.</h2><p>I’m an applied economist working across spatial measurement, policy, and trade. I help researchers turn difficult questions into clear, defensible arguments.</p><div class="st-hero-actions"><a class="st-button" href="#selected-work">Explore my work <span aria-hidden="true">↓</span></a><a class="st-underlink" href="#practice">Learn with me</a></div></div>
   <div class="st-portrait-stage"><div class="st-field" data-line-field><canvas aria-hidden="true"></canvas><svg class="st-field-fallback" viewBox="0 0 500 500" aria-hidden="true">{Array.from({length:22},(_,i)=><path d={`M0 ${100+i*13} C180 ${40+i*9} 300 ${330+i*5} 500 ${120+i*14}`}/>)}</svg></div><button class="st-motion" type="button" hidden>Pause motion</button><figure class="st-portrait"><img {...portrait} fetchpriority="high" decoding="async"/><figcaption><span>{identityRecord.name}</span><span>{identityRecord.location}</span></figcaption></figure><p class="st-photo-note">A rigorous mind.<br/>A generous practice.</p></div>
  </div>
  <div class="st-entry-paths"><a href="/teaching"><span>For students &amp; researchers<small>Build your methods and your judgment</small></span><span class="st-arrow" aria-hidden="true">↗</span></a><a href="#inquiry" data-inquiry-intent="collaborate"><span>For research teams<small>Bring a question worth working through</small></span><span class="st-arrow" aria-hidden="true">↗</span></a><a href="/job-market"><span>For hiring &amp; collaboration<small>Experience, research record, and CV</small></span><span class="st-arrow" aria-hidden="true">↗</span></a></div>
 </section>
 <nav class="st-experience-nav" aria-label="Homepage experiences"><a href="#selected-work">Selected work</a><a href="#instruments">Interactive tools</a><a href="#connections">Research map</a><a href="#practice">Learn with me</a></nav>
 <section id="selected-work" class="st-work st-section" data-projects>
  <div class="st-section-top"><p>Selected work</p><a href="/research">The full research record <span aria-hidden="true">↗</span></a></div><h2>Three ways into the work.</h2>
  <div class="st-projects"><div class="st-project-tabs" role="tablist" aria-label="Explore selected projects" hidden>{selectedRecords.map((r,i)=><button id={`project-tab-${i}`} role="tab" aria-controls={`project-panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{tabs[i]}</button>)}</div>
  {selectedRecords.map((record,i)=><section class="st-project" id={`project-panel-${i}`} aria-labelledby={`project-title-${i}`}>
   {i===0?<figure class="st-coeff"><div class="st-figure-head"><span>Rural–urban comparison</span><span>NMTC</span></div><svg viewBox="0 0 550 310" role="img" aria-labelledby="coefficient-title coefficient-desc"><title id="coefficient-title">Pooled and within-intermediary rural coefficients</title><desc id="coefficient-desc">Pooled coefficient minus 0.262. Within-CDE coefficient minus 0.047; 95 percent confidence interval from minus 0.245 to plus 0.152. Descriptive comparisons, not causal effects. No pooled confidence interval is shown.</desc>{[-.3,-.2,-.1,0,.1,.2].map(v=><g><line x1={coefficientX(v)} x2={coefficientX(v)} y1="55" y2="253" stroke={v===0?'#a5a5a5':'#4a4a4a'} stroke-dasharray={v===0?'3 5':undefined}/><text x={coefficientX(v)} y="278" text-anchor="middle">{v===0?'0':v.toFixed(1)}</text></g>)}<text x="55" y="35">Pooled comparison</text><circle cx={coefficientX(nmtc.pooled)} cy="85" r="7" fill="#ccc"/><text x={coefficientX(nmtc.pooled)+16} y="90" class="st-coeff-value">−0.262</text><text x="55" y="144">Within the same intermediary</text><line x1={coefficientX(nmtc.lower)} x2={coefficientX(nmtc.upper)} y1="194" y2="194" stroke="#ddd" stroke-width="3"/>{[nmtc.lower,nmtc.upper].map(v=><line x1={coefficientX(v)} x2={coefficientX(v)} y1="187" y2="201" stroke="#ddd" stroke-width="2"/>)}<circle cx={coefficientX(nmtc.within)} cy="194" r="7" fill="#fff"/><text x={coefficientX(nmtc.within)} y="226" text-anchor="middle" class="st-coeff-value">−0.047</text></svg><figcaption>Within-CDE bar: 95% confidence interval.<br/>Descriptive comparisons; no causal effect is identified.</figcaption></figure>:i===1?<div class="st-trade-art"><span>Trade in the Spotlight</span><div class="st-trade-question">A country is<br/>more than<br/>its centroid.</div><div class="st-trade-terms"><span>Population</span><span>Night lights</span><span>Distance</span></div></div>:<div class="st-method-art"><span>Applied Statistics</span><div class="st-method-chain"><span>Question</span><i aria-hidden="true">↓</i><span>Estimand</span><i aria-hidden="true">↓</i><span>Evidence</span><i aria-hidden="true">↓</i><span>Interpretation</span></div><small>One argument. Inspectable steps.</small></div>}
   <div class="st-project-copy"><p class="st-status">{record.status}</p><h3 id={`project-title-${i}`}>{titles[i]}</h3><p>{record.question}</p><p>{record.built}</p><p class="st-credit">{record.role}</p><div class="st-project-links">{record.links.slice(0,2).map(link=><a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}</div></div>
  </section>)}
  </div>
  <p class="st-supporting">Also in the record: additional contributor to the semiconductor demonstration in <a href="/work#case-nncta-semiconductor-demonstration"><cite>Securing America's Future</cite></a>; ad hoc referee, <a href="/cv#service">Journal of Economic Theory</a>. <a href="/work">See the wider body of work</a>.</p>
 </section>
 <ResearchContinuum/>
 <HomepageInstruments/>
 <section id="practice" class="st-practice st-section"><div class="st-practice-heading"><p class="st-kicker">The way I work</p><h2>High standards.<br/>Room to grow.</h2><p>My aim is to train researchers who can train others. We connect the question, the mathematics, and the interpretation, so you leave better equipped to work independently.</p><a class="st-underlink" href="/teaching">My teaching record <span aria-hidden="true">↗</span></a><a class="st-button" href="#inquiry" data-inquiry-intent="learn">Work through it with me <span aria-hidden="true">↗</span></a></div><div class="st-practice-list">{[['Find the real question.','Clarify what you want to learn, what you can measure, and which comparison would actually be informative.'],['Make the reasoning visible.','Connect the mathematics, the code, and the interpretation. Work through the step that still feels mysterious.'],['Build your independence.','Learn to diagnose problems, defend your choices, and recognize when the evidence asks you to change your mind.']].map(([title,body],i)=><article><span>0{i+1}</span><div><h3>{title}</h3><p>{body}</p></div></article>)}</div><div class="st-teaching-note"><div><strong>Teaching, with a record behind it.</strong><p>{teachingRecognition.award}, {teachingRecognition.year}. {tutoringRecord.wyzant.hoursDisplay} platform-recorded Wyzant hours as of {tutoringRecord.wyzant.asOf}. Instructor of record for three semesters at Georgia Tech.</p></div><a href={publicLinks.wyzant}>Find me on Wyzant <span aria-hidden="true">↗</span></a></div></section>
 <section class="st-resource st-section"><div class="st-resource-title"><p>A place to begin</p><h2>Follow the argument.<br/>Try it for yourself.</h2></div><div><p>Start with the open econometrics course, work through an experiment, or explore the public research archive.</p>{[['/econometrics/','The Econometric Argument','Open course · September 2026 development edition'],['/econometrics/lab/','Interactive investigations','Explore the assumptions behind the answer'],['/learn/policy-statistics/','Policy Statistics Lab','Hands-on work with actual policy questions'],['/library','The public library','Search papers, projects, data, and writing']].map(([url,title,desc])=><a href={url}><span>{title}<small>{desc}</small></span><span aria-hidden="true">↗</span></a>)}</div></section>

 <section id="inquiry" class="st-contact st-section"><div><p class="st-kicker">Bring a question</p><h2>Let’s see where<br/>it takes us.</h2><p class="st-contact-note">Tell me what you’re working on, where you’re getting stuck, and what you want to be able to do.</p><a class="st-direct" href={publicLinks.email}>ianthelfrich@gmail.com <span aria-hidden="true">↗</span></a><p class="st-supporting">{availabilityRecord.status}. <a href="/cv">CV and background</a>.</p></div><form class="st-inquiry" data-inquiry hidden><label for="st-intent">I’d like to talk about</label><select id="st-intent" name="intent"><option value="learn">Learning and quantitative coaching</option><option value="collaborate">Research collaboration or advisory work</option><option value="hire">Academic or industry opportunity</option></select><label for="st-name">Your name</label><input id="st-name" name="name" autocomplete="name" required maxlength="120" placeholder="How should I address you?"/><label for="st-question">What are you working on?</label><textarea id="st-question" name="question" required maxlength="3000" rows="4" placeholder="The question, the context, and what would help…"></textarea><button class="st-button" type="submit">Open email draft <span aria-hidden="true">↗</span></button><p class="st-form-note" role="status">Opens your email app. Nothing is sent from this page.</p></form></section>
</Base>
<script>
 import {mountHomepage} from '../scripts/homepage-studio.mjs';
 import {mountFluidSurface} from '../scripts/homepage-fluid.mjs';
 let disposeFluid=mountFluidSurface(document);
 window.addEventListener('pagehide',()=>disposeFluid());
 window.addEventListener('pageshow',event=>{if(event.persisted)disposeFluid=mountFluidSurface(document);});
 let dispose=mountHomepage(document);
 window.addEventListener('pagehide',()=>dispose());
 window.addEventListener('pageshow',(event)=>{
  if(event.persisted) dispose=mountHomepage(document);
 });
</script>
