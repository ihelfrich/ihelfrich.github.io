          <a href="/job-market">Job market ↗</a>
          <a href="/cv">Curriculum vitae ↗</a>
          <a href="mailto:ianthelfrich@gmail.com">Email Ian ↗</a>
        </nav>
      </div>
    </div>
  </section>
</Base>

<script>
  // The gradient field. A lattice of marks, still by default. Each mark is a
  // spring-damped vector chasing the gradient of a potential centered on the
  // cursor; a click launches one radial impulse that resolves to rest. Motion
  // therefore has exactly the two licensed causes in DESIGN_SYSTEM.md: a
  // visitor changing state, and a calculation resolving. Idle cost is zero:
  // the rAF loop stops when the system reaches equilibrium.
  const stage = document.getElementById("field-stage");
  const canvas = document.getElementById("field-canvas") as HTMLCanvasElement | null;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (stage && canvas) {
    const ctx = canvas.getContext("2d")!;
    const SPACING = 54;        // lattice pitch, CSS px
    const SIGMA = 120;         // potential width
    const MAXLEN = 16;         // full extension of a mark
    const SPRING = 0.14;
    const DAMP = 0.8;
    const WAVE_SPEED = 620;    // px/s
    const WAVE_WIDTH = 55;     // shell thickness
    const WAVE_LIFE = 1500;    // ms
    const INK = [17, 17, 19];
    const BLUE = [40, 82, 232]; // signal blue: live elements only

    let W = 0, H = 0, dpr = 1;
    let marks: { x: number; y: number; mx: number; my: number; vx: number; vy: number }[] = [];
    let px = -1e9, py = -1e9;
    let waves: { x: number; y: number; t0: number }[] = [];
    let raf = 0, running = false;

    function resize() {
      const r = stage!.getBoundingClientRect();
      W = Math.max(1, r.width); H = Math.max(1, r.height);
      dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      marks = [];
      const x0 = (W % SPACING) / 2, y0 = (H % SPACING) / 2;
      for (let y = y0; y <= H; y += SPACING)
        for (let x = x0; x <= W; x += SPACING)
          marks.push({ x, y, mx: 0, my: 0, vx: 0, vy: 0 });
      draw();
    }

    function fieldAt(x: number, y: number, now: number) {
      // Cursor potential: gaussian bump, marks align away from the cursor.
      let fx = 0, fy = 0;
      const dx = x - px, dy = y - py;
      const d2 = dx * dx + dy * dy;
      if (d2 < 9 * SIGMA * SIGMA) {
        const d = Math.sqrt(d2) || 1;
        const g = Math.exp(-d2 / (2 * SIGMA * SIGMA));
        fx += (dx / d) * g; fy += (dy / d) * g;
      }
      // Impulse waves: an expanding gaussian shell, amplitude decaying in time.
      for (const w of waves) {
        const t = (now - w.t0) / 1000;
        const rr = WAVE_SPEED * t;
        const wx = x - w.x, wy = y - w.y;
        const d = Math.hypot(wx, wy) || 1;
        const shell = Math.exp(-((d - rr) ** 2) / (2 * WAVE_WIDTH * WAVE_WIDTH));
        const decay = Math.exp(-2.2 * t);
        fx += (wx / d) * shell * decay * 0.9;
        fy += (wy / d) * shell * decay * 0.9;
      }
      return { fx, fy };
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      for (const m of marks) {
        const len = Math.hypot(m.mx, m.my);
        const t = Math.min(1, len / MAXLEN);
        // Base lattice dot, always present: the still state of the field.
        ctx.fillStyle = `rgba(${INK[0]},${INK[1]},${INK[2]},0.16)`;
        ctx.fillRect(m.x - 0.75, m.y - 0.75, 1.5, 1.5);
        if (len > 0.4) {
          const e = t * t;
          const r_ = Math.round(INK[0] + (BLUE[0] - INK[0]) * e);
          const g_ = Math.round(INK[1] + (BLUE[1] - INK[1]) * e);
          const b_ = Math.round(INK[2] + (BLUE[2] - INK[2]) * e);
          ctx.strokeStyle = `rgba(${r_},${g_},${b_},${0.16 + 0.68 * t})`;
          ctx.lineWidth = 1.4;
          ctx.beginPath();
          ctx.moveTo(m.x - m.mx / 2, m.y - m.my / 2);
          ctx.lineTo(m.x + m.mx / 2, m.y + m.my / 2);
          ctx.stroke();
        }
      }
    }

    function step(now: number) {
      waves = waves.filter((w) => now - w.t0 < WAVE_LIFE);
      let energy = 0;
      for (const m of marks) {
        const { fx, fy } = fieldAt(m.x, m.y, now);
        const tx = fx * MAXLEN, ty = fy * MAXLEN;
        m.vx = (m.vx + (tx - m.mx) * SPRING) * DAMP;
        m.vy = (m.vy + (ty - m.my) * SPRING) * DAMP;
        m.mx += m.vx; m.my += m.vy;
        energy += Math.abs(m.vx) + Math.abs(m.vy) + Math.abs(m.mx) + Math.abs(m.my);
      }
      draw();
      const pointerInside = px > -1e8;
      if (energy < 1 && !pointerInside && waves.length === 0) {
        running = false;
        return; // equilibrium: the calculation has resolved, the loop stops
      }
      raf = requestAnimationFrame(step);
    }

    function wake() {
      if (!running) {
        running = true;
        raf = requestAnimationFrame(step);
      }
    }

    if (!reduced) {
      stage.addEventListener("pointermove", (e) => {
        const r = canvas.getBoundingClientRect();
        px = e.clientX - r.left; py = e.clientY - r.top;
        wake();
      });
      stage.addEventListener("pointerleave", () => { px = -1e9; py = -1e9; wake(); });
      stage.addEventListener("pointerdown", (e) => {
        const r = canvas.getBoundingClientRect();
        waves.push({ x: e.clientX - r.left, y: e.clientY - r.top, t0: performance.now() });
        wake();
      });
    }

    const ro = new ResizeObserver(() => { cancelAnimationFrame(raf); running = false; resize(); });
    ro.observe(stage);
    resize();
  }
</script>

<style>
  :global(.quiet-home) {
    --quiet-ink: #111113;
    --quiet-paper: #f2eade;   /* archive bone, per DESIGN_SYSTEM.md */
    --quiet-white: #fff;
    --quiet-blue: #2852e8;    /* signal blue, per DESIGN_SYSTEM.md */
    --quiet-muted: #66666c;
    --quiet-rule: rgba(17, 17, 19, .19);
    background: var(--quiet-paper);
  }

  :global(.quiet-home main.wide) { width: 100%; max-width: none; padding: 0; }
  :global(.quiet-home .field-rail),
  :global(.quiet-home .h-scroll-progress) { display: none; }

  .quiet-hero,
  .quiet-work,
  .quiet-trust { color: var(--quiet-ink); background: var(--quiet-paper); }

  .quiet-kicker {
    margin: 0;
    color: var(--quiet-muted);
    font: 520 .7rem/1.4 var(--ih-mono);
    letter-spacing: .01em;
  }

  .quiet-hero { padding: 0 clamp(1.25rem, 4vw, 4.5rem); border-bottom: 1px solid var(--quiet-rule); }

  .quiet-hero__intro {
    position: relative;
    display: grid;
    min-height: clamp(620px, calc(100svh - 72px), 900px);
    padding: clamp(2rem, 4vw, 4rem) 0 1.1rem;
    grid-template-rows: auto 1fr auto;
    border-bottom: 1px solid var(--quiet-ink);
  }

  #field-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  .quiet-hero__intro > * { position: relative; z-index: 1; }
  .quiet-hero__intro > #field-canvas { z-index: 0; }

  @media (forced-colors: active) {
    #field-canvas { display: none; }
  }

  .quiet-hero__grid {
    display: grid;
    padding: clamp(4rem, 8vw, 8rem) 0 clamp(2rem, 4vw, 4rem);
    grid-template-columns: minmax(0, 8fr) minmax(280px, 4fr);
    gap: 2rem clamp(3rem, 8vw, 9rem);
    align-items: end;
  }

  .quiet-hero h1 {
    max-width: 11ch;
    margin: 0;
    color: var(--quiet-ink);
    font: 540 clamp(4.2rem, 8.4vw, 10rem)/.87 var(--ih-display);
    letter-spacing: -.075em;
    text-wrap: balance;
  }

  .quiet-hero__copy > p {
    max-width: 560px;
    margin: 0;
    color: #3d3d42;
    font: 430 clamp(1.05rem, 1.35vw, 1.25rem)/1.58 var(--ih-sans);
    letter-spacing: -.018em;
  }

  .quiet-hero__copy nav { display: flex; margin-top: 2rem; gap: 1.5rem; flex-wrap: wrap; }
  .quiet-hero__copy a,
  .quiet-work header a,
  .quiet-trust nav a { color: var(--quiet-ink); font: 600 .74rem var(--ih-sans); text-underline-offset: .34em; }
  .quiet-hero__copy a:hover,
  .quiet-work header a:hover,
  .quiet-trust nav a:hover { color: var(--quiet-blue); }

  .quiet-fieldnote {
    display: flex;
    margin: 0;
    gap: 1.4rem;
    flex-wrap: wrap;
    color: var(--quiet-muted);
    font: 520 .62rem/1.5 var(--ih-mono);
  }

  .quiet-fieldnote a { color: var(--quiet-muted); text-underline-offset: .3em; }
  .quiet-fieldnote a:hover { color: var(--quiet-blue); }

  @media (prefers-reduced-motion: reduce) {
    .quiet-fieldnote__hint { display: none; }
  }

  .quiet-routes { border-bottom: 1px solid var(--quiet-ink); }

  .quiet-routes > a {
    display: grid;
    min-height: 190px;
    padding: clamp(1.4rem, 2.5vw, 2.5rem) 0;
    grid-template-columns: minmax(80px, 1fr) minmax(320px, 7fr) minmax(190px, 4fr);
    gap: 1.5rem;
    align-items: start;
    color: var(--quiet-ink);
    border-bottom: 1px solid var(--quiet-rule);
    text-decoration: none;
  }

  .quiet-routes > a:last-child { border-bottom: 0; }
  .quiet-routes__index { color: var(--quiet-blue); font: 560 .7rem var(--ih-mono); }
  .quiet-routes h2 { max-width: 12ch; margin: 0; color: var(--quiet-ink); font: 540 clamp(2.2rem, 3.6vw, 4.5rem)/.92 var(--ih-display); letter-spacing: -.055em; }
  .quiet-routes p { max-width: 650px; margin: 1.2rem 0 0; color: var(--quiet-muted); font: 430 .92rem/1.52 var(--ih-sans); }
  .quiet-routes strong { display: flex; justify-content: space-between; gap: 1rem; color: var(--quiet-ink); font: 600 .76rem/1.4 var(--ih-sans); }
  .quiet-routes strong i { color: var(--quiet-blue); font-style: normal; transition: transform 150ms ease; }
  .quiet-routes > a:hover h2 { color: var(--quiet-blue); }
  .quiet-routes > a:hover strong i { transform: translate(2px, -2px); }

  .quiet-proofline {
    display: grid;
    min-height: 76px;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
  }

  .quiet-proofline li {
    display: flex;
    padding: 1rem;
    align-items: center;
    color: var(--quiet-muted);
    border-right: 1px solid var(--quiet-rule);
    font: 520 .68rem/1.4 var(--ih-mono);
  }

  .quiet-proofline li:first-child { padding-left: 0; }
  .quiet-proofline li:last-child { border-right: 0; }

  .quiet-work { padding: clamp(6rem, 10vw, 10rem) clamp(1.25rem, 4vw, 4.5rem); background: var(--quiet-white); }

  .quiet-work header { display: grid; grid-template-columns: minmax(120px, 2fr) minmax(0, 10fr); gap: 2rem; }
  .quiet-work header > div { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .quiet-work header h2 { max-width: 12ch; margin: 0; color: var(--quiet-ink); font: 540 clamp(3rem, 5.8vw, 7rem)/.9 var(--ih-display); letter-spacing: -.065em; }
  .quiet-work__list { margin-top: clamp(3rem, 6vw, 6rem); border-top: 1px solid var(--quiet-ink); }

  .quiet-work__row {
    display: grid;
    min-height: 210px;
    padding: clamp(1.5rem, 2.5vw, 2.5rem) 0;
    grid-template-columns: minmax(50px, 1fr) minmax(260px, 3fr) minmax(300px, 4fr) minmax(180px, 2fr) 28px;
    gap: 1.5rem;
    align-items: start;
    color: var(--quiet-ink);
    border-bottom: 1px solid var(--quiet-rule);
    text-decoration: none;
  }

  .quiet-work__number,
  .quiet-work small { color: var(--quiet-muted); font: 520 .67rem/1.4 var(--ih-mono); }
  .quiet-work__title small { display: block; margin-bottom: 1rem; }
  .quiet-work__title h3 { max-width: 18ch; margin: 0; color: var(--quiet-ink); font: 540 clamp(1.55rem, 2.3vw, 2.8rem)/1 var(--ih-display); letter-spacing: -.045em; }
  .quiet-work__row > p { max-width: 560px; margin: 0; color: #46464b; font: 430 .93rem/1.56 var(--ih-sans); }
  .quiet-work__proof { display: flex; flex-direction: column; gap: .55rem; }
  .quiet-work__proof strong { color: var(--quiet-ink); font: 560 clamp(1.2rem, 1.7vw, 1.8rem)/1 var(--ih-display); letter-spacing: -.04em; }
  .quiet-work__arrow { color: var(--quiet-blue); font: 500 1.1rem var(--ih-sans); transition: transform 150ms ease; }
  .quiet-work__row:hover .quiet-work__title h3 { color: var(--quiet-blue); }
  .quiet-work__row:hover .quiet-work__arrow { transform: translate(2px, -2px); }

  .quiet-trust {
    display: grid;
    padding: clamp(6rem, 10vw, 10rem) clamp(1.25rem, 4vw, 4.5rem);
    grid-template-columns: minmax(120px, 2fr) minmax(0, 10fr);
    gap: 2rem;
    border-top: 5px solid var(--quiet-blue);
  }

  .quiet-trust__body { display: grid; grid-template-columns: minmax(280px, 1fr) minmax(360px, .72fr); gap: 3rem 8vw; }
  .quiet-trust h2 { margin: 0; color: var(--quiet-ink); font: 540 clamp(3.2rem, 5.8vw, 7rem)/.87 var(--ih-display); letter-spacing: -.067em; }
  .quiet-trust__copy > p:first-child { max-width: 680px; margin: 0; color: #39393e; font: 430 clamp(1rem, 1.3vw, 1.2rem)/1.62 var(--ih-sans); }
  .quiet-trust__credentials { margin: 2.5rem 0 0; padding-top: 1rem; color: var(--quiet-muted); border-top: 1px solid var(--quiet-rule); font: 520 .7rem/1.6 var(--ih-mono); }
  .quiet-trust nav { display: flex; margin-top: 2rem; gap: 1.5rem; flex-wrap: wrap; }

  @media (max-width: 940px) {
    .quiet-hero__grid { grid-template-columns: 1fr; align-items: start; }
    .quiet-hero__copy { max-width: 620px; }
    .quiet-routes > a { grid-template-columns: 60px 1fr; }
    .quiet-routes > a > strong { grid-column: 2; }
    .quiet-work__row { grid-template-columns: 44px minmax(220px, 3fr) minmax(260px, 4fr) minmax(160px, 2fr) 24px; }
    .quiet-trust__body { grid-template-columns: 1fr; }
  }

  @media (max-width: 720px) {
    .quiet-hero__intro { min-height: 0; }
    .quiet-hero__grid { padding-top: 5rem; }
    .quiet-hero h1 { font-size: clamp(3.6rem, 16vw, 6.5rem); }
    .quiet-routes > a { grid-template-columns: 38px 1fr; }
    .quiet-proofline { grid-template-columns: 1fr 1fr; }
    .quiet-proofline li { min-height: 60px; border-bottom: 1px solid var(--quiet-rule); }
    .quiet-proofline li:nth-child(2) { border-right: 0; }
    .quiet-proofline li:nth-child(3) { padding-left: 0; border-bottom: 0; }
    .quiet-proofline li:nth-child(4) { border-bottom: 0; }
    .quiet-work header,
    .quiet-trust { grid-template-columns: 1fr; }
    .quiet-work header > div { align-items: start; flex-direction: column; }
    .quiet-work__row { grid-template-columns: 38px 1fr 24px; }
    .quiet-work__title { grid-column: 2; }
    .quiet-work__row > p,
    .quiet-work__proof { grid-column: 2; }
    .quiet-work__arrow { grid-column: 3; grid-row: 1; }
  }

  @media (max-width: 480px) {
    .quiet-hero,
    .quiet-work,
    .quiet-trust { padding-right: 1rem; padding-left: 1rem; }
    .quiet-hero__copy nav { flex-direction: column; align-items: flex-start; }
    .quiet-proofline { grid-template-columns: 1fr; }
    .quiet-proofline li { padding-left: 0; border-right: 0; border-bottom: 1px solid var(--quiet-rule) !important; }
    .quiet-proofline li:last-child { border-bottom: 0 !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .quiet-routes strong i,
    .quiet-work__arrow { transition: none; }
  }
</style>
