---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import NmtcCoefficientFigure from "../components/NmtcCoefficientFigure.astro";
import Portrait from "../components/Portrait.astro";
import { referees, availabilityRecord, identityRecord, nmtcPaperRecord, publicLinks, teachingRecognition, tutoringRecord } from "../data/public-record.mjs";
import { filterDiscoverableResearch } from "../data/research-discovery.mjs";

const pageTitle = "Ian Helfrich: 2026–27 economics job market";

const dossierIds = [
  "helfrich-2026-nmtc-rural-gap",
  "gonchar-helfrich-2025-spotlight",
  "helfrich-2024-ssrn-4772016",
  "helfrich-2024-dissertation",
];
const dossierResearch = filterDiscoverableResearch(await getCollection("research"))
  .filter((record) => dossierIds.includes(record.id))
  .sort((a, b) => dossierIds.indexOf(a.id) - dossierIds.indexOf(b.id));
---

<Base
  wide
  title={pageTitle}
  documentTitle={pageTitle}
  description="Ian Helfrich on the 2026–27 economics job market: the New Markets Tax Credit working paper, CV, resume, research record, and teaching record."
  pageClass="fieldbook-job-market"
>
  <section class="market-hero route-grid" data-rail-label="Job-market dossier">
    <div class="market-hero__copy">
      <p class="record-label">{availabilityRecord.cycle} · {availabilityRecord.asOf}</p>
      <h1>{pageTitle}</h1>
      <p class="market-position">{identityRecord.positionLine}</p>
      <p class="market-intro">I am an applied economist working across place-based policy, trade and spatial measurement, labor and AI, and quantitative education.</p>
      <div class="action-row">
        <a class="fieldbook-action" href={nmtcPaperRecord.pdf} data-goatcounter-click="pdf-nmtc-paper">Job market paper (PDF)</a>
        <a class="fieldbook-action fieldbook-action--quiet" href="/cv/ian-helfrich-cv.pdf" data-goatcounter-click="pdf-cv">CV (PDF)</a>
        <a class="fieldbook-action fieldbook-action--quiet" href="/cv/ian-helfrich-executive-resume.pdf" data-goatcounter-click="pdf-resume">Resume (PDF)</a>
        <span class="action-email"><a class="fieldbook-action fieldbook-action--quiet" href={publicLinks.email} data-goatcounter-click="email">Email Ian</a><span>{publicLinks.emailAddress}</span></span>
        <a class="fieldbook-action fieldbook-action--quiet" href="/book#job-market">Book a meeting</a>
      </div>
      <NmtcCoefficientFigure class="market-figure" plate>
        Rural coefficient on project leverage, the ratio of project cost to subsidized investment, pooled across all projects and within the same Community Development Entity. The within-CDE bar is the cluster-robust 95% confidence interval; the figure draws no pooled interval.
      </NmtcCoefficientFigure>
    </div>
    <aside role="note" class="market-hero__margin">
      <figure class="market-portrait">
        <Portrait sizes="96px" loading="eager" />
        <figcaption>{identityRecord.name}</figcaption>
      </figure>
      <p class="record-label">Current status</p>
      <strong>{availabilityRecord.status}</strong>
      <dl>
        <div><dt>Field</dt><dd>Applied microeconomics and econometrics</dd></div>
        <div><dt>Location</dt><dd>{identityRecord.location}</dd></div>
      </dl>
    </aside>
  </section>

  <section class="market-paper route-band" data-rail-label="Primary paper">
    <div class="route-shell route-shell--compact">
      <div class="paper-heading">
        <div>
          <p class="record-label">Job market paper · sole author and originator</p>
          <h2>{nmtcPaperRecord.title}:<span class="paper-subtitle"> {nmtcPaperRecord.subtitle}</span></h2>
          <p class="paper-version">Latest version: {nmtcPaperRecord.version}</p>
          <p class="paper-finding">{nmtcPaperRecord.finding}</p>
        </div>
        <aside role="note">
          <dl>
            <div><dt>Sample</dt><dd>19,907 transactions · 8,024 projects</dd></div>
            <div><dt>Raw coefficient</dt><dd>−0.262</dd></div>
            <div><dt>Mean within-CDE</dt><dd>−0.047 · 95% CI [−0.245, +0.152]</dd></div>
            <div><dt>Median within-CDE</dt><dd>−0.001</dd></div>
          </dl>
        </aside>
      </div>
      <div class="paper-account">
        <h3>Abstract</h3>
        <p>{nmtcPaperRecord.abstract}</p>
        <p>I assembled the transaction and project record, documented its provenance, estimated the pooled and within-intermediary comparisons, and decomposed the movement between them. {nmtcPaperRecord.design}</p>
        <p>This is descriptive, noncausal evidence. The mean interval is wide; the design does not identify why intermediaries differ or resolve the mechanism.</p>
        <p class="authorship-note">This project was my original idea, and I am its sole author. Katia Antunes and Elizaveta Gonchar contributed to it; they are not coauthors.</p>
      </div>
      <nav class="paper-links" aria-label="Primary paper links">
        <a href={nmtcPaperRecord.pdf} target="_blank" rel="noopener" data-goatcounter-click="pdf-nmtc-paper">Working paper · PDF ↗</a>
        <a href={nmtcPaperRecord.record}>Research record →</a>
        <a href="https://github.com/ihelfrich/us-nmtc-viewer" target="_blank" rel="noopener">Repository and evidence files ↗</a>
      </nav>
    </div>
  </section>

  <section class="market-references route-shell" data-rail-label="References" aria-labelledby="references-title">
    <header class="section-intro">
      <div>
        <p class="record-label">Letters of recommendation</p>
        <h2 id="references-title">References</h2>
      </div>
    </header>
    <ul class="referee-list">
      {referees.map((referee) => (
        <li>
          <h3>{referee.name}</h3>
          {referee.title && <p>{referee.title}</p>}
          <p>{referee.institution}</p>
          <p><a href={`mailto:${referee.email}`}>{referee.email}</a></p>
        </li>
      ))}
    </ul>
  </section>

  <section class="market-research route-shell" data-rail-label="Research record">
    <header class="section-intro">
      <div>
        <p class="record-label">Selected research</p>
        <h2>Research and current status</h2>
      </div>

    </header>
    <div class="dossier-list">
      {dossierResearch.map((record, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <p class="status-line">{record.data.displayStatus} · {record.data.year}</p>
            <h3><a href={`/research/${record.id}`}>{record.data.title}</a></h3>
            <p>{record.data.question}</p>
          </div>
          <aside role="note">
            <p><strong>Role</strong>{record.data.role}</p>
          </aside>
        </article>
      ))}
    </div>
    <a class="text-route" href="/research">Complete research ledger →</a>
  </section>

  <section class="market-teaching route-band" data-rail-label="Teaching">
    <div class="route-shell route-shell--compact">
      <header class="section-intro">
        <div>
          <p class="record-label">Teaching record</p>
          <h2>University classrooms, online courses, and quantitative coaching</h2>
        </div>
        <p>Instructor of record for three semesters at Georgia Tech; teaching support at Duke and Indiana; online instruction in microeconomics and macroeconomics; independent instruction and research-design coaching.</p>
      </header>
      <div class="teaching-evidence">
        <article><span>Award</span><strong>{teachingRecognition.award}, {teachingRecognition.year}</strong></article>
        <article><span>Evaluations</span><strong><a href={teachingRecognition.evaluations.href}>Georgia Tech course-evaluation record, {teachingRecognition.evaluations.year} →</a></strong></article>
        <article><span>Wyzant · platform-recorded</span><strong>{tutoringRecord.wyzant.hoursProse[0].toUpperCase() + tutoringRecord.wyzant.hoursProse.slice(1)} hours</strong></article>
        <article><span>Private practice · practice-recorded</span><strong>{tutoringRecord.privatePractice.hoursProse[0].toUpperCase() + tutoringRecord.privatePractice.hoursProse.slice(1)} additional hours</strong></article>
        <article><span>Materials</span><strong><a href="/teaching">Full teaching and coaching record →</a></strong></article>
      </div>
    </div>
  </section>

  <section class="market-close route-grid" data-rail-label="Documents and contact">
    <div>
      <p class="record-label">Documents and contact</p>
      <h2>CV and contact</h2>
    </div>
    <div class="market-links">
      <a href="/cv/ian-helfrich-cv.pdf" target="_blank" rel="noopener" data-goatcounter-click="pdf-cv">Academic CV · PDF ↗</a>
      <a href="/cv/ian-helfrich-executive-resume.pdf" target="_blank" rel="noopener" data-goatcounter-click="pdf-resume">Executive resume · PDF ↗</a>
      <a href="/cv">CV, career summary, and contact →</a>
      <a href={publicLinks.email} data-goatcounter-click="email">Email Ian →</a>
      <a href="/book#job-market">Book a 30-minute meeting →</a>
    </div>
  </section>
</Base>

<style>
  .route-shell { width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; padding-block: var(--ef-space-7); }
  .route-shell--compact { padding-block: 0; }
  .route-grid { display: grid; width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--ef-gutter); }
  .route-band { padding-block: var(--ef-space-7); background: var(--ef-figure); border-block: 1px solid var(--ef-ink); }
  .record-label,
  .status-line { margin: 0 0 0.7rem; color: var(--muted); font: 620 0.7rem/1.45 var(--font-data); letter-spacing: 0.07em; text-transform: uppercase; }
  /* 52px puts the kicker as far below the header as on /research, /teaching, /work and /about; space-8 left 200px empty above it. */
  .market-hero { min-height: 40rem; padding-top: 52px; padding-bottom: var(--ef-space-6); align-items: start; border-bottom: 1px solid var(--ef-ink); }
  .market-hero__copy { grid-column: 2 / span 7; }
  .market-hero h1 { max-width: 16ch; margin-bottom: 1rem; font-size: clamp(2.6rem, 5.4vw, 5.25rem); }
  .market-position { margin: 0 0 1rem; font-size: 1.08rem; font-weight: 600; }
  .market-intro { max-width: 64ch; margin: 0; font-size: 1.22rem; }
  .market-hero__margin { grid-column: 9 / span 3; padding-top: 0.8rem; border-top: 2px solid var(--ef-signal); }
  .market-hero__margin > strong { display: block; font-size: 1.05rem; }
  .market-portrait { display: flex; margin: 0 0 1.25rem; align-items: center; gap: 1rem; }
  .market-portrait :global(img) { display: block; width: 6rem; height: auto; aspect-ratio: 1; object-fit: cover; }
  .market-portrait figcaption { font: 600 1.05rem/1.3 var(--font-display); }
  .market-hero__margin dl { margin: 1rem 0 0; }
  .market-hero__margin dl > div { padding-block: 0.6rem; border-top: 1px solid var(--rule); }
  .market-hero__margin dt { color: var(--muted); font: 600 0.68rem/1.4 var(--font-data); text-transform: uppercase; }
  .market-hero__margin dd { margin: 0.2rem 0 0; }
  .action-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .fieldbook-action { display: inline-flex; min-height: 48px; padding: 0.8rem 1rem; align-items: center; color: var(--ef-figure); background: var(--ef-signal); border: 1px solid var(--ef-signal); border-radius: var(--ef-control-radius); font: 650 0.72rem/1 var(--font-data); text-decoration: none; text-transform: uppercase; }
  .fieldbook-action:hover { color: var(--ef-figure); background: var(--ef-ink); border-color: var(--ef-ink); }
  .fieldbook-action--quiet { color: var(--ef-ink); background: transparent; border-color: var(--ef-ink); }
  .action-email { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.75rem; }
  .action-email > span { font: 0.86rem/1.4 var(--font-data); }
  .market-figure { max-width: 40rem; margin-top: var(--ef-space-6); }
  .paper-heading { display: grid; grid-template-columns: minmax(0, 2fr) minmax(17rem, 0.8fr); gap: var(--ef-space-7); }
  .paper-heading h2 { max-width: 22ch; margin: 0; }
  .paper-subtitle { display: block; margin-top: 0.7rem; font-size: 0.52em; font-weight: 450; line-height: 1.2; }
  .paper-version { margin: 1rem 0 0; color: var(--muted); font: 620 0.7rem/1.45 var(--font-data); letter-spacing: 0.07em; text-transform: uppercase; }
  .paper-finding { max-width: 62ch; margin-top: 1.5rem; font-size: 1.25rem; }
  .paper-heading aside { padding-top: 0.7rem; border-top: 2px solid var(--ef-signal); }
  .paper-heading dl { margin: 0; }
  .paper-heading dl > div { display: grid; padding-block: 0.55rem; grid-template-columns: 1fr 1fr; gap: 0.7rem; border-bottom: 1px solid var(--rule); }
  .paper-heading dt { color: var(--muted); font: 600 0.68rem/1.4 var(--font-data); text-transform: uppercase; }
  .paper-heading dd { margin: 0; font-family: var(--font-data); font-size: 0.75rem; }
  .paper-account { max-width: 72ch; margin-top: var(--ef-space-6); font-size: 1.08rem; }
  .paper-account h3 { margin: 0 0 0.6rem; color: var(--muted); font: 620 0.7rem/1.45 var(--font-data); letter-spacing: 0.07em; text-transform: uppercase; }
  .authorship-note { padding-left: 1rem; border-left: 3px solid var(--ef-signal); }
  .paper-links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; margin-top: var(--ef-space-5); font: 620 0.72rem/1.4 var(--font-data); text-transform: uppercase; }
  .section-intro { display: grid; grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr); gap: var(--ef-space-6); align-items: end; }
  .section-intro h2 { margin: 0; }
  .section-intro > p { margin: 0; }
  .dossier-list { margin-top: var(--ef-space-6); border-top: 1px solid var(--ef-ink); }
  .dossier-list article { display: grid; padding-block: var(--ef-space-5); grid-template-columns: 3rem minmax(0, 2fr) minmax(15rem, 0.9fr); gap: var(--ef-space-5); border-bottom: 1px solid var(--rule); }
  .dossier-list article > span { color: var(--ef-signal); font: 600 0.76rem/1.4 var(--font-data); }
  .dossier-list h3 { margin: 0 0 0.75rem; font-size: clamp(1.35rem, 2.4vw, 2rem); }
  .dossier-list h3 a { color: var(--ef-ink); text-decoration: none; }
  .dossier-list aside { padding-left: 1rem; border-left: 1px solid var(--rule); }
  .dossier-list aside p { margin: 0; }
  .dossier-list aside strong { display: block; margin-bottom: 0.3rem; font: 650 0.68rem/1.4 var(--font-data); text-transform: uppercase; }
  .text-route { display: inline-block; margin-top: var(--ef-space-5); font: 620 0.72rem/1.4 var(--font-data); text-transform: uppercase; }
  .teaching-evidence { display: grid; margin-top: var(--ef-space-6); grid-template-columns: repeat(5, 1fr); border: 1px solid var(--ef-ink); }
  .teaching-evidence article { min-height: 10rem; padding: var(--ef-space-4); }
  .teaching-evidence article + article { border-left: 1px solid var(--ef-ink); }
  .teaching-evidence span { display: block; margin-bottom: 1rem; color: var(--muted); font: 620 0.68rem/1.4 var(--font-data); text-transform: uppercase; }
  .market-references { padding-bottom: 0; }
  .referee-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: var(--ef-space-5); margin: var(--ef-space-5) 0 0; padding: 0; list-style: none; }
  .referee-list li { margin: 0; padding-top: var(--ef-space-4); border-top: 1px solid var(--ef-ink); }
  .referee-list h3 { margin: 0 0 0.35rem; font-size: 1.15rem; }
  .referee-list p { margin: 0; line-height: 1.5; }
  .referee-list a { overflow-wrap: anywhere; }
  .market-close { padding-block: var(--ef-space-7); }
  .market-close > div:first-child { grid-column: 2 / span 7; }
  .market-close > div:last-child { grid-column: 9 / span 3; }
  .market-close h2 { margin: 0; }
  .market-links { display: grid; align-content: end; gap: 0.7rem; font: 620 0.72rem/1.4 var(--font-data); text-transform: uppercase; }
  @media (max-width: 60rem) {
    .market-hero__copy { grid-column: 1 / span 5; }
    .market-hero__margin { grid-column: 6 / span 3; }
    .section-intro { grid-template-columns: 1fr; }
    .dossier-list article { grid-template-columns: 2.5rem minmax(0, 1.5fr) minmax(13rem, 1fr); }
    .market-close > div:first-child { grid-column: 1 / span 5; }
    .market-close > div:last-child { grid-column: 6 / span 3; }
    .teaching-evidence { grid-template-columns: repeat(2, 1fr); }
    .teaching-evidence article:nth-child(odd):not(:first-child) { border-left: 0; }
    .teaching-evidence article:nth-child(n + 3) { border-top: 1px solid var(--ef-ink); }
  }
  @media (max-width: 45rem) {
    .route-grid { display: block; }
    .market-hero { min-height: auto; padding-top: 32px; padding-bottom: var(--ef-space-6); }
    .market-hero__margin { margin-top: var(--ef-space-5); }
    .route-shell { padding-block: var(--ef-space-6); }
    .paper-heading { grid-template-columns: 1fr; gap: var(--ef-space-5); }
    .dossier-list article { grid-template-columns: 2.5rem 1fr; }
    .dossier-list aside { grid-column: 2; padding: 1rem 0 0; border-top: 1px solid var(--rule); border-left: 0; }
    .teaching-evidence { grid-template-columns: 1fr; }
    .teaching-evidence article + article { border-top: 1px solid var(--ef-ink); border-left: 0; }
    .market-links { margin-top: var(--ef-space-5); }
  }
</style>
