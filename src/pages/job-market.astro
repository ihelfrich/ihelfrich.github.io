---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import portraitPlan from "../data/portrait-transport.json";
// The candidate as working paper, with a cover. The cover is the site's one
// midnight surface: fig. 0 renders the candidate's portrait as a measure of
// 4,200 mass points that assemble along a precomputed transport plan when
// the reader clicks "resolve" (points sampled from the photograph by
// brightness, paired to a gaussian start cloud along a Z-order curve so the
// flow reads as displacement interpolation). The typeset note follows.
// JMP designation remains the NMTC rural mobilization gap; swapping it is a
// one-block edit in section 2 plus one reference entry.

const papers = await getCollection("research");
const SHORT: Record<string, string> = {
  "helfrich-vardanyan-2026-ai-entry-level-labor": "AI × labor",
  "gonchar-helfrich-2025-spotlight": "Spotlight",
  "gonchar-helfrich-2026-effective-distance-panel": "Effective distance",
  "gonchar-helfrich-2026-ukraine": "Ukraine",
  "helfrich-2024-ssrn-4772016": "OT equilibrium",
  "helfrich-2026-aroe": "AROE",
  "helfrich-2026-penumbra": "Penumbra",
  "helfrich-2026-russian-crude": "Russian crude",
  "helfrich-2026-nmtc-rural-gap": "NMTC",
};
const nodes = papers.map((p) => ({
  id: p.id,
  short: SHORT[p.id] ?? p.data.title.slice(0, 16),
  title: p.data.title,
  year: p.data.year,
  tags: p.data.tags,
}));
const edges: { a: number; b: number; w: number; shared: string[] }[] = [];
for (let i = 0; i < nodes.length; i++)
  for (let j = i + 1; j < nodes.length; j++) {
    const shared = nodes[i].tags.filter((t) => nodes[j].tags.includes(t));
    if (shared.length > 0) edges.push({ a: i, b: j, w: shared.length, shared });
  }
const mapData = { nodes, edges };
---
<Base
  wide
  pageClass="paper-page"
  title="Job market"
  description="Ian Helfrich is on the 2026-27 economics job market. A candidate note for hiring committees, typeset as a working paper, with live figures."
>
  <section class="cover" aria-label="Cover">
    <div class="cover-inner">
      <div class="cover-type">
        <p class="cover-eyebrow">AEA job market · 2026-27 cycle</p>
        <h1>Making Complex<br />Evidence Usable</h1>
        <p class="cover-sub">The candidate note of Ian Helfrich, typeset as a working paper. Two of its figures are live instruments. It begins below.</p>
        <p class="cover-cta"><a href="#note">Read the note ↓</a></p>
      </div>
      <figure class="cover-fig">
        <canvas id="fig0" aria-label="The candidate's portrait, rendered as a cloud of mass points that assemble when resolved"></canvas>
        <figcaption>
          <span>fig. 0 · the candidate, as a measure · n = 4,200</span>
          <button type="button" id="fig0-btn">resolve</button>
        </figcaption>
      </figure>
    </div>
  </section>

  <article class="paper" id="note">
    <header class="paper-head">
      <p class="paper-eyebrow">AEA job market · 2026-27 cycle · this draft: August 2026</p>
      <p class="paper-doc-title">Making Complex Evidence Usable</p>
      <p class="paper-sub">A candidate note for hiring committees, with live figures</p>
      <p class="paper-author">Ian Helfrich<a class="fn-ref" href="#fn-corr" id="ref-corr">†</a></p>
      <p class="paper-affil">Ph.D. Economics, Georgia Institute of Technology, 2024</p>
      <p class="paper-jel">JEL: C14 · F14 · R12 · J23 &nbsp;·&nbsp; Keywords: applied econometrics, international trade, spatial economics, optimal transport, labor and AI</p>
      <nav class="paper-links" aria-label="Candidate documents">
        <a href="/cv/helfrich-cv-july-2026.pdf" target="_blank" rel="noopener">[ one-page CV ]</a>
        <a href="/cv/helfrich-cv-full.pdf" target="_blank" rel="noopener">[ full CV ]</a>
        <a href="/cv/cios-evals-2022.pdf" target="_blank" rel="noopener">[ evaluations ]</a>
        <a href="mailto:ianthelfrich@gmail.com?subject=Faculty%20search%20inquiry">[ email ]</a>
      </nav>
    </header>

    <section class="paper-abstract" aria-label="Abstract">
      <h2>Abstract</h2>
      <p>
        This note summarizes the candidacy of Ian Helfrich for the 2026-27 economics
        job market. The candidate is an applied econometrician working on spatial and
        high-dimensional methods, economic networks, and international trade, with a
        job market paper showing that 82.2 percent of the apparent rural penalty in
        U.S. New Markets Tax Credit leverage is between-intermediary selection. The
        research program spans satellite-calibrated trade costs, optimal transport
        theory, and the labor-market effects of generative AI. Two figures in this
        note are live instruments; the reader is invited to handle them. Availability
        runs through the December signal window and ASSA 2027.
      </p>
    </section>

    <section aria-labelledby="s1">
      <h2 id="s1">1&ensp;The candidate</h2>
      <p>
        The candidate holds a Ph.D. in Economics from the Georgia Institute of
        Technology (2024) with a doctoral minor in quantitative psychology, an M.S. in
        Geographic Information Science and Technology (2022), and prior degrees in
        economics from Georgia Tech, Indiana University, the Barcelona School of
        Economics, and the University of North Carolina at Chapel Hill. His advisors
        are Dr. Tibor Besedes and Dr. Usha Nair-Reichert.<a class="fn-ref" href="#fn-letters" id="ref-letters">1</a>
      </p>
      <p>
        Primary fields are applied econometrics, international trade, and spatial and
        urban economics; secondary fields are economic networks, labor and AI, and
        policy evaluation. A single test runs through the work: pick the wrong metric,
        comparison, or network representation and the economics is gone before
        estimation starts. Most of the papers below began as a failure of that test
        somewhere in the wild.
      </p>
    </section>

    <section aria-labelledby="s2">
      <h2 id="s2">2&ensp;The job market paper</h2>
      <p class="paper-jmp-title">
        <a href="/research/helfrich-2026-nmtc-rural-gap">"The rural mobilization gap in U.S. place-based tax credit"</a>
        &nbsp;·&nbsp; sole-authored &nbsp;·&nbsp; working paper, 2026
      </p>
      <p>
        The paper decomposes the rural-versus-urban private-leverage gap in the U.S.
        New Markets Tax Credit using Community Development Entity fixed effects, on a
        project-level panel linking every Qualified Equity Investment from FY2001 to
        FY2022 to its issuing intermediary. The raw rural gap of &minus;0.262 falls to
        &minus;0.047 (p = 0.64) once CDE identity enters the model: 82.2 percent of
        the apparent rural penalty is between-intermediary selection. A Chetty-Kleven
        style bunching test shows the 20 percent non-metro mandate does not bind in
        cumulative-deployment data. The decomposition moves the policy target
        upstream, from rural project markets to the CDFI Fund rules that decide which
        intermediaries receive allocation authority. Replication code and an
        interactive viewer are public (<a href="https://github.com/ihelfrich/us-nmtc-viewer" target="_blank" rel="noopener">github.com/ihelfrich/us-nmtc-viewer</a>).
      </p>
    </section>

    <section aria-labelledby="s3">
      <h2 id="s3">3&ensp;The research program</h2>
      <p>
        Nine papers are active; Figure 1 draws them as a graph whose edges are
        computed from the papers' own method tags. The connected component runs from
        optimal transport theory (Helfrich 2024) through satellite-calibrated
        measurement (Gonchar and Helfrich 2025, 2026) to the sanctions-era
        observation program. Two papers sit apart deliberately: separate lines of
        work in place-based policy and in labor. Full records, abstracts, and code
        are indexed in the references.
      </p>
      <figure class="paper-fig">
        <svg id="pgm2" viewBox="0 0 1000 460" role="img" aria-label="Graph of the candidate's papers connected by shared method tags"></svg>
        <figcaption>
          <strong>Figure 1.</strong> The research program as a graph. Nodes are
          papers; edge weight is the number of shared method tags. The layout is a
          force solve. The figure is live: drag a node to test the structure, or
          click it to open the paper's record.
          <span class="paper-fig-readout" id="pgm2-readout"></span>
        </figcaption>
      </figure>
    </section>

    <section aria-labelledby="s4">
      <h2 id="s4">4&ensp;Teaching</h2>
      <p>
        The candidate's teaching record spans instruction of record, graduate
        assistantship, and a large independent practice, summarized in Table 1. The
        open teaching infrastructure consists of public, browser-native course
        environments in active classroom use.<a class="fn-ref" href="#fn-est" id="ref-est">2</a>
      </p>
      <table class="paper-table">
        <caption><strong>Table 1.</strong> Teaching record.</caption>
        <thead>
          <tr><th>Role</th><th>Detail</th><th class="num">Scale</th></tr>
        </thead>
        <tbody>
          <tr><td>Instructor of record</td><td>Georgia Tech: economics and policy; principles of microeconomics</td><td class="num">3 semesters</td></tr>
          <tr><td>Graduate TA</td><td>Undergraduate economics; graduate econometrics; ECE signal processing</td><td class="num">4 courses</td></tr>
          <tr><td>Independent instruction</td><td>Economics, statistics, econometrics, finance, test preparation</td><td class="num">1,200+ hrs · 450+ students</td></tr>
          <tr><td>Recognition</td><td>Graduate Teaching Assistant of the Year, Georgia Tech (<a href="/cv/cios-evals-2022.pdf" target="_blank" rel="noopener">evaluations</a>)</td><td class="num">2023</td></tr>
          <tr><td>Open infrastructure</td><td><a href="https://github.com/ihelfrich/stats-lab" target="_blank" rel="noopener">Stats Lab</a>, <a href="https://github.com/ihelfrich/inference-lab" target="_blank" rel="noopener">Inference Lab</a>, <a href="https://github.com/ihelfrich/macroprep" target="_blank" rel="noopener">Macro Prep</a>, <a href="https://github.com/ihelfrich/econ101a" target="_blank" rel="noopener">Econ 101A</a>, <a href="https://github.com/ihelfrich/ppd504-studio" target="_blank" rel="noopener">PPD 504 Studio</a>, <a href="https://github.com/ihelfrich/pictures-of-inference" target="_blank" rel="noopener">Pictures of Inference</a></td><td class="num">6 sites</td></tr>
        </tbody>
      </table>
    </section>

    <section aria-labelledby="s5">
      <h2 id="s5">5&ensp;Availability</h2>
      <p>
        The candidate is applying through AEA JOE this cycle and is available for
        interviews through the December signal window and at ASSA in January 2027,
        in person or remote. Figure 2 places today against the market calendar.
        Research and teaching statements, evaluations, and reference letters arrive
        by email the same day they are requested.
      </p>
      <figure class="paper-fig">
        <svg id="cyc" viewBox="0 0 1000 150" role="img" aria-label="Timeline of the AEA 2026-27 job market cycle with a marker at today's date"></svg>
        <figcaption>
          <strong>Figure 2.</strong> The AEA 2026-27 cycle, to scale. The blue
          cursor is live and marks the day you are reading this.
        </figcaption>
      </figure>
    </section>

    <div class="paper-fnrule" role="separator"></div>
    <section class="paper-fns" aria-label="Footnotes">
      <p id="fn-corr"><span class="fn-mark">†</span> Corresponding candidate: <a href="mailto:ianthelfrich@gmail.com">ianthelfrich@gmail.com</a> &nbsp;·&nbsp; <a href="https://ihelfrich.github.io">ihelfrich.github.io</a> &nbsp;·&nbsp; <a href="https://github.com/ihelfrich" target="_blank" rel="noopener">github.com/ihelfrich</a> <a class="fn-back" href="#ref-corr">↩</a></p>
      <p id="fn-letters"><span class="fn-mark">1</span> Reference letters are
        delivered through application portals or directly to the committee on
        request. <a class="fn-back" href="#ref-letters">↩</a></p>
      <p id="fn-est"><span class="fn-mark">2</span> An interactive least-squares
        estimator accompanies the <a href="/teaching">teaching portfolio</a>: the
        reader places the data and the model refits, standard errors included, on
        every change. The mathematics behind this note's figures is documented in
        the <a href="/colophon">colophon</a>. <a class="fn-back" href="#ref-est">↩</a></p>
    </section>

    <section class="paper-refs" aria-labelledby="refs-title">
      <h2 id="refs-title">References</h2>
      <p>Gonchar, Elizaveta, and Ian Helfrich (2025). "Trade in the spotlight: nightlights and population-weighted distance." SSRN 5202676. <a href="/research/gonchar-helfrich-2025-spotlight">[record]</a></p>
      <p>Gonchar, Elizaveta, and Ian Helfrich (2026). "Effective distance: a satellite-calibrated bilateral trade-cost panel, 2000-2024." Working paper. <a href="/research/gonchar-helfrich-2026-effective-distance-panel">[record]</a></p>
      <p>Helfrich, Ian (2024). "A unifying framework for economic equilibrium and optimal transport in infinite-dimensional Hilbert spaces." SSRN 4772016. <a href="/research/helfrich-2024-ssrn-4772016">[record]</a></p>
      <p>Helfrich, Ian (2026). "The rural mobilization gap in U.S. place-based tax credit." Working paper; job market paper. <a href="/research/helfrich-2026-nmtc-rural-gap">[record]</a></p>
      <p>Helfrich, Ian (2026). "Penumbra: closed-loop observation under measurement gaps in cross-border trade." Draft. <a href="/research/helfrich-2026-penumbra">[record]</a></p>
      <p>Helfrich, Ian, and Shane Vardanyan (2026). "AI and the entry-level labor market." Working paper. <a href="/research/helfrich-vardanyan-2026-ai-entry-level-labor">[record]</a></p>
      <p class="paper-refs-more"><a href="/research">Complete program, with abstracts and code →</a></p>
    </section>
  </article>
</Base>

<script is:inline type="application/json" id="pgm2-data" set:html={JSON.stringify(mapData)} />
<script is:inline type="application/json" id="fig0-data" set:html={JSON.stringify(portraitPlan)} />

<script>
  // ── fig. 0: the candidate, as a measure ─────────────────────────────────
  // 4,200 points sampled from the portrait by brightness, paired to a
  // gaussian start cloud along a Z-order curve. "Resolve" flows the mass
  // along the plan (displacement interpolation); "disperse" reverses it.
  // Motion runs only on the visitor's click and stops at the endpoints.
  const fig0 = document.getElementById("fig0") as HTMLCanvasElement | null;
  const fig0Btn = document.getElementById("fig0-btn");
  const fig0Data = document.getElementById("fig0-data");
  if (fig0 && fig0Btn && fig0Data) {
    const ctx = fig0.getContext("2d")!;
    const { s, e } = JSON.parse(fig0Data.textContent || "{}") as { s: [number, number][]; e: [number, number, number][] };
    const N = e.length;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const FLOW = 1700;
    let size = 0, dpr = 1;
    let resolved = false, animFrom = 0, animT0 = -1, raf = 0;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    function resize() {
      const r = fig0.getBoundingClientRect();
      size = Math.max(1, r.width);
      dpr = Math.min(2, window.devicePixelRatio || 1);
      fig0.width = Math.round(size * dpr);
      fig0.height = Math.round(size * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw(resolved ? 1 : 0);
    }
    function draw(t: number) {
      ctx.clearRect(0, 0, size, size);
      const transit = t > 0.001 && t < 0.999;
      const wave = transit ? Math.sin(Math.PI * t) : 0;
      for (let i = 0; i < N; i++) {
        const x = (s[i][0] + (e[i][0] - s[i][0]) * t) * size;
        const y = (s[i][1] + (e[i][1] - s[i][1]) * t) * size;
        const b = e[i][2];
        const r_ = (1.05 + (0.55 + 0.85 * b) * t) * (size / 520);
        if (transit && i % 3 === 0) {
          ctx.fillStyle = `rgba(40,82,232,${0.5 + 0.4 * wave})`;
        } else {
          const a = 0.5 + 0.42 * (t * b + (1 - t) * 0.35);
          ctx.fillStyle = `rgba(242,234,222,${a})`;
        }
        ctx.beginPath();
        ctx.arc(x, y, r_, 0, 6.2832);
        ctx.fill();
      }
    }
    function step(now: number) {
      const raw = Math.min(1, (now - animT0) / FLOW);
      const t = resolved ? animFrom + (1 - animFrom) * ease(raw) : animFrom * (1 - ease(raw));
      draw(t);
      if (raw < 1) { raf = requestAnimationFrame(step); return; }
      animT0 = -1;
      fig0Btn!.textContent = resolved ? "disperse" : "resolve";
    }
    function toggle() {
      if (animT0 >= 0) return;
      resolved = !resolved;
      if (reduced) { draw(resolved ? 1 : 0); fig0Btn!.textContent = resolved ? "disperse" : "resolve"; return; }
      animFrom = resolved ? 0 : 1;
      animT0 = performance.now();
      fig0Btn!.textContent = "resolving";
      raf = requestAnimationFrame(step);
    }
    fig0Btn.addEventListener("click", toggle);
    fig0.addEventListener("pointerdown", toggle);
    new ResizeObserver(() => { cancelAnimationFrame(raf); animT0 = -1; resize(); }).observe(fig0);
    resize();
  }

  // ── Figure 1: the program map (compact variant of /research's instrument)
  const svg2 = document.getElementById("pgm2") as unknown as SVGSVGElement | null;
  const data2 = document.getElementById("pgm2-data");
  const ro2 = document.getElementById("pgm2-readout");
  if (svg2 && data2) {
    const { nodes, edges } = JSON.parse(data2.textContent || "{}");
    const Wv = 1000, Hv = 460, CX = Wv / 2, CY = Hv / 2 - 10;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const N = nodes.length;
    const X = new Float64Array(N), Y = new Float64Array(N);
    const VX = new Float64Array(N), VY = new Float64Array(N);
    const GOLD = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < N; i++) {
      const a = i * GOLD, r = 130 + 16 * i;
      X[i] = CX + Math.cos(a) * r; Y[i] = CY + Math.sin(a) * r * 0.66;
    }
    const NS = "http://www.w3.org/2000/svg";
    const edgeEls: SVGLineElement[] = [], nodeEls: SVGGElement[] = [];
    for (const e of edges) {
      const l = document.createElementNS(NS, "line");
      l.setAttribute("stroke", "rgba(17,17,19,0.22)");
      l.setAttribute("stroke-width", String(0.8 + e.w * 0.9));
      svg2.appendChild(l); edgeEls.push(l as SVGLineElement);
    }
    nodes.forEach((n: any, i: number) => {
      const g = document.createElementNS(NS, "g");
      g.setAttribute("cursor", "pointer");
      g.setAttribute("tabindex", "0");
      g.setAttribute("role", "link");
      g.setAttribute("aria-label", n.title);
      const halo = document.createElementNS(NS, "circle");
      halo.setAttribute("r", "16"); halo.setAttribute("fill", "transparent");
      const c = document.createElementNS(NS, "circle");
      c.setAttribute("r", "6.5"); c.setAttribute("fill", "#111113");
      const t = document.createElementNS(NS, "text");
      t.textContent = n.short;
      t.setAttribute("text-anchor", "middle");
      t.setAttribute("fill", "#66666c");
      t.setAttribute("style", "font: 520 10.5px var(--ih-mono); pointer-events: none;");
      const title = document.createElementNS(NS, "title");
      title.textContent = `${n.title} (${n.year})`;
      g.append(halo, c, t, title);
      svg2.appendChild(g); nodeEls.push(g as SVGGElement);
    });
    let running = false, raf = 0, dragging = -1, dragMoved = 0;
    function physics() {
      let energy = 0;
      for (let i = 0; i < N; i++) {
        if (i === dragging) continue;
        let fx = (CX - X[i]) * 0.01, fy = (CY - Y[i]) * 0.012;
        for (let j = 0; j < N; j++) {
          if (j === i) continue;
          const dx = X[i] - X[j], dy = Y[i] - Y[j];
          const d2 = Math.max(140, dx * dx + dy * dy), d = Math.sqrt(d2);
          fx += (dx / d) * (7200 / d2); fy += (dy / d) * (7200 / d2);
        }
        VX[i] = (VX[i] + fx) * 0.85; VY[i] = (VY[i] + fy) * 0.85;
      }
      for (const e of edges) {
        const dx = X[e.b] - X[e.a], dy = Y[e.b] - Y[e.a];
        const d = Math.max(1, Math.hypot(dx, dy));
        const f = (d - (180 - 34 * Math.min(3, e.w))) * 0.016 * e.w;
        const ux = dx / d, uy = dy / d;
        if (e.a !== dragging) { VX[e.a] += ux * f; VY[e.a] += uy * f; }
        if (e.b !== dragging) { VX[e.b] -= ux * f; VY[e.b] -= uy * f; }
      }
      for (let i = 0; i < N; i++) {
        if (i === dragging) continue;
        X[i] = Math.min(Wv - 60, Math.max(60, X[i] + VX[i]));
        Y[i] = Math.min(Hv - 40, Math.max(30, Y[i] + VY[i]));
        energy += VX[i] * VX[i] + VY[i] * VY[i];
      }
      return energy;
    }
    function render() {
      edges.forEach((e: any, k: number) => {
        edgeEls[k].setAttribute("x1", String(X[e.a])); edgeEls[k].setAttribute("y1", String(Y[e.a]));
        edgeEls[k].setAttribute("x2", String(X[e.b])); edgeEls[k].setAttribute("y2", String(Y[e.b]));
      });
      nodeEls.forEach((g, i) => {
        g.setAttribute("transform", `translate(${X[i]},${Y[i]})`);
        (g.children[2] as SVGTextElement).setAttribute("y", "22");
      });
    }
    function step() {
      const e = physics();
      render();
      if (e < 0.02 && dragging < 0) { running = false; return; }
      raf = requestAnimationFrame(step);
    }
    function wake() { if (!running) { running = true; raf = requestAnimationFrame(step); } }
    function svgPt(ev: PointerEvent) {
      const inv = svg2.getScreenCTM()!.inverse();
      return { x: ev.clientX * inv.a + ev.clientY * inv.c + inv.e, y: ev.clientX * inv.b + ev.clientY * inv.d + inv.f };
    }
    nodeEls.forEach((g, i) => {
      g.addEventListener("pointerdown", (ev) => {
        dragging = i; dragMoved = 0;
        g.setPointerCapture(ev.pointerId); ev.preventDefault(); wake();
      });
      g.addEventListener("pointermove", (ev) => {
        if (dragging !== i) return;
        const p = svgPt(ev);
        dragMoved += Math.abs(p.x - X[i]) + Math.abs(p.y - Y[i]);
        X[i] = p.x; Y[i] = p.y; VX[i] = 0; VY[i] = 0; wake();
      });
      g.addEventListener("pointerup", () => {
        const wasDrag = dragMoved > 6;
        dragging = -1; wake();
        if (!wasDrag) window.location.href = `/research/${nodes[i].id}`;
      });
      g.addEventListener("keydown", (ev) => {
        if ((ev as KeyboardEvent).key === "Enter") window.location.href = `/research/${nodes[i].id}`;
      });
      g.addEventListener("mouseenter", () => {
        (g.children[1] as SVGCircleElement).setAttribute("fill", "#2852e8");
        edges.forEach((e: any, k: number) => {
          if (e.a === i || e.b === i) edgeEls[k].setAttribute("stroke", "rgba(40,82,232,0.6)");
        });
        if (ro2) ro2.textContent = ` Hovering: ${nodes[i].title} (${nodes[i].year}).`;
      });
      g.addEventListener("mouseleave", () => {
        (g.children[1] as SVGCircleElement).setAttribute("fill", "#111113");
        edgeEls.forEach((l) => l.setAttribute("stroke", "rgba(17,17,19,0.22)"));
        if (ro2) ro2.textContent = "";
      });
    });
    if (reduced) {
      for (let s = 0; s < 700; s++) if (physics() < 0.02) break;
      render();
    } else { render(); wake(); }
  }

  // ── Figure 2: the cycle instrument (unchanged mathematics, paper styling)
  const svg = document.getElementById("cyc");
  if (svg) {
    const NS = "http://www.w3.org/2000/svg";
    const T0 = new Date("2026-08-01T00:00:00").getTime();
    const T1 = new Date("2027-03-01T00:00:00").getTime();
    const L = 14, R = 986, AX = 108;
    const x = (d: string | number) =>
      L + ((typeof d === "number" ? d : new Date(d + "T12:00:00").getTime()) - T0) / (T1 - T0) * (R - L);
    const el = (tag: string, attrs: Record<string, string>, text?: string) => {
      const n = document.createElementNS(NS, tag);
      for (const k in attrs) n.setAttribute(k, attrs[k]);
      if (text) n.textContent = text;
      svg.appendChild(n);
      return n;
    };
    const MONO = "font: 520 10.5px var(--ih-mono);";
    const band = (d0: string, d1: string, y: number, label: string) => {
      el("rect", { x: String(x(d0)), y: String(y), width: String(x(d1) - x(d0)), height: "16",
        rx: "3", fill: "rgba(17,17,19,0.07)", stroke: "rgba(17,17,19,0.28)", "stroke-width": "0.6" });
      el("text", { x: String(x(d0) + 5), y: String(y + 11.5), fill: "#3d3d42", style: MONO }, label);
    };
    el("line", { x1: String(L), y1: String(AX), x2: String(R), y2: String(AX), stroke: "#111113", "stroke-width": "1" });
    const months = ["2026-08-01","2026-09-01","2026-10-01","2026-11-01","2026-12-01","2027-01-01","2027-02-01","2027-03-01"];
    const names = ["Aug","Sep","Oct","Nov","Dec","Jan 27","Feb",""];
    months.forEach((m, i) => {
      const X = x(m);
      el("line", { x1: String(X), y1: String(AX - 4), x2: String(X), y2: String(AX + 4), stroke: "#898781", "stroke-width": "1" });
      if (names[i]) el("text", { x: String(X + 4), y: String(AX + 18), fill: "#898781", style: MONO }, names[i]);
    });
    band("2026-08-01", "2027-01-31", 30, "JOE listings open · Aug 1 to Jan 31");
    band("2026-10-01", "2026-11-30", 58, "deadline cluster · Oct to Nov");
    band("2026-12-01", "2026-12-15", 58, "");
    el("text", { x: String(x("2026-12-01")), y: "53", fill: "#3d3d42", style: MONO }, "signals · early Dec");
    const ax2 = x("2027-01-03");
    el("path", { d: `M ${ax2} ${AX - 9} l 5 6 l -5 6 l -5 -6 z`, fill: "#111113" });
    el("text", { x: String(ax2 + 8), y: String(AX - 8), fill: "#3d3d42", style: MONO }, "ASSA · Jan 2027");
    const now = Date.now();
    if (now >= T0 && now <= T1) {
      const X = x(now);
      el("line", { x1: String(X), y1: "22", x2: String(X), y2: String(AX + 6), stroke: "#2852e8", "stroke-width": "1.6" });
      const d = new Date();
      const lbl = `today · ${d.toLocaleDateString("en-US", { month: "short", day: "numeric" })}`;
      const anchor = X > R - 120 ? "end" : "start";
      el("text", { x: String(X + (anchor === "end" ? -6 : 6)), y: "18", fill: "#2852e8",
        "text-anchor": anchor, style: MONO }, lbl);
    }
  }
</script>

