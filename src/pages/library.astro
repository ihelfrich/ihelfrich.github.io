---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { isArchivalProject } from "../data/archival-projects.mjs";
import { filterDiscoverableResearch } from "../data/research-discovery.mjs";

const [allResearch, datasets, notes, allProjects] = await Promise.all([
  getCollection("research"),
  getCollection("datasets"),
  getCollection("writing", ({ data }) => !data.draft),
  getCollection("projects"),
]);
const research = filterDiscoverableResearch(allResearch);
const projects = allProjects.filter((entry) => !isArchivalProject(entry.id));
const fmt = (date) => new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });

const items = [
  ...research.map((entry) => ({
    type: "research",
    typeLabel: "Research",
    date: new Date(`${entry.data.year}-01-01`),
    year: entry.data.year,
    title: entry.data.title,
    summary: entry.data.question,
    status: entry.data.displayStatus,
    detail: entry.data.role,
    tags: [...entry.data.method, ...entry.data.tags],
    href: `/research/${entry.id}`,
    artifact: entry.data.pdf ?? entry.data.ssrn ?? entry.data.repo,
  })),
  ...datasets.map((entry) => ({
    type: "dataset",
    typeLabel: "Dataset",
    date: new Date(`${entry.data.year}-01-02`),
    year: entry.data.year,
    title: entry.data.title,
    summary: entry.data.blurb,
    status: entry.data.status,
    detail: `${entry.data.authors.join(", ")} · ${entry.data.license}`,
    tags: entry.data.tags,
    href: `/datasets/${entry.id}`,
    artifact: entry.data.doi ? `https://doi.org/${entry.data.doi}` : entry.data.zenodo ?? entry.data.viewer ?? entry.data.repo,
  })),
  ...notes.map((entry) => ({
    type: "note",
    typeLabel: "Note",
    date: entry.data.date,
    year: entry.data.date.getFullYear(),
    title: entry.data.title,
    summary: entry.data.summary,
    status: "Published note",
    detail: fmt(entry.data.date),
    tags: entry.data.tags,
    href: `/writing/${entry.id}`,
    artifact: undefined,
  })),
  ...projects.map((entry) => ({
    type: "project",
    typeLabel: "Project",
    date: entry.data.date,
    year: entry.data.date.getFullYear(),
    title: entry.data.title,
    summary: entry.data.blurb,
    status: entry.data.status,
    detail: fmt(entry.data.date),
    tags: entry.data.tags,
    href: `/projects/${entry.id}`,
    artifact: entry.data.url ?? entry.data.repo,
  })),
].sort((a, b) => +b.date - +a.date || a.title.localeCompare(b.title));

const channels = [
  ["research", "Research"],
  ["dataset", "Datasets"],
  ["project", "Projects"],
  ["note", "Notes"],
].map(([type, label]) => ({ type, label, count: items.filter((item) => item.type === type).length }));
---

<Base wide pageClass="quiet-library-page" title="Public index" description="A searchable index of Ian Helfrich's public research, datasets, projects, and writing.">
  <div class="library-shell">
    <header class="library-header">
      <div>
        <p class="library-label">Public record · {items.length} entries</p>
        <h1>Public index</h1>
      </div>
      <div class="library-intro">
        <p>Research, datasets, projects, and dated notes in one index. Each row states its current status and opens a record with context, provenance, or limits.</p>
        <nav aria-label="Machine-readable and syndicated records"><a href="/archive.json">JSON</a><a href="/rss.xml">RSS</a></nav>
      </div>
    </header>

    <section class="library-controls" aria-labelledby="index-controls-title" data-public-index>
      <h2 id="index-controls-title" class="sr-only">Filter public records</h2>
      <label><span>Search records</span><input type="search" placeholder="Title, topic, method, or author" data-library-query /></label>
      <div class="filter-group" role="group" aria-label="Filter by record type">
        <button type="button" class="is-active" aria-pressed="true" data-library-filter="all">All <span>{items.length}</span></button>
        {channels.map((channel) => <button type="button" aria-pressed="false" data-library-filter={channel.type}>{channel.label} <span>{channel.count}</span></button>)}
      </div>
      <output data-library-count aria-live="polite">{items.length} records visible</output>
    </section>

    <ol class="library-list" data-library-list>
      {items.map((item, index) => (
        <li data-library-item data-type={item.type} data-search={`${item.typeLabel} ${item.title} ${item.summary} ${item.status} ${item.detail} ${item.tags.join(" ")}`.toLowerCase()}>
          <p class="accession"><span>{String(index + 1).padStart(2, "0")}</span><small>{item.typeLabel}</small></p>
          <article>
            <p class="record-meta">{item.status} · {item.year}</p>
            <h2><a href={item.href}>{item.title}</a></h2>
            <p>{item.summary}</p>
            <ul aria-label="Methods and topics">{item.tags.slice(0, 5).map((tag) => <li>{tag}</li>)}</ul>
          </article>
          <aside>
            <strong>{item.detail}</strong>
            <a href={item.href}>Open record</a>
            {item.artifact && <a href={item.artifact} target="_blank" rel="noopener">Public artifact</a>}
          </aside>
        </li>
      ))}
    </ol>
    <p class="library-empty" data-library-empty hidden>No public record matches this query and record type.</p>

    <footer class="library-policy">
      <div><strong>Statuses are literal</strong><p>Draft, development, preprint, public working paper, and published dissertation name different stages.</p></div>
      <div><strong>Private work stays private</strong><p>Learners, clients, and private advisory relationships are excluded from this public index.</p></div>
      <div><strong>Changes remain dated</strong><p>Versions and update dates make revisions visible without implying that earlier records were final.</p></div>
    </footer>
  </div>
</Base>

<script is:inline>
  document.querySelectorAll("[data-public-index]").forEach((controls) => {
    const query = controls.querySelector("[data-library-query]");
    const buttons = Array.from(controls.querySelectorAll("[data-library-filter]"));
    const count = controls.querySelector("[data-library-count]");
    const list = document.querySelector("[data-library-list]");
    const records = Array.from(list?.querySelectorAll("[data-library-item]") ?? []);
    const empty = document.querySelector("[data-library-empty]");
    let filter = "all";
    const update = () => {
      const needle = query?.value.trim().toLowerCase() ?? "";
      let visible = 0;
      records.forEach((record) => {
        const typeMatches = filter === "all" || record.dataset.type === filter;
        const queryMatches = !needle || record.dataset.search.includes(needle);
        record.hidden = !(typeMatches && queryMatches);
        if (!record.hidden) visible += 1;
      });
      if (count) count.textContent = `${visible} ${visible === 1 ? "record" : "records"} visible`;
      if (empty) empty.hidden = visible > 0;
    };
    buttons.forEach((button) => button.addEventListener("click", () => {
      filter = button.dataset.libraryFilter;
      buttons.forEach((candidate) => {
        const active = candidate === button;
        candidate.classList.toggle("is-active", active);
        candidate.setAttribute("aria-pressed", String(active));
      });
      update();
    }));
    query?.addEventListener("input", update);
  });
</script>

<style>
  .library-shell { width: min(100%, 78rem); margin-inline: auto; }
  .library-header { display: grid; padding-block: clamp(2rem, 6vw, 5rem); grid-template-columns: minmax(0, 1.3fr) minmax(18rem, .7fr); gap: 2rem 5rem; align-items: end; border-block: 1px solid var(--ef-ink); }
  .library-label, .library-controls label span, .library-controls output, .accession, .record-meta { color: var(--muted); font: 620 .68rem/1.5 var(--font-data); letter-spacing: .07em; text-transform: uppercase; }
  .library-header h1 { margin: .6rem 0 0; font-size: clamp(3.6rem, 8vw, 7rem); }
  .library-intro > p { margin: 0; font-size: 1.15rem; }
  .library-intro nav { display: flex; margin-top: 1rem; gap: 1.25rem; }
  .library-intro nav a { display: inline-flex; min-height: 44px; align-items: center; font: 650 .7rem/1.4 var(--font-data); }
  .library-controls { display: grid; margin-top: 3rem; grid-template-columns: minmax(16rem, 1fr) auto; border: 1px solid var(--ef-ink); }
  .library-controls label { display: grid; min-width: 0; padding: .75rem 1rem; gap: .2rem; }
  .library-controls input { width: 100%; min-height: 44px; padding: 0; color: var(--ef-ink); background: transparent; border: 0; border-radius: 0; font: 560 1rem/1.4 var(--font-display); }
  .library-controls input:focus-visible { outline-offset: -2px; }
  .filter-group { display: flex; border-left: 1px solid var(--ef-ink); }
  .filter-group button { min-width: 78px; min-height: 68px; padding: .6rem; color: var(--ef-ink); background: transparent; border: 0; border-left: 1px solid var(--rule); border-radius: 0; cursor: pointer; font: 620 .64rem/1.4 var(--font-data); text-transform: uppercase; }
  .filter-group button:first-child { border-left: 0; }
  .filter-group button span { display: block; margin-top: .2rem; color: inherit; }
  .filter-group button:hover, .filter-group button.is-active { color: var(--ef-figure); background: var(--ef-signal); }
  .library-controls output { grid-column: 1 / -1; min-height: 44px; padding: .75rem 1rem; border-top: 1px solid var(--ef-ink); }
  .library-list { margin: 0; padding: 0; border-top: 1px solid var(--ef-ink); list-style: none; }
  .library-list > li { display: grid; margin: 0; padding-block: 1.75rem; grid-template-columns: 4rem minmax(0, 1fr) minmax(13rem, 18rem); gap: 1.5rem 3rem; border-bottom: 1px solid var(--ef-ink); }
  .library-list > li[hidden] { display: none; }
  .accession { display: grid; align-content: start; gap: .25rem; }
  .accession span { color: var(--ef-signal); }
  .accession small { font: inherit; }
  .library-list h2 { max-width: 28ch; margin: .35rem 0 .65rem; font-size: clamp(1.5rem, 3vw, 2.5rem); }
  .library-list h2 a { color: var(--ef-ink); text-decoration-color: transparent; }
  .library-list h2 a:hover { color: var(--ef-signal); text-decoration-color: currentColor; }
  .library-list article > p:not(.record-meta) { max-width: 68ch; }
  .library-list article ul { display: flex; margin: 1rem 0 0; padding: 0; flex-wrap: wrap; gap: .35rem .8rem; list-style: none; }
  .library-list article ul li { margin: 0; color: var(--muted); font: 560 .63rem/1.4 var(--font-data); }
  .library-list aside { display: grid; align-content: start; gap: .45rem; }
  .library-list aside strong { font: 580 .76rem/1.55 var(--font-data); }
  .library-list aside a { display: inline-flex; min-height: 44px; align-items: center; font: 650 .68rem/1.4 var(--font-data); text-transform: uppercase; }
  .library-empty { margin: 0; padding: 2rem; border-bottom: 1px solid var(--ef-ink); }
  .library-policy { display: grid; margin-block: clamp(3rem, 7vw, 6rem); grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--ef-ink); }
  .library-policy div { padding: 1.25rem; border-left: 1px solid var(--ef-ink); }
  .library-policy div:first-child { border-left: 0; }
  .library-policy strong { font: 620 1rem/1.4 var(--font-display); }
  .library-policy p { margin: .5rem 0 0; color: var(--muted); font-size: .94rem; }
  @media (max-width: 64rem) { .library-controls { grid-template-columns: 1fr; } .filter-group { display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); overflow: visible; border-top: 1px solid var(--ef-ink); border-left: 0; } .filter-group button { min-width: 0; } }
  @media (max-width: 45rem) { .library-header, .library-list > li, .library-policy { grid-template-columns: 1fr; } .accession { display: none; } .library-list aside { padding-top: 1rem; border-top: 1px solid var(--rule); } .library-policy div { border-top: 1px solid var(--ef-ink); border-left: 0; } .library-policy div:first-child { border-top: 0; } }
  @media (prefers-reduced-motion: reduce) { .filter-group button { transition: none; } }
</style>
