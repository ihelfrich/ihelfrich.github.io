---
import Base from '../../layouts/Base.astro';
import MacroLab from '../../components/MacroLab.astro';
import '../../styles/macroeconomics.css';
import 'katex/dist/katex.min.css';
---
<Base wide title="Macroeconomics suite" description="Fifteen interactive macroeconomic models with linked visualizations, live mathematics and numerical diagnostics, from undergraduate foundations to research methods." pageClass="macro-page">
  <div class="macro-shell">
    <header class="macro-header">
      <p class="macro-eyebrow"><a href="/teaching">Teaching</a><span>/</span> Macroeconomics</p>
      <div><h1>Macroeconomics suite.</h1><p>Growth, business cycles,<br />and economic policy.</p></div>
    </header>
    <MacroLab />
    <footer class="macro-footnote"><p>Fifteen models with adjustable parameters, equations, and exercises. Calibration and numerical methods are documented within each model.</p><a href="/calculus/">Calculus ↗</a><a href="/econometrics/">Econometrics ↗</a></footer>
  </div>
</Base>
