---
import Base from '../../layouts/Base.astro';
import MacroLab from '../../components/MacroLab.astro';
import '../../styles/macroeconomics.css';
import 'katex/dist/katex.min.css';
---
<Base wide title="Macroeconomics lab" description="Interactive macroeconomic models: growth, generations, monetary policy, public debt and dynamic optimization. Explore the mechanisms, equations and computations." pageClass="macro-page">
  <div class="macro-shell">
    <header class="macro-header">
      <p class="macro-eyebrow"><a href="/teaching">Teaching</a><span>/</span> Models you can work with</p>
      <div><h1>Macroeconomics lab.</h1><p>Change an assumption.<br /> Trace what happens to the economy.</p></div>
    </header>
    <MacroLab />
    <footer class="macro-footnote"><p>These are specified teaching economies with illustrative parameters. Use the equations and assumptions to establish what each experiment can explain.</p><a href="/econometrics/">From models to empirical evidence: the econometrics course ↗</a></footer>
  </div>
</Base>
