---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const people = (await getCollection("people")).sort((a, b) => a.data.order - b.data.order);
---
<Base title="People" description="Research collaborators and co-authors.">
  <h1>People</h1>
  <p>I work across a small set of long-term research collaborations. This page records public collaborators; private coaching and advisory relationships remain private.</p>

  <div class="h-card-grid">
    {people.map(p => (
      <a class="h-card" href={`/people/${p.id}`}>
        <div class="h-card-tag">{p.data.role}</div>
        <div class="h-card-title">{p.data.name}</div>
        <div class="h-card-blurb">{p.data.bio.slice(0, 200)}{p.data.bio.length > 200 ? '…' : ''}</div>
      </a>
    ))}
  </div>
</Base>
