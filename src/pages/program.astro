---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { filterDiscoverableResearch } from "../data/research-discovery.mjs";

const records = filterDiscoverableResearch(await getCollection("research"))
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
---

<Base
  wide
  title="Research questions and connections"
  description="A secondary view of Ian Helfrich's public research record, with maturity and limits preserved."
  pageClass="fieldbook-program"
>
  <section class="program-page">
    <header>
      <p class="record-label">Secondary research view</p>
      <h1>Research questions and connections</h1>
      <p>This page gathers the public research questions in one compact sequence. Shared subjects or methods can help a reader navigate between records; they do not turn active designs into completed findings.</p>
      <a class="fieldbook-action" href="/research">Research by stage of evidence</a>
    </header>
    <div class="program-register">
      {records.map((record, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <p class="status-line">{record.data.displayStatus} · {record.data.year}</p>
            <h2><a href={`/research/${record.id}`}>{record.data.title}</a></h2>
            <p>{record.data.question}</p>
          </div>
          <aside>
            <strong>{record.data.role}</strong>
            <p>{record.data.limit}</p>
          </aside>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .program-page { width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; padding-block: var(--ef-space-8); }
  .program-page > header { display: grid; grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr); gap: var(--ef-space-6); align-items: end; }
  .program-page > header .record-label { grid-column: 1 / -1; }
  .program-page > header h1 { max-width: 11ch; margin: 0; }
  .program-page > header > p:not(.record-label) { margin: 0; }
  .program-page > header .fieldbook-action { grid-column: 2; justify-self: start; }
  .record-label,
  .status-line { margin: 0 0 0.7rem; color: var(--muted); font: 620 0.7rem/1.45 var(--font-data); letter-spacing: 0.07em; text-transform: uppercase; }
  .fieldbook-action { display: inline-flex; min-height: 48px; margin-top: 0.5rem; padding: 0.8rem 1rem; align-items: center; color: var(--ef-figure); background: var(--ef-signal); border: 1px solid var(--ef-signal); border-radius: var(--ef-control-radius); font: 650 0.72rem/1 var(--font-data); text-decoration: none; text-transform: uppercase; }
  .program-register { margin-top: var(--ef-space-7); border-top: 1px solid var(--ef-ink); }
  .program-register article { display: grid; padding-block: var(--ef-space-5); grid-template-columns: 3rem minmax(0, 2fr) minmax(15rem, 0.9fr); gap: var(--ef-space-5); border-bottom: 1px solid var(--rule); }
  .program-register article > span { color: var(--ef-signal); font: 600 0.76rem/1.4 var(--font-data); }
  .program-register h2 { margin: 0 0 0.7rem; font-size: clamp(1.35rem, 2.5vw, 2.1rem); }
  .program-register h2 a { color: var(--ef-ink); text-decoration: none; }
  .program-register aside { padding-left: 1rem; border-left: 1px solid var(--rule); }
  .program-register aside strong { font: 650 0.7rem/1.45 var(--font-data); }
  .program-register aside p { margin-top: 0.8rem; padding-top: 0.8rem; color: var(--ef-oxide); border-top: 2px solid currentColor; }
  @media (max-width: 45rem) {
    .program-page { padding-block: var(--ef-space-7); }
    .program-page > header { grid-template-columns: 1fr; }
    .program-page > header .fieldbook-action { grid-column: 1; }
    .program-register article { grid-template-columns: 2.5rem 1fr; }
    .program-register aside { grid-column: 2; padding: 1rem 0 0; border-top: 1px solid var(--rule); border-left: 0; }
  }
</style>
