---
import Base from "../../layouts/Base.astro";
import CdeDecomposition from "../../components/CdeDecomposition.astro";
import { getCollection, getEntry, render } from "astro:content";
import { filterDiscoverableResearch } from "../../data/research-discovery.mjs";

export async function getStaticPaths() {
  const papers = filterDiscoverableResearch(await getCollection("research"));
  return papers.map(p => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const paper = await getEntry("research", slug);
const { Content } = await render(paper);
---
<Base wide pageClass="record-page record-paper" title={paper.data.title} description={paper.data.abstract}>
  <article class="h-article">
    <header>
      <div class="record-topline"><a href="/library">PUBLIC INDEX</a><span>PAPER · {paper.data.year}</span><span><i></i>{paper.data.displayStatus}</span></div>
      <div class="h-article-meta">{paper.data.venue ?? "INDEPENDENT RESEARCH RECORD"}</div>
      <h1>{paper.data.title}</h1>
      <p class="record-authors">{paper.data.authors.join(" · ")}</p>
      <p class="record-deck">{paper.data.abstract}</p>
      <div class="record-actions">
        {paper.data.pdf && <a href={paper.data.pdf} target="_blank" rel="noopener">PDF →</a>}
        {paper.data.ssrn && <a href={paper.data.ssrn} target="_blank" rel="noopener">SSRN →</a>}
        {paper.data.repo && <a href={paper.data.repo} target="_blank" rel="noopener">Code & data →</a>}
      </div>
    </header>
    {slug === "helfrich-2026-nmtc-rural-gap" && <CdeDecomposition />}
    <div class="record-body"><Content /></div>
    <footer class="record-end"><span>END OF PUBLIC RECORD</span><a href="/research">All papers →</a><a href="/library">Complete public index →</a></footer>
  </article>
</Base>
