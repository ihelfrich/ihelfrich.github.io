---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ResearchGraph from "../../components/ResearchGraph.astro";
import { filterDiscoverableResearch } from "../../data/research-discovery.mjs";

const maturityGroups = [
  {
    key: "circulating",
    heading: "Public and circulating",
    note: "A manuscript or institutional record is available now.",
  },
  {
    key: "working",
    heading: "Current work",
    note: "The analysis is documented; only cleared public artifacts are linked.",
  },
  {
    key: "development",
    heading: "Active development",
    note: "No results yet. These records describe a question, design, or data build without an empirical result claim.",
  },
  {
    key: "earlier",
    heading: "Earlier work",
    note: "Completed institutional work with its original date and boundary intact.",
  },
] as const;

const research = filterDiscoverableResearch(await getCollection("research"));
const recordsByMaturity = new Map(maturityGroups.map((group) => [
  group.key,
  research
    .filter((record) => record.data.maturity === group.key)
    .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title)),
]));
const sourceLink = (record) => record.data.pdf
  ? { label: "PDF", href: record.data.pdf }
  : record.data.ssrn
    ? { label: "SSRN", href: record.data.ssrn }
    : record.data.repo
      ? { label: "Repository", href: record.data.repo }
      : undefined;
---

<Base
  wide
  title="Research"
  description="Research by Ian Helfrich, organized by what is public, what has evidence available, and what remains under development."
  pageClass="fieldbook-research"
>
  <section class="research-hero route-grid" data-rail-label="Research overview">
    <div class="research-hero__copy">
      <p class="record-label">Research ledger · status first</p>
      <h1>Research, by stage of evidence</h1>
      <p>My research spans trade, spatial measurement, place-based policy, labor and AI, and economic theory. This page separates work a reader can inspect now from working papers and designs still under development, because the status is part of the claim.</p>
    </div>
    <aside class="research-hero__key" aria-label="Status definitions">
      <dl>
        <div><dt>Public</dt><dd>A manuscript or institutional record is available.</dd></div>
        <div><dt>Current</dt><dd>The analysis is documented; links are limited to cleared artifacts.</dd></div>
        <div><dt>Development</dt><dd>No results yet.</dd></div>
      </dl>
    </aside>
  </section>

  <div class="maturity-register">
    {maturityGroups.map((group, groupIndex) => {
      const records = recordsByMaturity.get(group.key) ?? [];
      return (
        <section class="maturity-section route-shell" data-rail-label={group.heading} id={`stage-${group.key}`}>
          <header class="maturity-heading">
            <span>{String(groupIndex + 1).padStart(2, "0")}</span>
            <div>
              <h2>{group.heading}</h2>
              <p>{group.note}</p>
            </div>
            <strong>{String(records.length).padStart(2, "0")} records</strong>
          </header>

          <div class="research-list">
            {records.map((record, index) => {
              const artifact = sourceLink(record);
              return (
                <article class="research-row" id={`record-${record.id}`} data-fieldbook-reveal>
                  <div class="research-row__accession" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
                  <div class="research-row__main">
                    <p class="status-line">{record.data.displayStatus} · {record.data.year}</p>
                    <h3><a href={`/research/${record.id}`}>{record.data.title}</a></h3>
                    <p class="research-question">{record.data.question}</p>
                    <p><strong>Role:</strong> {record.data.role}</p>
                    <nav aria-label={`${record.data.title} links`}>
                      <a href={`/research/${record.id}`}>Research record →</a>
                      {artifact && <a href={artifact.href} target={/^https?:/.test(artifact.href) ? "_blank" : undefined} rel={/^https?:/.test(artifact.href) ? "noopener" : undefined}>{artifact.label}{/^https?:/.test(artifact.href) ? " ↗" : " →"}</a>}
                    </nav>
                  </div>
                  <aside class="research-row__margin">
                    <p><span>Method</span>{record.data.method.join(" · ")}</p>
                    <p class="limit"><span>Limit</span>{record.data.limit}</p>
                  </aside>
                </article>
              );
            })}
            {group.key === "working" && (
              <article class="research-row supporting-record" data-fieldbook-reveal>
                <div class="research-row__accession" aria-hidden="true">B</div>
                <div class="research-row__main">
                  <p class="status-line">Book and workbook in progress · August 2026</p>
                  <h3><a href="/projects/pictures-of-inference">Pictures of Inference</a></h3>
                  <p class="research-question">How can visual models make estimators, sampling variation, and causal comparisons easier to reason about?</p>
                  <p><strong>Role:</strong> With Elizaveta Gonchar. Part One, chapters 1–10 drafted as of August 14, 2026.</p>
                  <nav aria-label="Pictures of Inference link"><a href="/projects/pictures-of-inference">Project record →</a></nav>
                </div>
                <aside class="research-row__margin">
                  <p><span>Method</span>Visual explanation · simulation · workbook construction</p>
                  <p class="limit"><span>Limit</span>The book is in progress. It is not described as complete or forthcoming.</p>
                </aside>
              </article>
            )}
          </div>
        </section>
      );
    })}
  </div>

  <section class="research-map route-band" data-rail-label="Research map">
    <div class="route-shell route-shell--compact">
      <header class="section-intro">
        <div>
          <p class="record-label">Secondary view</p>
          <h2>Shared methods across the public record</h2>
        </div>
        <p>The complete maturity list above remains the canonical view. The graph offers another way to explore explicit method tags without implying that every record belongs to one finished program.</p>
      </header>
      <ResearchGraph papers={research} />
    </div>
  </section>

  <section class="research-close route-grid" data-rail-label="Contact">
    <div>
      <p class="record-label">Research conversation</p>
      <h2>Working on an adjacent question?</h2>
    </div>
    <div>
      <p>Send the paper title or project description, the connection you see, and the specific conversation you are proposing.</p>
      <a class="fieldbook-action" href="mailto:ianthelfrich@gmail.com?subject=Research%20inquiry">Email Ian</a>
    </div>
  </section>
</Base>

<style>
  .route-shell { width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; padding-block: var(--ef-space-7); }
  .route-shell--compact { padding-block: 0; }
  .route-grid { display: grid; width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--ef-gutter); }
  .route-band { padding-block: var(--ef-space-7); background: var(--ef-figure); border-block: 1px solid var(--ef-ink); }
  .record-label,
  .status-line { margin: 0 0 0.7rem; color: var(--muted); font: 620 0.7rem/1.45 var(--font-data); letter-spacing: 0.07em; text-transform: uppercase; }
  .research-hero { min-height: 39rem; padding-block: var(--ef-space-8) var(--ef-space-7); align-items: end; border-bottom: 1px solid var(--ef-ink); }
  .research-hero__copy { grid-column: 2 / span 7; }
  .research-hero h1 { max-width: 10ch; }
  .research-hero__copy > p:last-child { max-width: 62ch; font-size: 1.25rem; }
  .research-hero__key { grid-column: 9 / span 3; padding-top: 0.6rem; border-top: 2px solid var(--ef-signal); }
  .research-hero__key dl { margin: 0; }
  .research-hero__key dl > div { padding-block: 0.65rem; border-bottom: 1px solid var(--rule); }
  .research-hero__key dt { font: 650 0.7rem/1.4 var(--font-data); text-transform: uppercase; }
  .research-hero__key dd { margin: 0.2rem 0 0; }
  .maturity-section + .maturity-section { border-top: 1px solid var(--ef-ink); }
  .maturity-heading { display: grid; padding-bottom: var(--ef-space-5); align-items: start; grid-template-columns: 4rem minmax(0, 1fr) auto; gap: var(--ef-space-4); }
  .maturity-heading > span { color: var(--ef-signal); font: 560 1.5rem/1 var(--font-data); }
  .maturity-heading h2 { margin: 0; }
  .maturity-heading p { max-width: 54ch; margin-top: 0.6rem; }
  .maturity-heading > strong { color: var(--muted); font: 620 0.7rem/1.4 var(--font-data); text-transform: uppercase; }
  .research-list { border-top: 1px solid var(--ef-ink); }
  .research-row { display: grid; padding-block: var(--ef-space-5); grid-template-columns: 3rem minmax(0, 2fr) minmax(15rem, 0.85fr); gap: var(--ef-space-5); border-bottom: 1px solid var(--rule); }
  .research-row__accession { color: var(--ef-signal); font: 560 0.9rem/1.4 var(--font-data); }
  .research-row h3 { margin: 0 0 0.85rem; font-size: clamp(1.45rem, 2.7vw, 2.35rem); line-height: 1.08; }
  .research-row h3 a { color: var(--ef-ink); text-decoration: none; }
  .research-row h3 a:hover { color: var(--ef-signal); }
  .research-question { max-width: 65ch; font-size: 1.15rem; }
  .research-row nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; font: 620 0.72rem/1.4 var(--font-data); }
  .research-row__margin { padding-left: 1rem; border-left: 1px solid var(--rule); font-size: 0.95rem; }
  .research-row__margin p { margin: 0; }
  .research-row__margin p + p { margin-top: 1.25rem; }
  .research-row__margin span { display: block; margin-bottom: 0.35rem; color: var(--muted); font: 650 0.68rem/1.4 var(--font-data); letter-spacing: 0.06em; text-transform: uppercase; }
  .research-row__margin .limit { padding-top: 0.75rem; color: var(--ef-oxide); border-top: 2px solid currentColor; }
  .supporting-record { background: color-mix(in srgb, var(--ef-figure) 62%, transparent); }
  .section-intro { display: grid; grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr); gap: var(--ef-space-6); align-items: end; }
  .section-intro h2 { margin: 0; }
  .section-intro > p { margin: 0; }
  .research-map :global(.evidence-aperture) { margin-top: var(--ef-space-6); }
  .research-close { padding-block: var(--ef-space-7); }
  .research-close > div:first-child { grid-column: 2 / span 7; }
  .research-close > div:last-child { grid-column: 9 / span 3; }
  .research-close h2 { margin: 0; }
  .fieldbook-action { display: inline-flex; min-height: 48px; margin-top: 1rem; padding: 0.8rem 1rem; align-items: center; color: var(--ef-figure); background: var(--ef-signal); border: 1px solid var(--ef-signal); border-radius: var(--ef-control-radius); font: 650 0.76rem/1 var(--font-data); text-decoration: none; text-transform: uppercase; }
  .fieldbook-action:hover { color: var(--ef-figure); background: var(--ef-ink); border-color: var(--ef-ink); }
  @media (max-width: 60rem) {
    .research-hero__copy { grid-column: 1 / span 5; }
    .research-hero__key { grid-column: 6 / span 3; }
    .research-row { grid-template-columns: 2.5rem minmax(0, 1.7fr) minmax(13rem, 0.9fr); }
    .section-intro { grid-template-columns: 1fr; }
    .research-close > div:first-child { grid-column: 1 / span 5; }
    .research-close > div:last-child { grid-column: 6 / span 3; }
  }
  @media (max-width: 45rem) {
    .route-grid { display: block; }
    .research-hero { min-height: auto; padding-block: var(--ef-space-7); }
    .research-hero__key { margin-top: var(--ef-space-5); }
    .route-shell { padding-block: var(--ef-space-6); }
    .maturity-heading { grid-template-columns: 2.5rem 1fr; }
    .maturity-heading > strong { grid-column: 2; }
    .research-row { grid-template-columns: 2.5rem 1fr; }
    .research-row__margin { grid-column: 2; padding: 1rem 0 0; border-top: 1px solid var(--rule); border-left: 0; }
  }
</style>
