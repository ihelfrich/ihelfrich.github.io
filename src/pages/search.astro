---
import Base from "../layouts/Base.astro";
---

<Base wide pageClass="quiet-search-page" title="Search" description="Search Ian Helfrich's public research, projects, datasets, writing, and teaching records.">
  <div class="quiet-shell">
    <header class="quiet-header">
      <div><p class="quiet-label">Utility · public records only</p><h1>Search</h1></div>
      <p class="quiet-lead">Search the rendered public site by topic, method, title, or author. Records withheld from public discovery and archival teaching builds are excluded.</p>
    </header>

    <section class="search-panel" aria-labelledby="search-heading">
      <h2 id="search-heading" class="sr-only">Site search</h2>
      <p class="search-status" data-search-status aria-live="polite">The search index loads locally in your browser.</p>
      <div id="search"></div>
      <p class="search-fallback" data-search-fallback>Use the <a href="/library">public index</a> when browser search is unavailable or scripting is disabled.</p>
    </section>

    <aside class="privacy-note"><strong>Privacy</strong><span>Queries run against static files in your browser. This site does not send search terms to an analytics service.</span></aside>
  </div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      const status = document.querySelector("[data-search-status]");
      const fallback = document.querySelector("[data-search-fallback]");
      const searchRoot = document.querySelector("#search");
      if (status) status.textContent = "Loading the public search index…";
      if (typeof window.PagefindUI !== "function" || !searchRoot) {
        if (status) status.textContent = "Search is unavailable in this build.";
        return;
      }
      try {
        new window.PagefindUI({
          element: "#search",
          showSubResults: true,
          showImages: false,
          excerptLength: 30,
          resetStyles: false,
        });
        if (fallback) fallback.hidden = true;
        if (status) status.textContent = "Search is ready. Enter a term.";
        const announceResults = () => {
          const input = searchRoot.querySelector("input[type='text'], input[type='search']");
          const query = input?.value.trim() ?? "";
          if (!query) {
            if (status) status.textContent = "Search is ready. Enter a term.";
            return;
          }
          const results = searchRoot.querySelectorAll(".pagefind-ui__result");
          const message = searchRoot.querySelector(".pagefind-ui__message");
          if (results.length > 0) {
            if (status) status.textContent = `${results.length} ${results.length === 1 ? "result" : "results"} shown for ${query}.`;
          } else if (message) {
            if (status) status.textContent = `No public records match ${query}.`;
          } else if (status) {
            status.textContent = `Searching for ${query}…`;
          }
        };
        searchRoot.addEventListener("input", announceResults);
        new MutationObserver(announceResults).observe(searchRoot, { childList: true, subtree: true });
      } catch (error) {
        if (status) status.textContent = "Search could not load in this build.";
        if (fallback) fallback.hidden = false;
      }
    });
  </script>
</Base>

<style>
  .quiet-shell { width: min(100%, 72rem); margin-inline: auto; }
  .quiet-header { display: grid; padding-block: clamp(2rem, 6vw, 5rem); grid-template-columns: minmax(0, 1.35fr) minmax(18rem, .65fr); gap: 2rem 5rem; align-items: end; border-block: 1px solid var(--ef-ink); }
  .quiet-label, .search-status, .privacy-note strong { color: var(--muted); font: 620 .68rem/1.5 var(--font-data); letter-spacing: .07em; text-transform: uppercase; }
  h1 { margin: .6rem 0 0; font-size: clamp(3.6rem, 8vw, 7rem); }
  .quiet-lead { margin: 0; font-size: 1.15rem; }
  .search-panel { padding-block: clamp(2rem, 6vw, 5rem); }
  .search-status { min-height: 1.5rem; }
  .search-fallback { margin-top: 1rem; padding: 1rem 0 1rem 1rem; border-left: 3px solid var(--ef-oxide); }
  .privacy-note { display: grid; padding: 1rem 0 1rem 1rem; grid-template-columns: 8rem minmax(0, 1fr); gap: 1rem; border-left: 3px solid var(--ef-signal); }
  :global(.pagefind-ui) { --pagefind-ui-primary: var(--ef-signal); --pagefind-ui-text: var(--ef-ink); --pagefind-ui-background: var(--ef-figure); --pagefind-ui-border: var(--rule-dark); --pagefind-ui-tag: var(--ef-paper); --pagefind-ui-font: var(--font-text); --pagefind-ui-border-radius: 0; }
  :global(.pagefind-ui__search-input) { min-height: 52px; font-family: var(--font-display); font-size: 1rem; }
  :global(.pagefind-ui__result-title) { font-family: var(--font-display); }
  @media (max-width: 45rem) { .quiet-header, .privacy-note { grid-template-columns: 1fr; } }
</style>
