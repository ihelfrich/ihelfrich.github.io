<div class="parameter"><label for="years">Job persistence <output id="years-value">10 years</output></label><input id="years" type="range" min="1" max="20" step="1" value="10"/></div>
<div class="parameter"><label for="discount">Real discount rate <output id="discount-value">3%</output></label><input id="discount" type="range" min="0" max="10" step="1" value="3"/></div>
<div class="parameter"><label for="half-life">Travel-time half-life <output id="half-life-value">15 min</output></label><input id="half-life" type="range" min="5" max="30" step="5" value="15"/></div>
