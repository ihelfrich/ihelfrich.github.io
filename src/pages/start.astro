---
import Base from "../layouts/Base.astro";
---

<Base
  wide
  noindex
  excludeFromSearch
  title="Start an inquiry"
  description="Use Ian Helfrich's canonical contact route for hiring, research, applied quantitative work, teaching, or coaching inquiries."
>
  <section class="compatibility-page">
    <p class="record-label">Updated contact route</p>
    <h1>Start with the question, context, and timeline.</h1>
    <p>The contact page now provides the current inquiry categories, direct email route, privacy boundary, and link to the full CV and availability record.</p>
    <a class="fieldbook-action" href="/contact">Continue to contact</a>
  </section>
</Base>

<style>
  .compatibility-page { width: min(calc(100% - 2 * var(--ef-edge)), 70rem); min-height: calc(100vh - 4.5rem); margin-inline: auto; padding-block: var(--ef-space-8); }
  .record-label { margin: 0 0 0.7rem; color: var(--muted); font: 620 0.7rem/1.45 var(--font-data); letter-spacing: 0.07em; text-transform: uppercase; }
  .compatibility-page h1 { max-width: 11ch; }
  .compatibility-page > p:not(.record-label) { max-width: 60ch; font-size: 1.2rem; }
  .fieldbook-action { display: inline-flex; min-height: 48px; margin-top: 1rem; padding: 0.8rem 1rem; align-items: center; color: var(--ef-figure); background: var(--ef-signal); border: 1px solid var(--ef-signal); border-radius: var(--ef-control-radius); font: 650 0.72rem/1 var(--font-data); text-decoration: none; text-transform: uppercase; }
  .fieldbook-action:hover { color: var(--ef-figure); background: var(--ef-ink); border-color: var(--ef-ink); }
</style>
