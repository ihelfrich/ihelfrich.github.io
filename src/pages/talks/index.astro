---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const allTalks = await getCollection("talks");
const upcoming = allTalks.filter(t => t.data.upcoming).sort((a, b) => +a.data.date - +b.data.date);
const past = allTalks.filter(t => !t.data.upcoming).sort((a, b) => +b.data.date - +a.data.date);

const fmt = (d) => new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<Base title="Talks" description="Conference talks, seminars, and public-facing presentations.">
  <h1>Talks</h1>

  {upcoming.length > 0 && (
    <>
      <div class="h-section-head"><h2>Upcoming</h2></div>
      <ul class="h-row-list">
        {upcoming.map(t => (
          <li class="h-row">
            <div class="h-row-meta">{fmt(t.data.date)} · {t.data.venue}{t.data.location ? ` · ${t.data.location}` : ''} · {t.data.type}</div>
            <h3 class="h-row-title">{t.data.title}</h3>
            {t.data.abstract && <p class="h-row-summary">{t.data.abstract}</p>}
          </li>
        ))}
      </ul>
    </>
  )}

  <div class="h-section-head"><h2>Past</h2></div>
  <ul class="h-row-list">
    {past.map(t => (
      <li class="h-row">
        <div class="h-row-meta">{fmt(t.data.date)} · {t.data.venue}{t.data.location ? ` · ${t.data.location}` : ''} · {t.data.type}</div>
        <h3 class="h-row-title">{t.data.title}</h3>
        {t.data.abstract && <p class="h-row-summary">{t.data.abstract}</p>}
        {(t.data.slides || t.data.video) && (
          <div style="margin-top: 0.4rem; font-family: var(--font-sans); font-size: 0.85rem;">
            {t.data.slides && <a href={t.data.slides} target="_blank" rel="noopener">Slides</a>}
            {t.data.slides && t.data.video && <span style="color: var(--muted);"> · </span>}
            {t.data.video && <a href={t.data.video} target="_blank" rel="noopener">Video</a>}
          </div>
        )}
      </li>
    ))}
  </ul>
</Base>
