---
import Base from "../../layouts/Base.astro";
import CourseFeature from "../../components/econometrics/CourseFeature.astro";
import RepresentationRelay from "../../components/RepresentationRelay.astro";
import { picturesOfInferenceRecord, publicLinks, teachingRecognition, tutoringRecord } from "../../data/public-record.mjs";

const institutions = [
  {
    years: "2017–2023",
    institution: "Georgia Institute of Technology",
    role: "Instructor of record and teaching assistant",
    detail: "Instructor of record for three economics semesters. Additional service as a teaching assistant in Economics and as a member of the inaugural Graduate Teaching Fellow cohort, including curriculum design and orientation leadership.",
  },
  {
    years: "2016–2017",
    institution: "Duke Global Executive MBA",
    role: "Teaching support",
    detail: "Supported instruction in managerial economics, strategy, and global markets. This was a teaching-support role.",
  },
  {
    years: "2015–2016",
    institution: "Indiana University Bloomington",
    role: "Graduate teaching assistant",
    detail: "Supported undergraduate economics instruction while completing graduate training in economics.",
  },
  {
    years: "2022–2023",
    institution: "Campus / MTI College",
    role: "Online instructor",
    detail: "Taught Principles of Microeconomics in Summer and Fall 2022 and Principles of Macroeconomics in Spring 2023.",
  },
] as const;

const subjectFamilies = [
  ["Statistics & inference", "Probability, estimation, uncertainty, diagnostics, and clear interpretation."],
  ["Econometrics & research design", "Estimands, comparison design, causal inference, robustness, and research communication."],
  ["Python & SQL", "Data work, analysis, reproducible workflows, and research computing."],
  ["Microeconomics", "Consumer and producer theory, markets, incentives, game theory, and policy applications."],
  ["Macroeconomics", "Growth, business cycles, monetary and fiscal policy, and open-economy analysis."],
  ["Business, strategy & marketing", "Managerial economics, finance, quantitative marketing, and decision analysis."],
  ["GIS & public data", "Spatial reasoning, remote sensing, QGIS, policy data, and geographic evidence."],
] as const;
---

<Base
  wide
  title="Teaching and coaching"
  description="Institutional teaching, independent tutoring, quantitative research-design coaching, and open learning systems by Ian Helfrich."
  pageClass="fieldbook-teaching"
>
  <section class="teaching-hero route-grid" data-rail-label="Teaching overview">
    <div class="teaching-hero__copy">
      <p class="record-label">University teaching · executive education · independent practice</p>
      <h1>Teaching &amp; Coaching</h1>
      <p>I teach economics, statistics, econometrics, programming, and research design. My work ranges from foundational instruction to advising doctoral researchers and executives on empirical design, analysis, and communication.</p>
    </div>
    <aside class="teaching-hero__margin">
      <p>I have taught in university classrooms, supported Duke's Global Executive MBA program, led online courses, and worked through Wyzant and a separate private practice. The chronology and independently sourced hour totals appear below.</p>
    </aside>
  </section>

  <CourseFeature />

  <section class="relay-section route-band" data-rail-label="Representation relay">
    <div class="route-shell route-shell--compact">
      <header class="section-intro">
        <div>
          <p class="record-label">Live teaching demonstration</p>
          <h2>One relationship, five representations</h2>
        </div>
        <p>Change the price. The sentence, equation, table, graph, and code update together. The point is to make inconsistencies visible, while keeping the underlying result fixed.</p>
      </header>
      <RepresentationRelay />
    </div>
  </section>

  <section class="practice-record route-shell" data-rail-label="Independent practice">
    <header class="section-intro">
      <div>
        <p class="record-label">Independent practice · {tutoringRecord.asOf}</p>
        <h2>Independent instruction, by source</h2>
      </div>
      <p>Wyzant reports platform hours; the private-practice figure comes from a separate practice ledger. The two figures are shown independently.</p>
    </header>
    <div class="hours-pair">
      <article>
        <p class="source-line">platform-recorded · {tutoringRecord.wyzant.evidenceLabel}</p>
        <strong>{tutoringRecord.wyzant.hoursDisplay}</strong>
        <h3>Instruction through Wyzant</h3>
        <p>{tutoringRecord.wyzant.hoursProse[0].toUpperCase() + tutoringRecord.wyzant.hoursProse.slice(1)} hours, current as of {tutoringRecord.wyzant.asOf}. <a href={publicLinks.wyzant} target="_blank" rel="noopener">Public profile ↗</a></p>
      </article>
      <article>
        <p class="source-line">practice-recorded · {tutoringRecord.privatePractice.evidenceLabel}</p>
        <strong>{tutoringRecord.privatePractice.hoursDisplay}</strong>
        <h3>Independent private practice</h3>
        <p>{tutoringRecord.privatePractice.hoursProse[0].toUpperCase() + tutoringRecord.privatePractice.hoursProse.slice(1)} additional hours, separate from Wyzant.</p>
      </article>
    </div>
    <p class="practice-range">I work with students, doctoral researchers, professionals, and executives. Subjects include economics, statistics, econometrics, research design, Python, SQL, Stata, data analysis, finance, marketing analytics, strategy, policy, GIS, and quantitative test preparation. Engagements range from focused tutoring to ongoing quantitative research-design coaching.</p>
    <div class="subject-families" aria-label="Teaching subject families">
      {subjectFamilies.map(([title, detail]) => (
        <article>
          <h3>{title}</h3>
          <p>{detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="coaching-method route-shell" data-rail-label="Research-design coaching">
    <header class="section-intro">
      <div>
        <p class="record-label">Research-design coaching</p>
        <h2>From research question to empirical design</h2>
      </div>
      <p>A coaching engagement begins by clarifying the claim or decision, the target quantity, and the available evidence. Software and estimator choices follow from those decisions.</p>
    </header>
    <ol class="coaching-sequence">
      <li><span>01</span><div><strong>Decision</strong><p>Identify the decision, claim, or scholarly contribution the analysis needs to inform.</p></div></li>
      <li><span>02</span><div><strong>Estimand</strong><p>Define the population, treatment or exposure, outcome, time frame, and quantity of interest.</p></div></li>
      <li><span>03</span><div><strong>Evidence</strong><p>Test whether the available data match the question and document the construction.</p></div></li>
      <li><span>04</span><div><strong>Comparison</strong><p>Choose a credible comparison and name the threats that could defeat it.</p></div></li>
      <li><span>05</span><div><strong>Verification</strong><p>Plan diagnostics, robustness checks, and reproducible computation before interpreting output.</p></div></li>
      <li><span>06</span><div><strong>Communication</strong><p>State the result, uncertainty, scope, and limit in language suited to the audience.</p></div></li>
    </ol>
    <p class="composite-note">For example, “Did this program work?” becomes a set of explicit choices about target population, timing, outcome, comparison group, and plausible threats to identification. This is a composite illustration, not an account of an individual learner or client project.</p>
  </section>

  <section class="institutional-record route-band" data-rail-label="Institutional record">
    <div class="route-shell route-shell--compact">
      <header class="section-intro">
        <div>
          <p class="record-label">Institutional chronology</p>
          <h2>Classrooms, executive education, and online instruction</h2>
        </div>
        <p>The chronology distinguishes instructor-of-record appointments from teaching-support roles.</p>
      </header>
      <div class="chronology">
        {institutions.map((entry) => (
          <article data-fieldbook-reveal>
            <time>{entry.years}</time>
            <div>
              <h3>{entry.institution}</h3>
              <p class="role-line">{entry.role}</p>
              <p>{entry.detail}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="recognition-pair">
        <article>
          <p class="source-line">Award</p>
          <h3>{teachingRecognition.award}, {teachingRecognition.year}</h3>
        </article>
        <article>
          <p class="source-line">Teaching evaluations</p>
          <h3>Georgia Tech course-evaluation record, {teachingRecognition.evaluations.year}</h3>
          <a href={teachingRecognition.evaluations.href}>View source PDF →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="learning-systems route-shell" id="capability-libraries" data-rail-label="Learning systems">
    <header class="section-intro">
      <div>
        <p class="record-label">Durable learning systems</p>
        <h2>Reusable public materials</h2>
      </div>
      <p>The portfolio focuses on generalized public tools and books. Learner-specific work remains private.</p>
    </header>
    <div class="system-register">
      <article>
        <p class="source-line">Living book · open data lab</p>
        <h3><a href="https://helfrich-causal-inference.pr0digal.chatgpt.site/">Counterfactuals</a></h3>
        <p>A causal-inference book built from questions, assignment mechanisms, estimands, and evidence. Its public data lab lets readers inspect, plot, filter, and download the rows.</p>
        <a href="https://helfrich-causal-inference.pr0digal.chatgpt.site/data">Open the book and data lab →</a>
      </article>
      <article>
        <p class="source-line">Live public system · version 0.1</p>
        <h3><a href="/projects/applied-statistics">Applied Statistics</a></h3>
        <p>One complete two-group inference workflow, with a synchronized question, data, derivation, diagnostics, interpretation, and implementations in JavaScript, Python, R, and Julia.</p>
        <a href="/projects/applied-statistics">Open the system and least-squares lab →</a>
      </article>
      <article>
        <p class="source-line">{picturesOfInferenceRecord.status}</p>
        <h3><a href={picturesOfInferenceRecord.href}>Pictures of Inference</a></h3>
        <p>{picturesOfInferenceRecord.collaborators}. A visual route into estimators, sampling variation, and causal comparisons; {picturesOfInferenceRecord.part}, {picturesOfInferenceRecord.chapters}, drafted as of {picturesOfInferenceRecord.draftedAsOf}.</p>
        <a href={picturesOfInferenceRecord.href}>Project record →</a>
      </article>
      <article>
        <p class="source-line">Open supporting resources</p>
        <h3>Teaching notes and statistical software references</h3>
        <p>Public notes, examples, and reference material organized around reusable concepts and workflows.</p>
        <a href="/projects">Browse public learning projects →</a>
      </article>
    </div>
  </section>

  <section class="teaching-close route-grid" data-rail-label="Contact">
    <div>
      <p class="record-label">Teaching and coaching inquiries</p>
      <h2>Tell me the subject, level, timeline, and kind of help you need.</h2>
    </div>
    <div>
      <p>I am available for advanced tutoring, quantitative research-design coaching, curriculum and learning-system work, and institutional teaching.</p>
      <a class="fieldbook-action" href="/contact">Ask about teaching or coaching</a>
      <a class="text-route" href="/cv#teaching">View the full teaching record →</a>
    </div>
  </section>
</Base>

<style>
  .route-shell { width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; padding-block: var(--ef-space-7); }
  .route-shell--compact { padding-block: 0; }
  .route-grid { display: grid; width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--ef-gutter); }
  .route-band { padding-block: var(--ef-space-7); color: var(--ef-ink); background: var(--ef-figure); border-block: 1px solid var(--ef-ink); }
  .record-label,
  .source-line,
  .role-line { margin: 0 0 0.7rem; color: var(--muted); font: 620 0.7rem/1.45 var(--font-data); letter-spacing: 0.07em; text-transform: uppercase; }
  .teaching-hero { min-height: 38rem; padding-block: var(--ef-space-8) var(--ef-space-7); align-items: end; border-bottom: 1px solid var(--ef-ink); }
  .teaching-hero__copy { grid-column: 2 / span 7; }
  .teaching-hero__copy h1 { max-width: 9ch; }
  .teaching-hero__copy > p:last-child { max-width: 64ch; font-size: 1.25rem; }
  .teaching-hero__margin { grid-column: 9 / span 3; padding-top: 0.8rem; border-top: 2px solid var(--ef-signal); }
  .section-intro { display: grid; grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr); gap: var(--ef-space-6); align-items: end; }
  .section-intro h2 { margin: 0; }
  .section-intro > p { margin: 0; }
  .relay-section :global(.evidence-aperture) { margin-top: var(--ef-space-6); }
  .hours-pair { display: grid; margin-top: var(--ef-space-6); grid-template-columns: 1fr 1fr; border: 1px solid var(--ef-ink); }
  .hours-pair article { min-height: 22rem; padding: var(--ef-space-5); }
  .hours-pair article + article { border-left: 1px solid var(--ef-ink); }
  .hours-pair article > strong { display: block; margin-block: 1rem; font: 570 clamp(3.5rem, 8vw, 7rem)/0.9 var(--font-display); letter-spacing: -0.065em; }
  .hours-pair h3 { font-size: clamp(1.35rem, 2.3vw, 2rem); }
  .practice-range { max-width: 72ch; margin-top: var(--ef-space-5); font-size: 1.15rem; }
  .subject-families { display: grid; margin-top: var(--ef-space-5); grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ef-ink); border-left: 1px solid var(--ef-ink); }
  .subject-families article { min-height: 11rem; padding: var(--ef-space-4); border-right: 1px solid var(--ef-ink); border-bottom: 1px solid var(--ef-ink); }
  .subject-families h3 { margin-top: 0; font: 650 0.78rem/1.4 var(--font-data); text-transform: uppercase; }
  .subject-families p { font-size: 0.96rem; }
  .coaching-sequence { display: grid; margin: var(--ef-space-6) 0 0; padding: 0; grid-template-columns: repeat(3, 1fr); list-style: none; border-top: 1px solid var(--ef-ink); border-left: 1px solid var(--ef-ink); }
  .coaching-sequence li { display: grid; min-height: 13rem; padding: var(--ef-space-4); grid-template-columns: 2.5rem 1fr; gap: 0.65rem; border-right: 1px solid var(--ef-ink); border-bottom: 1px solid var(--ef-ink); }
  .coaching-sequence span { color: var(--ef-signal); font: 600 0.72rem/1.4 var(--font-data); }
  .coaching-sequence strong { font: 650 0.78rem/1.4 var(--font-data); text-transform: uppercase; }
  .coaching-sequence p { margin-top: 0.65rem; }
  .composite-note { max-width: 74ch; margin-top: var(--ef-space-5); padding-left: 1rem; border-left: 3px solid var(--ef-oxide); }
  .chronology { margin-top: var(--ef-space-6); border-top: 1px solid var(--ef-ink); }
  .chronology article { display: grid; padding-block: var(--ef-space-5); grid-template-columns: minmax(8rem, 0.6fr) minmax(0, 2fr); gap: var(--ef-space-5); border-bottom: 1px solid var(--rule); }
  .chronology time { color: var(--ef-signal); font: 600 0.78rem/1.4 var(--font-data); }
  .chronology h3 { margin: 0; font-size: clamp(1.3rem, 2vw, 1.8rem); }
  .chronology .role-line { margin-top: 0.35rem; }
  .recognition-pair { display: grid; margin-top: var(--ef-space-6); grid-template-columns: 1fr 1fr; border: 1px solid var(--ef-ink); }
  .recognition-pair article { padding: var(--ef-space-5); }
  .recognition-pair article + article { border-left: 1px solid var(--ef-ink); }
  .recognition-pair h3 { margin: 0; }
  .system-register { display: grid; margin-top: var(--ef-space-6); grid-template-columns: repeat(2, 1fr); border: 1px solid var(--ef-ink); }
  .system-register article { padding: var(--ef-space-5); }
  .system-register article { border-bottom: 1px solid var(--ef-ink); }
  .system-register article:nth-child(even) { border-left: 1px solid var(--ef-ink); }
  .system-register article:nth-last-child(-n+2) { border-bottom: 0; }
  .system-register h3 { margin-top: 0; font-size: 1.45rem; }
  .teaching-close { padding-block: var(--ef-space-7); border-top: 1px solid var(--ef-ink); }
  .teaching-close > div:first-child { grid-column: 2 / span 7; }
  .teaching-close > div:last-child { grid-column: 9 / span 3; }
  .teaching-close h2 { margin: 0; }
  .fieldbook-action { display: inline-flex; min-height: 48px; margin-top: 1rem; padding: 0.8rem 1rem; align-items: center; color: var(--ef-figure); background: var(--ef-signal); border: 1px solid var(--ef-signal); border-radius: var(--ef-control-radius); font: 650 0.72rem/1 var(--font-data); text-decoration: none; text-transform: uppercase; }
  .fieldbook-action:hover { color: var(--ef-figure); background: var(--ef-ink); border-color: var(--ef-ink); }
  .text-route { display: block; margin-top: 1rem; font: 620 0.72rem/1.4 var(--font-data); text-transform: uppercase; }
  @media (max-width: 60rem) {
    .teaching-hero__copy { grid-column: 1 / span 5; }
    .teaching-hero__margin { grid-column: 6 / span 3; }
    .section-intro { grid-template-columns: 1fr; }
    .subject-families { grid-template-columns: repeat(2, 1fr); }
    .coaching-sequence { grid-template-columns: repeat(2, 1fr); }
    .system-register { grid-template-columns: 1fr; }
    .system-register article + article { border-top: 1px solid var(--ef-ink); border-left: 0; }
    .teaching-close > div:first-child { grid-column: 1 / span 5; }
    .teaching-close > div:last-child { grid-column: 6 / span 3; }
  }
  @media (max-width: 45rem) {
    .route-grid { display: block; }
    .teaching-hero { min-height: auto; padding-block: var(--ef-space-7); }
    .teaching-hero__margin { margin-top: var(--ef-space-5); }
    .route-shell { padding-block: var(--ef-space-6); }
    .hours-pair,
    .recognition-pair,
    .coaching-sequence { grid-template-columns: 1fr; }
    .subject-families { grid-template-columns: 1fr; }
    .hours-pair article + article,
    .recognition-pair article + article { border-top: 1px solid var(--ef-ink); border-left: 0; }
    .chronology article { grid-template-columns: 1fr; gap: 0.65rem; }
  }
</style>
