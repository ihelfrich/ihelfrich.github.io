---
import Base from "../../layouts/Base.astro";
import AssumptionLab from "../../components/AssumptionLab.astro";
import { readVerdicts, runExperiment } from "../../lib/ols-assumptions.mjs";

const assumptions = [
  {
    id: "a1-specification",
    assumption: "specification",
    number: 1,
    kicker: "Correct specification",
    heading: "The model is linear, correctly specified, and has an additive error",
    notation: "Yᵢ = β₀ + β₁X₁ᵢ + ⋯ + βₖXₖᵢ + εᵢ",
    protects: "Unbiasedness",
    question: "What does a straight line cost you when the policy actually has diminishing returns?",
    caption:
      "A quadratic spending relationship fitted with a straight line. The slider controls the omitted curvature.",
    strengthLabel: "Curvature in the true relationship",
    domain: [0.4, 4.2] as [number, number],
    method: ["OLS on a quadratic truth", "500-sample Monte Carlo", "true null tested at 5%"],
    limit:
      "With this uniform regressor, the difference between the fitted slope and the linear-term coefficient equals the omitted curvature. Other regressor distributions change that relationship.",
    setting:
      "Spending per pupil raises test scores, and the first thousand dollars does more than the tenth. A budget office fits a line and reports a single per-dollar effect.",
    breaks:
      "The omitted squared term contributes to the fitted slope. At full curvature, the average estimate is 3.4, while the coefficient of the linear term is 1.",
    detect:
      "Plot residuals against fitted values and regressors. Systematic curvature can indicate a missing nonlinear term; RESET tests for certain specification errors.",
    fix:
      "Consider a squared term, a log specification, or a spline, according to the relationship being modeled. Changing standard errors leaves the misspecified coefficient unchanged.",
  },
  {
    id: "a2-zero-mean",
    assumption: "zeroMean",
    number: 2,
    kicker: "Zero-mean error",
    heading: "The error term has a population mean of zero",
    notation: "E(εᵢ) = 0",
    protects: "Intercept normalization",
    question: "If every household understates its spending by the same amount, what happens to the slope?",
    caption:
      "A common offset shifts the intercept and leaves the slope unchanged.",
    strengthLabel: "Size of the constant offset",
    domain: [0.5, 1.5] as [number, number],
    method: ["OLS with a shifted error", "500-sample Monte Carlo", "true null tested at 5%"],
    limit:
      "This result concerns an offset common to every observation. An error component correlated with a regressor can bias the slope.",
    setting:
      "A benefits survey collects self-reported spending. Respondents understate by roughly the same amount regardless of income, so every observation sits below its true value.",
    breaks:
      "The intercept absorbs the offset. Replacing the intercept by β₀ + 4 and the error by ε − 4 gives the same model with a zero-mean error.",
    detect:
      "OLS residuals sum to zero when a constant is included. That identity cannot establish the mean of the population error.",
    fix:
      "Include an intercept to absorb the common offset. Its interpretation depends on the outcome scale.",
  },
  {
    id: "a3-exogeneity",
    assumption: "exogeneity",
    number: 3,
    kicker: "Exogeneity",
    heading: "No regressor is correlated with the error term",
    notation: "Cov(Xⱼᵢ, εᵢ) = 0 for every j",
    protects: "Unbiasedness",
    question: "How does selection into training affect the estimated earnings effect?",
    caption:
      "An unmeasured driver raises earnings and also predicts who enrols. The slider is how strongly enrolment and that driver move together.",
    strengthLabel: "Correlation between enrolment and the omitted driver",
    domain: [0.4, 2.6] as [number, number],
    method: ["OLS with an omitted confounder", "500-sample Monte Carlo", "true null tested at 5%"],
    limit:
      "The confounder is known in this simulation. In an empirical study, the identification argument must address unobserved selection.",
    setting:
      "A job-training programme is evaluated on earnings. Motivation is unmeasured, raises earnings on its own, and predicts who enrols in the first place.",
    breaks:
      "At full strength, the average estimate is 2.2 against a true effect of 1. The simulation rejects the true null in nearly every repetition.",
    detect:
      "Residual diagnostics alone cannot establish exogeneity. Examine how enrollment was determined and which common causes of enrollment and earnings were measured.",
    fix:
      "A randomized assignment, valid instrument, discontinuity, or credible difference-in-differences design may address selection. Each requires its own identifying assumptions.",
  },
  {
    id: "a4-independence",
    assumption: "independence",
    number: 4,
    kicker: "Independent errors",
    heading: "Observations of the error term are uncorrelated with each other",
    notation: "Corr(εᵢ, εⱼ) = 0 for i ≠ j",
    protects: "Efficiency and valid standard errors",
    question: "How does serial correlation affect the standard error?",
    caption:
      "Errors follow an AR(1) process along a time trend. Total error variance is held fixed, so the only thing the slider changes is persistence.",
    strengthLabel: "Persistence of the shock",
    domain: [-0.9, 2.9] as [number, number],
    method: ["OLS with AR(1) errors", "500-sample Monte Carlo", "true null tested at 5%"],
    limit:
      "HC1 allows heteroskedasticity but ignores serial correlation. Newey-West estimates account for both under the relevant regularity conditions.",
    setting:
      "State unemployment is tracked quarterly after a stimulus. A bad quarter does not clear by the next one, so the shock persists.",
    breaks:
      "In this simulation, the slope remains unbiased. At full persistence, its sampling spread is about six times the reported standard error, and the nominal 5% test rejects roughly 70% of the time.",
    detect:
      "Plot residuals in time order and inspect their autocorrelation. Durbin-Watson and Breusch-Godfrey tests address specified forms of serial correlation.",
    fix:
      "Use a dependence-appropriate variance estimator, such as Newey-West. HC1 alone does not account for correlation across periods.",
  },
  {
    id: "a5-homoskedasticity",
    assumption: "homoskedasticity",
    number: 5,
    kicker: "Constant variance",
    heading: "The error term has constant variance",
    notation: "Var(εᵢ) = σ² for every i",
    protects: "Efficiency and valid standard errors",
    question: "Large cities are noisier than small ones. What does that do to a significance test?",
    caption:
      "Error spread grows with the regressor, and the regressor is skewed the way municipal data actually is: many small units, a few very large ones.",
    strengthLabel: "How fast the spread grows with size",
    domain: [-0.6, 2.6] as [number, number],
    method: ["OLS with size-dependent error variance", "HC1 robust standard errors", "500-sample Monte Carlo"],
    limit:
      "HC1 reduces the distortion without eliminating it at this sample size, because robust standard errors are an asymptotic correction. HC3 does better in small samples.",
    setting:
      "Municipal expenditure is regressed on resident income across cities. A town of four thousand and a city of four million are one observation each, and the large ones vary enormously.",
    breaks:
      "The slope stays unbiased and the reported standard error reports only about 60% of the true spread. A nominal 5% test rejects a true null roughly 22% of the time. The noisiest observations are also the highest-leverage ones, which is what makes the distortion this severe.",
    detect:
      "Plot residuals against fitted values and look for a fan opening to the right. The White and Breusch-Pagan tests formalise it, with White the more general and Breusch-Pagan the cheaper in degrees of freedom.",
    fix:
      "HC1 reduces the rejection rate from about 22% to about 9% in this example. Its finite-sample performance can remain imperfect; the choice of variance estimator and functional form needs further checking.",
  },
  {
    id: "a6-collinearity",
    assumption: "noCollinearity",
    number: 6,
    kicker: "No exact collinearity",
    heading: "No exact linear relationship between regressors",
    notation: "No Xⱼ is an exact linear combination of the others",
    protects: "Identification, and then precision",
    question: "If two predictors say almost the same thing, which one gets the credit?",
    caption:
      "Increasing the correlation between regressors widens the coefficient distribution and its reported standard error.",
    strengthLabel: "Correlation between the two regressors",
    domain: [-0.6, 2.6] as [number, number],
    method: ["Two-regressor OLS", "variance inflation", "500-sample Monte Carlo"],
    limit:
      "This panel shows near-collinearity. Exact collinearity is not a matter of degree: the estimator has no unique solution at all, and software drops a variable instead of reporting one.",
    setting:
      "Programme need is modelled on both the poverty rate and median household income across census tracts. The two are close to mirror images of each other.",
    breaks:
      "In this near-collinearity example, the estimate stays centered on the true coefficient while its spread grows about tenfold. The rejection rate remains near 5%.",
    detect:
      "Variance inflation factors, and the tell-tale pattern of a jointly significant F with no individually significant t. Wide confidence intervals on coefficients you expected to be sharp.",
    fix:
      "Additional independent variation can improve precision. Combining predictors changes the estimand; dropping one may change the specification. Exact collinearity prevents a unique coefficient estimate.",
  },
  {
    id: "a7-normality",
    assumption: "normality",
    number: 7,
    kicker: "Normal errors",
    heading: "The error term is normally distributed",
    notation: "εᵢ ~ N(0, σ²)",
    protects: "Exact finite-sample inference",
    question: "Disaster payouts are wildly skewed. Does that invalidate the t-test?",
    caption:
      "Mean-zero lognormal errors vary in skewness and tail weight.",
    strengthLabel: "Skew and tail weight of the errors",
    defaultN: 20,
    domain: [0.1, 1.9] as [number, number],
    method: ["OLS with lognormal errors", "500-sample Monte Carlo", "true null tested at 5%"],
    limit:
      "The reported standard error does understate the average spread here, yet the test keeps its size, because the standard error errs in the same direction as the estimate in the same sample. The ratio and the rejection rate are not the same diagnostic.",
    setting:
      "Disaster relief payouts are regressed on damage assessments. Most claims are modest and a few are enormous, so the errors are nothing like a bell curve.",
    breaks:
      "For the sample sizes and error distributions shown here, the two-sided rejection rate stays near or below 5%. Other nonnormal distributions or test statistics can behave differently.",
    detect:
      "A QQ plot of the residuals, or Jarque-Bera. Both will correctly tell you the errors are not normal, which is a different question from whether it matters.",
    fix:
      "Check the behavior of the statistic for the relevant sample size and error distribution. Normality also affects prediction intervals and other distribution-dependent calculations.",
  },
];

/**
 * Seven thumbnails, each the same experiment at full violation: forty intervals
 * against the truth. The ones that bleed are the ones that cost you an answer.
 */
const overview = assumptions.map((item) => {
  const result = runExperiment({ assumption: item.assumption, strength: 1, n: item.defaultN ?? 60, reps: 240 });
  const verdict = readVerdicts(result, { robust: false });
  const [lo, hi] = item.domain;
  const y = (value: number) => 74 - Math.max(-0.06, Math.min(1.06, (value - lo) / (hi - lo))) * 64;
  const bands = [...result.intervals].sort((a, b) => a.b1 - b.b1).slice(0, 40).map((interval, index) => {
    const half = interval.tcrit * interval.se;
    return {
      x: 4 + index * 4.8,
      y1: y(interval.b1 - half),
      y2: y(interval.b1 + half),
      covers: interval.b1 - half <= result.trueB1 && interval.b1 + half >= result.trueB1,
    };
  });
  return { item, bands, truthY: y(result.trueB1), misses: verdict.misses, worst: verdict.centre.state === "broken" ? "estimate" : verdict.size.state === "clean" ? "nothing" : "test" };
});
---

<Base
  wide
  title="The seven classical assumptions of OLS"
  description="An interactive companion to the classical assumptions of ordinary least squares, built on public-policy examples. Simulations compare coefficient bias, standard errors, and rejection rates."
>
  <article class="ols-page">
    <header class="ols-hero">
      <p class="ols-kicker">Teaching · applied econometrics</p>
      <h1>OLS assumptions</h1>
      <p class="ols-lede">Seven simulations of classical linear-regression assumptions. Each changes one feature of the data-generating process and measures its effect on estimation and inference.</p>
    </header>

    <section class="ols-frame" aria-labelledby="three-questions">
      <h2 id="three-questions">Bias, precision, and test size</h2>
      <p>
        Bias is the difference between the expected estimate and the target coefficient. Under the Gauss-Markov conditions, OLS has the smallest variance among linear unbiased estimators. The simulations compare coefficient bias, the reported standard error, and the frequency of rejecting a true null.
      </p>
      <p>
        Each panel runs the same experiment. It builds a world where the true slope is exactly 1, draws 500 samples
        from it, estimates the slope in each, and tests a hypothesis that is true by construction. That gives three
        readings:
      </p>
      <ol class="ols-questions">
        <li>
          <strong>Does the estimate still centre on the truth?</strong> The gap between the dashed line and the blue
          line is bias.
        </li>
        <li>
          <strong>Does the reported standard error match the real spread?</strong> The teal bar is how much the
          estimate actually moves between samples. The rust bar is how much the regression claims it moves.
        </li>
        <li>
          <strong>How often does a 5% test reject a true null?</strong> A correctly sized test rejects in 5% of repetitions; simulation estimates that frequency with sampling variation.
        </li>
      </ol>

    </section>

    <section class="ols-map" aria-labelledby="what-breaks">
      <h2 id="what-breaks">Simulation results</h2>
      <div class="ols-table-scroll">
        <table>
          <caption>Results at the maximum violation setting.</caption>
          <thead>
            <tr>
              <th scope="col">Assumption broken</th>
              <th scope="col">Estimate still centred?</th>
              <th scope="col">Standard error accurate?</th>
              <th scope="col">Actual size of a 5% test</th>
            </tr>
          </thead>
          <tbody>
            <tr><th scope="row">1 · Specification</th><td class="is-bad">No, bias +2.4</td><td>Roughly</td><td class="is-bad">~100%</td></tr>
            <tr><th scope="row">2 · Zero-mean error</th><td class="is-good">Yes</td><td class="is-good">Yes</td><td class="is-good">5%</td></tr>
            <tr><th scope="row">3 · Exogeneity</th><td class="is-bad">No, bias +1.2</td><td>Roughly</td><td class="is-bad">~100%</td></tr>
            <tr><th scope="row">4 · Independence</th><td class="is-good">Yes</td><td class="is-bad">No, understates 6×</td><td class="is-bad">~70%</td></tr>
            <tr><th scope="row">5 · Homoskedasticity</th><td class="is-good">Yes</td><td class="is-bad">No, understates 1.6×</td><td class="is-bad">~22%</td></tr>
            <tr><th scope="row">6 · No collinearity</th><td class="is-good">Yes</td><td class="is-good">Yes</td><td class="is-good">5%</td></tr>
            <tr><th scope="row">7 · Normality</th><td class="is-good">Yes</td><td>Understates on average</td><td class="is-good">5% or below</td></tr>
          </tbody>
        </table>
      </div>
      <p class="ols-note">
        Specification and exogeneity failures bias the coefficient in these examples. Serial correlation and heteroskedasticity affect inference without shifting the coefficient’s mean. The remaining examples concern intercept normalization, near-collinearity, and nonnormal errors.
      </p>
    </section>

    <section class="ols-atlas" aria-labelledby="atlas">
      <h2 id="atlas">Seven experiments at a glance</h2>
      <p>
        Each graph shows forty simulated 95% intervals at the maximum setting, ordered by their coefficient estimate. Highlighted intervals exclude the true coefficient.
      </p>
      <ol class="ols-atlas__grid">
        {overview.map((entry) => (
          <li>
            <a href={`#${entry.item.id}`}>
              <span class="ols-atlas__n">{String(entry.item.number).padStart(2, "0")}</span>
              <span class="ols-atlas__name">{entry.item.kicker}</span>
              <svg viewBox="0 0 200 84" role="img" aria-label={`${entry.item.kicker}: ${entry.misses} intervals in a hundred miss the true slope`}>
                <line x1="2" x2="198" y1={entry.truthY} y2={entry.truthY} class="ols-atlas__truth"></line>
                {entry.bands.map((band) => (
                  <line x1={band.x} x2={band.x} y1={band.y1} y2={band.y2} class={band.covers ? "ols-atlas__ci" : "ols-atlas__ci is-miss"}></line>
                ))}
              </svg>
              <span class={`ols-atlas__stat${entry.misses > 8 ? " is-bad" : ""}`}>{entry.misses} in 100 miss</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {assumptions.map((item) => (
      <section class="ols-assumption" id={item.id} aria-labelledby={`${item.id}-heading`}>
        <header class="ols-assumption__head">
          <p class="ols-number">Assumption {item.number}</p>
          <h2 id={`${item.id}-heading`}>{item.heading}</h2>
          <p class="ols-notation">{item.notation}</p>
          <p class="ols-protects"><span>Protects</span> {item.protects}</p>
        </header>

        <div class="ols-assumption__body">
          <div class="ols-prose">
            <h3>The policy setting</h3>
            <p>{item.setting}</p>
            <h3>What breaks</h3>
            <p>{item.breaks}</p>
          </div>
          <div class="ols-prose">
            <h3>How you detect it</h3>
            <p>{item.detect}</p>
            <h3>What you do about it</h3>
            <p>{item.fix}</p>
          </div>
        </div>

        <AssumptionLab
          id={item.id + "-lab"}
          assumption={item.assumption}
          number={item.number}
          kicker={item.kicker}
          question={item.question}
          caption={item.caption}
          strengthLabel={item.strengthLabel}
          defaultN={item.defaultN ?? 60}
          domain={item.domain}
          limit={item.limit}
          method={item.method}
        />
      </section>
    ))}

    <section class="ols-close" aria-labelledby="closing">
      <h2 id="closing">Implications for applied work</h2>
      <p>
        Specification and identification determine what a coefficient estimates. Variance assumptions determine whether the reported uncertainty is appropriate. These examples isolate one issue at a time; an empirical analysis may face several together.</p>
      <p>
        Heteroskedasticity-robust standard errors address unequal error variance. They do not remove omitted-variable bias or establish a causal interpretation.</p>
    </section>
  </article>
</Base>

<style>
  .ols-page { display: grid; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .ols-hero { max-width: 68ch; }
  .ols-kicker {
    color: color-mix(in srgb, var(--ef-ink) 62%, transparent);
    font: 600 0.7rem/1.4 var(--font-data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ols-hero h1 { margin-block: 0.4rem 0.8rem; }
  .ols-lede { font: 400 clamp(1.1rem, 1.6vw, 1.35rem)/1.6 var(--font-text); max-width: 62ch; }
  .ols-frame, .ols-map, .ols-close { display: grid; gap: 0.9rem; max-width: 72rem; }
  .ols-frame p, .ols-close p, .ols-note { max-width: 68ch; }
  .ols-questions { display: grid; gap: 0.6rem; max-width: 68ch; padding-left: 1.2rem; }
  .ols-note {
    border-left: 3px solid var(--ef-signal);
    color: color-mix(in srgb, var(--ef-ink) 82%, transparent);
    padding-left: 0.8rem;
  }
  .ols-table-scroll { overflow-x: auto; }
  .ols-map table { border-collapse: collapse; font: 500 0.82rem/1.5 var(--font-data); min-width: 44rem; width: 100%; }
  .ols-map caption {
    color: color-mix(in srgb, var(--ef-ink) 62%, transparent);
    font-size: 0.74rem;
    padding-bottom: 0.5rem;
    text-align: left;
  }
  .ols-map th, .ols-map td {
    border-bottom: 1px solid color-mix(in srgb, var(--ef-ink) 16%, var(--ef-paper));
    padding: 0.55rem 0.7rem 0.55rem 0;
    text-align: left;
  }
  .ols-map thead th {
    border-bottom-color: color-mix(in srgb, var(--ef-ink) 42%, var(--ef-paper));
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ols-map .is-bad { color: var(--ef-oxide); font-weight: 650; }
  .ols-map .is-good { color: var(--ef-teal); font-weight: 650; }
  .ols-atlas { display: grid; gap: 0.9rem; }
  .ols-atlas > p { max-width: 68ch; }
  .ols-atlas__grid {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ols-atlas__grid a {
    background: var(--ef-figure);
    border: 1px solid color-mix(in srgb, var(--ef-ink) 16%, var(--ef-paper));
    display: grid;
    gap: 0.25rem;
    padding: 0.6rem 0.7rem 0.7rem;
    text-decoration: none;
  }
  .ols-atlas__grid a:hover { border-color: var(--ef-signal); }
  .ols-atlas__n { color: var(--ef-signal); font: 700 0.66rem/1.3 var(--font-data); letter-spacing: 0.1em; }
  .ols-atlas__name { color: var(--ef-ink); font: 600 0.86rem/1.3 var(--font-display); }
  .ols-atlas__grid svg { display: block; height: auto; margin-block: 0.3rem; width: 100%; }
  .ols-atlas__truth { stroke: var(--ef-ink); stroke-width: 1.5; }
  .ols-atlas__ci { stroke: color-mix(in srgb, var(--ef-ink) 30%, var(--ef-paper)); stroke-width: 2.4; }
  .ols-atlas__ci.is-miss { stroke: var(--ef-oxide); stroke-width: 3; }
  .ols-atlas__stat {
    color: color-mix(in srgb, var(--ef-ink) 62%, transparent);
    font: 600 0.7rem/1.4 var(--font-data);
    font-variant-numeric: tabular-nums;
  }
  .ols-atlas__stat.is-bad { color: var(--ef-oxide); }
  .ols-assumption {
    border-top: 2px solid var(--ef-ink);
    display: grid;
    gap: 1.4rem;
    padding-top: 1.1rem;
  }
  .ols-number {
    color: var(--ef-signal);
    font: 650 0.72rem/1.4 var(--font-data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ols-assumption__head h2 { margin-block: 0.3rem 0.5rem; max-width: 26ch; }
  .ols-notation {
    background: var(--ef-figure);
    border: 1px solid color-mix(in srgb, var(--ef-ink) 18%, var(--ef-paper));
    display: inline-block;
    font: 500 0.92rem/1.5 var(--font-data);
    padding: 0.35rem 0.7rem;
  }
  .ols-protects { font: 500 0.78rem/1.5 var(--font-data); margin-top: 0.6rem; }
  .ols-protects span {
    color: color-mix(in srgb, var(--ef-ink) 60%, transparent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ols-assumption__body { display: grid; gap: 1.4rem 2.4rem; }
  .ols-prose h3 {
    color: color-mix(in srgb, var(--ef-ink) 66%, transparent);
    font: 600 0.72rem/1.4 var(--font-data);
    letter-spacing: 0.08em;
    margin-block: 0.9rem 0.3rem;
    text-transform: uppercase;
  }
  .ols-prose h3:first-child { margin-top: 0; }
  .ols-prose p { max-width: 62ch; }
  @media (min-width: 58rem) {
    .ols-assumption__body { grid-template-columns: 1fr 1fr; }
  }
</style>
