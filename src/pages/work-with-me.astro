---
import Base from "../layouts/Base.astro";
---

<Base
  wide
  noindex
  excludeFromSearch
  title="Work with Ian Helfrich"
  description="Use the canonical contact route for roles, research collaboration, applied quantitative work, teaching, or research-design coaching."
>
  <section class="compatibility-page">
    <p class="record-label">Updated contact route</p>
    <h1>Roles, research, applied work, and advanced teaching begin in one place.</h1>
    <p>The contact page states what to include for hiring and collaboration, teaching and coaching, or a research and media inquiry.</p>
    <div class="action-row">
      <a class="fieldbook-action" href="/contact">Continue to contact</a>
      <a class="text-route" href="/work">Review selected work →</a>
    </div>
  </section>
</Base>

<style>
  .compatibility-page { width: min(calc(100% - 2 * var(--ef-edge)), 70rem); min-height: calc(100vh - 4.5rem); margin-inline: auto; padding-block: var(--ef-space-8); }
  .record-label { margin: 0 0 0.7rem; color: var(--muted); font: 620 0.7rem/1.45 var(--font-data); letter-spacing: 0.07em; text-transform: uppercase; }
  .compatibility-page h1 { max-width: 12ch; }
  .compatibility-page > p:not(.record-label) { max-width: 60ch; font-size: 1.2rem; }
  .action-row { display: flex; flex-wrap: wrap; margin-top: 1rem; align-items: center; gap: 0.8rem 1.2rem; }
  .fieldbook-action { display: inline-flex; min-height: 48px; padding: 0.8rem 1rem; align-items: center; color: var(--ef-figure); background: var(--ef-signal); border: 1px solid var(--ef-signal); border-radius: var(--ef-control-radius); font: 650 0.72rem/1 var(--font-data); text-decoration: none; text-transform: uppercase; }
  .fieldbook-action:hover { color: var(--ef-figure); background: var(--ef-ink); border-color: var(--ef-ink); }
  .text-route { font: 620 0.72rem/1.4 var(--font-data); text-transform: uppercase; }
</style>
