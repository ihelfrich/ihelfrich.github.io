---
import Base from "../layouts/Base.astro";
import CaseRecord from "../components/CaseRecord.astro";
import { tutoringRecord } from "../data/public-record.mjs";
import { workCases } from "../data/work-cases.mjs";

const caseCategories = {
  "nmtc-rural-gap": ["applied", "policy", "measurement"],
  "human-or-machine": ["applied", "measurement"],
  "trade-in-the-spotlight": ["applied", "measurement", "spatial"],
  "applied-statistics": ["learning", "measurement"],
  "nncta-semiconductor-demonstration": ["policy", "applied"],
};

const filterOptions = [
  { value: "all", label: "All five cases" },
  { value: "applied", label: "Applied research" },
  { value: "measurement", label: "Measurement" },
  { value: "policy", label: "Policy" },
  { value: "spatial", label: "Spatial" },
  { value: "learning", label: "Learning systems" },
];
---

<Base
  wide
  title="Selected work"
  description="Selected cases in applied economics, measurement, spatial analysis, policy, and quantitative education."
  pageClass="fieldbook-work"
>
  <section class="work-hero route-grid" data-rail-label="Selected work">
    <div class="work-hero__copy">
      <p class="record-label">Case index · 2023–2026</p>
      <h1>Selected work</h1>
      <p>These cases show the work between an interesting question and a defensible answer: choosing the comparison, building the evidence, checking the interpretation, and leaving a record another person can inspect.</p>
    </div>
    <aside class="work-hero__key">
      <span>Each case records</span>
      <ol>
        <li>Question</li><li>Status</li><li>Role</li><li>Method</li><li>Result</li><li>Limit</li>
      </ol>
    </aside>
  </section>

  <section class="work-index route-shell" data-rail-label="Case index">
    <header class="section-intro">
      <div>
        <p class="record-label">Five public records</p>
        <h2>Filter the index</h2>
      </div>
      <p>The filter changes the visible index only. Each case keeps one canonical record and its stated evidentiary boundary.</p>
    </header>
    <div class="case-filters" role="group" aria-label="Filter selected work" data-work-filters>
      {filterOptions.map((option, index) => (
        <button type="button" data-work-filter={option.value} aria-pressed={index === 0 ? "true" : "false"}>{option.label}</button>
      ))}
    </div>
    <p class="filter-result" data-work-filter-result aria-live="polite">Showing all five cases.</p>

    <nav class="quiet-index" aria-label="Selected case links">
      {workCases.map((record, index) => (
        <a href={`#case-${record.id}`} data-work-index={record.id}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{record.title}</strong>
          <small>{record.status}</small>
        </a>
      ))}
    </nav>
  </section>

  <section class="case-register route-shell" data-rail-label="Case records">
    <h2 class="sr-only">Case records</h2>
    {workCases.map((record, index) => (
      <div
        class="case-entry"
        data-work-case={record.id}
        data-work-categories={caseCategories[record.id]?.join(" ") ?? ""}
        data-fieldbook-reveal
      >
        <div class="case-entry__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
        <CaseRecord record={record} />
      </div>
    ))}
  </section>

  <section class="additional-practice route-shell" data-rail-label="Additional practice">
    <div class="section-intro">
      <div>
        <p class="record-label">Additional practice</p>
        <h2>Related methods, kept within their public record</h2>
      </div>
      <p>My formal training and public work also span geographic information science, remote sensing, research software, industrial-sector diagnostics, and browser-based econometrics instruction. Public examples appear where a reusable artifact exists. Private and learner-specific builds are excluded.</p>
    </div>
    <dl class="practice-ledger">
      <div><dt>Spatial measurement</dt><dd><a href="/research/gonchar-helfrich-2025-spotlight"><cite>Trade in the Spotlight</cite></a>, the <a href="/research/helfrich-2024-dissertation">doctoral dissertation</a>, and public GIS records.</dd></div>
      <div><dt>Research systems</dt><dd>The <a href="https://github.com/ihelfrich/us-nmtc-viewer">NMTC viewer and public pipeline ↗</a> and <a href="/projects/applied-statistics">Applied Statistics</a>.</dd></div>
      <div><dt>Industrial diagnostics</dt><dd>Indicator selection, analytical sequencing, composite diagnostics, and international benchmarking. Private client identities, geographies, and outcomes are not published.</dd></div>
      <div><dt>Quantitative instruction</dt><dd>Generalized browser-based sequences that connect a question, data, calculation, diagnostics, and interpretation.</dd></div>
      <div><dt>Independent teaching practice</dt><dd>{tutoringRecord.wyzant.hoursProse[0].toUpperCase() + tutoringRecord.wyzant.hoursProse.slice(1)} Wyzant hours and {tutoringRecord.privatePractice.hoursProse} additional private-practice hours as of {tutoringRecord.asOf}; the two sources remain separate. <a href="/teaching">Teaching record →</a></dd></div>
    </dl>
  </section>

  <section class="work-close route-grid" data-rail-label="Contact">
    <div>
      <p class="record-label">Next conversation</p>
      <h2>Start with the question and the record you need.</h2>
    </div>
    <div>
      <p>For a research, advisory, or teaching inquiry, include the context, timeline, and decision or output the work must support.</p>
      <a class="fieldbook-action" href="/contact">Contact Ian</a>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll("[data-work-filters]").forEach((group) => {
    const buttons = Array.from(group.querySelectorAll("[data-work-filter]"));
    const cases = Array.from(document.querySelectorAll("[data-work-case]"));
    const links = Array.from(document.querySelectorAll("[data-work-index]"));
    const result = document.querySelector("[data-work-filter-result]");
    buttons.forEach((button) => button.addEventListener("click", () => {
      const value = button.getAttribute("data-work-filter") || "all";
      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      let count = 0;
      cases.forEach((entry) => {
        const categories = entry.getAttribute("data-work-categories")?.split(" ") ?? [];
        const visible = value === "all" || categories.includes(value);
        if (entry instanceof HTMLElement) entry.hidden = !visible;
        if (visible) count += 1;
      });
      links.forEach((link) => {
        const record = link.getAttribute("data-work-index");
        const entry = cases.find((candidate) => candidate.getAttribute("data-work-case") === record);
        if (link instanceof HTMLElement) link.hidden = entry instanceof HTMLElement ? entry.hidden : false;
      });
      if (result) result.textContent = value === "all" ? "Showing all five cases." : `Showing ${count} ${count === 1 ? "case" : "cases"}.`;
    }));
  });
</script>

<style>
  .route-shell { width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; padding-block: var(--ef-space-7); }
  .route-grid { display: grid; width: min(calc(100% - 2 * var(--ef-edge)), var(--ef-grid-max)); margin-inline: auto; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--ef-gutter); }
  .record-label { margin: 0 0 0.75rem; color: var(--muted); font: 620 0.72rem/1.4 var(--font-data); letter-spacing: 0.08em; text-transform: uppercase; }
  .work-hero { min-height: 36rem; padding-block: var(--ef-space-8) var(--ef-space-7); align-items: end; border-bottom: 1px solid var(--ef-ink); }
  .work-hero__copy { grid-column: 2 / span 7; }
  .work-hero__copy h1 { margin-bottom: 1.25rem; }
  .work-hero__copy > p:last-child { max-width: 60ch; font-size: 1.3rem; }
  .work-hero__key { grid-column: 10 / span 2; padding-top: 0.75rem; border-top: 2px solid var(--ef-signal); font: 560 0.72rem/1.5 var(--font-data); }
  .work-hero__key span { color: var(--muted); text-transform: uppercase; }
  .work-hero__key ol { margin: 0.75rem 0 0; padding-left: 1.5rem; }
  .section-intro { display: grid; grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr); gap: var(--ef-space-6); align-items: end; }
  .section-intro h2 { margin: 0; }
  .section-intro > p { margin: 0; }
  .case-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: var(--ef-space-5); }
  .case-filters button { min-height: 44px; padding: 0.65rem 0.85rem; color: var(--ef-ink); background: transparent; border: 1px solid var(--ef-ink); border-radius: var(--ef-control-radius); cursor: pointer; font: 620 0.7rem/1 var(--font-data); }
  .case-filters button[aria-pressed="true"] { color: var(--ef-figure); background: var(--ef-signal); border-color: var(--ef-signal); }
  .filter-result { margin-top: 0.75rem; color: var(--muted); font: 540 0.72rem/1.4 var(--font-data); }
  .quiet-index { display: grid; margin-top: var(--ef-space-5); border-top: 1px solid var(--ef-ink); }
  .quiet-index a { display: grid; min-height: 64px; padding-block: 0.8rem; align-items: center; grid-template-columns: 3rem minmax(0, 2fr) minmax(12rem, 1fr); gap: 1rem; color: var(--ef-ink); border-bottom: 1px solid var(--rule); text-decoration: none; }
  .quiet-index a:hover strong { color: var(--ef-signal); }
  .quiet-index span,
  .quiet-index small { font-family: var(--font-data); font-size: 0.7rem; }
  .quiet-index small { color: var(--muted); }
  .case-register { padding-top: 0; }
  .case-entry { display: grid; grid-template-columns: minmax(3rem, 0.45fr) minmax(0, 6fr); gap: var(--ef-space-4); border-top: 1px solid var(--ef-ink); }
  .case-entry:last-child { border-bottom: 1px solid var(--ef-ink); }
  .case-entry[hidden] { display: none; }
  .case-entry__number { padding-top: var(--ef-space-5); color: var(--ef-signal); font: 580 clamp(1.5rem, 3vw, 3rem)/1 var(--font-data); }
  .case-entry :global(.case-record) { border-top: 0; padding-block: var(--ef-space-5); }
  .additional-practice { border-top: 1px solid var(--ef-ink); }
  .practice-ledger { margin-top: var(--ef-space-6); border-top: 1px solid var(--ef-ink); }
  .practice-ledger > div { display: grid; padding-block: 1rem; grid-template-columns: minmax(12rem, 1fr) minmax(0, 3fr); gap: var(--ef-space-5); border-bottom: 1px solid var(--rule); }
  .practice-ledger dt { font: 650 0.72rem/1.4 var(--font-data); text-transform: uppercase; }
  .practice-ledger dd { margin: 0; }
  .work-close { padding-block: var(--ef-space-7); border-top: 1px solid var(--ef-ink); }
  .work-close > div:first-child { grid-column: 2 / span 7; }
  .work-close > div:last-child { grid-column: 9 / span 3; }
  .work-close h2 { margin: 0; }
  .fieldbook-action { display: inline-flex; min-height: 48px; margin-top: 1rem; padding: 0.8rem 1rem; align-items: center; color: var(--ef-figure); background: var(--ef-signal); border: 1px solid var(--ef-signal); border-radius: var(--ef-control-radius); font: 650 0.76rem/1 var(--font-data); text-decoration: none; text-transform: uppercase; }
  .fieldbook-action:hover { color: var(--ef-figure); background: var(--ef-ink); border-color: var(--ef-ink); }
  @media (max-width: 60rem) {
    .work-hero__copy { grid-column: 1 / span 6; }
    .work-hero__key { grid-column: 7 / span 2; }
    .section-intro { grid-template-columns: 1fr; }
    .work-close > div:first-child { grid-column: 1 / span 5; }
    .work-close > div:last-child { grid-column: 6 / span 3; }
  }
  @media (max-width: 45rem) {
    .route-grid { display: block; }
    .work-hero { min-height: auto; padding-block: var(--ef-space-7); }
    .work-hero__key { margin-top: var(--ef-space-5); }
    .route-shell { padding-block: var(--ef-space-6); }
    .quiet-index a { grid-template-columns: 2.5rem 1fr; }
    .quiet-index small { grid-column: 2; }
    .practice-ledger > div { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
