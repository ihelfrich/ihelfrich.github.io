---
import Base from "../../layouts/Base.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("writing");
  return posts.map(p => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const post = await getEntry("writing", slug);
const { Content } = await render(post);
const fmt = (d) => new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---
<Base wide pageClass="record-page record-writing" title={post.data.title} description={post.data.summary}>
  <article class="h-article">
    <header>
      <div class="record-topline"><a href="/library">PUBLIC INDEX</a><span>ESSAY / NOTE</span><span><i></i>PUBLISHED</span></div>
      <div class="h-article-meta">{fmt(post.data.date)}{post.data.updated ? ` · updated ${fmt(post.data.updated)}` : ""}{post.data.tags.length > 0 ? ` · ${post.data.tags.join(" · ")}` : ""}</div>
      <h1>{post.data.title}</h1>
      <p class="record-authors">Ian Helfrich</p>
      <p class="record-deck">{post.data.subtitle ?? post.data.summary}</p>
    </header>
    <div class="record-body"><Content /></div>
    <footer class="record-end"><span>END OF NOTE</span><a href="/writing">All essays + notes →</a><a href="/rss.xml">Follow by RSS →</a></footer>
  </article>
</Base>
