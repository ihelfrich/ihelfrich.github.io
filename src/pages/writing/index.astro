---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("writing"))
  .filter(post => !post.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date);
const fmt = (date) => new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Base wide pageClass="quiet-index-page" title="Writing" description="Dated essays and notes by Ian Helfrich on research, methods, teaching, and the public site.">
  <div class="quiet-shell">
    <header class="quiet-header">
      <div><p class="quiet-label">Archive · essays and notes</p><h1>Writing</h1></div>
      <p class="quiet-lead">Dated notes on research, methods, teaching, and the public record. Older entries remain visible with their original publication context.</p>
    </header>

    <ol class="writing-list">
      {posts.map((post) => (
        <li>
          <p>{fmt(post.data.date)}{post.data.updated ? ` · updated ${fmt(post.data.updated)}` : ""}</p>
          <article><h2><a href={`/writing/${post.id}`}>{post.data.title}</a></h2><div>{post.data.summary}</div></article>
          <ul aria-label="Topics">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
        </li>
      ))}
    </ol>

    <footer class="writing-footer"><a href="/rss.xml">Subscribe to site updates by RSS</a></footer>
  </div>
</Base>

<style>
  .quiet-shell { width: min(100%, 72rem); margin-inline: auto; }
  .quiet-header { display: grid; padding-block: clamp(2rem, 6vw, 5rem); grid-template-columns: minmax(0, 1.35fr) minmax(18rem, .65fr); gap: 2rem 5rem; align-items: end; border-block: 1px solid var(--ef-ink); }
  .quiet-label, .writing-list > li > p, .writing-list ul { color: var(--muted); font: 620 .68rem/1.5 var(--font-data); letter-spacing: .07em; text-transform: uppercase; }
  h1 { margin: .6rem 0 0; font-size: clamp(3.6rem, 8vw, 7rem); }
  .quiet-lead { margin: 0; font-size: 1.15rem; }
  .writing-list { margin: 3rem 0 0; padding: 0; border-top: 1px solid var(--ef-ink); list-style: none; }
  .writing-list > li { display: grid; margin: 0; padding-block: 1.75rem; grid-template-columns: 11rem minmax(0, 1fr) minmax(10rem, 15rem); gap: 1.5rem 3rem; border-bottom: 1px solid var(--ef-ink); }
  .writing-list h2 { margin: 0 0 .65rem; font-size: clamp(1.55rem, 3vw, 2.5rem); }
  .writing-list h2 a { color: var(--ef-ink); }
  .writing-list article > div { max-width: 62ch; }
  .writing-list ul { display: flex; margin: 0; padding: 0; align-content: start; flex-wrap: wrap; gap: .3rem .7rem; list-style: none; }
  .writing-list ul li { margin: 0; }
  .writing-footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--ef-ink); }
  .writing-footer a { display: inline-flex; min-height: 44px; align-items: center; font: 650 .7rem/1.4 var(--font-data); text-transform: uppercase; }
  @media (max-width: 45rem) { .quiet-header, .writing-list > li { grid-template-columns: 1fr; } }
</style>
