---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("writing"))
  .filter(p => !p.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date);

const fmt = (d) => new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---
<Base title="Writing" description="Essays and notes on applied economics, blended finance, methods, and teaching.">
  <h1>Writing</h1>
  <p>Essays and notes on applied economics, blended finance, methods, and teaching. <a href="/rss.xml">Subscribe via RSS</a>.</p>

  <ul class="h-row-list">
    {posts.map(post => (
      <li class="h-row">
        <div class="h-row-meta">{fmt(post.data.date)} {post.data.tags.length > 0 ? `· ${post.data.tags.join(" · ")}` : ""}</div>
        <h3 class="h-row-title"><a href={`/writing/${post.id}`}>{post.data.title}</a></h3>
        <p class="h-row-summary">{post.data.summary}</p>
      </li>
    ))}
  </ul>
</Base>
